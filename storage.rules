rules_version = '2';

// ELITE90 PRO · Regras de segurança do Cloud Storage
// Bucket: elite90-c716b.firebasestorage.app
//
// PRINCÍPIO: nenhum arquivo entra ou sai pelo navegador.
//  · ENTRADA: submit-lead.ts recebe as fotos como dado na requisição e grava
//    pelo Admin SDK. O formulário público NUNCA envia direto ao bucket.
//  · SAÍDA: get-foto-urls.ts gera links temporários de 15 minutos, também
//    pelo Admin SDK. O navegador consome o link, não o bucket.
// Ambos os caminhos ignoram estas regras. Fechar tudo não quebra nada.
//
// O QUE ESTA VERSÃO CORRIGE:
//  · `allow write: if true` em /leads/** — permitia que qualquer pessoa na
//    internet, sem conta alguma, gravasse arquivos de qualquer tipo e
//    tamanho no bucket do projeto. Nunca foi necessário para o formulário
//    funcionar, porque o envio real passa pela função de servidor.
//  · `allow read: if request.auth != null` em /leads/** — qualquer conta
//    criada no projeto lia as fotos corporais de candidatos reais.

service firebase.storage {
  match /b/{bucket}/o {

    // ── HOMOLOGAÇÃO — REMOVER NO FIM DO PROJETO
    // Fotos sintéticas usadas por scripts/seed-triagem-bulk.ts. São imagens de
    // pessoas que não existem; nenhuma foto real de candidato fica aqui (o
    // submit-lead grava sempre em leads/{uploadId}/, coberto pela regra final).
    //
    // ALCANCE REAL desta permissão: `read` inclui LISTAR o conteúdo do prefixo,
    // não só abrir um arquivo cujo caminho já se conhece. Na prática, qualquer
    // pessoa na internet consegue enumerar e baixar TODO o conteúdo de
    // test_seed/. Aceito por serem imagens sintéticas — mas é bom saber que a
    // exposição é essa, e não "só quem souber o endereço".
    //
    // Não substituir por leitura admin-only: as fichas fictícias precisam ter
    // foto visível no painel para os testes de triagem fazerem sentido. A saída
    // correta é a remoção no encerramento, não o fechamento agora.
    // Entra na família (C) da lista de limpeza, junto com o script que a consome.
    match /test_seed/{allPaths=**} {
      allow read:  if true;
      allow write: if false;
    }

    // ── Todo o resto: negado, incluindo leads/, portals/ e galeria.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
