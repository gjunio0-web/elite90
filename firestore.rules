rules_version = '2';

// ELITE90 PRO · Regras de segurança do Firestore
// Projeto: elite90-c716b (southamerica-east1)
//
// PRINCÍPIO: o Admin SDK (usado por todas as Netlify Functions) IGNORA estas
// regras. Portanto, tudo o que passa por função de servidor continua
// funcionando com as regras fechadas. Estas regras governam APENAS o acesso
// direto do navegador.
//
// POR QUE `request.auth != null` NÃO SERVE: o provedor de e-mail/senha e o
// Google estão habilitados, e a chave pública do Firebase está no HTML. Isso
// significa que qualquer pessoa na internet consegue criar uma conta neste
// projeto. "Autenticado" NÃO é sinônimo de "autorizado". A autorização real
// deste projeto é o custom claim `admin`, atribuído manualmente por
// scripts/set-admin-claim.js.
//
// ESTÁGIO ATUAL (1 de 2): admin-only. Mantém funcionando as leituras diretas
// que ainda existem no navegador — admin/fichas.astro:1181 (leads) e
// admin/fichas.astro:1985 (avaliacoes) — e a de admin/atletas.astro:4888
// (athletes), esta última pendente de item de backlog próprio no épico do M2.
// ESTÁGIO FINAL (2 de 2): negar tudo, depois que essas leituras migrarem
// para funções de servidor. Ver bloco comentado no fim do arquivo.
//
// Números de linha conferidos contra o código em 15/08/2026. Se divergirem,
// vale localizar pelo trecho (getDocs de "leads" / "avaliacoes" / "athletes")
// em vez de confiar na linha.

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // ── LEADS (fichas de triagem — dado pessoal sensível, LGPD)
    // Criação: só via submit-lead (Admin SDK) — nunca pelo navegador.
    // Leitura: painel admin (fichas.astro:1181).
    // Alteração: troca de status (fichas.astro:1381) — a migrar para função.
    // Exclusão: só via delete-lead (Admin SDK) e purge-rejected-leads.
    // ESCOPO DA ALTERAÇÃO: `update` aqui permite ao admin alterar QUALQUER
    // campo da ficha, não só `status` — a regra é mais larga que o uso real.
    // Decisão consciente (15/08/2026): restringir campo a campo seria trabalho
    // jogado fora, já que esta escrita deve migrar para função de servidor.
    // Fechar no momento da migração, não antes.
    match /leads/{leadId} {
      allow read:   if isAdmin();
      allow update: if isAdmin();
      allow create, delete: if false;
    }

    // ── AVALIAÇÕES
    // Leitura: painel admin (fichas.astro:1985, filtro por leadId na 1984).
    // Escrita: só via send-evaluation / resend-evaluation (Admin SDK).
    // Histórico: existiu no painel uma gravação de `lastLinkCopiedAt` nesta
    // coleção, feita direto do navegador ao copiar o link da avaliação. Ela
    // teria falhado assim que esta regra entrasse em vigor, e o erro seria
    // engolido por um .catch() vazio. O campo não era lido em nenhum ponto do
    // código — era telemetria morta. REMOVIDA do painel em 15/08/2026.
    // Não reintroduzir: não é funcionalidade faltando.
    match /avaliacoes/{avaliacaoId} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    // ── ATLETAS (M2) — nenhum acesso direto do navegador.
    // A leitura atual em admin/atletas.astro:4888 deve migrar para função
    // de servidor. Enquanto não migrar, manter a leitura admin-only abaixo.
    match /athletes/{athleteId} {
      allow read:  if isAdmin();
      allow write: if false;

      // Subcoleções do M2: o wildcard {subcollection} nega TODAS, existentes e
      // futuras — não é preciso enumerá-las aqui, e nenhuma escapa por omissão.
      // As previstas no esquema de persistência v3 são weights, checkins e
      // plans; a lista deve ser conferida contra o esquema quando o M2 ganhar
      // back-end, para garantir que nenhuma precise de acesso direto.
      // Escrita e leitura exclusivamente por função de servidor.
      match /{subcollection}/{docId} {
        allow read, write: if false;
      }
    }

    // ── EXERCÍCIOS (catálogo) — nenhum acesso direto do navegador.
    // A leitura é por listar-exercicios.ts, a escrita por atualizar-exercicio.ts
    // — as duas usam o Admin SDK, que ignora estas regras. O portal público lê
    // o arquivo estático gerado em build, não a coleção.
    // Bloco nomeado por clareza (spec do catálogo, seção 8): a negação genérica
    // abaixo já cobria esta coleção antes deste bloco existir. Não é correção
    // de falha — é o mesmo comentário que os blocos vizinhos já têm, para quem
    // olhar as regras não precisar confiar no padrão implícito do fim do arquivo.
    match /exercises/{exerciseId} {
      allow read, write: if false;
    }

    // ── Tudo o mais: negado. Explícito, para não depender do padrão.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

// ── ESTÁGIO FINAL, a aplicar depois que as leituras diretas migrarem ──
// service cloud.firestore {
//   match /databases/{database}/documents {
//     match /{document=**} {
//       allow read, write: if false;
//     }
//   }
// }
