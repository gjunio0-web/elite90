    // ════════════════════════════════════════════════════════
    //  M2-01 — CLIENTE ÚNICO DE ESCRITA (Fase 1 da persistência)
    // ════════════════════════════════════════════════════════
    // TODA gravação do M2 passa por aqui. Um ponto só, e não um fetch por
    // ponto de chamada, por três razões:
    //
    //  1. A fila local de escrita sem rede (Fase 7) substitui ESTE ponto e
    //     mais nenhum. Espalhar chamadas agora significaria caçá-las depois.
    //  2. A chave de idempotência nasce aqui, no cliente, desde já — mesmo
    //     que a Fase 1 não a use para desduplicar. Quem gera a chave é quem
    //     enfileira, e é o mesmo lugar.
    //  3. O token nunca é guardado em variável: window.__getFreshToken() já
    //     resolve isso, e reusá-lo evita uma segunda fonte de verdade sobre
    //     a sessão.
    //
    // NÃO grava versão publicada: isso é a Fase 5. Só rascunho.
    let m2SaveSeq = 0;
    function m2NovaChave() {
      // Sem crypto.randomUUID em navegador antigo: o par tempo + contador
      // basta, porque a chave só precisa ser única dentro desta sessão.
      m2SaveSeq += 1;
      return Date.now().toString(36) + '-' + m2SaveSeq.toString(36);
    }

    async function m2Escrever(rota, carga) {
      const idToken = await window.__getFreshToken();
      const resp = await fetch('/.netlify/functions/' + rota, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + idToken },
        body: JSON.stringify(Object.assign({ idempotencyKey: m2NovaChave() }, carga)),
      });
      if (!resp.ok) {
        let detalhe = '';
        try { detalhe = (await resp.json()).erro || ''; } catch (_) {}
        throw new Error('[' + resp.status + '] ' + (detalhe || 'falha ao gravar'));
      }
      return resp.json();
    }

    // ── LEITOR ÚNICO (item 1.4) ──
    // Irmão de m2Escrever. Toda leitura do M2 passa por aqui, pelo mesmo motivo
    // que toda escrita passa por um ponto só: quando a fila da Fase 7 chegar,
    // ela se instala em dois lugares conhecidos, não em vinte espalhados.
    //
    // Usa POST como a escrita. Não é descuido — ver a justificativa no cabeçalho
    // de ler-rascunho-plano.ts: o padrão de escrita é normativo (Adendo 05,
    // W-4/TF-05), a convenção de método não é.
    async function m2Ler(rota, carga) {
      const idToken = await window.__getFreshToken();
      const resp = await fetch('/.netlify/functions/' + rota, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + idToken },
        body: JSON.stringify(carga),
      });
      if (!resp.ok) {
        let detalhe = '';
        try { detalhe = (await resp.json()).erro || ''; } catch (_) {}
        throw new Error('[' + resp.status + '] ' + (detalhe || 'falha ao ler'));
      }
      return resp.json();
    }

    // Devolve o rascunho gravado, ou null quando não há.
    //
    // NUNCA LANÇA. Falha de leitura degrada para "monta como montava antes" — o
    // Coach perde o rascunho persistido naquela abertura, mas a gaveta abre e
    // ele trabalha. Lançar aqui deixaria a aba em branco por indisponibilidade
    // momentânea de rede, o que é pior que o estado anterior a este item.
    // O erro vai para o console e para o indicador de estado.
    async function m2CarregarRascunho(kind, athleteId) {
      if (!athleteId) return null;
      try {
        const r = await m2Ler('ler-rascunho-plano', { athleteUid: athleteId, planType: kind });
        return (r && r.draft) || null;
      } catch (e) {
        console.error('[m2CarregarRascunho]', kind, e);
        m2SetSaveState(kind, 'error', 'não foi possível carregar o rascunho salvo');
        return null;
      }
    }

    // Estado do autossalvo, por tipo de plano. Exibido no cabeçalho de
    // publicação — sem isto, uma falha de gravação seria silenciosa, e o Coach
    // continuaria digitando sobre trabalho que não está sendo salvo.
    const m2SaveState = { training: 'idle', nutrition: 'idle' };

    function m2SetSaveState(kind, estado, mensagem) {
      m2SaveState[kind] = estado;
      const el = document.getElementById((kind === 'training' ? 'tr' : 'nu') + '-savestate');
      if (!el) return;
      if (estado === 'saving')  { el.textContent = 'salvando…';      el.style.color = 'var(--c-textsub)'; }
      else if (estado === 'saved') { el.textContent = 'salvo';        el.style.color = 'var(--c-textsub)'; }
      else if (estado === 'error') { el.textContent = 'NÃO SALVO — ' + (mensagem || 'erro'); el.style.color = 'var(--c-status-alert)'; }
      else { el.textContent = ''; }
    }

    async function m2SalvarRascunho(kind, plano) {
      const a = wke04CurrentAthlete;
      if (!a || !a.id) return;                 // gaveta fechada: nada a salvar
      m2SetSaveState(kind, 'saving');
      try {
        await m2Escrever('salvar-rascunho-plano', {
          athleteUid: a.id,
          planType: kind,
          draft: plano,
        });
        m2SetSaveState(kind, 'saved');
      } catch (e) {
        m2SetSaveState(kind, 'error', e && e.message ? e.message : '');
        console.error('[m2SalvarRascunho]', kind, e);
      }
    }


