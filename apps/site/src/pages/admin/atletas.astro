      if (!ntePlanCache[athlete.id]) {
        if (athlete.planStatus === 'none') {
          // Atleta recém-chegado: sem plano nutricional publicado (estado de primeira vez)
          ntePlanCache[athlete.id] = { target: null, dayType: 'treino', days: { treino: { meals: [] }, descanso: { meals: [] } }, isNew: true };
        } else {
          ntePlanCache[athlete.id] = nteBuildBasePlan(athlete);
