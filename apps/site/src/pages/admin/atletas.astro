    function nteRenderFormulaPanel() {
      const tbody = document.getElementById('nte-formula-rows');
      if (!tbody) return;
      tbody.innerHTML = Object.entries(nteFormulaConfig).map(function(entry) {
        const phase = entry[0], vals = entry[1];
        const ARROWS = '<span class="nte-stepper-arrows">' +
          '<button type="button" class="nte-stepper-btn" data-dir="up" tabindex="-1" aria-label="Aumentar"><svg width="7" height="5" viewBox="0 0 10 6" fill="none"><path d="M1 5L5 1L9 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></button>' +
          '<button type="button" class="nte-stepper-btn" data-dir="down" tabindex="-1" aria-label="Diminuir"><svg width="7" height="5" viewBox="0 0 10 6" fill="none"><path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></button>' +
          '</span>';
        const cell = (macro, min, max) =>
          '<td><span class="nte-stepper"><input class="nte-formula-input" data-phase="' + phase + '" data-macro="' + macro + '" type="number" step="0.1" min="' + min + '" max="' + max + '" value="' + vals[macro] + '" />' + ARROWS + '</span></td>';
        return '<tr>' +
          '<td class="nte-formula-phase">' + phase + '</td>' +
          cell('p', '0.5', '5') +
          cell('c', '0.5', '10') +
          cell('g', '0.1', '3') +
        '</tr>';
      }).join('');
    }

    function nteApplyFormula() {
      var inputs = document.querySelectorAll('.nte-formula-input');
      inputs.forEach(function(inp) {
        var phase = inp.dataset.phase, macro = inp.dataset.macro;
        var val = parseFloat(inp.value);
        if (!isNaN(val) && val > 0 && nteFormulaConfig[phase]) nteFormulaConfig[phase][macro] = Math.round(val * 10) / 10;
      });
      try { localStorage.setItem('elite90_nte_formula', JSON.stringify(nteFormulaConfig)); } catch(e) {}
      // Recalcula meta para o atleta atual
      if (nteState.athlete && nteState.plan && !nteState.plan.isNew) {
        var full = nteBuildBasePlan(nteState.athlete);
        nteState.plan.target = full.target;
        if (ntePlanCache[nteState.athlete.id]) ntePlanCache[nteState.athlete.id].target = full.target;
      }
      document.getElementById('nte-formula-panel').hidden = true;
      renderNutrition();
      wkeToast('Metas recalculadas para ' + (nteState.athlete ? nteState.athlete.name.split(' ')[0] : 'atleta'));
    }

    // Setas customizadas da tabela de fórmula (delegado; sobrevive a re-renders).
    // A digitação direta no input continua válida — os dois métodos coexistem.
    document.addEventListener('click', function(e) {
      const btn = e.target.closest && e.target.closest('.nte-stepper-btn');
      if (!btn) return;
      const wrap = btn.closest('.nte-stepper');
      const inp = wrap && wrap.querySelector('.nte-formula-input');
      if (!inp) return;
      const dir = btn.dataset.dir;
      try { if (dir === 'up') inp.stepUp(); else inp.stepDown(); }
      catch (_) {
        const step = parseFloat(inp.step) || 0.1, v = parseFloat(inp.value) || 0;
        inp.value = (dir === 'up' ? v + step : v - step);
      }
      let num = Math.round(parseFloat(inp.value) * 10) / 10;
      const mn = parseFloat(inp.min), mx = parseFloat(inp.max);
      if (!isNaN(mn)) num = Math.max(mn, num);
      if (!isNaN(mx)) num = Math.min(mx, num);
      inp.value = num;
      inp.dispatchEvent(new Event('input', { bubbles: true }));
    });

    function nteResetFormula() {
      nteFormulaConfig = JSON.parse(JSON.stringify(NTE_FORMULA_DEFAULTS));
