    // ── Histórico de avaliações: dinâmico por semana corrente e cadência quinzenal ──
    var EVO_EVAL_SERIES = {
      'Peso (kg)':    { base: 82.0, step: 0.6,  dir: 'up',   dec: 1 },
      'Cintura (cm)': { base: 82.5, step: -0.25, dir: 'down', dec: 1 },
      'Ombros (cm)':  { base: 120.0, step: 0.4,  dir: 'up',   dec: 1 },
      'Braço D (cm)': { base: 39.0, step: 0.4,   dir: 'up',   dec: 1 },
      'V-Taper':      { base: 1.45, step: 0.01,  dir: 'up',   dec: 2 }
    };
    function evoFmt(v, dec) { return v.toFixed(dec).replace('.', ','); }
    function evoRenderEvalTable() {
      var wrap = document.getElementById('evo-evtable-wrap');
      if (!wrap) return;
      // semanas de avaliação completa: cadência quinzenal (1,3,5,...) até a semana corrente
      var weeks = [];
      for (var w = 1; w <= evoCycleWeek; w += 2) weeks.push(w);
      if (weeks.length === 0) weeks = [1];
      var cur = weeks[weeks.length - 1];
      var head = '<thead><tr><th style="min-width:78px">Métrica</th>';
      weeks.forEach(function(w){ head += '<th' + (w === cur ? ' class="evo-evcur"' : '') + '>S' + w + '</th>'; });
      head += '<th>Δ ciclo</th></tr></thead>';
      var body = '<tbody>';
      Object.keys(EVO_EVAL_SERIES).forEach(function(metric){
        var s = EVO_EVAL_SERIES[metric];
        body += '<tr><td>' + metric + '</td>';
        var first = s.base, last = s.base;
        weeks.forEach(function(w, i){
          var val = s.base + s.step * (w - 1);
          if (i === 0) first = val;
          last = val;
          body += '<td' + (w === cur ? ' class="evo-evcur"' : '') + '>' + evoFmt(val, s.dec) + '</td>';
        });
        var delta = last - first;
        var arrow = (s.dir === 'up') ? (delta >= 0 ? '↑' : '↓') : (delta <= 0 ? '↓' : '↑');
        var sign = delta >= 0 ? '+' : '−';
        body += '<td class="evo-dpos">' + sign + evoFmt(Math.abs(delta), s.dec) + ' ' + arrow + '</td></tr>';
      });
      body += '</tbody>';
      wrap.innerHTML = '<table class="evo-evtable">' + head + body + '</table>';
    }

