    // (<script is:inline>, sem type="module") e não enxerga o `auth` local de
    // lá diretamente.
    async function compartilharPlano(kind) {
      if (!wke04CurrentAthlete) return;
      const pfx = kind === 'training' ? 'tr' : 'nu';
      const btn = document.getElementById(pfx + '-sharebtn');
      if (btn) btn.disabled = true;
      try {
        const idToken = await window.__getFreshToken();
        const resp = await fetch('/.netlify/functions/compartilhar-plano', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + idToken },
          body: JSON.stringify({ athleteId: wke04CurrentAthlete.id, kind: kind }),
        });
        const texto = await resp.text();
        let dados = {};
        try { dados = texto ? JSON.parse(texto) : {}; } catch { dados = {}; }
        if (!resp.ok) {
          wkeToast(dados.erro || 'Não foi possível gerar o link do protocolo.', { type: 'error' });
          return;
        }
        // A ESCOLHA DE CANAL entra aqui, entre o retorno da função e o envio.
        // Antes, whatsappUrl abria direto; sem telefone, copiava e avisava. Os
        // dois caminhos continuam existindo — passaram para dentro do modal,
        // onde a opção de WhatsApp fica apagada quando não há telefone e o
        // endereço fica visível para cópia em qualquer caso.
        shrAbrir(kind, dados);
