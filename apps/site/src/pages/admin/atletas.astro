    // Semana do ciclo: usa o campo week do atleta (mesma fonte do cabeçalho do drawer).
    // Fallback para derivação a partir do dia (DIA DO CICLO = hoje − DATA) se week ausente.
    function evoDeriveCycleWeek() {
      var a = wke04CurrentAthlete;
      var w;
      var diaDerivado = cicloDia(a && a.startDate);
      if (diaDerivado !== null) {
        w = cicloSemana(diaDerivado);
      } else if (a && typeof a.week === 'number') {
        w = a.week;
      } else {
        var day = (a && typeof a.day === 'number') ? a.day : 35;
        w = Math.ceil(day / 7);
      }
      if (w < 1) w = 1;
      if (w > EVO_TOTAL_WEEKS) w = EVO_TOTAL_WEEKS;
      return w;
    }
    // Gera as 13 pílulas da régua. Marcador de cadência fica reservado (inerte) até a subcoleção evaluations/ existir.
    function evoRenderRuler() {
      var track = document.getElementById('evo-rulertrack');
      if (!track) return;
      var html = '';
      for (var w = 1; w <= EVO_TOTAL_WEEKS; w++) {
        var cls = 'evo-wkpill';
        var clickable = true;
        if (w === evoCycleWeek) cls += ' current';
        if (w > evoCycleWeek) { cls += ' future'; clickable = false; }
        else if (w < evoCycleWeek) cls += ' done';
        // marca a semana em visualização: 'cur' se for a corrente, 'viewing' se for passada
        if (w === evoViewWeek) cls += (w === evoCycleWeek) ? ' cur' : ' viewing';
        var onclick = clickable ? ' onclick="evoLoadWeek(' + w + ')"' : '';
        // slot de cadência reservado (3 marcadores inertes: A semanal · B/C quinzenal · dobras mensal)
        var cad = '<div class="evo-wkcad"><span class="evo-cadmark"></span><span class="evo-cadmark"></span><span class="evo-cadmark"></span></div>';
        html += '<button class="' + cls + '"' + onclick + '><span class="evo-wknum">S' + w + '</span>' + cad + '</button>';
      }
      track.innerHTML = html;
    }
    // Centraliza a régua na semana corrente do ciclo (chamada quando a aba fica visível).
    function evoCenterRuler() {
      evoScrollToWeek(evoCycleWeek);
    }
    // Rola a régua para deixar a semana w visível e centrada quando possível.
    function evoScrollToWeek(w) {
      var track = document.getElementById('evo-rulertrack');
      if (!track) return;
      var pills = track.querySelectorAll('.evo-wkpill');
      var target = pills[w - 1];
      if (!target) return;
      var left = target.offsetLeft - (track.clientWidth / 2) + (target.offsetWidth / 2);
      var max = track.scrollWidth - track.clientWidth;
      track.scrollLeft = Math.max(0, Math.min(left, max));
    }
    // Habilita arrasto horizontal (mouse e touch) na régua.
    function evoEnableDrag() {
      var track = document.getElementById('evo-rulertrack');
      if (!track || track._dragBound) return;
      track._dragBound = true;
      var down = false, startX = 0, startScroll = 0, moved = false;
      track.addEventListener('mousedown', function(e){ down = true; moved = false; startX = e.pageX; startScroll = track.scrollLeft; });
      window.addEventListener('mousemove', function(e){ if (!down) return; var dx = e.pageX - startX; if (Math.abs(dx) > 3) moved = true; track.scrollLeft = startScroll - dx; });
      window.addEventListener('mouseup', function(){ down = false; });
      // impede que o clique dispare se houve arrasto
      track.addEventListener('click', function(e){ if (moved) { e.stopPropagation(); e.preventDefault(); } }, true);
      // converte scroll vertical de trackpad/roda em horizontal sobre a régua
      track.addEventListener('wheel', function(e){ if (Math.abs(e.deltaY) > Math.abs(e.deltaX)) { track.scrollLeft += e.deltaY; e.preventDefault(); } }, { passive: false });
    }
