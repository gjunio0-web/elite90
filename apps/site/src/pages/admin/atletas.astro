      if (display) display.style.display = 'block';
      if (slider)  slider.style.display  = 'none';
      if (compareBtn) compareBtn.textContent = 'Comparar com Início';
    }

    function prevPhoto() {
      if (currentPhotoIndex > 0) {
        currentPhotoIndex--;
        if (compareMode) exitCompareMode();
        updatePhotoDisplay();
        updateArrowStates();
      }
    }
    function nextPhoto() {
      if (currentPhotoIndex < photoFiles.length - 1) {
        currentPhotoIndex++;
        if (compareMode) exitCompareMode();
        updatePhotoDisplay();
        updateArrowStates();
      }
    }




    // ── EVENTS ──
    document.getElementById('drawer-close').addEventListener('click', closeAthleteDrawer);
    document.getElementById('athlete-drawer').addEventListener('click', (e) => {
      if (e.target.id === 'athlete-drawer') closeAthleteDrawer();
    });

    document.getElementById('search-input').addEventListener('input', (e) => {
      const query = dobraBusca(e.target.value);
      filteredAthletes = athletes.filter(a => 
        dobraBusca(a.name).includes(query) || dobraBusca(a.email).includes(query)
      );
      renderTable();
    });

    document.getElementById('filter-status').addEventListener('change', (e) => {
      const situacao = e.target.value;
      filteredAthletes = situacao ? athletes.filter(a => situacaoDoAtleta(a) === situacao) : [...athletes];
      renderTable();
    });

    // ── Dropdown de status customizado do DS (portado de fichas.astro) ──
    function __createMenu(items) {
      const ul = document.createElement('ul');
      ul.className = 'status-dropdown-menu';
      ul.hidden = true;
      ul.setAttribute('role', 'listbox');
      ul.innerHTML = items.map(({ value, label }) =>
        `<li><button type="button" role="option" data-value="${value}">${label}</button></li>`
      ).join('');
      document.body.appendChild(ul);
      return ul;
    }
    function __positionMenu(menu, trigger) {
      const r = trigger.getBoundingClientRect();
      menu.style.left = `${r.left}px`;
      menu.style.minWidth = `${r.width}px`;
      menu.style.top = '-9999px';
      menu.hidden = false;
      const menuH = menu.offsetHeight;
      menu.style.top = (window.innerHeight - r.bottom) > menuH
        ? `${r.bottom + 4}px`
        : `${r.top - menuH - 4}px`;
    }
    const FILTER_LABELS = { '': 'Todos', 'recem-promovido': 'Recém-promovido', 'no-prazo': 'Check-in no Prazo', 'acima-7-dias': 'Acima de 7 Dias', 'acima-14-dias': 'Acima de 14 Dias' };
    const __filterMenu = __createMenu([
      { value: '', label: 'Todos' },
      { value: 'recem-promovido', label: 'Recém-promovido' },
      { value: 'no-prazo', label: 'Check-in no Prazo' },
      { value: 'acima-7-dias', label: 'Acima de 7 Dias' },
      { value: 'acima-14-dias', label: 'Acima de 14 Dias' },
    ]);
    function __closeFilterMenu() { __filterMenu.hidden = true; }
    document.addEventListener('click', (e) => {
      if (__filterMenu.contains(e.target)) {
        const opt = e.target.closest('button[data-value]');
        if (opt) {
          const val = opt.dataset.value;
          document.getElementById('filter-dropdown-label').textContent = FILTER_LABELS[val] ?? 'Todos';
          const sel = document.getElementById('filter-status');
          sel.value = val;
          sel.dispatchEvent(new Event('change'));
          __closeFilterMenu();
        }
        return;
      }
      __closeFilterMenu();
    });
    document.getElementById('filter-dropdown-btn')?.addEventListener('click', (e) => {
      e.stopPropagation();
      const isOpen = !__filterMenu.hidden;
      __closeFilterMenu();
      if (!isOpen) __positionMenu(__filterMenu, e.currentTarget);
    });
    window.addEventListener('scroll', __closeFilterMenu, { passive: true });

    // ── Tabela → cards por largura real (desktop) ──
    // Decide se a tabela vira cards empilhados com base na largura DE
    // VERDADE, não num ponto de corte fixo — o media query abaixo
    // (max-width:768px) já cobre o mobile de sempre, mas nunca cobria uma
    // tela larga o bastante para não ser "mobile" e, ainda assim, estreita
    // demais para as colunas caberem sem rolagem lateral (o que .table-wrap
    // com overflow-x:auto permitia acontecer, silenciosamente).
    //
    // PORQUÊ MEDIR EM VEZ DE SÓ COMPARAR LARGURA DE TELA
    // Esta tabela tem colunas fluidas (width:%) — só transborda por causa do
    // conteúdo (nome sem quebra, botões de ação), não por uma largura mínima
    // declarada. Não dá pra saber de antemão a partir de que largura de tela
    // ela para de caber; é preciso perguntar ao próprio navegador.
    //
    // PORQUÊ FORÇAR "MODO TABELA" ANTES DE MEDIR
    // Depois que a tabela vira cards, seu scrollWidth passa a refletir o
    // LAYOUT DE CARDS (sempre cabe), não mais o da tabela — perguntar de
    // novo nesse estado nunca revelaria que ela voltou a caber. mostrarTabela
    // força o layout tabular de volta, IMEDIATAMENTE ANTES da leitura de
    // scrollWidth, na mesma execução síncrona que decide e reaplica o estado
    // final — o navegador nunca chega a pintar o quadro intermediário
    // forçado.
    //
    // ESPELHADO em fichas.astro (mesma função, adaptada só no "aplicar": lá
    // troca a visibilidade de dois blocos distintos — tabela e cards vivem
    // em elementos SEPARADOS —, aqui reflui a mesma tabela via CSS). Manter
    // as duas em sincronia se uma mudar.
    //
    // "observar" (opcional) existe por causa de fichas.astro: lá o elemento
    // medido (wrap) fica display:none no modo cards, e um elemento fora do
    // layout para de reportar resize — o mecanismo travaria em cards para
    // sempre. Aqui o wrap nunca some (só o conteúdo interno reflui), então
    // não precisa ser usado — mas o parâmetro existe nos dois para as duas
    // cópias ficarem idênticas.
    function observarLarguraTabela(opts) {
      const mql = opts.mediaMobile ? window.matchMedia(opts.mediaMobile) : null;
      const tolerancia = opts.tolerancia ?? 1;
      const alvoObservado = opts.observar || opts.wrap;
      let frame = 0;
      function medir() {
        frame = 0;
        if (mql && mql.matches) return;
        opts.mostrarTabela();
        const precisa = opts.table.scrollWidth > opts.wrap.clientWidth + tolerancia;
        opts.aplicar(precisa);
      }
      function agendar() {
        if (frame) return;
        frame = requestAnimationFrame(medir);
      }
      const ro = new ResizeObserver(agendar);
      ro.observe(alvoObservado);
      mql?.addEventListener('change', agendar);
      agendar();
      return () => {
        ro.disconnect();
        mql?.removeEventListener('change', agendar);
        if (frame) cancelAnimationFrame(frame);
      };
    }
    {
      const wrap = document.getElementById('athletes-table-wrap');
      const table = document.getElementById('athletes-table');
      if (wrap && table) {
        observarLarguraTabela({
          wrap, table,
          mediaMobile: '(max-width: 768px)',
          mostrarTabela: () => wrap.classList.remove('tc-cards'),
          aplicar: (precisaDeCards) => wrap.classList.toggle('tc-cards', precisaDeCards),
        });
      }
    }

    // ── INIT: ver loadAthletes(), chamado pelo auth guard no topo do arquivo. ──
</script>
<script type="module" is:inline>
    // ── FIREBASE / AUTH GUARD (mesmo padrão de fichas.astro) ──
    // Este é o único bloco type="module" da página (precisa de import ESM).
    // Toda a lógica de UI vive no <script> clássico logo abaixo, porque
    // depende de dezenas de funções chamadas via onclick="..." — isso só
    // funciona se as funções estiverem no escopo global, o que acontece
    // automaticamente para scripts clássicos, mas não para módulos. A ponte
    // entre os dois é feita via window.__setAthletes/__getFreshToken.
    import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-app.js";
    import { getAuth, signOut, onAuthStateChanged } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-auth.js";
    import { getFirestore, collection, getDocs } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-firestore.js";

    const cfg = {
      apiKey: document.querySelector('meta[name="fb-api"]')?.content,
      authDomain: document.querySelector('meta[name="fb-auth"]')?.content,
      projectId: document.querySelector('meta[name="fb-proj"]')?.content,
      storageBucket: document.querySelector('meta[name="fb-bucket"]')?.content,
      messagingSenderId: document.querySelector('meta[name="fb-sender"]')?.content,
      appId: document.querySelector('meta[name="fb-appid"]')?.content,
    };
    const app = initializeApp(cfg);
    const auth = getAuth(app);
    const db = getFirestore(app);

    // Obtém sempre um token fresco (o SDK renova automaticamente se expirado).
    // NUNCA armazenar o idToken em variável — tokens Firebase expiram em 1h.
    // Exposto para o script clássico (usado por renderAthletePhotos).
    window.__getFreshToken = async function () {
      const user = auth.currentUser;
      if (!user) throw new Error("Sessão expirada. Recarregue a página.");
      return user.getIdToken(/* forceRefresh */ false);
    };

    document.getElementById("btn-logout")?.addEventListener("click", async () => {
      await signOut(auth);
      window.location.href = "/admin/login";
    });

    // Auth guard com verificação de Custom Claim
    onAuthStateChanged(auth, async user => {
      if (!user) { window.location.href = "/admin/login"; return; }
      try {
        const tokenResult = await user.getIdTokenResult(true);
        if (!tokenResult.claims.admin) {
          await signOut(auth);
          window.location.href = "/admin/login?erro=acesso-negado";
          return;
        }
      } catch {
        await signOut(auth);
        window.location.href = "/admin/login";
        return;
      }
      // Carrega a coleção "athletes" do Firestore. Vazia até a equipe
      // popular dados reais — a tabela/KPIs já tratam lista vazia sem erro.
      try {
        const snap = await getDocs(collection(db, "athletes"));
        window.__setAthletes(snap.docs.map(d => ({ id: d.id, ...d.data() })));
      } catch (err) {
        console.error("Erro ao carregar atletas:", err);
        window.__setAthletesError();
      }
    });
</script>

<meta name="fb-api"    content={import.meta.env.PUBLIC_FIREBASE_API_KEY} />
<meta name="fb-auth"   content={import.meta.env.PUBLIC_FIREBASE_AUTH_DOMAIN} />
<meta name="fb-proj"   content={import.meta.env.PUBLIC_FIREBASE_PROJECT_ID} />
<meta name="fb-bucket" content={import.meta.env.PUBLIC_FIREBASE_STORAGE_BUCKET} />
<meta name="fb-sender" content={import.meta.env.PUBLIC_FIREBASE_MESSAGING_SENDER_ID} />
<meta name="fb-appid"  content={import.meta.env.PUBLIC_FIREBASE_APP_ID} />
</body>
