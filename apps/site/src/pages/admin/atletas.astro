        // pontos extras (acima do ideal), com separador e anel
        if (count > EVO_AUDIO_IDEAL) {
          var sep = document.createElement('div');
          sep.className = 'evo-dsep';
          c.appendChild(sep);
          for (var j = EVO_AUDIO_IDEAL + 1; j <= count; j++) {
