    function renderAthleteFlags(athlete) {
      const container = document.getElementById('athlete-flags');
      if (!container) return;
      container.innerHTML = '';

      // Flags reais — athlete.flags é um array de códigos (ex.: ["CARDIO","LESAO"])
      // definido pela equipe no documento Firestore do atleta.
      const flags = Array.isArray(athlete.flags) ? athlete.flags.filter(f => FLAG_META[f]) : [];

      if (flags.length === 0) {
        container.style.display = 'none';
        return;
      }

      container.style.display = 'flex';
      flags.forEach(key => {
        const f = FLAG_META[key];
        if (!f) return;
        const badge = document.createElement('div');
        badge.style.cssText = `
          display: flex; align-items: center;
          padding: 8px 12px;
          border: 1px solid ${f.color};
          border-radius: 2px;
          font-family: var(--font-label);
          font-size: 0.65rem;
          font-weight: 700;
          text-transform: uppercase;
          letter-spacing: 0.1em;
          color: ${f.color};
          line-height: 1.4;
        `;
        badge.textContent = `${f.code} · ${f.label}`;
        container.appendChild(badge);
      });
    }

