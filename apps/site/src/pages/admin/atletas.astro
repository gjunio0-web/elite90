    // Alt+ArrowUp/Down: reordenação por teclado
    document.addEventListener('keydown', function(e) {
      if (!e.altKey || (e.key !== 'ArrowUp' && e.key !== 'ArrowDown')) return;
      var focused = document.activeElement;
      var card = focused && focused.closest && focused.closest('.wke-exercise');
      if (!card) return;
      e.preventDefault();
      var exIdx = parseInt(card.getAttribute('data-ex'));
      var arr = wkeCurrentDay().exercises;
      var newIdx = e.key === 'ArrowUp' ? exIdx - 1 : exIdx + 1;
      if (newIdx < 0 || newIdx >= arr.length) return;
      var tmp = arr[exIdx]; arr[exIdx] = arr[newIdx]; arr[newIdx] = tmp;
      // P-05: FLIP — anima troca por teclado também
      var flipBefore = wkeCaptureFlip();
      renderWorkout();
      wkePlayFlip(flipBefore);
      wkeToast('Ordem atualizada');
