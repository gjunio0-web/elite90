      // ORIGEM do plano, pela mesma razão da aba de Treino. A nutrição não tem
      // passo de calibração separado: `nteBuildBasePlan` já recebe o atleta e
      // resolve as metas pelo peso e pela fase, e já vive no núcleo.
      nteAplicarPlano(athlete, ntePlanCache[athlete.id]);
