    // ── DRAWER ──
    let drawerCloseTimer = null;

    // ── DRAG TO DISMISS (mobile bottom sheet) ──
    (function() {
      let startY = 0, currentY = 0, isDragging = false, startTime = 0;
      const DISMISS_THRESHOLD = 0.3;
      const VELOCITY_THRESHOLD = 0.4;

      function getPanel() { return document.querySelector('#athlete-drawer .drawer-panel'); }

      // Quando o arrasto nasce no CONTEÚDO (e não no puxador), ele é provisório:
      // vale enquanto o dedo desce, e é devolvido ao navegador assim que sobe,
      // para a rolagem seguir normal. Sem essa distinção, habilitar o arrasto
      // pelo conteúdo mataria a rolagem da gaveta.
      let origemConteudo = false;

      function onTouchStart(e, doConteudo) {
        const panel = getPanel();
        if (!panel) return;
        startY = e.touches[0].clientY;
        currentY = 0;
        isDragging = true;
        origemConteudo = !!doConteudo;
        startTime = Date.now();
        panel.style.transition = 'none';
      }

      function cancelarArrasto() {
        isDragging = false;
        origemConteudo = false;
        currentY = 0;
        const panel = getPanel();
        if (panel) { panel.style.transition = ''; panel.style.transform = ''; }
      }

      // Devolve true quando o gesto foi consumido como arrasto — só aí o
      // chamador cancela o comportamento padrão. Devolver false deixa o
      // navegador rolar.
      function onTouchMove(e) {
        if (!isDragging) return false;
        const panel = getPanel();
        if (!panel) return false;
        const dy = e.touches[0].clientY - startY;
        if (dy < 0) {
          if (origemConteudo) cancelarArrasto();
          return false;
        }
        currentY = dy;
        panel.style.transform = 'translateY(' + dy + 'px)';
        return true;
      }

      function onTouchEnd() {
        if (!isDragging) return;
        isDragging = false;
        const panel = getPanel();
        if (!panel) return;

        const elapsed = Date.now() - startTime;
        const velocity = currentY / Math.max(elapsed, 1);
        const panelHeight = panel.offsetHeight;
        const shouldDismiss = currentY > panelHeight * DISMISS_THRESHOLD || velocity > VELOCITY_THRESHOLD;

        panel.style.transition = 'transform 0.35s cubic-bezier(0.16, 1, 0.3, 1)';

        if (shouldDismiss) {
          panel.style.transform = 'translateY(100%)';
          drawerCloseTimer = setTimeout(function() {
            const drawer = document.getElementById('athlete-drawer');
            drawer.style.display = 'none';
            drawer.classList.remove('open');
            panel.style.transform = '';
            drawerCloseTimer = null;
            // Ocultar FAB
            const fab = document.getElementById('drawer-fab');
            if (fab) { fab.classList.remove('visible'); document.getElementById('fab-actions')?.classList.remove('open'); }
          }, 350);
        } else {
          panel.style.transform = 'translateY(0)';
        }
        currentY = 0;
      }

      // Delegar no documento — funciona mesmo se drawer abrir depois
      document.addEventListener('touchstart', function(e) {
        const drawer = document.getElementById('athlete-drawer');
        if (!drawer || !drawer.classList.contains('open')) return;

        // Overlays de tela cheia (.evo-overlay: preview de treino/nutrição,
        // editor de evolução) têm cabeçalho PRÓPRIO que reaproveita a classe
        // .drawer-header por estilo — não por participar deste arrasto. Sem
        // esta saída, tocar ali (inclusive no botão "✕" de fechar) iniciava
        // o arrasto da GAVETA por trás, não do overlay: o toque virava
        // translateY no painel da gaveta em vez de rolagem/fechamento do
        // overlay, e podia deixá-lo parcialmente arrastado sem fechar nem
        // voltar ao lugar — o "preso na parte inferior, não fecha" relatado.
        if (e.target.closest('.evo-overlay')) return;

        // Puxador e cabeçalho: arrasto sempre, não há o que rolar ali.
        if (e.target.closest('.drawer-handle, .drawer-header')) { onTouchStart(e, false); return; }

        // Conteúdo: só quando já está no topo. Fora do topo o gesto para baixo
        // é rolagem, e roubá-lo seria pior que não ter arrasto nenhum. Este é o
        // caminho que faltava — puxar a gaveta pelo corpo dela não iniciava
        // gesto algum, que é como a maioria tenta fechá-la.
        const wrap = e.target.closest('.drawer-content-wrap');
        if (wrap && wrap.scrollTop <= 0) onTouchStart(e, true);
      }, { passive: true });

      document.addEventListener('touchmove', function(e) {
        if (isDragging && onTouchMove(e)) e.preventDefault();
      }, { passive: false });

      document.addEventListener('touchend', function() {
        if (isDragging) onTouchEnd();
      });
    })();

    function openAthleteDrawer(athleteId) {
      const athlete = athletes.find(a => a.id === athleteId);
      if (!athlete) return;
      wke04CurrentAthlete = athlete;

      document.getElementById('drawer-athlete-name').textContent = athlete.name;
      // Rótulo externo (Adendo 02 — Delegação): o que um delegado externo vê
      // no lugar do nome. Mostrado aqui como referência, não como substituição
      // — o Coach continua vendo o nome. Atleta promovido antes da Fase 2 e
      // ainda não alcançado pela rotina de preenchimento mostra o traço.
      document.getElementById('drawer-external-label').textContent = athlete.externalLabel || '—';
      document.getElementById('overview-cycle-label').innerHTML = `Progresso: <span style="color: var(--c-white); font-weight: var(--fw-body-bold); font-size: var(--fs-body-md);">Semana ${athlete.week} de 13</span>. Em fase de <span style="color: var(--c-white); font-weight: var(--fw-body-bold); font-size: var(--fs-body-md);">${rotuloFase(athlete.phase)}</span>. Iniciado em <span style="color: var(--c-white); font-weight: var(--fw-body-bold); font-size: var(--fs-body-md);">${formatarDataBr(athlete.startDate) || '—'}</span>.`;
      document.getElementById('overview-progress').style.width = `${(athlete.day / 90) * 100}%`;


      // Perfil do Atleta
      const profileStart  = document.getElementById('profile-start');
      const profileSituacao = document.getElementById('profile-situacao');
      const profileAge    = document.getElementById('profile-age');
      const profileGenero = document.getElementById('profile-genero');
      const profileHeight = document.getElementById('profile-height');
      const profileYears  = document.getElementById('profile-years');
      const profileFreq   = document.getElementById('profile-freq');
      const profileDur    = document.getElementById('profile-duration');
      const profileGoal   = document.getElementById('profile-goal');
      // Vocabulário fechado gravado em minúsculas (promote-lead.ts); rótulo de
      // exibição mapeado aqui, não invertido na gravação.
      const GENERO_LABEL = { masculino: 'Masculino', feminino: 'Feminino', outro: 'Outro' };
      if (profileStart)  profileStart.textContent  = formatarDataBr(athlete.startDate) || '—';
      if (profileSituacao) {
        const situacao = situacaoDoAtleta(athlete);
        profileSituacao.innerHTML = situacao
          ? `<span class="status-badge ${situacao}">${SITUACAO_LABEL[situacao]}</span>`
          : '—';
      }
      // Idade não é mais gravada — deriva-se de birthDate na leitura
      // (Esquema v3, princípio P3; Fase 2 removeu athlete.age).
      if (profileAge) {
        const idade = idadeDeNascimento(athlete.birthDate);
        profileAge.textContent = idade !== null ? `${idade} anos` : '—';
      }
      if (profileGenero) profileGenero.textContent = GENERO_LABEL[athlete.genero] || '—';
      // heightCm é número (centímetros); a tela volta a exibir em metros, no
      // mesmo formato de sempre.
      if (profileHeight) {
        profileHeight.textContent = (athlete.heightCm != null)
          ? `${String(athlete.heightCm / 100).replace('.', ',')} m`
          : '—';
      }
      if (profileYears)  profileYears.textContent  = (athlete.trainingYears != null) ? `${athlete.trainingYears} anos` : '—';
      if (profileFreq) {
        profileFreq.textContent = (athlete.weeklyFrequency != null)
          ? `${String(athlete.weeklyFrequency).replace('.', ',')}x / semana`
          : '—';
      }
      // dailyMinutes é gravado em minutos (Esquema v3, seção 5); a tela volta
      // a exibir em horas, formato que o Coach já conhecia antes da Fase 2.
      // Escolha de exibição, não de gravação — sinalizada para revisão.
      if (profileDur) {
        profileDur.textContent = (athlete.dailyMinutes != null)
          ? `${String(athlete.dailyMinutes / 60).replace('.', ',')} h/dia`
          : '—';
      }
      if (profileGoal)   profileGoal.textContent   = athlete.goal    || '—';

      // Check-in
      const ci = athlete.checkin;
      const pr = athlete.prev;
      const ciWeight = document.getElementById('checkin-weight');
      const ciWaist  = document.getElementById('checkin-waist');
      const ciHip    = document.getElementById('checkin-hip');
      const ciPerc   = document.getElementById('checkin-perception');
      if (ciWeight) ciWeight.textContent = ci ? ci.weight : '—';
      if (ciWaist)  ciWaist.textContent  = ci ? ci.waist  : '—';
      if (ciHip)    ciHip.textContent    = ci ? ci.hip    : '—';
      if (ciPerc)   ciPerc.textContent   = ci ? ci.perception : '';
      if (ciPerc)   ciPerc.placeholder = ci ? '' : 'Nenhum relato enviado ainda…'; // placeholder não se aplica a span, mas mantido para compatibilidade
      renderAthletePhotos(athlete);

      // Delta das métricas (cor por fase)
      function renderDelta(elId, current, previous, phase, metricType) {
        const el = document.getElementById(elId);
        if (!el || !current || !previous) { if(el) el.innerHTML = ''; return; }
        const diff = (current - previous).toFixed(1);
        const absDiff = Math.abs(diff);
        if (absDiff < 0.05) { el.className = 'metric-delta neutral'; el.textContent = '— sem alteração'; return; }
        const sign = diff > 0 ? '+' : '';
        const pct = previous ? Math.abs(((current - previous) / previous) * 100).toFixed(1) : null;
        // Positivo por fase:
        // Peso: Bulking = subir é bom; Cutting = descer é bom; Diet Break = neutro
        // Cintura: sempre descer é bom
        // Quadril: Bulking = neutro/leve; Cutting = descer é bom
        let positive;
        if (metricType === 'weight') {
          positive = phase === 'Bulking' ? diff > 0 : phase === 'Cutting' ? diff < 0 : null;
        } else if (metricType === 'waist' || metricType === 'hip') {
          positive = diff < 0;
        }
        const cls = positive === null ? 'neutral' : positive ? 'positive' : 'negative';
        const arrow = diff > 0 ? '↑' : '↓';
        el.className = `metric-delta ${cls}`;
        el.textContent = `${sign}${diff} ${arrow}${pct !== null ? ` (${pct}%)` : ''}`;
      }
      if (ci && pr) {
        renderDelta('delta-weight', ci.weight, pr.weight, athlete.phase, 'weight');
        renderDelta('delta-waist',  ci.waist,  pr.waist,  athlete.phase, 'waist');
        renderDelta('delta-hip',    ci.hip,    pr.hip,    athlete.phase, 'hip');
      } else {
        ['delta-weight','delta-waist','delta-hip'].forEach(id => { const el=document.getElementById(id); if(el) el.innerHTML=''; });
      }

      // Indicador de semana do ciclo
      const weekNum  = document.getElementById('cycle-week-num');
      const weekFill = document.getElementById('cycle-week-fill');
      const weekDot  = document.getElementById('cycle-week-dot');
      const pct = Math.round((athlete.week / 13) * 100);
      if (weekNum)  weekNum.textContent  = athlete.week;
      if (weekFill) weekFill.style.width = `${pct}%`;
      if (weekDot)  weekDot.style.left   = `${pct}%`;

      renderAthleteFlags(athlete);

      // Avaliação (read-only)
      const av = athlete.avaliacao;
      const avalMap = {
        'av-ombros': av?.ombros, 'av-peito': av?.peito, 'av-cintura-abd': av?.cintura, 'av-quadril': av?.quadril,
        'av-braco-esq-relax': av?.bracoEsqRelax, 'av-braco-dir-relax': av?.bracoDirRelax,
        'av-braco-esq-cont': av?.bracoEsqCont, 'av-braco-dir-cont': av?.bracoDirCont,
        'av-coxa-prox-esq': av?.coxaProxEsq, 'av-coxa-prox-dir': av?.coxaProxDir,
        'av-coxa-med-esq': av?.coxaMedEsq, 'av-coxa-med-dir': av?.coxaMedDir,
        'av-pant-esq': av?.pantEsq, 'av-pant-dir': av?.pantDir,
        'av-subesc': av?.subesc, 'av-peit': av?.peit, 'av-suprail': av?.suprail, 'av-abd-dobra': av?.abd,
        'av-tric-esq': av?.tricEsq, 'av-tric-dir': av?.tricDir,
        'av-bic-esq': av?.bicEsq, 'av-bic-dir': av?.bicDir,
        'av-coxa-dobra-esq': av?.coxaDobEsq, 'av-coxa-dobra-dir': av?.coxaDobDir,
        'av-pant-dobra-esq': av?.pantDobEsq, 'av-pant-dobra-dir': av?.pantDobDir,
      };
      Object.entries(avalMap).forEach(([id, val]) => {
        const el = document.getElementById(id);
        if (el) el.textContent = val != null ? val : '—';
      });

      const drawer = document.getElementById('athlete-drawer');
      // Cancelar qualquer fechamento pendente antes de abrir
      if (drawerCloseTimer) { clearTimeout(drawerCloseTimer); drawerCloseTimer = null; }
      drawer.style.display = 'flex';
      requestAnimationFrame(() => drawer.classList.add('open'));
      // Mostrar FAB
      const fab = document.getElementById('drawer-fab');
      if (fab) fab.classList.add('visible');

      // Init sidenav: expandida + hover listeners
      const sidenav = document.getElementById('drawer-sidenav');
      if (sidenav) sidenav.classList.remove('collapsed');
      document.querySelectorAll('.sidenav-item').forEach(b => b.classList.toggle('active', b.dataset.tab === 'overview'));
      initSidenav();

      // Fechar ao clicar no backdrop
      drawer.onclick = function(e) { if (e.target === drawer) closeAthleteDrawer(); };

      // Scroll ao topo do painel
      const panel = drawer.querySelector('.drawer-panel');
      if (panel) panel.scrollTop = 0;

      // Reset tabs para Visão Geral
      document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
      document.querySelectorAll('.tab-button').forEach(b => b.classList.remove('active'));
      document.querySelectorAll('.drawer-tab-opt').forEach(b => b.classList.remove('active'));
      document.getElementById('tab-overview').classList.add('active');
      const overviewBtn = document.querySelector('.tab-button[data-tab="overview"]');
      if (overviewBtn) overviewBtn.classList.add('active');
      const overviewOpt = document.querySelector('.drawer-tab-opt[data-tab="overview"]');
      if (overviewOpt) overviewOpt.classList.add('active');
      const label = document.getElementById('drawer-active-tab-label');
      if (label) label.textContent = 'Visão Geral';

      // Inicializar gráficos com dados do atleta — Chart.js vem de CDN;
      // uma falha de carregamento (rede, bloqueador) não pode derrubar o
      // resto do drawer (Treino/Nutricional/Evolução são independentes).
      try { initCharts(athlete); } catch (e) { console.error('Erro ao inicializar gráficos:', e); }

      // Inicializar editores de treino (WKE-01) e nutricional (NTE-01).
      //
      // ITEM 1.4: as duas passaram a ser assíncronas, porque buscam o rascunho
      // gravado antes de montar. A promessa é DELIBERADAMENTE não aguardada
      // aqui, e o motivo importa: a gaveta abre na aba Visão Geral, e travá-la
      // por uma leitura de plano que o Coach talvez nem vá abrir seria pagar
      // latência por trabalho que pode não ser usado.
      //
      // As duas montam a própria aba ao terminar — renderWorkout e
      // renderNutrition são chamadas por elas, não daqui. Se a leitura demorar,
      // a aba correspondente monta um instante depois; nenhuma outra parte da
      // gaveta depende disso.
      //
      // O .catch existe para que uma falha não vire rejeição não tratada no
      // console. m2CarregarRascunho já não lança, mas o encadeamento pode
      // quebrar por outro motivo, e silêncio aqui esconderia o defeito.
      // AC-21 · A TERCEIRA COSTURA: como o atleta é identificado.
      //
      // O núcleo compartilhado lê `displayLabel`, rótulo de exibição JÁ
      // RESOLVIDO, e não sabe se recebeu nome real ou rótulo externo. Quem
      // resolve é a hospedeira, porque é ela que sabe a quem serve.
      //
      // Aqui, a hospedeira é a gaveta do Coach: ele vê o nome, e a redução ao
      // primeiro termo é dele. A hospedeira restrita resolverá o mesmo campo com
      // o que a projeção lhe devolveu — e a escolha entre nome e rótulo continua
      // na projeção do servidor, onde a D-14 do Adendo 02 a pôs.
      //
      // Resolvido AQUI, num ponto só, e não dentro de `initWorkout` e
      // `initNutrition`: o campo é da identidade do atleta, não da abertura de
      // cada aba, e duplicá-lo nas duas rotinas convidaria a divergirem.
      athlete.displayLabel = String(athlete.name || '').split(' ')[0];

      initWorkout(athlete).catch(function (e) { console.error('initWorkout:', e); });
      initNutrition(athlete).catch(function (e) { console.error('initNutrition:', e); });

      // WKE-04: cabeçalhos de publicação.
      // Leem planStatus do documento do atleta, não do rascunho — por isso não
      // aguardam as duas chamadas acima.
      renderPubHeader('training');
      renderPubHeader('nutrition');

      // UC2b: aba Evolução
      evoInit();
    }

    function closeAthleteDrawer() {
      const drawer = document.getElementById('athlete-drawer');
      drawer.classList.remove('open');
      drawerCloseTimer = setTimeout(() => { drawer.style.display = 'none'; drawerCloseTimer = null; }, 350);
      // Ocultar FAB
      const fab = document.getElementById('drawer-fab');
      if (fab) { fab.classList.remove('visible'); document.getElementById('fab-actions')?.classList.remove('open'); document.getElementById('fab-main')?.classList.remove('open'); }
    }

