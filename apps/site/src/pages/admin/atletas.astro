      if (kind === 'nutrition' && wke04CurrentAthlete) nteCongelarPlano(ntePlanCache[wke04CurrentAthlete.id]);
      const now = new Date();
      const dd = String(now.getDate()).padStart(2,'0') + '/' + String(now.getMonth()+1).padStart(2,'0') + '/' + now.getFullYear();
      const hh = String(now.getHours()).padStart(2,'0') + ':' + String(now.getMinutes()).padStart(2,'0');
      p.status = 'publicado';
      p.publishedAt = dd + ' ' + hh;
      p.hasUnpublishedChanges = false;
