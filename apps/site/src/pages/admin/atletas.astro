      var c = document.getElementById('evo-daudio');
      var lbl = document.getElementById('evo-caudio');
      if (c) {
        c.innerHTML = '';
        // pontos da faixa (1..ideal)
        for (var i = 1; i <= EVO_AUDIO_IDEAL; i++) {
          var d = document.createElement('div');
          d.className = 'evo-d ' + (i <= count ? 'on' : 'off');
          c.appendChild(d);
        }
        // pontos extras (acima do ideal), com separador e anel
        if (count > EVO_AUDIO_IDEAL) {
          var sep = document.createElement('div');
          sep.className = 'evo-dsep';
          c.appendChild(sep);
          for (var j = EVO_AUDIO_IDEAL + 1; j <= count; j++) {
