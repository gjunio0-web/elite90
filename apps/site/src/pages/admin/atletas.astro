    .evo-ovl-head { flex-shrink: 0; }
    .evo-ovl-save { font-family: var(--font-label); font-size: 0.6rem; font-weight: var(--fw-label); text-transform: uppercase; letter-spacing: 0.08em; color: var(--c-lime); background: none; border: none; cursor: pointer; padding: 4px 0; }
    .evo-ovl-save:hover { opacity: 0.7; }
    .evo-ovl-meta { display: flex; align-items: center; gap: 8px; padding: 9px 18px; border-bottom: 1px solid rgba(255, 255, 255, 0.08); }
    .evo-draftpill { display: inline-flex; padding: 2px 9px; border-radius: var(--radius-pill); background: rgba(230,126,34,0.10); color: var(--c-status-new); border: 1px solid rgba(230,126,34,0.20); font-family: var(--font-label); font-size: 0.53rem; font-weight: var(--fw-label); text-transform: uppercase; letter-spacing: 0.08em; }
    .evo-ed-ts { font-family: var(--font-body); font-size: 0.67rem; color: var(--c-textsub); }
    .evo-ed-autosave { margin-left: auto; font-family: var(--font-label); font-size: 0.53rem; font-weight: var(--fw-label); text-transform: uppercase; letter-spacing: 0.08em; color: var(--c-lime); opacity: 0; transition: opacity 400ms ease; }
    .evo-ed-autosave.show { opacity: 1; }
    .evo-ovl-body { padding: 16px 18px 40px; }
    .evo-edit { width: 100%; background: var(--c-black); border: 1px solid rgba(255, 255, 255, 0.14); border-radius: var(--radius-card); color: var(--c-white); font-family: var(--font-body); font-size: 0.79rem; line-height: 1.68; padding: 10px 12px; resize: none; overflow: hidden; transition: border-color 140ms ease, box-shadow 140ms ease; }
    .evo-edit:focus { outline: none; border-color: var(--c-lime); box-shadow: 0 0 0 2px rgba(166, 195, 0, 0.12); }
    .evo-ed-sub { background: var(--c-darkbg); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: var(--radius-card); padding: 9px 12px; margin-top: 9px; }
    .ia-tag { display: inline-block; padding: 1px 6px; background: rgba(166,195,0,0.08); color: rgba(166,195,0,0.5); border: 1px solid rgba(166,195,0,0.18); border-radius: 2px; font-size: 0.47rem; font-weight: var(--fw-label); text-transform: uppercase; letter-spacing: 0.1em; }
    .evo-origtoggle { display: inline-flex; align-items: center; gap: 5px; margin-top: 10px; font-family: var(--font-label); font-size: 0.55rem; font-weight: var(--fw-label); text-transform: uppercase; letter-spacing: 0.08em; color: var(--c-textsub); background: none; border: none; cursor: pointer; padding: 0; }
    .evo-origtoggle:hover { color: rgba(166,195,0,0.6); }
    .evo-origbox { display: none; margin-top: 8px; background: rgba(166,195,0,0.04); border: 1px solid rgba(166,195,0,0.1); border-radius: var(--radius-card); padding: 10px 12px; font-family: var(--font-body); font-size: 0.76rem; color: var(--c-textsub); line-height: 1.65; }
    .evo-origbox.show { display: block; }
    .evo-origlbl { font-family: var(--font-label); font-size: 0.5rem; font-weight: var(--fw-label); text-transform: uppercase; letter-spacing: 0.1em; color: rgba(166,195,0,0.38); margin-bottom: 5px; }
    .evo-ed-alrtnote { font-family: var(--font-body); font-size: 0.71rem; color: var(--c-textsub); line-height: 1.55; margin-bottom: 13px; }
    .evo-ed-alert { border: 1px solid rgba(234,179,8,0.15); border-radius: var(--radius-card); background: rgba(234,179,8,0.03); padding: 11px 12px; margin-bottom: 8px; transition: opacity 280ms ease; }
    .evo-ed-alert.resolved { opacity: 0.4; }
    .evo-ed-alert-row { display: flex; gap: 8px; align-items: flex-start; }
    .evo-ed-alert-txt { font-family: var(--font-body); font-size: 0.77rem; color: var(--c-textbody); line-height: 1.62; }
    .evo-ed-alert-txt.struck { text-decoration: line-through; color: var(--c-textsub); }
    .evo-ed-alert-acts { display: flex; align-items: center; gap: 6px; margin-top: 9px; justify-content: flex-end; }
    .evo-aact { font-family: var(--font-label); font-size: 0.54rem; font-weight: var(--fw-label); text-transform: uppercase; letter-spacing: 0.08em; background: none; border: 1px solid rgba(255, 255, 255, 0.14); border-radius: var(--radius-card); color: var(--c-textsub); padding: 4px 10px; cursor: pointer; transition: color 120ms ease, border-color 120ms ease; }
    .evo-aact.amber:hover { color: var(--c-status-warning); border-color: rgba(234,179,8,0.35); }
    .evo-resbadge { font-family: var(--font-label); font-size: 0.54rem; font-weight: var(--fw-label); text-transform: uppercase; letter-spacing: 0.08em; color: var(--c-textsub); }
    .evo-resundo { margin-left: auto; font-family: var(--font-label); font-size: 0.54rem; font-weight: var(--fw-label); text-transform: uppercase; letter-spacing: 0.08em; color: var(--c-textsub); background: none; border: none; cursor: pointer; text-decoration: underline; }
    /* preview do atleta */
    .evo-prev-card { background: var(--c-darkbg); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: var(--radius-card); padding: 16px; }
    .evo-prev-badge { display: inline-flex; align-items: center; gap: 5px; padding: 4px 11px; border-radius: var(--radius-pill); background: rgba(166, 195, 0, 0.12); color: var(--c-lime); border: 1px solid rgba(166, 195, 0, 0.50); font-family: var(--font-label); font-size: 0.55rem; font-weight: var(--fw-label); text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 14px; }
    .evo-prev-h { font-family: var(--font-label); font-size: 0.58rem; font-weight: var(--fw-label); text-transform: uppercase; letter-spacing: 0.12em; color: var(--c-lime); margin: 14px 0 7px; }
    .evo-prev-p { font-family: var(--font-body); font-size: 0.82rem; color: var(--c-textbody); line-height: 1.7; }
    .evo-featbadge { display: inline-block; padding: 2px 7px; background: rgba(74,144,217,0.12); color: var(--c-status-progress); border: 1px solid rgba(74,144,217,0.20); border-radius: var(--radius-pill); font-family: var(--font-label); font-size: 0.5rem; font-weight: var(--fw-label); text-transform: uppercase; letter-spacing: 0.08em; margin-left: 7px; vertical-align: middle; }
    .evo-evtable { width: 100%; border-collapse: collapse; margin-bottom: 10px; }
    .evo-evtable th { font-family: var(--font-label); font-size: 0.51rem; font-weight: var(--fw-label); text-transform: uppercase; letter-spacing: 0.1em; color: var(--c-lime); padding: 5px 6px 5px 0; border-bottom: 1px solid rgba(255, 255, 255, 0.08); text-align: right; }
    .evo-evtable th:first-child { text-align: left; }
    .evo-evtable td { font-family: var(--font-body); font-size: 0.68rem; color: var(--c-textbody); padding: 5px 6px 5px 0; border-bottom: 1px solid rgba(255,255,255,0.04); text-align: right; }
    .evo-evtable td:first-child { text-align: left; color: var(--c-textsub); }
    .evo-evtable tr:last-child td { border-bottom: none; }
    .evo-evcur { background: rgba(166, 195, 0, 0.12); color: var(--c-lime) !important; font-weight: 600; border-radius: 2px; padding: 5px 6px; }
    .evo-dpos { color: var(--c-lime); font-family: var(--font-label); font-size: 0.58rem; font-weight: var(--fw-label); }
    .evo-evnote { font-family: var(--font-body); font-size: 0.67rem; color: var(--c-textsub); margin-bottom: 9px; line-height: 1.5; padding: 7px 10px; background: var(--c-darkbg); border-left: 2px solid rgba(255, 255, 255, 0.14); border-radius: 0 var(--radius-card) var(--radius-card) 0; }
    .evo-linkbtn { display: flex; align-items: center; justify-content: center; width: 100%; padding: 9px; border: 1px solid rgba(166, 195, 0, 0.50); border-radius: var(--radius-card); background: transparent; color: var(--c-lime); font-family: var(--font-label); font-size: 0.61rem; font-weight: var(--fw-label); text-transform: uppercase; letter-spacing: 0.08em; cursor: pointer; transition: background 120ms ease; }
    .evo-linkbtn:hover { background: rgba(166, 195, 0, 0.12); }
    .wke-add-ex [data-lucide] { width: 15px; height: 15px; }

    .wke-empty { text-align: center; padding: var(--space-8) var(--space-5); border: 1px dashed rgba(255, 255, 255, 0.14); border-radius: var(--radius-card); margin-bottom: var(--space-3); }
    .wke-empty-icon { color: var(--c-textsub); opacity: 0.5; margin-bottom: var(--space-3); }
    .wke-empty-icon [data-lucide] { width: 32px; height: 32px; }
    .wke-empty-title { font-family: var(--font-label); font-size: var(--fs-body-sm); font-weight: var(--fw-label); text-transform: uppercase; letter-spacing: var(--tracking-label); color: var(--c-textbody); margin-bottom: 4px; }
    .wke-empty-sub { font-family: var(--font-body); font-size: var(--fs-body-sm); color: var(--c-textsub); }
    .wke-firsttime-cta { display: inline-flex; align-items: center; justify-content: center; gap: 8px; margin-top: var(--space-5); padding: 11px 22px; background: var(--c-lime); border: 1px solid var(--c-lime); border-radius: var(--radius-pill); color: #0D0D0D; font-family: var(--font-label); font-size: var(--fs-label); font-weight: var(--fw-label); text-transform: uppercase; letter-spacing: var(--tracking-cta); cursor: pointer; transition: opacity 150ms ease; }
    .wke-firsttime-cta:hover { opacity: 0.88; }
    .wke-firsttime-cta [data-lucide] { width: 15px; height: 15px; }

    /* ── SHR — Escolha de canal no compartilhamento de plano ──────────────
       Passo intermediário entre o retorno de compartilhar-plano.ts e o envio.
       NÃO substitui nada do servidor: o token, a renovação e o atalho de
       WhatsApp continuam vindo prontos da função. O que muda é que o Coach
       escolhe por onde enviar, em vez de o WhatsApp abrir direto.
       Reaproveita a convenção de .wke-search-overlay.                       */
    .shr-overlay { position: fixed; inset: 0; z-index: 340; background: rgba(0,0,0,0.7); display: flex; align-items: flex-start; justify-content: center; padding: 12vh var(--space-4) var(--space-4); }
    .shr-overlay[hidden] { display: none !important; }
    .shr-box { width: 100%; max-width: 440px; background: var(--c-darkbg); border: 1px solid rgba(166, 195, 0, 0.50); border-radius: var(--radius-card); box-shadow: var(--shadow-lg); padding: var(--space-5); }
    .shr-head { display: flex; align-items: flex-start; gap: var(--space-3); margin-bottom: 6px; }
    .shr-title { font-family: var(--font-display); font-size: 1.45rem; letter-spacing: 0.04em; line-height: 1; text-transform: uppercase; color: var(--c-white); }
    .shr-title em { font-style: normal; color: var(--c-lime); }
    .shr-close { margin-left: auto; flex-shrink: 0; width: 30px; height: 30px; display: inline-flex; align-items: center; justify-content: center; background: transparent; border: 1px solid rgba(255,255,255,0.14); border-radius: var(--radius-card); color: var(--c-textsub); cursor: pointer; }
    .shr-close:hover { color: var(--c-white); border-color: rgba(255,255,255,0.28); }
    .shr-close [data-lucide] { width: 15px; height: 15px; }
    .shr-sub { font-family: var(--font-body); font-size: var(--fs-body-sm); color: var(--c-textsub); line-height: 1.55; margin-bottom: var(--space-4); }
    .shr-sub strong { color: var(--c-body); font-weight: 500; }
    .shr-verchip { display: inline-flex; align-items: center; gap: 6px; margin-bottom: 14px; padding: 4px 10px; border-radius: 999px; background: rgba(166,195,0,0.12); border: 1px solid rgba(166,195,0,0.45); color: var(--c-lime); font-family: var(--font-label); font-weight: var(--fw-label); font-size: var(--fs-label); letter-spacing: var(--tracking-label); text-transform: uppercase; }
    .shr-verchip [data-lucide] { width: 13px; height: 13px; }
    .shr-urlwrap { display: flex; align-items: center; gap: 8px; margin-bottom: 8px; padding: 9px 10px 9px 12px; background: var(--c-black); border: 1px solid rgba(255,255,255,0.10); border-radius: var(--radius-card); }
    .shr-url { flex: 1; min-width: 0; font-family: var(--font-mono, ui-monospace, monospace); font-size: var(--fs-body-sm); color: var(--c-body); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .shr-copy { flex-shrink: 0; display: inline-flex; align-items: center; gap: 6px; padding: 7px 12px; background: transparent; border: 1px solid rgba(166,195,0,0.50); border-radius: var(--radius-card); color: var(--c-lime); font-family: var(--font-label); font-weight: var(--fw-label); font-size: var(--fs-label); letter-spacing: var(--tracking-label); text-transform: uppercase; white-space: nowrap; cursor: pointer; }
    .shr-copy:hover { background: rgba(166,195,0,0.08); }
    .shr-copy [data-lucide] { width: 14px; height: 14px; }
    /* O aviso NÃO é decorativo: o endereço não exige senha, e o Coach precisa
       saber disso ANTES de colar em algum lugar, não depois.                */
    .shr-hint { font-family: var(--font-body); font-size: 0.63rem; color: #7a7a7a; line-height: 1.5; margin-bottom: var(--space-5); }
    .shr-lbl { font-family: var(--font-label); font-weight: var(--fw-label); font-size: var(--fs-label); letter-spacing: var(--tracking-label); text-transform: uppercase; color: #777; margin-bottom: 9px; }
    .shr-opt { width: 100%; display: flex; align-items: center; gap: var(--space-3); margin-bottom: 8px; padding: 11px 13px; background: transparent; border: 1px solid rgba(255,255,255,0.10); border-radius: var(--radius-card); text-align: left; cursor: pointer; transition: border-color var(--dur-fast) var(--ease-std), background var(--dur-fast) var(--ease-std); }
    .shr-opt:hover:not(:disabled) { border-color: rgba(166,195,0,0.40); background: rgba(166,195,0,0.04); }
    .shr-opt:disabled { opacity: 0.40; cursor: not-allowed; }
    .shr-opt-ico { flex-shrink: 0; display: inline-flex; color: var(--c-lime); }
    .shr-opt-ico [data-lucide] { width: 17px; height: 17px; }
    .shr-opt-txt { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2px; }
    .shr-opt-l { font-family: var(--font-label); font-weight: var(--fw-label); font-size: 0.66rem; letter-spacing: 0.05em; text-transform: uppercase; color: #EEE; }
    .shr-opt-s { font-family: var(--font-body); font-size: var(--fs-body-sm); color: #8d8d8d; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .shr-opt-chev { flex-shrink: 0; display: inline-flex; color: #5a5a5a; }
    .shr-opt-chev [data-lucide] { width: 15px; height: 15px; }

    /* AddExerciseSearch — autocomplete overlay */
    .wke-search-overlay { position: fixed; inset: 0; z-index: 320; background: rgba(0,0,0,0.7); display: flex; align-items: flex-start; justify-content: center; padding-top: 12vh; }
    .wke-search-overlay[hidden] { display: none !important; }
    .wke-search-box { width: 100%; max-width: 440px; background: var(--c-darkbg); border: 1px solid rgba(166, 195, 0, 0.50); border-radius: var(--radius-card); box-shadow: var(--shadow-lg); overflow: hidden; }
    .wke-search-inputwrap { position: relative; padding: var(--space-3); border-bottom: 1px solid rgba(255, 255, 255, 0.08); }
    .wke-search-inputwrap [data-lucide] { position: absolute; left: calc(var(--space-3) + 10px); top: 50%; transform: translateY(-50%); color: var(--c-textsub); width: 16px; height: 16px; }
    .wke-search-input { width: 100%; background: var(--c-black); border: 1px solid rgba(255, 255, 255, 0.14); border-radius: var(--radius-card); color: var(--c-white); font-family: var(--font-body); font-size: var(--fs-body-md); padding: 11px 12px 11px 38px; }
    .wke-search-input:focus { outline: none; border-color: var(--c-lime); box-shadow: 0 0 0 2px rgba(166, 195, 0, 0.12); }
    .wke-search-results { max-height: 320px; overflow-y: auto; }
    .wke-search-catalogo { display: flex; align-items: center; justify-content: center; gap: 7px; padding: 10px; border-top: 1px solid rgba(255,255,255,0.08); font-family: var(--font-label); font-weight: var(--fw-label); font-size: var(--fs-label); letter-spacing: var(--tracking-label); text-transform: uppercase; color: var(--c-textsub); text-decoration: none; transition: color var(--dur-fast) var(--ease-std), background var(--dur-fast) var(--ease-std); }
    .wke-search-catalogo:hover { color: var(--c-lime); background: rgba(166,195,0,0.06); }
    .wke-search-catalogo [data-lucide] { width: 13px; height: 13px; }
    .wke-search-result { display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); padding: 11px var(--space-4); cursor: pointer; border-bottom: 1px solid rgba(255,255,255,0.04); transition: background 120ms ease; }
    /* Pendência como TARJA, não como texto na linha. O estado é o mesmo para
       centenas de resultados: dizê-lo por extenso em cada um custava largura
       (e rolagem horizontal) para repetir o que a legenda diz uma vez.
       box-shadow interno em vez de border-left: borda empurraria o conteúdo
       3px e desalinharia a linha pendente das demais. */
    .wke-search-result--pendente { box-shadow: inset 3px 0 0 var(--c-pending); }
    .wke-search-legenda { position: sticky; top: 0; z-index: 1; background: var(--c-darkbg); border-bottom: 1px solid rgba(255,255,255,0.06); padding: 9px var(--space-4); font-family: var(--font-body); font-size: 11px; line-height: 1.45; color: var(--c-textsub); }
    .wke-search-result:hover, .wke-search-result.active { background: rgba(166, 195, 0, 0.12); }
    /* O nome é a informação que o Coach procura; as etiquetas são contexto.
       Antes a prioridade era a inversa: as etiquetas tinham flex-shrink 0 e o
       nome era o único que cedia, quebrando em três linhas. */
    .wke-search-result-name { font-family: var(--font-body); font-size: var(--fs-body-sm); color: var(--c-white); flex: 1 1 auto; min-width: 0; }
    .wke-search-result-tags { display: flex; gap: 5px; flex: 0 1 auto; min-width: 0; }
    .wke-search-result-tags .wke-ex-tag { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .wke-search-hint { padding: var(--space-4); text-align: center; font-family: var(--font-body); font-size: var(--fs-body-sm); color: var(--c-textsub); }

    /* Toast (auto-save / PR feedback) */
    .wke-toast-wrap { position: fixed; bottom: 24px; left: 50%; transform: translateX(-50%); z-index: 340; display: flex; flex-direction: column; gap: 8px; align-items: center; pointer-events: none; }
    .wke-toast { display: flex; align-items: center; gap: 8px; background: var(--c-surface-2); border: 1px solid rgba(255, 255, 255, 0.14); border-radius: var(--radius-pill); padding: 9px 18px; font-family: var(--font-body); font-size: var(--fs-body-sm); color: var(--c-white); box-shadow: var(--shadow-md); animation: wke-toast-in 200ms var(--ease-out) both; }
    .wke-toast.pr { border-color: var(--c-lime); }
    .wke-toast [data-lucide] { width: 14px; height: 14px; color: var(--c-lime); }
    @keyframes wke-toast-in { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }
    .nte-macro-delta { font-family: var(--font-body); font-size: 10px; color: var(--c-textsub); margin-top: 2px; }
    .wke-toast-warning { border-color: var(--c-status-warning); }
    .wke-toast-warning [data-lucide] { color: var(--c-status-warning); }
    .wke-toast-error { border-color: var(--c-status-rejected); }
    .wke-toast-error [data-lucide] { color: var(--c-status-rejected); }
    .wke-toast-info { border-color: rgba(255, 255, 255, 0.14); }
    .wke-toast-info [data-lucide] { color: var(--c-textsub); }

    /* ── NTE: NUTRITION EDITOR (Aba 5 — Nutricional) ── */
    /* Fórmula de Macros — painel colapsável */
    .nte-formula-gear-btn { background: transparent; border: 1px solid rgba(255, 255, 255, 0.14); border-radius: var(--radius-card); color: var(--c-textsub); width: 28px; height: 28px; display: inline-flex; align-items: center; justify-content: center; cursor: pointer; transition: color 150ms ease, border-color 150ms ease; }
    .nte-formula-gear-btn:hover { color: var(--c-lime); border-color: rgba(166, 195, 0, 0.50); }
    .nte-formula-gear-btn [data-lucide] { width: 14px; height: 14px; }
    .nte-formula-panel-open .nte-formula-gear-btn { color: var(--c-lime); border-color: var(--c-lime); }
    #nte-formula-panel { background: var(--c-darkbg); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: var(--radius-card); padding: var(--space-4); margin-bottom: var(--space-4); }
    /* Painel da fórmula posicionado logo abaixo de "Publicado em…" dentro do nu-pubheader */
    #nu-pubheader { flex-wrap: wrap; row-gap: 6px; }
    #nu-pubheader #nte-formula-panel { order: 99; flex-basis: 100%; width: 100%; margin-top: 6px; margin-bottom: 0; }
    .nte-formula-header { font-family: var(--font-label); font-size: 10px; font-weight: var(--fw-label); text-transform: uppercase; letter-spacing: var(--tracking-label); color: var(--c-textsub); margin-bottom: var(--space-3); }
    .nte-formula-table { width: 100%; border-collapse: collapse; }
    .nte-formula-table thead th { font-family: var(--font-label); font-size: 9.5px; font-weight: var(--fw-label); text-transform: uppercase; letter-spacing: var(--tracking-label); color: var(--c-textsub); text-align: left; padding: 0 6px 6px; }
    .nte-formula-table thead th:first-child { width: 30%; }
    .nte-formula-table tbody td { padding: 4px 6px; border-bottom: 1px solid rgba(255,255,255,0.04); }
    .nte-formula-table tbody tr:last-child td { border-bottom: none; }
    .nte-formula-phase { font-family: var(--font-label); font-size: 10px; font-weight: var(--fw-label); color: var(--c-textbody); text-transform: uppercase; letter-spacing: 0.04em; }
    .nte-formula-input { width: 100%; background: var(--c-black); border: 1px solid rgba(255, 255, 255, 0.14); border-radius: 3px; color: var(--c-lime); font-family: var(--font-body); font-size: var(--fs-body-sm); font-weight: var(--fw-body-bold); padding: 4px 6px; text-align: center; }
    .nte-formula-input:focus { outline: none; border-color: var(--c-lime); box-shadow: 0 0 0 2px rgba(166,195,0,0.2); }
    /* Esconde os spinners nativos do navegador (destoam do DS); digitação direta */
    .nte-formula-input::-webkit-outer-spin-button,
    .nte-formula-input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
    .nte-formula-input { -moz-appearance: textfield; appearance: textfield; }
    /* Setas customizadas em lime (digitação direta continua válida) */
    .nte-stepper { display: flex; align-items: stretch; gap: 3px; }
    .nte-stepper > .nte-formula-input { flex: 1 1 auto; min-width: 0; }
    .nte-stepper-arrows { display: flex; flex-direction: column; flex: 0 0 auto; }
    .nte-stepper-btn {
      display: flex; align-items: center; justify-content: center;
      width: 18px; flex: 1 1 0; padding: 0; margin: 0;
      background: var(--c-black); border: 1px solid rgba(255, 255, 255, 0.14);
      color: var(--c-lime); cursor: pointer; line-height: 0;
      transition: background 120ms ease, border-color 120ms ease;
    }
    .nte-stepper-btn:first-child { border-radius: 3px 3px 0 0; border-bottom: none; }
    .nte-stepper-btn:last-child  { border-radius: 0 0 3px 3px; }
    .nte-stepper-btn:hover  { background: rgba(166,195,0,0.15); border-color: var(--c-lime); }
    .nte-stepper-btn:active { background: rgba(166,195,0,0.30); }
    .nte-formula-actions { display: flex; gap: var(--space-2); margin-top: var(--space-4); }
    .nte-formula-btn { flex: 1; padding: 8px; border-radius: var(--radius-card); font-family: var(--font-label); font-size: var(--fs-label); font-weight: var(--fw-label); text-transform: uppercase; letter-spacing: var(--tracking-cta); cursor: pointer; transition: opacity 150ms ease; background: transparent; border: 1px solid rgba(255, 255, 255, 0.14); color: var(--c-textsub); }
    .nte-formula-btn.primary { background: var(--c-lime); border-color: var(--c-lime); color: #0D0D0D; }
    .nte-formula-btn:hover { opacity: 0.85; }
    .nte-dayselector { display: flex; gap: var(--space-2); margin-bottom: var(--space-5); }
    .nte-dayseg { flex: 1; padding: 9px 14px; border-radius: var(--radius-pill); border: 1px solid rgba(255, 255, 255, 0.14); background: transparent; color: var(--c-textsub); font-family: var(--font-label); font-size: var(--fs-label); font-weight: var(--fw-label); text-transform: uppercase; letter-spacing: var(--tracking-cta); cursor: pointer; transition: color 150ms ease, border-color 150ms ease, background 150ms ease; }
    .nte-dayseg:hover { border-color: rgba(166, 195, 0, 0.50); color: var(--c-white); }
    .nte-dayseg.active { background: var(--c-lime); border-color: var(--c-lime); color: #0D0D0D; }

    .nte-macros { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-2); margin-bottom: var(--space-5); }
    .nte-calcctx { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; padding: 9px 12px; margin-bottom: var(--space-4); background: var(--c-darkbg); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: var(--radius-card); }
    .nte-calcctx-lbl { font-family: var(--font-body); font-size: 0.7rem; color: var(--c-textsub); }
    .nte-calcctx-sep { color: rgba(255, 255, 255, 0.14); }
    .nte-phasechip { display: inline-flex; align-items: center; padding: 3px 10px; border-radius: var(--radius-pill); font-family: var(--font-label); font-size: 0.58rem; font-weight: var(--fw-label); text-transform: uppercase; letter-spacing: 0.07em; border: 1px solid; }
    .nte-phasechip.bulking { background: rgba(166,195,0,0.10); color: var(--c-lime); border-color: rgba(166, 195, 0, 0.50); }
    .nte-phasechip.cutting { background: rgba(74,144,217,0.10); color: var(--c-status-progress); border-color: rgba(74,144,217,0.4); }
    .nte-phasechip.manutencao { background: rgba(153,153,153,0.12); color: var(--c-textbody); border-color: rgba(153,153,153,0.35); }
    .nte-phasechip.dietbreak { background: rgba(234,179,8,0.10); color: var(--c-status-warning); border-color: rgba(234,179,8,0.4); }
    .nte-weightval { font-family: var(--font-label); font-size: 0.66rem; font-weight: var(--fw-label); color: var(--c-white); letter-spacing: 0.03em; }
    .nte-previewbtn { margin-left: auto; display: inline-flex; align-items: center; gap: 6px; padding: 7px 13px; background: transparent; border: 1px solid rgba(166, 195, 0, 0.50); border-radius: var(--radius-card); color: var(--c-lime); font-family: var(--font-label); font-size: 0.6rem; font-weight: var(--fw-label); text-transform: uppercase; letter-spacing: 0.07em; cursor: pointer; transition: background 120ms ease; white-space: nowrap; }
    .nte-previewbtn:hover { background: rgba(166, 195, 0, 0.12); }
    .nte-previewbtn [data-lucide] { width: 14px; height: 14px; }
    /* ── Documento do atleta: envelope espelhando /avaliacao/[token] com Montserrat + DS ── */
    .doc-sheet { max-width: 760px; margin: 0 auto; }
    .doc-header { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding-bottom: 20px; margin-bottom: 28px; border-bottom: 1px solid rgba(166,195,0,0.2); }
    .doc-logo { display: flex; align-items: center; gap: 12px; }
    .doc-logo img { width: 51px; height: 56px; flex-shrink: 0; display: block; }
    /* Assinatura da marca no envelope: "COACH RUIZ · ELITE90 PRO" numa linha; em
       telas estreitas o separador some e os termos empilham. Gemea das regras de
       pages/avaliacao/[token].astro (.logo-name) — alterar as duas juntas. */
    .doc-logo-h { font-family: var(--font-display); font-size: 1.35rem; letter-spacing: 0.1em; color: var(--c-lime); line-height: 1; display: flex; align-items: baseline; gap: 0.3em; white-space: nowrap; }
    @media (max-width: 660px) {
      .doc-logo-h { flex-direction: column; align-items: flex-start; gap: 2px; font-size: 1.15rem; }
      .doc-logo-sep { display: none; }
      .doc-logo-p { font-size: 0.5rem; letter-spacing: 0.1em; }
      .doc-badge { font-size: 0.52rem; padding: 5px 10px; letter-spacing: 0.08em; }
    }
    @media (max-width: 399px) { .doc-badge { display: none; } }
    .doc-logo-p { font-family: var(--font-body); font-size: 0.55rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--c-textsub); margin-top: 3px; }
    .doc-badge { padding: 6px 14px; border-radius: var(--radius-pill); font-family: var(--font-label); font-size: 0.6rem; font-weight: var(--fw-label); letter-spacing: 0.12em; text-transform: uppercase; background: rgba(85,102,0,0.3); color: var(--c-lime); border: 1px solid rgba(166, 195, 0, 0.50); white-space: nowrap; }
    .doc-card { position: relative; background: #121212; border-radius: 18px; padding: 32px; border: 1px solid rgba(255,255,255,0.05); }
    .doc-card::after { content: ''; position: absolute; inset: 0; border-radius: inherit; padding: 1px; background: linear-gradient(to bottom right, rgba(166,195,0,0.35), rgba(85,102,0,0.05)); -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0); -webkit-mask-composite: xor; mask-composite: exclude; pointer-events: none; }
    .doc-title { font-family: var(--font-display); font-size: clamp(1.6rem, 4vw, 2.4rem); letter-spacing: 0.04em; color: var(--c-white); line-height: 1.1; margin-bottom: 24px; }
    .doc-summary { padding: 18px 20px; background: rgba(0,0,0,0.4); border-left: 3px solid var(--c-lime); border-radius: 0 10px 10px 0; font-family: var(--font-body); font-size: 0.8rem; color: var(--c-textbody); line-height: 1.8; margin-bottom: 36px; }
    .doc-summary strong { color: var(--c-white); }
    .doc-section { margin-bottom: 32px; }
    .doc-section:last-child { margin-bottom: 0; }
    .doc-section-h { display: flex; align-items: center; gap: 12px; margin-bottom: 16px; }
    .doc-section-num { font-family: var(--font-display); font-size: 1.7rem; color: var(--c-lime); line-height: 1; }
    .doc-section-title { font-family: var(--font-display); font-size: clamp(1.1rem, 3vw, 1.5rem); letter-spacing: 0.06em; color: var(--c-white); text-transform: uppercase; }
    .doc-section-body { font-family: var(--font-body); font-size: 0.82rem; line-height: 1.85; color: var(--c-textbody); }
    /* Observações do Coach no documento do atleta: o texto é digitado livremente
       num textarea, então as quebras de linha são intenção do autor. */
    .doc-section-body.doc-notes { white-space: pre-wrap; }
    .doc-divider { height: 1px; background: rgba(255,255,255,0.06); margin: 28px 0; }
    /* macros e refeições dentro do documento */
    .doc-macros { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; margin: 4px 0 6px; }
    .doc-macro { background: var(--c-black); border-radius: var(--radius-card); padding: 10px; text-align: center; }
    .doc-macro-v { font-family: var(--font-display); font-size: 1.2rem; color: var(--c-lime); line-height: 1; }
    .doc-macro-l { font-family: var(--font-label); font-size: 0.5rem; color: var(--c-textsub); text-transform: uppercase; letter-spacing: 0.08em; margin-top: 4px; }
    .doc-meal { border-top: 1px solid rgba(255,255,255,0.06); padding-top: 12px; margin-top: 12px; }
    .doc-meal:first-of-type { border-top: none; margin-top: 8px; padding-top: 0; }
    .doc-meal-h { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 6px; }
    .doc-meal-name { font-family: var(--font-label); font-size: 0.68rem; font-weight: var(--fw-label); color: var(--c-white); text-transform: uppercase; letter-spacing: 0.06em; }
    .doc-meal-kcal { font-family: var(--font-display); font-size: 0.9rem; color: var(--c-lime); }
    .doc-food { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; padding: 3px 0; }
    .doc-food-name { font-family: var(--font-body); font-size: 0.76rem; color: var(--c-textbody); }
    .doc-food-qty { font-family: var(--font-body); font-size: 0.7rem; color: var(--c-textsub); white-space: nowrap; }
    .doc-empty { font-family: var(--font-body); font-size: 0.74rem; color: var(--c-textsub); font-style: italic; padding: 4px 0; }
    /* exercícios dentro do documento (treino) */
    .doc-ex { border-top: 1px solid rgba(255,255,255,0.06); padding: 10px 0; }
    .doc-ex:first-of-type { border-top: none; padding-top: 4px; }
    .doc-ex-name { font-family: var(--font-label); font-size: 0.72rem; font-weight: var(--fw-label); color: var(--c-white); text-transform: uppercase; letter-spacing: 0.04em; margin-bottom: 4px; }
    .doc-ex-sets { font-family: var(--font-body); font-size: 0.76rem; color: var(--c-textbody); }
    .doc-footer { text-align: center; padding: 24px 0 8px; margin-top: 28px; }
    .doc-footer-div { width: 100%; height: 1px; background: linear-gradient(to right, transparent, var(--c-lime) 20%, var(--c-lime) 80%, transparent); opacity: 0.25; margin-bottom: 18px; }
    .doc-footer-copy { font-family: var(--font-label); font-size: 0.55rem; font-weight: var(--fw-label); text-transform: uppercase; letter-spacing: 0.1em; color: var(--c-textsub); }
    .doc-footer-credit { font-family: var(--font-label); font-size: 0.5rem; font-weight: var(--fw-label); text-transform: uppercase; letter-spacing: 0.08em; color: rgba(153,153,153,0.5); margin-top: 6px; }
    .nte-macro { background: var(--c-darkbg); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: var(--radius-card); padding: var(--space-3); }
    .nte-macro-top { display: flex; align-items: baseline; justify-content: space-between; gap: 4px; }
    .nte-macro-value { font-family: var(--font-display); font-size: 1.45rem; color: var(--c-white); line-height: 1; letter-spacing: 0.01em; }
    .nte-macro-target { font-family: var(--font-body); font-size: 10px; color: var(--c-textsub); }
    .nte-macro-label { font-family: var(--font-label); font-size: 10px; color: var(--c-textsub); text-transform: uppercase; letter-spacing: var(--tracking-label); margin-top: 6px; margin-bottom: 7px; }
    .nte-macro-bar { height: 4px; background: rgba(255, 255, 255, 0.08); border-radius: 2px; overflow: hidden; }
    .nte-macro-fill { height: 100%; border-radius: 2px; transition: width 200ms var(--ease-out), background 200ms ease; }
    .nte-macro-fill.on { background: var(--c-lime); }
    .nte-macro-fill.near { background: var(--c-status-warning); }
    .nte-macro-fill.off { background: var(--c-status-rejected); }

    .nte-meal { background: var(--c-surface-2); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: var(--radius-card); margin-bottom: var(--space-3); overflow: hidden; }
    .nte-meal-header { display: flex; align-items: center; gap: var(--space-2); padding: var(--space-3) var(--space-3) var(--space-2); }
    .nte-meal-name { flex: 1; min-width: 0; font-family: var(--font-label); font-weight: var(--fw-label); font-size: var(--fs-body-sm); text-transform: uppercase; color: var(--c-white); letter-spacing: 0.04em; background: transparent; border: 1px solid transparent; border-radius: 3px; padding: 3px 6px; }
    .nte-meal-name:hover { border-color: rgba(255, 255, 255, 0.14); }
    .nte-meal-name:focus { outline: none; border-color: var(--c-lime); background: var(--c-black); box-shadow: 0 0 0 2px rgba(166, 195, 0, 0.12); }
    .nte-meal-kcal { font-family: var(--font-display); font-size: 1rem; color: var(--c-lime); flex-shrink: 0; padding: 0 4px; }
    .nte-meal-actions { display: flex; gap: 4px; flex-shrink: 0; }

    .nte-foods { width: 100%; border-collapse: collapse; }
    .nte-foods thead th { font-family: var(--font-label); font-size: 9.5px; font-weight: var(--fw-label); text-transform: uppercase; letter-spacing: var(--tracking-label); color: var(--c-textsub); text-align: left; padding: 6px var(--space-3); border-bottom: 1px solid rgba(255, 255, 255, 0.08); }
    .nte-foods thead th.num, .nte-foods tbody td.num { text-align: right; }
    .nte-foods tbody td { padding: 5px var(--space-3); border-bottom: 1px solid rgba(255,255,255,0.04); font-family: var(--font-body); font-size: var(--fs-body-sm); color: var(--c-textbody); vertical-align: middle; }
    .nte-foods tbody tr:last-child td { border-bottom: none; }
    .nte-food-name { color: var(--c-white); }
    .nte-food-macros { font-family: var(--font-body); font-size: 10px; color: var(--c-textsub); margin-top: 2px; }
    .nte-qty-wrap { display: inline-flex; align-items: baseline; gap: 3px; }
    .nte-qty-input { background: transparent; border: 1px solid transparent; border-radius: 3px; color: var(--c-white); font-family: var(--font-body); font-size: var(--fs-body-sm); font-weight: var(--fw-body-bold); padding: 4px 6px; width: 64px; text-align: right; transition: border-color 120ms ease, background 120ms ease; }
    .nte-qty-input:hover { border-color: rgba(255, 255, 255, 0.14); }
    .nte-qty-input:focus { outline: none; border-color: var(--c-lime); background: var(--c-black); box-shadow: 0 0 0 2px rgba(166, 195, 0, 0.12); }
    .nte-qty-input.invalid { border-color: var(--c-status-rejected); box-shadow: 0 0 0 2px rgba(231,76,60,0.15); }
    .nte-qty-unit { font-family: var(--font-body); font-size: 11px; color: var(--c-textsub); }
    .nte-food-kcal { font-family: var(--font-body); font-weight: var(--fw-body-bold); color: var(--c-white); white-space: nowrap; }
    .nte-food-del { width: 24px; height: 24px; display: inline-flex; align-items: center; justify-content: center; background: transparent; border: 1px solid transparent; border-radius: var(--radius-card); color: var(--c-textsub); cursor: pointer; transition: color 150ms ease, border-color 150ms ease; }
    .nte-food-del:hover { color: var(--c-status-rejected); border-color: rgba(255, 255, 255, 0.14); }
    .nte-food-del [data-lucide] { width: 14px; height: 14px; }
    .nte-meal-addfood { display: flex; align-items: center; gap: 6px; width: 100%; padding: 9px var(--space-3); background: transparent; border: none; border-top: 1px solid rgba(255, 255, 255, 0.08); color: var(--c-lime); font-family: var(--font-label); font-size: 11px; font-weight: var(--fw-label); text-transform: uppercase; letter-spacing: var(--tracking-cta); cursor: pointer; transition: background 150ms ease; }
    .nte-meal-addfood:hover { background: rgba(166, 195, 0, 0.12); }
    .nte-meal-addfood [data-lucide] { width: 13px; height: 13px; }

    /* AddFoodSearch — preview de quantidade */
    .nte-food-result { display: block; }
    .nte-food-result-macros { font-family: var(--font-body); font-size: 10px; color: var(--c-textsub); margin-top: 2px; }
    .nte-qty-overlay { position: fixed; inset: 0; z-index: 330; background: rgba(0,0,0,0.7); display: flex; align-items: flex-start; justify-content: center; padding-top: 12vh; }
    .nte-qty-overlay[hidden] { display: none !important; }
    .nte-qty-box { width: 100%; max-width: 380px; background: var(--c-darkbg); border: 1px solid rgba(166, 195, 0, 0.50); border-radius: var(--radius-card); box-shadow: var(--shadow-lg); padding: var(--space-5); }
    .nte-qty-title { font-family: var(--font-label); font-size: var(--fs-body-sm); font-weight: var(--fw-label); text-transform: uppercase; letter-spacing: var(--tracking-label); color: var(--c-white); margin-bottom: var(--space-4); }
    .nte-qty-field { display: flex; align-items: center; gap: var(--space-3); margin-bottom: var(--space-4); }
    .nte-qty-field input { flex: 1; background: var(--c-black); border: 1px solid rgba(255, 255, 255, 0.14); border-radius: var(--radius-card); color: var(--c-white); font-family: var(--font-body); font-size: var(--fs-body-md); padding: 10px 12px; }
    .nte-qty-field input:focus { outline: none; border-color: var(--c-lime); box-shadow: 0 0 0 2px rgba(166, 195, 0, 0.12); }
    .nte-qty-preview { display: grid; grid-template-columns: repeat(4,1fr); gap: var(--space-2); margin-bottom: var(--space-5); }
    .nte-qty-prev-cell { text-align: center; }
    .nte-qty-prev-val { font-family: var(--font-display); font-size: 1.15rem; color: var(--c-white); }
    .nte-qty-prev-lbl { font-family: var(--font-label); font-size: 9px; color: var(--c-textsub); text-transform: uppercase; letter-spacing: var(--tracking-label); margin-top: 3px; }
    .nte-qty-actions { display: flex; gap: var(--space-2); }
    .nte-qty-actions button { flex: 1; padding: 10px; border-radius: var(--radius-card); font-family: var(--font-label); font-size: var(--fs-label); font-weight: var(--fw-label); text-transform: uppercase; letter-spacing: var(--tracking-cta); cursor: pointer; transition: opacity 150ms ease; }
    .nte-qty-cancel { background: transparent; border: 1px solid rgba(255, 255, 255, 0.14); color: var(--c-textsub); }
    .nte-qty-confirm { background: var(--c-lime); border: 1px solid var(--c-lime); color: #0D0D0D; }
    .nte-qty-confirm:hover, .nte-qty-cancel:hover { opacity: 0.85; }

    /* ── MODALS ── */

    /* ── PHOTO MODAL ── */
    #photo-modal-overlay { position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 300; background: rgba(0,0,0,.95); display: flex; align-items: center; justify-content: center; touch-action: manipulation; }
    #photo-modal-overlay[data-open="false"] { display: none; }
    .photo-modal-container { position: relative; display: flex; align-items: center; justify-content: center; width: 100%; max-width: 100%; }
    .photo-modal-image { width: 100%; max-width: 500px; aspect-ratio: 3/4; background: var(--c-darkbg); border-radius: var(--radius-card); background-size: contain; background-repeat: no-repeat; background-position: center center; }
    .photo-modal-arrow { position: fixed; top: 50%; transform: translateY(-50%); width: 56px; height: 56px; background: transparent; border: 0.75px solid var(--c-white); color: var(--c-white); border-radius: 50%; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: all var(--dur-med) var(--ease-std); padding: 0; font-family: inherit; z-index: 301; }
    .photo-modal-arrow svg { width: 28px; height: 28px; }
    .photo-modal-arrow:hover:not(:disabled) { border-color: var(--c-lime); color: var(--c-lime); background: rgba(166, 195, 0, 0.1); }
    .photo-modal-arrow:disabled { opacity: 0.2; cursor: default; pointer-events: none; }
    .photo-modal-arrow-left { left: calc(50% - 250px - 40px); }
    .photo-modal-arrow-right { right: calc(50% - 250px - 40px); }
    .photo-modal-close { position: fixed; top: 40px; right: 40px; width: 48px; height: 48px; background: transparent; border: 0.75px solid var(--c-white); color: var(--c-white); border-radius: 50%; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: all var(--dur-med) var(--ease-std); padding: 0; font-family: inherit; z-index: 301; }
    .photo-modal-close svg { width: 20px; height: 20px; }
    .photo-modal-close:hover { border-color: var(--c-lime); color: var(--c-lime); background: rgba(166, 195, 0, 0.1); }
    .photo-modal-counter { position: absolute; top: 100%; left: 50%; transform: translateX(-50%); margin-top: 24px; background: transparent; border: 0.75px solid var(--c-white); color: var(--c-white); padding: 8px 16px; border-radius: 20px; font-family: var(--font-label); font-size: var(--fs-label); letter-spacing: var(--tracking-cta); text-transform: uppercase; transition: all var(--dur-med) var(--ease-std); white-space: nowrap; z-index: 301; }
    .photo-modal-counter:hover { border-color: var(--c-lime); color: var(--c-lime); background: rgba(166, 195, 0, 0.1); }

    /* Slider antes/depois no modal */
    .photo-modal-slider-wrap { width: 100%; max-width: 500px; aspect-ratio: 3/4; border-radius: var(--radius-card); overflow: hidden; border: 1px solid rgba(255, 255, 255, 0.14); }
    .photo-modal-slider-wrap img-comparison-slider { width: 100%; height: 100%; display: block; --divider-width: 2px; --divider-color: var(--c-lime); --default-handle-opacity: 1; }
    .photo-modal-slider-wrap figure { margin: 0; width: 100%; height: 100%; display: block; position: relative; overflow: hidden; background: var(--c-darkbg); }
    .photo-modal-slider-wrap figure img { width: 100%; height: 100%; aspect-ratio: 3/4; object-fit: contain; display: block; }
    .photo-slider-tag { position: absolute; top: 12px; bottom: auto; font-family: var(--font-label); font-size: 0.6rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: var(--c-white); background: rgba(13,13,13,0.85); padding: 4px 10px; border-radius: 2px; pointer-events: none; white-space: nowrap; line-height: 1.4; }
    .photo-slider-tag--before { left: 12px; }
    .photo-slider-tag--after  { right: 12px; }
    .photo-modal-compare-btn { touch-action: manipulation; background: rgba(13,13,13,0.72); border: 0.75px solid rgba(166,195,0,0.45); color: var(--c-lime); font-family: var(--font-label); font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; padding: 5px 14px; border-radius: 40px; cursor: pointer; backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); transition: background var(--dur-fast) var(--ease-std), border-color var(--dur-fast) var(--ease-std); white-space: nowrap; }
    .photo-modal-compare-btn:hover { background: rgba(13,13,13,0.92); border-color: var(--c-lime); }
    /* ── FAB: CAPTURA PASSIVA + NOTA RÁPIDA ── */
    /* pointer-events: none no CONTÊINER, auto só nos botões de verdade.
       O contêiner se dimensiona pelo filho mais largo, e o filho mais largo é
       .fab-actions — a lista recolhida, que guarda os rótulos e mede 187px.
       O círculo visível tem 52px e fica na ponta direita, então sobravam ~135px
       de caixa transparente à esquerda dele, com pointer-events auto, deitados
       sobre o botão "Adicionar exercício": da metade dele para a direita, o
       toque ia para o FAB. Transparente não quer dizer atravessável — a caixa
       recebe o toque igual, e só pointer-events resolve. */
    .drawer-fab { position: fixed; bottom: var(--space-5); right: var(--space-5); z-index: 250; display: flex; flex-direction: column-reverse; align-items: flex-end; gap: var(--space-3); pointer-events: none; }
    .fab-main { pointer-events: auto; width: 52px; height: 52px; border-radius: 50%; background: var(--grad-cta); border: none; color: #000; font-size: 22px; cursor: pointer; display: flex; align-items: center; justify-content: center; box-shadow: 0 4px 16px rgba(0,0,0,0.5); transition: transform var(--dur-fast) var(--ease-std), box-shadow var(--dur-fast) var(--ease-std); }
    .fab-main:hover { transform: scale(1.08); box-shadow: var(--glow-lime); }
    .fab-main.open { transform: rotate(45deg); }
    .fab-actions { display: flex; flex-direction: column; gap: var(--space-3); align-items: flex-end; overflow: hidden; max-height: 0; transition: max-height var(--dur-med) var(--ease-out), opacity var(--dur-med) var(--ease-out); opacity: 0; pointer-events: none; }
    .fab-actions.open { max-height: 200px; opacity: 1; pointer-events: all; }
    .fab-option { display: flex; align-items: center; gap: var(--space-3); }
    .fab-option-label { background: var(--c-darkbg); border: 1px solid rgba(255, 255, 255, 0.14); color: var(--c-white); font-family: var(--font-label); font-size: 0.65rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; padding: 6px 12px; border-radius: var(--radius-card); white-space: nowrap; }
    .fab-option-btn { width: 40px; height: 40px; border-radius: 50%; background: var(--c-darkbg); border: 1px solid rgba(166, 195, 0, 0.50); color: var(--c-lime); font-size: 18px; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: all var(--dur-fast) var(--ease-std); }
    .fab-option-btn:hover { background: rgba(166, 195, 0, 0.12); }

    /* FAB oculto por padrão, visível apenas quando drawer aberto */
    .drawer-fab { display: none; }
    .drawer-fab.visible { display: flex; }

    /* ── HAMBURGER DRAWER TABS (escondido por padrão, visível no mobile) ── */
    .drawer-hamburger-wrap { display: none; position: relative; }
    .drawer-hamburger-btn { display: flex; align-items: center; justify-content: center; width: 36px; height: 36px; background: transparent; border: 1px solid rgba(255, 255, 255, 0.14); border-radius: var(--radius-card); color: var(--c-white); cursor: pointer; transition: border-color var(--dur-fast) var(--ease-std); padding: 0; }
    .drawer-hamburger-btn:hover { border-color: var(--c-lime); }

    /* ── HAMBURGER NAV PANEL (LP-style) ── */
    .drawer-tab-dropdown {
      display: block;
      position: fixed;
      top: 0; right: 0; bottom: 0;
      width: 82%;
      max-width: 380px;
      background: #242424;
      z-index: 600;
      overflow-y: auto;
      padding: var(--space-5) var(--space-6) var(--space-8);
      transform: translateX(110%);
      transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
      box-shadow: -8px 0 40px rgba(0,0,0,0.6);
    }
    .drawer-tab-dropdown.open { transform: translateX(0); }
    .drawer-tab-backdrop { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 599; }
    .drawer-tab-backdrop.open { display: block; }
    .drawer-tab-close-btn { display: block; background: none; border: none; color: var(--c-white); font-size: 1rem; cursor: pointer; margin-left: auto; margin-bottom: var(--space-8); padding: 0; line-height: 1; }
    .drawer-tab-close-btn:hover { color: var(--c-lime); }
    .drawer-tab-opt { display: block; width: 100%; background: none; border: none; border-bottom: 1px solid rgba(255,255,255,0.08); padding: var(--space-5) 0; color: var(--c-white); font-family: var(--font-label); font-size: 0.8125rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; cursor: pointer; text-align: left; transition: color var(--dur-fast) var(--ease-std); }
    .drawer-tab-opt:first-of-type { border-top: 1px solid rgba(255,255,255,0.08); }
    .drawer-tab-opt:last-child { border-bottom: none; }
    .drawer-tab-opt:hover { color: var(--c-lime); }
    .drawer-tab-opt.active { color: var(--c-lime); }

    /* ── RESPONSIVE DESIGN ── */
    @media (max-width: 1024px) {
      .stats-row { gap: var(--space-3); }
      .stat-card__value { font-size: clamp(1.5rem, 4vw, 2.5rem); }
    }

    @media (max-width: 768px) {
      /* ── HEADER ── */

      /* ── TITLE ── */
      .title-row { padding: var(--space-3) var(--space-4) var(--space-5); }
      .page-title { font-size: var(--fs-display-xl); }
      .action-btns { position: static; margin-top: var(--space-4); }

      /* ── STATS ── */
      .stats-row { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-3); padding: 0 var(--space-4); }
      .stat-card__label { font-size: 0.7rem; }
      .stat-card__value { font-size: 1.5rem; }

      /* ── TOOLBAR ── */
      .toolbar { flex-direction: column; gap: var(--space-3); padding-left: var(--space-4); padding-right: var(--space-4); }
      .search { width: 100%; max-width: 100%; }
      .filter-select { width: 100%; }
      .toolbar-count { margin-left: 0; }

      /* ── PUBLICAÇÃO (Treino + Nutricional compartilham .pub-header) ── */
      .pub-header { flex-direction: column; align-items: stretch; gap: 10px; }
      .pub-actions { margin-left: 0; width: 100%; flex-wrap: wrap; }
      .pub-actions .btn-protocol { flex: 1 1 100%; justify-content: center; }
      .pub-ts { width: 100%; }
      /* Faixa de fase/peso: botão de preview full-width quando quebra */
      .nte-previewbtn { margin-left: 0; width: 100%; justify-content: center; }
      /* Modal de canal vira folha inferior, como a própria gaveta faz */
      .shr-overlay { align-items: flex-end; padding: 0; }
      .shr-box { max-width: none; border-radius: var(--radius-card) var(--radius-card) 0 0; border-bottom: none; padding-bottom: var(--space-6); }
      /* Mobile: engrenagem de fórmula sobe para a linha do título "Plano Nutricional", à direita */
      #nu-pubheader { position: relative; }
      /* 76px, não 40px: cabem dois ícones flutuantes agora (compartilhar +
         fórmula), não um só — ver #nu-sharebtn/#nu-formulabtn abaixo. */
      #nu-pubheader .pub-titlewrap { padding-right: 76px; order: 1; }
      #nu-pubheader .nte-formula-gear-btn { position: absolute; top: 0; margin: 0; }
      #nu-pubheader #nu-formulabtn { right: 0; }
      #nu-pubheader #nu-sharebtn { right: 36px; }
      /* Mobile: dissolve o agrupador pub-actions para reordenar ts/painel/publicar via flex order */
      #nu-pubheader .pub-actions { display: contents; }
      #nu-pubheader .pub-ts { order: 2; }
      #nu-pubheader #nte-formula-panel { order: 3; margin-top: 0; }
      #nu-pubheader .btn-protocol { order: 4; flex: 1 1 100%; justify-content: center; }

      /* ── TABLE → CARDS ── */
      .table-wrap { padding: 0 var(--space-4) var(--space-8); }
      table { display: block; width: 100%; }
      thead { display: none; }
      tbody { display: block; width: 100%; }
      /* Exceção: a tabela de avaliações mantém estrutura tabular no mobile */
      .evo-evtable { display: table; }
      .evo-evtable thead { display: table-header-group; }
      .evo-evtable tbody { display: table-row-group; }
      .evo-evtable tr { display: table-row; }
      .evo-evtable th, .evo-evtable td { display: table-cell; }
      /* Exceção: tabela do accordion "ver histórico completo" do WKE-04 também */
      .wke-loadhist-full table { display: table; }
      .wke-loadhist-full thead { display: table-header-group; }
      .wke-loadhist-full tbody { display: table-row-group; }
      .wke-loadhist-full tr { display: table-row; }
      .wke-loadhist-full th, .wke-loadhist-full td { display: table-cell; }

      .athlete-row {
        display: flex !important;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--space-2) var(--space-3);
        padding: var(--space-4);
        margin-bottom: var(--space-3);
        background: var(--c-darkbg);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: var(--radius-card);
        width: 100%;
        box-sizing: border-box;
      }
      .athlete-row:hover td { background: transparent; }
      .athlete-row td { display: block; padding: 0; border: none; }

      .td--date { display: none !important; }
      .td--name-cell { order: 1; width: 100%; }
      .td--name { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
      .td--cycle { order: 2; flex: 1; font-size: var(--fs-body-sm); display: flex; align-items: center; gap: var(--space-3); }
      .td--progress { flex: 1; display: block; }
      .td--status { order: 3; width: auto; }
      .status-badge { font-size: 0.6rem; padding: 3px 10px; white-space: nowrap; }
      .td--actions { order: 4; width: 100%; text-align: right; }

      /* ── DRAWER → BOTTOM SHEET ── */
      #athlete-drawer { align-items: flex-end; justify-content: center; background: rgba(0,0,0,0); }
      #athlete-drawer.open { background: rgba(0,0,0,0.6); }
      .drawer-panel {
        width: 100%;
        /* svh = viewport PEQUENO, medido como se a barra do navegador estivesse
           à mostra. Com vh, a conta é feita contra o viewport grande e não é
           refeita quando a barra aparece: a folga de 8% no topo passava a ser
           exatamente o que a barra ocupava, e a gaveta parecia cobrir a tela
           inteira. Com svh a folga sobrevive aos dois estados — fica maior com
           a barra recolhida, o que é preferível a sumir.
           A linha vh acima fica de reserva para navegador sem suporte a svh. */
        height: 92vh;
        height: 92svh;
        border-left: none;
        border-top: none;
        border-radius: 20px 20px 0 0;
        padding: 0;
        overflow: hidden;
        position: relative;
        transform: translateY(100%);
        transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
      }
      #athlete-drawer.open .drawer-panel { transform: translateY(0); }
      .drawer-handle { display: block; width: 48px; height: 20px; background: transparent; margin: 0 auto var(--space-3); display: flex; align-items: center; justify-content: center; cursor: grab; touch-action: none; }
    .drawer-handle::after { content: ''; display: block; width: 40px; height: 4px; background: rgba(255, 255, 255, 0.14); border-radius: 2px; }
      #drawer-tabs-nav { display: none; }
      .drawer-hamburger-wrap { display: block; }
      #drawer-close { display: none; }
      .drawer-sidenav { display: none; }
      .drawer-body { flex-direction: column; }
      .drawer-content-wrap { overflow-y: auto; padding: var(--space-4); }
      /* Cabeçalho compacto no mobile. touch-action: none pelo mesmo motivo do
         puxador: sem isso o navegador podia reivindicar o gesto como rolagem
         antes de o touchmove chegar a cancelá-lo — o touchstart é passivo e não
         pode cancelar nada. Arrastar pelo puxador sempre funcionou; pelo
         cabeçalho, era sorteio. */
      .drawer-header { padding: var(--space-3) var(--space-4) var(--space-3); touch-action: none; }
      .drawer-tab-indicator { display: flex !important; }

      /* ── AVALIAÇÃO: Blocos bilaterais em pares no mobile ── */
      .metric-grid[style*="1fr 1fr 1fr 1fr"] { grid-template-columns: 1fr 1fr !important; }
      .metric-grid[style*="1fr 1fr 1fr"] { grid-template-columns: 1fr 1fr !important; }
      .checkin-left { border-right: none; border-bottom: 1px solid rgba(255, 255, 255, 0.08); padding-right: 0; padding-bottom: var(--space-5); }

      /* ── MODALS ── */

      /* ── PHOTO MODAL ── */
      .photo-modal-image { width: 90vw; max-width: 90vw; height: auto; max-height: 75vh; aspect-ratio: 3/4; object-fit: contain; }
      .photo-modal-slider-wrap { width: 90vw; max-width: 90vw; max-height: 75vh; aspect-ratio: 3/4; touch-action: pan-x; }
      .photo-modal-arrow { width: 44px; height: 44px; }
      .photo-modal-arrow svg { width: 22px; height: 22px; }
      .photo-modal-arrow-left { left: 8px; }
      .photo-modal-arrow-right { right: 8px; }
      .photo-modal-close { width: 40px; height: 40px; top: 20px; right: 20px; }

      /* ── GRID LAYOUTS ── */
      .photos-grid { flex-wrap: wrap; }
    }

    @media (max-width: 480px) {
      .stats-row { grid-template-columns: repeat(2, 1fr); }
      .wke-stats { grid-template-columns: repeat(2, 1fr); }
      .nte-macros { grid-template-columns: repeat(2, 1fr); }
      .athlete-row { padding: var(--space-3); }
      .photos-grid { flex-wrap: wrap; }
      .filter-select { font-size: 16px; }
      .btn-primary, .btn-secondary { width: 100%; }
    }
    .modal-close:hover { color: var(--c-lime); }
    .item-row { display: flex; justify-content: space-between; align-items: center; padding: var(--space-3) 0; border-bottom: 1px solid rgba(255,255,255,0.05); font-size: var(--fs-body-sm); }
    .item-row:last-child { border-bottom: none; }
    .item-remove { background: none; border: none; color: var(--c-textsub); cursor: pointer; font-size: 14px; }
    .modal-actions { display: flex; gap: var(--space-3); justify-content: flex-end; margin-top: var(--space-6); padding-top: var(--space-4); border-top: 1px solid rgba(255, 255, 255, 0.08); }
    .btn-primary { padding: 10px 20px; background: var(--grad-cta); color: #000; border: none; border-radius: var(--radius-card); font-family: var(--font-label); font-weight: var(--fw-label); font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.08em; cursor: pointer; transition: box-shadow var(--dur-fast) var(--ease-std); }
    .btn-primary:hover { box-shadow: var(--glow-lime); }
    .btn-secondary { padding: 10px 20px; background: transparent; color: var(--c-textsub); border: 1px solid rgba(255,255,255,0.15); border-radius: var(--radius-card); font-family: var(--font-label); font-weight: var(--fw-label); font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.08em; cursor: pointer; transition: border-color var(--dur-fast) var(--ease-std), color var(--dur-fast) var(--ease-std); }
    .btn-secondary:hover { border-color: var(--c-lime); color: var(--c-lime); }


  </style>
</head>
<body>

  <AdminHeader badge="Atletas" backHref="/admin" />

  <!-- TITLE -->
  <div class="title-row">
    <div class="eyebrow">Módulo 2 — Acompanhamento do Atleta</div>
    <h1 class="page-title">Gestão &amp; <b>Atletas</b></h1>
    <div class="action-btns">
      <button class="btn-action-outline" onclick="atualizarLista()"><span data-lucide="refresh-cw"></span> Atualizar</button>
      <button class="btn-action-filled" onclick="exportarCSV()"><span data-lucide="download"></span> Exportar CSV</button>
    </div>
  </div>

  <!-- STATS -->
  <div class="stats-row">
    <div class="stat-card stat-card--total">
      <div class="stat-card__label">Total de Atletas</div>
      <div class="stat-card__value" id="kpi-total">12</div>
    </div>
    <div class="stat-card">
      <div class="stat-card__label">Recém-promovido</div>
      <div class="stat-card__value" id="kpi-recem-promovido" style="color: var(--c-status-progress);">—</div>
    </div>
    <div class="stat-card">
      <div class="stat-card__label">Check-in no Prazo</div>
      <div class="stat-card__value" id="kpi-no-prazo" style="color: var(--c-lime);">—</div>
    </div>
    <div class="stat-card">
      <div class="stat-card__label">Acima de 7 Dias</div>
      <div class="stat-card__value" id="kpi-acima-7-dias" style="color: var(--c-status-warning);">—</div>
    </div>
    <div class="stat-card">
      <div class="stat-card__label">Acima de 14 Dias</div>
      <div class="stat-card__value" id="kpi-acima-14-dias" style="color: var(--c-status-rejected);">—</div>
    </div>
  </div>

  <!-- TOOLBAR -->
  <div class="toolbar">
    <div class="search">
      <i data-lucide="search"></i>
      <input type="text" id="search-input" placeholder="Buscar por nome ou e-mail…" />
    </div>
    <select class="filter-select" id="filter-status">
      <option value="">Todos</option>
      <option value="recem-promovido">Recém-promovido</option>
      <option value="no-prazo">Check-in no Prazo</option>
      <option value="acima-7-dias">Acima de 7 Dias</option>
      <option value="acima-14-dias">Acima de 14 Dias</option>
    </select>
    <button type="button" id="filter-dropdown-btn" class="filter-select" aria-haspopup="listbox" aria-label="Filtrar por status">
      <span id="filter-dropdown-label">Todos</span>
      <svg width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true"><path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
    <span class="toolbar-count" id="athletes-count">—</span>
  </div>

  <!-- TABLE -->
  <div class="table-wrap" id="athletes-table-wrap">
    <table id="athletes-table">
      <thead>
        <tr>
          <th style="width: 15%; text-align: left;"><button class="sort-btn" onclick="sortAthletes('date')">DATA <span class="sort-arrow">↕</span></button></th>
          <th style="width: 25%; text-align: left;"><button class="sort-btn" onclick="sortAthletes('name')">NOME <span class="sort-arrow">↕</span></button></th>
          <th style="width: 15%; text-align: left;"><button class="sort-btn" onclick="sortAthletes('cycle')">DIA DO CICLO <span class="sort-arrow">↕</span></button></th>
          <th style="width: 18%; text-align: left;">STATUS</th>
          <th style="width: 12%; text-align: left;">PROGRESSO</th>
          <th style="width: 15%; text-align: left;">AÇÕES</th>
        </tr>
      </thead>
      <tbody id="athletes-tbody"></tbody>
    </table>
  </div>

  <!-- DRAWER -->
  <div id="athlete-drawer" style="display: none;">
    <div class="drawer-panel">
      <span class="drawer-handle"></span>
      <div class="drawer-header">
        <span class="drawer-title">Atleta <span id="drawer-athlete-name"></span></span>
        <span class="drawer-external-label" id="drawer-external-label"></span>
        <!-- Hamburger (mobile) / X (desktop) -->
        <div class="drawer-hamburger-wrap" id="drawer-hamburger-wrap">
          <button class="drawer-hamburger-btn" id="drawer-hamburger-btn" onclick="toggleDrawerMenu()" aria-label="Menu de navegação">
            <i data-lucide="menu"></i>
          </button>
        </div>
        <button class="drawer-close" id="drawer-close" aria-label="Fechar gaveta">✕</button>
      </div>

      <!-- DRAWER BODY: sidenav + content -->
      <div class="drawer-body">
        <nav class="drawer-sidenav" id="drawer-sidenav">
          <button class="sidenav-item active" data-tab="overview" onclick="selectSidenavTab(event,'overview')"><span class="sidenav-abbr">VG</span><span class="sidenav-label">Visão Geral</span></button>
          <button class="sidenav-item" data-tab="checkin" onclick="selectSidenavTab(event,'checkin')"><span class="sidenav-abbr">CI</span><span class="sidenav-label">Check-in</span></button>
          <button class="sidenav-item" data-tab="avaliacao" onclick="selectSidenavTab(event,'avaliacao')"><span class="sidenav-abbr">AV</span><span class="sidenav-label">Avaliação</span></button>
          <button class="sidenav-item" data-tab="evolution" onclick="selectSidenavTab(event,'evolution')"><span class="sidenav-abbr">EV</span><span class="sidenav-label">Evolução</span></button>
          <button class="sidenav-item" data-tab="training" onclick="selectSidenavTab(event,'training')"><span class="sidenav-abbr">TR</span><span class="sidenav-label">Treino</span></button>
          <button class="sidenav-item" data-tab="nutrition" onclick="selectSidenavTab(event,'nutrition')"><span class="sidenav-abbr">NU</span><span class="sidenav-label">Nutricional</span></button>
        </nav>
        <div class="drawer-content-wrap">

      <!-- TAB 1: OVERVIEW -->
      <div class="tab-content active" id="tab-overview">
        <!-- PERFIL DO ATLETA -->
        <div class="drawer-section">
          <div class="drawer-section-title">Perfil do Atleta</div>
          
          <div id="athlete-flags" style="display: flex; flex-direction: column; gap: 8px; margin-bottom: 16px;"></div>

          <div class="drawer-row">
            <span class="drawer-label">Início do Programa</span>
            <span class="drawer-value" id="profile-start">—</span>
          </div>
          <div class="drawer-row">
            <span class="drawer-label">Situação</span>
            <span class="drawer-value" id="profile-situacao">—</span>
          </div>
          <div class="drawer-row">
            <span class="drawer-label">Idade</span>
            <span class="drawer-value" id="profile-age">—</span>
          </div>
          <div class="drawer-row">
            <span class="drawer-label">Gênero</span>
            <span class="drawer-value" id="profile-genero">—</span>
          </div>
          <div class="drawer-row">
            <span class="drawer-label">Altura</span>
            <span class="drawer-value" id="profile-height">—</span>
          </div>
          <div class="drawer-row">
            <span class="drawer-label">Tempo de Atividade</span>
            <span class="drawer-value" id="profile-years">—</span>
          </div>
          <div class="drawer-row">
            <span class="drawer-label">Frequência Semanal</span>
            <span class="drawer-value" id="profile-freq">—</span>
          </div>
          <div class="drawer-row">
            <span class="drawer-label">Tempo Médio Treino/Dia</span>
            <span class="drawer-value" id="profile-duration">—</span>
          </div>
          <div class="drawer-row">
            <span class="drawer-label">Objetivo</span>
            <span class="drawer-value" id="profile-goal">—</span>
          </div>
          <div class="drawer-row" style="padding-top: 14px; border-bottom: none;">
            <a href="#" target="_blank" style="font-family: var(--font-label); font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; color: var(--c-lime); text-decoration: none; transition: opacity var(--transition-base);" onmouseover="this.style.opacity='0.7'" onmouseout="this.style.opacity='1'">
              📄 Ver Avaliação Preliminar →
            </a>
          </div>
        </div>

