      if (!a[key]) a[key] = { status: 'rascunho', publishedAt: null, hasUnpublishedChanges: false };
      return a[key];
    }
    function renderPubHeader(kind) {
      const p = getPlanRef(kind);
      if (!p) return;
      const pfx = kind === 'training' ? 'tr' : 'nu';
      const badge = document.getElementById(pfx + '-pubbadge');
      const ts = document.getElementById(pfx + '-pubts');
      const btn = document.getElementById(pfx + '-pubbtn');
      if (!badge || !ts || !btn) return;
      if (p.status === 'publicado' && !p.hasUnpublishedChanges) {
        badge.className = 'pub-badge pub';
        badge.innerHTML = '<span class="pub-dot live"></span>Publicado';
        ts.textContent = 'Publicado em ' + p.publishedAt;
        btn.className = 'btn-protocol';
        btn.innerHTML = '<span data-lucide="upload"></span> Publicar protocolo';
      } else if (p.status === 'publicado' && p.hasUnpublishedChanges) {
        badge.className = 'pub-badge unpub';
        badge.innerHTML = '<span class="pub-dot"></span>Alterações não publicadas';
        ts.textContent = 'Versão ativa: ' + p.publishedAt;
        btn.className = 'btn-protocol unpub';
        btn.innerHTML = '<span data-lucide="upload"></span> Republicar protocolo';
      } else {
        badge.className = 'pub-badge draft';
        badge.innerHTML = '<span class="pub-dot"></span>Rascunho';
        ts.textContent = 'Nunca publicado';
        btn.className = 'btn-protocol';
        btn.innerHTML = '<span data-lucide="upload"></span> Publicar protocolo';
      }
