    .evo-ed-alert-acts { display: flex; align-items: center; gap: 6px; margin-top: 9px; justify-content: flex-end; }
    .evo-aact { font-family: var(--font-label); font-size: 0.54rem; font-weight: var(--fw-label); text-transform: uppercase; letter-spacing: 0.08em; background: none; border: 1px solid rgba(255, 255, 255, 0.14); border-radius: var(--radius-card); color: var(--c-textsub); padding: 4px 10px; cursor: pointer; transition: color 120ms ease, border-color 120ms ease; }
