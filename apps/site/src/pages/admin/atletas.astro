---
export const prerender = false;
import '@fontsource/bebas-neue';
import '@fontsource/raleway/600.css';
import '@fontsource/raleway/700.css';
import '@fontsource/raleway/800.css';
import '@fontsource/montserrat/400.css';
import '@fontsource/montserrat/500.css';
import '@fontsource/montserrat/600.css';
import '@fontsource/montserrat/700.css';
import '../../styles/tokens.css';
import '../../styles/global.css';
import AdminHeader from '../../components/AdminHeader.astro';
---
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ELITE 90 PRO - Acompanhamento do Atleta</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="icon" href="/favicon.ico" />
  <script type="module" src="https://cdn.jsdelivr.net/npm/img-comparison-slider@8/dist/index.js"></script>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/img-comparison-slider@8/dist/styles.css" />
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
  <style is:global>

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { background: var(--c-black); color: var(--c-textbody); font-family: var(--font-body); font-size: var(--fs-body-md); -webkit-font-smoothing: antialiased; }
    
    /* ── SCROLLBAR STYLING (DS Pattern) ── */
    ::-webkit-scrollbar { width: 6px; height: 6px; }
    ::-webkit-scrollbar-track { background: var(--c-darkbg); }
    ::-webkit-scrollbar-thumb { background: rgba(166, 195, 0, 0.50); border-radius: 3px; }
    ::-webkit-scrollbar-thumb:hover { background: var(--c-lime); }
    * { scrollbar-color: rgba(166, 195, 0, 0.50) var(--c-darkbg); scrollbar-width: thin; }

    /* ── TITLE ── */
    .title-row { position: relative; padding: var(--space-4) var(--space-5) var(--space-6); }
    .eyebrow { font-family: var(--font-label); font-weight: var(--fw-label); font-size: var(--fs-label); letter-spacing: var(--tracking-label); text-transform: uppercase; color: var(--c-textsub); margin-bottom: var(--space-3); }
    .page-title { font-family: var(--font-display); font-size: var(--fs-display-lg); line-height: var(--lh-display); letter-spacing: var(--tracking-display); color: var(--c-white); text-transform: uppercase; }
    .page-title b { color: var(--c-lime); }
    .action-btns { display: flex; gap: var(--space-3); flex-wrap: wrap; position: absolute; top: var(--space-4); right: var(--space-5); margin-top: 0; }
    .btn-action-outline { padding: 10px 20px; border: 1.5px solid var(--c-lime); background: transparent; color: var(--c-lime); border-radius: var(--radius-card); font-family: var(--font-label); font-size: var(--fs-label); font-weight: var(--fw-label); text-transform: uppercase; letter-spacing: var(--tracking-cta); cursor: pointer; display: inline-flex; align-items: center; gap: 8px; transition: background 150ms ease; }
    .btn-action-outline:hover { background: rgba(166, 195, 0, 0.12); }
    .btn-action-outline [data-lucide] { width: 14px; height: 14px; }
    .btn-action-filled { padding: 10px 20px; border: 1.5px solid var(--c-lime); background: var(--c-lime); color: #0D0D0D; border-radius: var(--radius-card); font-family: var(--font-label); font-size: var(--fs-label); font-weight: var(--fw-label); text-transform: uppercase; letter-spacing: var(--tracking-cta); cursor: pointer; display: inline-flex; align-items: center; gap: 8px; transition: opacity 150ms ease; }
    .btn-action-filled:hover { opacity: 0.88; }
    .btn-action-filled [data-lucide] { width: 14px; height: 14px; }

    /* ── STATS ── */
    .stats-row { display: flex; gap: var(--space-4); margin-bottom: var(--space-6); padding: 0 var(--space-5); flex-wrap: wrap; }
    .stat-card { background: var(--c-darkbg); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: var(--radius-card); padding: var(--space-4) var(--space-5); flex: 1; min-width: 140px; }
    .stat-card--total { border-left: 3px solid var(--c-lime); background: linear-gradient(135deg, rgba(166, 195, 0, 0.12) 0%, var(--c-darkbg) 60%); }
    .stat-card__label { font-family: var(--font-label); font-size: var(--fs-label); font-weight: var(--fw-label); text-transform: uppercase; letter-spacing: var(--tracking-cta); color: var(--c-textsub); margin-bottom: var(--space-2); }
    .stat-card--total .stat-card__label { color: var(--c-lime); }
    .stat-card__value { font-family: var(--font-display); font-size: var(--fs-display-md); color: var(--c-lime); line-height: 1; }

    /* ── TOOLBAR ── */
    .toolbar { display: flex; align-items: center; gap: var(--space-3); padding: 0 var(--space-5) var(--space-4); flex-wrap: wrap; }
    .search { position: relative; flex: 1; min-width: 240px; max-width: 480px; }
    .search [data-lucide] { position: absolute; left: var(--space-3); top: 50%; transform: translateY(-50%); color: var(--c-textsub); }
    .search input { width: 100%; background: var(--c-darkbg); border: 1px solid rgba(255, 255, 255, 0.14); border-radius: var(--radius-card); color: var(--c-white); padding: var(--space-3) var(--space-3) var(--space-3) var(--space-5); font-family: var(--font-body); font-size: var(--fs-body-md); }
    .search input:focus { outline: none; border-color: var(--c-lime); box-shadow: 0 0 16px rgba(166, 195, 0, 0.20); }
    .filter-select { background: var(--c-darkbg); border: 1px solid rgba(255, 255, 255, 0.14); color: var(--c-textbody); padding: var(--space-3); border-radius: var(--radius-card); font-family: var(--font-body); font-size: var(--fs-body-md); cursor: pointer; }
    /* ── Dropdown de status customizado do DS (portado de fichas.astro) ── */
    #filter-status { display: none; }
    #filter-dropdown-btn { display: inline-flex; align-items: center; justify-content: space-between; gap: 10px; min-width: 200px; }
    #filter-dropdown-btn svg { flex-shrink: 0; color: var(--c-textsub); }
    .status-dropdown-menu {
      position: fixed;
      z-index: 500;
      background: var(--c-darkbg);
      border: 1px solid rgba(255, 255, 255, 0.14);
      border-radius: var(--radius-card);
      list-style: none;
      padding: 4px 0;
      min-width: 200px;
      box-shadow: 0 8px 32px rgba(0,0,0,0.85);
      overflow: hidden;
    }
    .status-dropdown-menu li button {
      width: 100%;
      padding: 12px 16px;
      text-align: left;
      background: transparent;
      border: none;
      font-family: var(--font-label);
      font-size: 0.65rem;
      font-weight: var(--fw-label);
      text-transform: uppercase;
      letter-spacing: 0.12em;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 8px;
      transition: background 150ms ease;
    }
    .status-dropdown-menu li button::before {
      content: "";
      width: 6px; height: 6px;
      border-radius: 50%;
      background: currentColor;
      flex-shrink: 0;
    }
    .status-dropdown-menu li button:hover { background: rgba(255,255,255,0.06); }
    .status-dropdown-menu li button[data-value=""]                { color: var(--c-textsub); }
    .status-dropdown-menu li button[data-value="active"]          { color: var(--c-status-active); }
    .status-dropdown-menu li button[data-value="checkin_sent"]    { color: var(--c-status-checkin); }
    .status-dropdown-menu li button[data-value="awaiting_checkin"]{ color: var(--c-status-pending); }
    .toolbar-count { font-family: var(--font-label); font-weight: var(--fw-label); font-size: var(--fs-label); letter-spacing: var(--tracking-cta); text-transform: uppercase; color: var(--c-textsub); margin-left: auto; }

    /* ── TABLE (PADRÃO M1) ── */
    .table-wrap { overflow-x: auto; padding: 0 var(--space-5) var(--space-8); }
    table { width: 100%; border-collapse: collapse; }
    th { font-family: var(--font-label); font-size: var(--fs-label); font-weight: var(--fw-label); text-transform: uppercase; letter-spacing: var(--tracking-cta); color: var(--c-lime); text-align: left; padding: var(--space-3) var(--space-4); border-bottom: 1px solid rgba(255, 255, 255, 0.08); }
    .athlete-row { transition: background var(--dur-med) var(--ease-std); }
    .athlete-row:hover td { background: rgba(255,255,255,.03); }
    .athlete-row td { padding: var(--space-4); border-bottom: 1px solid rgba(255, 255, 255, 0.08); vertical-align: middle; }

    /* Sort Button */
    .sort-btn { background: none; border: none; color: var(--c-lime); font-family: var(--font-label); font-size: var(--fs-label); text-transform: uppercase; letter-spacing: var(--tracking-label); cursor: pointer; padding: 0; display: flex; align-items: center; gap: var(--space-2); transition: all var(--dur-fast) var(--ease-std); text-align: left; }
    .sort-btn:hover { opacity: 0.8; }
    .sort-arrow { font-size: 0.75rem; color: var(--c-textsub); }

    /* Coluna DATA */
    .td--date { width: 15%; color: var(--c-textsub); font-size: var(--fs-body-sm); text-align: left; }

    /* Coluna NOME (com e-mail abaixo) */
    .td--name-cell { width: 25%; text-align: left; }
    .td--name { display: block; font-weight: var(--fw-body-bold); color: var(--c-white); font-size: var(--fs-body-md); margin-bottom: var(--space-1); }
    .td--email { display: block; font-size: var(--fs-body-sm); color: var(--c-textsub); }

    /* Coluna DIA DO CICLO */
    .td--cycle { width: 15%; text-align: left; font-size: var(--fs-body-sm); color: var(--c-white); }

    /* Status Badge */
    .status-badge { display: inline-block; padding: var(--space-2) var(--space-3); border-radius: var(--radius-pill); font-size: 0.65rem; font-weight: var(--fw-label); text-transform: uppercase; letter-spacing: var(--tracking-label); }
    .status-badge.active { background: rgba(166, 195, 0, 0.12); color: var(--c-status-active); border: 1px solid var(--c-status-active); }
    .status-badge.checkin_sent { background: rgba(230, 126, 34, 0.12); color: var(--c-status-checkin); border: 1px solid var(--c-status-checkin); }
    .status-badge.awaiting_checkin { background: rgba(241, 196, 15, 0.12); color: var(--c-status-pending); border: 1px solid var(--c-status-pending); }

    /* Coluna STATUS */
    .td--status { width: 18%; text-align: left; }

    /* Coluna PROGRESSO */
    .td--progress { width: 20%; }
    .progress-bar { width: 100%; height: 6px; background: rgba(255,255,255,0.1); border-radius: 3px; overflow: hidden; }
    .progress-fill { height: 100%; background: var(--c-lime); border-radius: 3px; }

    /* Coluna AÇÕES */
    .td--actions { width: 18%; text-align: right; }
    .act { display: inline-flex; align-items: center; gap: var(--space-2); background: none; border: none; cursor: pointer; font-family: var(--font-label); font-weight: var(--fw-label); font-size: var(--fs-label); letter-spacing: var(--tracking-cta); text-transform: uppercase; color: var(--c-textsub); transition: color var(--dur-med) var(--ease-std); }
    .act:hover { color: var(--c-lime); }
    .act [data-lucide] { width: 14px; height: 14px; }

    /* ── DRAWER ── */
    #athlete-drawer { position: fixed; inset: 0; z-index: 100; display: flex; align-items: flex-start; justify-content: flex-end; background: rgba(0,0,0,0); transition: background var(--dur-med) var(--ease-std); }
    #athlete-drawer.open { background: rgba(0,0,0,0.6); }
    #athlete-drawer[hidden] { display: none !important; }
    .drawer-panel { background: var(--c-darkbg); width: min(800px, 96vw); height: 100%; overflow: hidden; border-left: 3px solid var(--c-lime); box-shadow: var(--shadow-lg); display: flex; flex-direction: column; transform: translateX(100%); transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1); }
    #athlete-drawer.open .drawer-panel { transform: translateX(0); }
    .drawer-header { display: flex; justify-content: space-between; align-items: center; padding: var(--space-6) var(--space-6) var(--space-4); border-bottom: 1px solid rgba(255, 255, 255, 0.08); flex-shrink: 0; }
    .drawer-body { display: flex; flex-direction: row; flex: 1; overflow: hidden; }
    .drawer-sidenav { width: 170px; flex-shrink: 0; background: rgba(0,0,0,0.25); border-right: 1px solid rgba(255, 255, 255, 0.08); display: flex; flex-direction: column; transition: width 0.28s cubic-bezier(0.16,1,0.3,1); overflow: hidden; }
    .drawer-sidenav.collapsed { width: 52px; }
    .sidenav-item { display: flex; align-items: center; gap: 12px; padding: 16px 0 16px 14px; background: none; border: none; border-left: 3px solid transparent; color: var(--c-textsub); font-family: var(--font-label); font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; cursor: pointer; width: 100%; text-align: left; white-space: nowrap; transition: color 140ms, border-color 140ms; }
    .sidenav-item:hover { color: var(--c-textbody); }
    .sidenav-item.active { color: var(--c-lime); border-left-color: var(--c-lime); }
    .sidenav-abbr { font-family: var(--font-display); font-size: 1.1rem; flex-shrink: 0; width: 28px; text-align: center; }
    .sidenav-label { opacity: 1; transition: opacity 0.15s; }
    .drawer-sidenav.collapsed .sidenav-label { opacity: 0; }
    .drawer-content-wrap { flex: 1; overflow-y: auto; padding: var(--space-5) var(--space-6) var(--space-8); scrollbar-width: thin; scrollbar-color: rgba(166,195,0,0.5) transparent; position: relative; }
    .drawer-content-wrap::-webkit-scrollbar { width: 4px; }
    .drawer-content-wrap::-webkit-scrollbar-thumb { background: rgba(166,195,0,0.5); border-radius: 2px; }
    .drawer-title { font-family: var(--font-display); font-size: var(--fs-display-md); letter-spacing: var(--tracking-display); color: var(--c-white); text-transform: uppercase; }
    .drawer-title span { color: var(--c-lime); }
    .drawer-close { background: none; border: none; color: var(--c-textsub); font-size: 20px; cursor: pointer; line-height: 1; transition: color var(--dur-med) var(--ease-std); }
    .drawer-close:hover { color: var(--c-lime); }

    /* ── TABS ── */
    .tabs-nav { display: flex; gap: var(--space-2); margin-bottom: var(--space-6); border-bottom: 1px solid rgba(255, 255, 255, 0.08); overflow-x: auto; }
    .tab-button { background: none; border: none; cursor: pointer; padding: var(--space-3) var(--space-3); font-family: var(--font-label); font-size: 0.7rem; font-weight: var(--fw-label); text-transform: uppercase; letter-spacing: 0.06em; color: var(--c-textsub); border-bottom: 2px solid transparent; transition: color var(--dur-med) var(--ease-std), border-color var(--dur-med) var(--ease-std); white-space: nowrap; }
    .tab-button.active { color: var(--c-lime); border-bottom-color: var(--c-lime); }
    .tab-button:hover { color: var(--c-textbody); }
    .tab-content { display: none; }
    .tab-content.active { display: block; }

    /* ── DRAWER CONTENT ── */
    .drawer-section { margin-bottom: var(--space-6); margin-top: var(--space-6); }
    .drawer-section:first-child { margin-top: 0; }
    .drawer-section-title { font-family: var(--font-label); font-size: var(--fs-body-sm); font-weight: var(--fw-label); text-transform: uppercase; letter-spacing: var(--tracking-label); color: var(--c-lime); margin-bottom: var(--space-4); }
    .drawer-row { display: flex; justify-content: space-between; align-items: center; padding: var(--space-3) 0; border-bottom: 1px solid rgba(255,255,255,0.05); }
    .drawer-label { font-size: var(--fs-body-md); color: var(--c-textsub); }
    .drawer-value { font-size: var(--fs-body-md); color: var(--c-white); font-weight: var(--fw-body-bold); }

    /* ── CHECK-IN: SEMANA + VARIAÇÕES ── */
    .cycle-week-bar { margin-bottom: var(--space-6); }
    .cycle-week-label { font-family: var(--font-label); font-size: var(--fs-label); text-transform: uppercase; letter-spacing: var(--tracking-label); color: var(--c-textsub); margin-bottom: var(--space-2); }
    .cycle-week-track { position: relative; height: 4px; background: rgba(255, 255, 255, 0.08); border-radius: 2px; }
    .cycle-week-fill { height: 100%; background: var(--c-lime); border-radius: 2px; transition: width var(--dur-med) var(--ease-out); }
    .cycle-week-dot { position: absolute; top: 50%; transform: translate(-50%, -50%); width: 10px; height: 10px; border-radius: 50%; background: var(--c-lime); border: 2px solid var(--c-black); }
    .cycle-week-num { font-family: var(--font-display); font-size: var(--fs-display-md); color: var(--c-lime); letter-spacing: var(--tracking-display); line-height: 1; margin-top: var(--space-2); }
    .cycle-week-total { font-family: var(--font-label); font-size: var(--fs-label); color: var(--c-textsub); }

    .metric-delta { display: flex; align-items: center; gap: 6px; font-family: var(--font-label); font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; margin-top: 4px; }
    .metric-delta.positive { color: var(--c-lime); }
    .metric-delta.negative { color: var(--c-status-checkin); }
    .metric-delta.neutral  { color: var(--c-textsub); }


    .checkin-container { display: flex; flex-direction: column; gap: var(--space-6); padding: 0; width: 100%; min-width: 0; }

    /* Seção M1-style: título lime + linha separadora */
    .m1-section { margin-bottom: var(--space-8); }
    .m1-section-title { font-family: var(--font-label); font-size: var(--fs-body-sm); font-weight: var(--fw-label); text-transform: uppercase; letter-spacing: var(--tracking-label); color: var(--c-lime); margin-bottom: var(--space-3); }
    .m1-section-line { display: none; }

    /* Campo rótulo/valor M1-style */
    .m1-field { margin-bottom: var(--space-5); }
    .m1-field-label { font-family: var(--font-label); font-size: 0.6875rem; font-weight: var(--fw-label); text-transform: uppercase; letter-spacing: var(--tracking-label); color: var(--c-textsub); margin-bottom: var(--space-2); }
    .m1-field-value { font-family: var(--font-body); font-size: var(--fs-body-md); color: var(--c-white); line-height: var(--lh-body); }

    /* Botão outlined full-width M1-style */
    .m1-btn-outline { display: block; width: 100%; padding: 10px 20px; background: transparent; border: 1px solid rgba(166, 195, 0, 0.3); border-radius: var(--radius-card); color: var(--c-lime); font-family: var(--font-label); font-size: 0.7rem; font-weight: var(--fw-label); text-transform: uppercase; letter-spacing: 0.08em; cursor: pointer; text-align: center; transition: background var(--dur-fast) var(--ease-std), border-color var(--dur-fast) var(--ease-std); margin-bottom: var(--space-3); }
    .m1-btn-outline:hover { background: rgba(166, 195, 0, 0.05); border-color: var(--c-lime); }

    .metric-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-5) var(--space-5); margin-bottom: var(--space-6); }
    .metric-input { display: flex; flex-direction: column; justify-content: space-between; gap: var(--space-1); }
    .metric-label { font-family: var(--font-label); font-size: 0.6875rem; font-weight: var(--fw-label); text-transform: uppercase; letter-spacing: var(--tracking-label); color: var(--c-textsub); min-height: 2em; }
    .metric-value-wrap { display: flex; align-items: baseline; gap: 4px; border-bottom: 1px solid rgba(255, 255, 255, 0.14); padding-bottom: var(--space-1); }
    .metric-value { background: transparent; border: none; color: var(--c-white); font-family: var(--font-body); font-size: var(--fs-body-md); font-weight: var(--fw-body-bold); display: inline; padding: var(--space-3) 0; }
    .metric-unit { font-family: var(--font-body); font-size: var(--fs-body-md); font-weight: var(--fw-body-bold); color: var(--c-textsub); white-space: nowrap; }
    .checkin-textarea { width: 100%; padding: var(--space-4); background: transparent; border: none; color: var(--c-textbody); font-family: var(--font-body);
    font-size: var(--fs-body-md); line-height: var(--lh-body); min-height: 100px; resize: none; cursor: not-allowed; opacity: 0.9; max-width: 100%; }
    .photos-grid { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-bottom: var(--space-6); }
    .photo-thumb { width: 144px; height: 144px; flex-shrink: 0; border-radius: var(--radius-card); background: var(--c-darkbg); cursor: pointer; overflow: hidden; display: block; transition: opacity var(--dur-med) var(--ease-std); background-size: cover; background-position: center center; background-repeat: no-repeat; }
    .photo-thumb:hover { opacity: 0.8; }
    .photos-helper { font-size: var(--fs-body-sm); color: var(--c-textsub); line-height: var(--lh-body); margin-bottom: var(--space-4); }
    .photos-empty { font-size: var(--fs-body-sm); color: var(--c-textsub); font-style: italic; }

    /* ── TAB: CHECK-IN — CAPTURA PASSIVA (DIREITA) ── */
    .capture-panel { display: flex; flex-direction: column; gap: var(--space-6); padding: 0; align-items: center; }
    .recorder-btn { width: 56px; height: 56px; border-radius: 50%; background: var(--grad-cta); border: none; cursor: pointer; display: flex; align-items: center; justify-content: center; color: #000; font-size: 20px; transition: box-shadow var(--dur-med) var(--ease-std); align-self: center; margin-bottom: var(--space-4); }
    .recorder-btn:hover { box-shadow: 0 0 24px rgba(166, 195, 0, 0.50); }
    .recorder-btn.recording { background: var(--c-status-rejected); animation: pulse-red 1s infinite; }
    @keyframes pulse-red { 0%, 100% { opacity: 1; } 50% { opacity: 0.7; } }
    .recording-indicator { text-align: center; font-family: var(--font-label); font-size: var(--fs-body-sm); color: var(--c-textsub); margin-bottom: var(--space-3); }
    .recording-time { font-family: var(--font-display); font-size: var(--fs-display-md); color: var(--c-status-rejected); margin-top: var(--space-2); }
    .recorder-actions { display: flex; gap: var(--space-3); justify-content: center; margin-bottom: var(--space-4); }
    .btn-small { padding: 10px 20px; background: transparent; border: 1px solid rgba(166, 195, 0, 0.3); color: var(--c-lime); border-radius: var(--radius-card); font-family: var(--font-label); font-size: 0.7rem; font-weight: var(--fw-label); text-transform: uppercase; cursor: pointer; transition: background var(--dur-fast) var(--ease-std), border-color var(--dur-fast) var(--ease-std); }
    .btn-small:hover { background: rgba(166, 195, 0, 0.05); border-color: var(--c-lime); }
    .btn-small.discard { border-color: rgba(153,153,153,0.3); color: var(--c-textsub); }
    .btn-small.discard:hover { background: rgba(153,153,153,0.05); border-color: var(--c-textsub); }
    .audio-preview { background: var(--c-black); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: var(--radius-card); padding: var(--space-4); margin-bottom: var(--space-4); }
    .audio-preview audio { width: 100%; height: 32px; }
    .note-textarea { width: 100%; padding: var(--space-4); background: var(--c-black); border: 1px solid rgba(255, 255, 255, 0.14); border-radius: var(--radius-card); color: var(--c-white); font-family: var(--font-body); font-size: var(--fs-body-sm); min-height: 80px; resize: vertical; margin-bottom: var(--space-4); }
    .note-textarea:focus { outline: none; border-color: var(--c-lime); box-shadow: 0 0 0 2px rgba(166, 195, 0, 0.12); }
    .ingestoes-list { background: var(--c-black); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: var(--radius-card); padding: var(--space-4); max-height: 150px; overflow-y: auto; }
    .ingestao-item { display: flex; align-items: center; gap: var(--space-3); padding: var(--space-3) 0; border-bottom: 1px solid rgba(255,255,255,0.05); font-size: var(--fs-body-sm); color: var(--c-textbody); }
    .ingestao-item:last-child { border-bottom: none; }
    .ingestao-icon { color: var(--c-lime); }
    .ingestao-remove { background: none; border: none; color: var(--c-textsub); cursor: pointer; margin-left: auto; font-size: 14px; }

    /* ── TAB: TREINO/NUTRIÇÃO ── */
    .day-card { background: var(--c-surface-2); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: var(--radius-card); padding: var(--space-5); margin-bottom: var(--space-5); }
    .day-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--space-3); }
    .day-title { font-family: var(--font-label); font-weight: var(--fw-label); font-size: var(--fs-body-sm); text-transform: uppercase; color: var(--c-lime); }
    .exercise-item { display: flex; justify-content: space-between; align-items: flex-start; padding: var(--space-3) 0; border-bottom: 1px solid rgba(255,255,255,0.05); font-size: var(--fs-body-sm); }
    .exercise-item:last-child { border-bottom: none; }
    .exercise-name { font-weight: var(--fw-body-bold); color: var(--c-white); }
    .exercise-meta { font-size: 11px; color: var(--c-textsub); margin-top: var(--space-1); }

    /* ── WKE: WORKOUT EDITOR (Aba 4 — Treino) ── */
    .wke-daytabs { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-bottom: var(--space-5); }
    .wke-daytab { padding: 8px 16px; border-radius: var(--radius-pill); border: 1px solid rgba(255, 255, 255, 0.14); background: transparent; color: var(--c-textsub); font-family: var(--font-label); font-size: var(--fs-label); font-weight: var(--fw-label); text-transform: uppercase; letter-spacing: var(--tracking-cta); cursor: pointer; transition: color 150ms ease, border-color 150ms ease, background 150ms ease; white-space: nowrap; }
    .wke-daytab:hover { border-color: rgba(166, 195, 0, 0.50); color: var(--c-white); }
    .wke-daytab.active { background: var(--c-lime); border-color: var(--c-lime); color: #0D0D0D; }
    .wke-daytab.add { color: var(--c-lime); border-style: dashed; border-color: rgba(166, 195, 0, 0.50); }
    .wke-daytab.add:hover { background: rgba(166, 195, 0, 0.12); color: var(--c-lime); border-color: var(--c-lime); }

    .wke-stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-2); margin-bottom: var(--space-5); }
    .wke-stat { background: var(--c-darkbg); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: var(--radius-card); padding: var(--space-3); }
    .wke-stat-value { font-family: var(--font-display); font-size: 1.75rem; color: var(--c-white); line-height: 1; letter-spacing: 0.01em; }
    .wke-stat-unit { font-size: 0.85rem; color: var(--c-textsub); margin-left: 2px; }
    .wke-stat-label { font-family: var(--font-label); font-size: 10px; color: var(--c-textsub); text-transform: uppercase; letter-spacing: var(--tracking-label); margin-top: 6px; }
    .wke-stat-sublabel { font-family: var(--font-body); font-size: 9.5px; color: var(--c-lime); margin-top: 3px; }

    .wke-exercise { background: var(--c-surface-2); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: var(--radius-card); margin-bottom: var(--space-3); overflow: hidden; transition: opacity 150ms ease, box-shadow 150ms ease, border-color 150ms ease; }
    .wke-exercise.dragging { opacity: 0.6; box-shadow: var(--shadow-md); border-color: rgba(166, 195, 0, 0.50); }
    /* WKE-02: Drag-and-Drop */
    body.wke-dragging, body.wke-dragging * { user-select: none !important; }
    body.wke-dragging .wke-ex-drag { cursor: grabbing !important; }
    .wke-drag-ghost { position: fixed; z-index: 420; pointer-events: none; background: var(--c-surface-2); border: 1px solid var(--c-lime); border-radius: var(--radius-pill); padding: 7px 14px 7px 10px; box-shadow: var(--shadow-lg); font-family: var(--font-label); font-size: 11px; font-weight: var(--fw-label); text-transform: uppercase; letter-spacing: 0.04em; color: var(--c-white); display: flex; align-items: center; gap: 8px; white-space: nowrap; opacity: 0.95; }
    .wke-drag-ghost-icon { color: var(--c-lime); font-size: 13px; }
    .wke-drag-placeholder { height: 2px; background: var(--c-lime); border-radius: 2px; margin: 2px var(--space-3); box-shadow: 0 0 6px rgba(166,195,0,0.5); }
    .wke-exercise[tabindex]:focus-visible { outline: 1px solid rgba(166, 195, 0, 0.50); outline-offset: 2px; }
    /* WKE-02 / P-05: animação FLIP 150ms ao reordenar exercícios */
    .wke-exercise.wke-flip-playing { transition: transform 150ms ease-out; }
    @media (prefers-reduced-motion: reduce) {
      .wke-exercise.wke-flip-playing { transition: none; }
    }
    .wke-ex-header { display: flex; align-items: flex-start; gap: var(--space-2); padding: var(--space-3) var(--space-3) var(--space-2); }
    .wke-ex-drag { color: var(--c-textsub); cursor: grab; font-size: 15px; line-height: 1.5; user-select: none; flex-shrink: 0; padding-top: 1px; }
    .wke-ex-drag:active { cursor: grabbing; }
    .wke-ex-titlewrap { flex: 1; min-width: 0; }
    .wke-ex-name { font-family: var(--font-label); font-weight: var(--fw-label); font-size: var(--fs-body-sm); text-transform: uppercase; color: var(--c-white); letter-spacing: 0.04em; }
    .wke-ex-tags { display: flex; gap: 6px; margin-top: 6px; flex-wrap: wrap; }
    .wke-ex-tag { font-family: var(--font-body); font-size: 10px; color: var(--c-textsub); text-transform: uppercase; letter-spacing: 0.05em; background: var(--c-black); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: var(--radius-pill); padding: 2px 9px; }
    .wke-ex-actions { display: flex; gap: 4px; flex-shrink: 0; }
    .wke-ex-actionbtn { width: 28px; height: 28px; display: inline-flex; align-items: center; justify-content: center; background: transparent; border: 1px solid transparent; border-radius: var(--radius-card); color: var(--c-textsub); cursor: pointer; transition: color 150ms ease, border-color 150ms ease; }
    .wke-ex-actionbtn:hover { color: var(--c-lime); border-color: rgba(255, 255, 255, 0.14); }
    .wke-ex-actionbtn.danger:hover { color: var(--c-status-rejected); }
    .wke-ex-actionbtn [data-lucide] { width: 15px; height: 15px; }

    .wke-sets { width: 100%; border-collapse: collapse; margin-top: 2px; }
    .wke-sets thead th { font-family: var(--font-label); font-size: 9.5px; font-weight: var(--fw-label); text-transform: uppercase; letter-spacing: var(--tracking-label); color: var(--c-textsub); text-align: left; padding: 6px var(--space-3); border-bottom: 1px solid rgba(255, 255, 255, 0.08); }
    .wke-sets thead th.num, .wke-sets tbody td.num { text-align: center; }
    .wke-sets tbody td { padding: 4px var(--space-3); border-bottom: 1px solid rgba(255,255,255,0.04); font-family: var(--font-body); font-size: var(--fs-body-sm); color: var(--c-textbody); vertical-align: middle; }
    .wke-sets tbody tr:last-child td { border-bottom: none; }
    .wke-set-idx { font-family: var(--font-label); font-weight: var(--fw-label); color: var(--c-textsub); width: 28px; }
    .wke-cell-input { background: transparent; border: 1px solid transparent; border-radius: 3px; color: var(--c-white); font-family: var(--font-body); font-size: var(--fs-body-sm); font-weight: var(--fw-body-bold); padding: 4px 6px; width: 100%; min-width: 44px; transition: border-color 120ms ease, background 120ms ease; }
    .wke-cell-input:hover { border-color: rgba(255, 255, 255, 0.14); }
    .wke-cell-input:focus { outline: none; border-color: var(--c-lime); background: var(--c-black); box-shadow: 0 0 0 2px rgba(166,195,0,0.2); }
    .wke-cell-input.load { color: var(--c-lime); font-weight: var(--fw-body-bold); }
    .wke-cell-input.editable-hint { cursor: text; }
    .wke-cell-input.invalid { border-color: var(--c-status-rejected); box-shadow: 0 0 0 2px rgba(231,76,60,0.15); }
    .wke-cell-static { color: var(--c-textsub); }
    .wke-cell-error { display: block; font-family: var(--font-body); font-size: 10px; color: var(--c-status-rejected); padding: 0 var(--space-3) 6px; }
    .wke-ex-titlewrap .wke-cell-error { padding: 4px 0 0; }
    /* Descanso editável no header do exercício (C-04) */
    .wke-ex-rest { display: inline-flex; align-items: center; gap: 3px; font-family: var(--font-body); font-size: 10px; color: var(--c-textsub); text-transform: uppercase; letter-spacing: 0.05em; background: var(--c-black); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: var(--radius-pill); padding: 2px 9px; }
    .wke-ex-rest input { width: 34px; background: transparent; border: none; border-bottom: 1px solid rgba(255, 255, 255, 0.14); color: var(--c-lime); font-family: var(--font-body); font-size: 10px; font-weight: var(--fw-body-bold); text-align: center; padding: 0 1px 1px; }
    .wke-ex-rest input:focus { outline: none; border-bottom-color: var(--c-lime); }
    .wke-ex-rest input.invalid { border-bottom-color: var(--c-status-rejected); }

    /* Adicionar/remover série (C-02) */
    .wke-add-set { width: 100%; background: transparent; border: 1px dashed rgba(255, 255, 255, 0.14); border-radius: var(--radius-card); color: var(--c-textsub); font-family: var(--font-label); font-size: 10px; font-weight: var(--fw-label); text-transform: uppercase; letter-spacing: var(--tracking-label); padding: 7px; margin-top: var(--space-2); cursor: pointer; transition: color 150ms ease, border-color 150ms ease; display: inline-flex; align-items: center; justify-content: center; gap: 6px; }
    .wke-add-set:hover { color: var(--c-lime); border-color: rgba(166, 195, 0, 0.50); }
    .wke-add-set [data-lucide] { width: 13px; height: 13px; }
    .wke-set-del { width: 24px; height: 24px; display: inline-flex; align-items: center; justify-content: center; background: transparent; border: 1px solid transparent; border-radius: var(--radius-card); color: var(--c-textsub); cursor: pointer; transition: color 150ms ease, border-color 150ms ease; }
    .wke-set-del:hover:not(:disabled) { color: var(--c-status-rejected); border-color: rgba(255, 255, 255, 0.14); }
    .wke-set-del:disabled { opacity: 0.3; cursor: default; }
    .wke-set-del [data-lucide] { width: 14px; height: 14px; }

    /* Pill de dia: × ao hover + rename inline (C-03) */
    .wke-daytab-wrap { position: relative; display: inline-flex; }
    .wke-daytab-x { position: absolute; top: -5px; right: -5px; width: 17px; height: 17px; border-radius: 50%; background: var(--c-surface-2); border: 1px solid rgba(255, 255, 255, 0.14); color: var(--c-textsub); display: none; align-items: center; justify-content: center; cursor: pointer; z-index: 2; padding: 0; }
    .wke-daytab-wrap:hover .wke-daytab-x { display: inline-flex; }
    .wke-daytab-x:hover { color: var(--c-status-rejected); border-color: var(--c-status-rejected); }
    .wke-daytab-x [data-lucide] { width: 10px; height: 10px; }
    .wke-daytab-rename { padding: 8px 16px; border-radius: var(--radius-pill); border: 1px solid var(--c-lime); background: var(--c-black); color: var(--c-white); font-family: var(--font-label); font-size: var(--fs-label); font-weight: var(--fw-label); text-transform: uppercase; letter-spacing: var(--tracking-cta); width: 150px; }
    .wke-daytab-rename:focus { outline: none; box-shadow: 0 0 0 2px rgba(166,195,0,0.2); }

    /* ConfirmationDialog reutilizável (C-03) */
    .wke-confirm-overlay { position: fixed; inset: 0; z-index: 360; background: rgba(0,0,0,0.7); display: flex; align-items: center; justify-content: center; padding: var(--space-5); }
    .wke-confirm-overlay[hidden] { display: none !important; }
    .wke-confirm-box { width: 100%; max-width: 400px; background: var(--c-darkbg); border: 1px solid rgba(255, 255, 255, 0.14); border-radius: var(--radius-card); box-shadow: var(--shadow-lg); padding: var(--space-5); }
    .wke-confirm-title { font-family: var(--font-label); font-size: var(--fs-body-sm); font-weight: var(--fw-label); text-transform: uppercase; letter-spacing: var(--tracking-label); color: var(--c-white); margin-bottom: var(--space-2); }
    .wke-confirm-msg { font-family: var(--font-body); font-size: var(--fs-body-sm); color: var(--c-textbody); line-height: 1.5; margin-bottom: var(--space-5); }
    .wke-confirm-actions { display: flex; gap: var(--space-2); }
    .wke-confirm-actions button { flex: 1; padding: 10px; border-radius: var(--radius-card); font-family: var(--font-label); font-size: var(--fs-label); font-weight: var(--fw-label); text-transform: uppercase; letter-spacing: var(--tracking-cta); cursor: pointer; transition: opacity 150ms ease; }
    .wke-confirm-cancel { background: transparent; border: 1px solid rgba(255, 255, 255, 0.14); color: var(--c-textsub); }
    .wke-confirm-ok { background: var(--c-status-rejected); border: 1px solid var(--c-status-rejected); color: #fff; }
    .wke-confirm-ok:hover, .wke-confirm-cancel:hover { opacity: 0.85; }

    .wke-pr-badge { display: inline-flex; align-items: center; gap: 3px; font-family: var(--font-label); font-size: 9px; font-weight: var(--fw-label); text-transform: uppercase; letter-spacing: 0.08em; color: #0D0D0D; background: var(--c-lime); border-radius: var(--radius-pill); padding: 2px 7px; margin-left: 6px; transform-origin: left center; }
    .wke-pr-badge.just-won { animation: wke-pr-pop 100ms var(--ease-out) both; }
    @keyframes wke-pr-pop { from { transform: scale(0); } to { transform: scale(1); } }

    .wke-ex-history { display: flex; align-items: center; gap: 6px; padding: 8px var(--space-3) var(--space-3); border-top: 1px solid rgba(255, 255, 255, 0.08); margin-top: 2px; }
    .wke-ex-history [data-lucide] { width: 12px; height: 12px; color: var(--c-textsub); flex-shrink: 0; }
    .wke-ex-history-text { font-family: var(--font-body); font-size: 11px; color: var(--c-textsub); line-height: 1.4; }
    .wke-ex-history-text b { color: var(--c-textbody); font-weight: var(--fw-body-bold); }
    .wke-ex-loadhist { display: flex; flex-wrap: wrap; gap: 6px; padding: 8px var(--space-3) var(--space-3); border-top: 1px solid rgba(255, 255, 255, 0.08); margin-top: 2px; }
    .wke-loadchip { font-family: var(--font-body); font-size: 10px; color: var(--c-textsub); background: var(--c-black); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: var(--radius-pill); padding: 3px 9px; white-space: nowrap; }
    .wke-loadchip.latest { color: var(--c-lime); border-color: rgba(166, 195, 0, 0.50); background: rgba(166, 195, 0, 0.12); }
    /* WKE-04 Bloco B — Opção A: accordion "ver histórico completo" */
    .wke-loadhist-more { font-family: var(--font-body); font-size: 10px; color: var(--c-textsub); background: transparent; border: 1px dashed rgba(255, 255, 255, 0.08); border-radius: var(--radius-pill); padding: 3px 9px; cursor: pointer; transition: color 120ms ease, border-color 120ms ease; }
    .wke-loadhist-more:hover { color: var(--c-lime); border-color: rgba(166, 195, 0, 0.50); }
    .wke-loadhist-full { padding: 0 var(--space-3) var(--space-3); border-top: 1px solid rgba(255, 255, 255, 0.08); margin-top: -1px; }
    .wke-loadhist-full[hidden] { display: none; }
    .wke-loadhist-full table { width: 100%; border-collapse: collapse; margin-top: 10px; font-family: var(--font-body); font-size: 11px; }
    .wke-loadhist-full th { text-align: left; font-family: var(--font-label); font-size: 0.55rem; font-weight: var(--fw-label); text-transform: uppercase; letter-spacing: 0.08em; color: var(--c-textsub); padding: 6px 8px; border-bottom: 1px solid rgba(255, 255, 255, 0.08); }
    .wke-loadhist-full td { color: var(--c-textbody); padding: 6px 8px; border-bottom: 1px solid rgba(255,255,255,0.04); }
    .wke-loadhist-full tr:last-child td { border-bottom: none; }
    .wke-loadhist-full tr.latest td { color: var(--c-lime); }
    .wke-loadhist-full td.num { font-variant-numeric: tabular-nums; }

    .wke-add-ex { display: flex; align-items: center; justify-content: center; gap: 8px; width: 100%; padding: var(--space-3); background: transparent; border: 1px dashed rgba(166, 195, 0, 0.50); border-radius: var(--radius-card); color: var(--c-lime); font-family: var(--font-label); font-size: var(--fs-label); font-weight: var(--fw-label); text-transform: uppercase; letter-spacing: var(--tracking-cta); cursor: pointer; transition: background 150ms ease, border-color 150ms ease; }
    .wke-add-ex:hover { background: rgba(166, 195, 0, 0.12); border-color: var(--c-lime); }
    /* ── WKE-04 · Publicação ── */
    .pub-header { display: flex; align-items: center; gap: 12px; padding: 12px 0 14px; margin-bottom: var(--space-5); border-bottom: 1px solid rgba(255, 255, 255, 0.08); }
    .pub-titlewrap { min-width: 0; }
    .pub-badge { display: inline-flex; align-items: center; gap: 5px; padding: 4px 11px; border-radius: var(--radius-pill); font-family: var(--font-label); font-size: 0.55rem; font-weight: var(--fw-label); text-transform: uppercase; letter-spacing: 0.08em; white-space: nowrap; }
    .pub-badge.draft  { background: rgba(153,153,153,0.10); color: var(--c-textsub); border: 1px solid rgba(153,153,153,0.25); }
    .pub-badge.pub    { background: rgba(166, 195, 0, 0.12); color: var(--c-lime); border: 1px solid rgba(166, 195, 0, 0.50); }
    .pub-badge.unpub  { background: rgba(230,126,34,0.10); color: var(--c-status-new); border: 1px solid rgba(230,126,34,0.30); }
    .pub-dot { width: 5px; height: 5px; border-radius: 50%; background: currentColor; }
    @keyframes pub-pulse { 0%,100% { opacity: 1; } 50% { opacity: 0.3; } }
    .pub-dot.live { animation: pub-pulse 1.6s ease-in-out infinite; }
    .pub-actions { margin-left: auto; display: flex; align-items: center; gap: 8px; flex-shrink: 0; }
    .pub-ts { font-family: var(--font-body); font-size: 0.62rem; color: var(--c-textsub); white-space: nowrap; }
    .btn-protocol { display: inline-flex; align-items: center; gap: 7px; padding: 9px 15px; background: transparent; border: 1px solid rgba(166, 195, 0, 0.50); border-radius: var(--radius-card); color: var(--c-lime); font-family: var(--font-label); font-size: 0.62rem; font-weight: var(--fw-label); text-transform: uppercase; letter-spacing: 0.08em; cursor: pointer; transition: background 140ms ease, border-color 140ms ease; white-space: nowrap; }
    .btn-protocol:hover { background: rgba(166, 195, 0, 0.12); border-color: var(--c-lime); }
    .btn-protocol [data-lucide] { width: 14px; height: 14px; }
    .btn-protocol.unpub { border-color: var(--c-status-new); color: var(--c-status-new); }
    .btn-protocol.unpub:hover { background: rgba(230,126,34,0.10); }
    .btn-report { display: inline-flex; align-items: center; gap: 7px; padding: 9px 16px; background: var(--grad-cta); border: none; border-radius: var(--radius-card); color: #000; font-family: var(--font-label); font-size: 0.62rem; font-weight: var(--fw-label); text-transform: uppercase; letter-spacing: 0.08em; cursor: pointer; transition: box-shadow 140ms ease; white-space: nowrap; }
    .btn-report:hover { box-shadow: var(--glow-lime); }
    .btn-report [data-lucide] { width: 14px; height: 14px; }
    /* ── UC2b · Aba Evolução (Motor de Evolução) ── */
    .evo-wsrow { display: flex; align-items: center; justify-content: space-between; margin-bottom: var(--space-5); }
    .evo-wk { font-family: var(--font-display); font-size: 1.05rem; color: var(--c-white); letter-spacing: 0.04em; }
    .evo-pill { display: inline-flex; align-items: center; gap: 5px; padding: 5px 11px; border-radius: var(--radius-pill); font-family: var(--font-label); font-size: 0.57rem; font-weight: var(--fw-label); text-transform: uppercase; letter-spacing: 0.08em; }
    .evo-pill.none  { background: rgba(153,153,153,0.10); color: var(--c-textsub); border: 1px solid rgba(153,153,153,0.25); }
    .evo-pill.gen   { background: rgba(74,144,217,0.10); color: var(--c-status-progress); border: 1px solid rgba(74,144,217,0.30); }
    .evo-pill.draft { background: rgba(230,126,34,0.10); color: var(--c-status-new); border: 1px solid rgba(230,126,34,0.30); }
