<script is:inline set:html={editorPlanoNucleo}></script>
<script is:inline>
    // ---------- contrato de gancho do editor de plano (AC-16) ----------
    //
    // `packages/editor-plano/nucleo.js` não conhece esta página. O que ele precisa
    // daqui, alcança por este objeto — e nada além. As doze entradas são o
    // contrato inteiro, medido, e não uma lista aberta.
    //
    // É por aqui que a ausência da publicação continua ESTRUTURAL, e não
    // condicional: a rota restrita do profissional, no passo 2, monta o mesmo
    // objeto SEM `getPlanRef`, `renderPubHeader` e `m2SalvarRascunho`, e o botão
    // que as acionaria não existe naquele arquivo (CA-33, CA-49). O núcleo não
    // decide o que pode publicar — ele não sabe publicar.
    //
    // Declarado com `var`, no topo, e apontando direto para as funções: declaração
    // de função é içada e já está inicializada quando este objeto é construído.
    // AC-17 · O gancho contém APENAS PUBLICAÇÃO. Três entradas, e nada além
    // (CA-53). Quem lê este objeto vê a fronteira de publicação inteira de uma
    // vez, que é o que a AC-16 descreve.
    //
    // Ele já teve doze. As outras nove eram corpo do editor e utilitários que o
    // passo 1b classificou pelo PREFIXO DO NOME, onde a AC-15 classifica por
    // conteúdo: sete foram para `@elite90/editor-plano`, duas para
    // `@elite90/editor-comuns`. Nenhuma virou cópia (CA-54).
    //
    // É por aqui que a ausência da publicação continua ESTRUTURAL: a rota
    // restrita do profissional monta este mesmo objeto vazio, e o botão que o
    // acionaria não existe naquele arquivo (CA-33). O núcleo não decide o que
    // pode publicar — ele não sabe publicar.
    var EditorPlanoHost = {
      getPlanRef: getPlanRef,
      renderPubHeader: renderPubHeader,
      m2SalvarRascunho: m2SalvarRascunho,
    };

    // ── DOBRA DE BUSCA, TERMOS E CASAMENTO ──
    // dobraBusca, termosBusca, casaTodosTermos e pontuaAlimento vêm de
    // @elite90/busca (packages/busca/nucleo.js), injetado como script clássico
    // logo acima — não por <script type="module"> import, porque estas
    // funções são chamadas por dezenas de atributos onclick="…"/oninput="…"
    // espalhados pela página, o que só funciona com o escopo global que um
    // script clássico dá automaticamente (o único type="module" da página,
    // mais abaixo, é o guard de autenticação, que não expõe nada ao escopo
    // global por desenho). Mesma fonte usada pelas funções Netlify e pelos
    // scripts de carga — ver M2-BUSCA-DE-ALIMENTOS-SEM-PONTUACAO-v1.1.md.
    //
    // Histórico: até 02/09/2026 esta função era uma cópia local que só
    // removia acento (NFD, intervalo combinante U+0300–U+036F) e caixa, sem
    // tratar pontuação — por isso "arroz integral" não achava "Arroz,
    // integral, cozido" no plano nutricional (precisava da vírgula). A cópia
    // foi substituída pela versão do pacote compartilhado, que também troca
    // pontuação por espaço.

    // ── MENSAGEM DE FALHA DE ACESSO AO FIRESTORE ──
    // ESPELHA a função de mesmo nome em fichas.astro — não importa de um
    // módulo compartilhado pelo mesmo motivo de observarLarguraTabela (ver o
    // cabeçalho dela mais acima): nem o <script is:inline> clássico daqui,
    // nem o <script type="module"> de fichas.astro, resolvem um import
    // relativo de dentro do corpo da página. Antes desta função, as três
    // aparições desta mensagem (esta tabela, e a tabela e o card de
    // fichas.astro) eram três cópias escritas em momentos diferentes: cores
    // (--c-status-rejected vs --c-status-alert) e até o próprio texto
    // divergiam entre elas. --c-status-rejected (vermelho) é o token certo
    // aqui — é falha de permissão, não um aviso brando. Manter as duas
    // cópias em sincronia se mudar.
    function mensagemFalhaAcessoHTML(opts) {
      opts = opts || {};
      const texto = '[ FALHA DE ACESSO ] Permissão negada ou erro de rede. Verifique as regras do Firestore.';
      const estilo = 'text-align:center;color:var(--c-status-rejected);font-weight:700;padding:24px;';
      if (opts.formato === 'card') {
        return `<div class="${opts.className || ''}" style="${estilo}">${texto}</div>`;
      }
      const classeAttr = opts.className ? ` class="${opts.className}"` : '';
      return `<tr><td${classeAttr} colspan="${opts.colspan}" style="${estilo}">${texto}</td></tr>`;
    }

    // ── PONTE COM O SCRIPT type="module" (Firebase) ──
    // O módulo Firebase (import ESM) roda em escopo separado; ele chama
    // estas duas funções, expostas aqui em window, quando a auth guard
    // resolve (dados carregados ou falha de acesso).
    window.__setAthletes = function (list) {
      athletes = (list || []).map(normalizarCiclo);
      filteredAthletes = [...athletes];
      renderTable();
      renderIcons();
    };
    window.__setAthletesError = function () {
      const tbody = document.getElementById('athletes-tbody');
      if (tbody) tbody.innerHTML = mensagemFalhaAcessoHTML({ colspan: 6 });
    };

    // ── ÍCONES (substitui a dependência do bundle lucide por SVGs inline,
    //    consistente com o resto do repo — nenhum outro componente usa uma
    //    lib de ícones). Mesmos nomes data-lucide já usados no HTML/JS
    //    portado; renderIcons() varre [data-lucide] e injeta o SVG. ──

    // ── FOTOS DO CHECK-IN (get-foto-urls.ts real, sem persistência mock) ──
    // Convenção de paths no Storage (a popular pelo time/app do atleta):
    //   athlete.checkin.photos   — fotos do check-in da semana atual
    //   athlete.baselinePhotos   — fotos do Dia 1 (mesma ordem/ângulo)
    async function renderAthletePhotos(athlete) {
      const grid = document.getElementById('photos-grid');
      if (!grid) return;
      photoFiles = [];
      photoBeforeFiles = [];
      const currentPaths = athlete.checkin?.photos || [];
      const baselinePaths = athlete.baselinePhotos || [];
      if (!currentPaths.length) {
        grid.innerHTML = '<p class="photos-empty">Nenhuma foto enviada ainda.</p>';
        return;
      }
      grid.innerHTML = '<p class="photos-empty">Carregando fotos…</p>';
      try {
        const allPaths = [...new Set([...currentPaths, ...baselinePaths])];
        const idToken = await window.__getFreshToken();
        const res = await fetch('/.netlify/functions/get-foto-urls', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${idToken}` },
          body: JSON.stringify({ paths: allPaths }),
        });
        if (!res.ok) throw new Error('Falha ao gerar links de fotos');
        const { urls } = await res.json();
        const urlByPath = Object.fromEntries(allPaths.map((p, i) => [p, urls[i]]));
        photoFiles = currentPaths.map(p => urlByPath[p]).filter(Boolean);
        photoBeforeFiles = baselinePaths.map(p => urlByPath[p]).filter(Boolean);
        grid.innerHTML = photoFiles.map((url, i) =>
          `<div class="photo-thumb" onclick="openPhotoModal(${i})" style="background-image: url('${url}');"></div>`
        ).join('');
      } catch (e) {
        console.error('Erro ao carregar fotos do check-in:', e);
        grid.innerHTML = '<p class="photos-empty">Não foi possível carregar as fotos agora.</p>';
      }
    }

    // ── SIDENAV ──
    let sidenavLocked = false;

    function expandSidenav() {
      if (sidenavLocked) return;
      const nav = document.getElementById('drawer-sidenav');
      if (nav) nav.classList.remove('collapsed');
    }
    function collapseSidenav() {
      const nav = document.getElementById('drawer-sidenav');
      if (nav) nav.classList.add('collapsed');
    }
    function selectSidenavTab(e, tabId) {
      e.stopPropagation();
      // Muda aba
      document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
      const t = document.getElementById('tab-' + tabId);
      if (t) t.classList.add('active');
      // Atualiza realce
      document.querySelectorAll('.sidenav-item').forEach(b => b.classList.toggle('active', b.dataset.tab === tabId));
      document.querySelectorAll('.tab-button').forEach(b => b.classList.toggle('active', b.dataset.tab === tabId));
      document.querySelectorAll('.drawer-tab-opt').forEach(b => b.classList.toggle('active', b.dataset.tab === tabId));
      // Atualiza label mobile
      const mobileLabel = document.getElementById('mobile-tab-label');
      const tabLabels = { overview:'Visão Geral', checkin:'Check-in', avaliacao:'Avaliação', evolution:'Evolução', training:'Treino', nutrition:'Nutricional' };
      if (mobileLabel) mobileLabel.textContent = tabLabels[tabId] || tabId;
      // Scroll ao topo
      const w = document.querySelector('.drawer-content-wrap');
      if (w) w.scrollTop = 0;
      // UC2b: centraliza a régua quando a aba Evolução fica visível
      if (tabId === 'evolution' && typeof evoOnReveal === 'function') evoOnReveal();
    }

    function initSidenav() {
      const nav = document.getElementById('drawer-sidenav');
      if (!nav) return;
      nav.addEventListener('mouseenter', () => expandSidenav());
      nav.addEventListener('mouseleave', () => {
        if (!sidenavLocked) collapseSidenav();
      });
    }

    // Populado por loadAthletes() via Firestore, após o auth guard.
    let athletes = [];

    // ── CICLO: dia e semana são DERIVADOS de startDate ──
    // Antes, `day` e `week` vinham gravados no documento do atleta e eram
    // usados direto pela tabela, pela barra de progresso e pela régua da aba
    // Evolução. Campo gravado envelhece: no dia seguinte à gravação o número
    // já está errado, e nada na interface denuncia a divergência. Aqui eles
    // passam a ser calculados a partir de startDate a cada carga.
    //
    // Convenção: o próprio dia de início é o dia 1 (não o dia 0), coerente
    // com a semana de ciclo w01 do esquema de persistência. A diferença é
    // medida entre meias-noites locais e arredondada, para não escorregar
    // uma unidade em mudança de fuso.
    //
    // Limite: dia e semana são grampeados no fim do ciclo (90 e 13). Um ciclo
    // vencido continua exibindo 90/90 — não há estado "encerrado" modelado
    // hoje, e criá-lo é decisão de produto, não desta mudança.
    const CICLO_TOTAL_DIAS = 90;
    const CICLO_TOTAL_SEMANAS = 13;

    function cicloDia(startDate, hoje) {
      if (!startDate) return null;
      const ini = parseDate(startDate);
      if (!ini || isNaN(ini.getTime())) return null;
      const a = new Date(ini.getFullYear(), ini.getMonth(), ini.getDate());
      const h = hoje instanceof Date ? hoje : new Date();
      const b = new Date(h.getFullYear(), h.getMonth(), h.getDate());
      const dias = Math.round((b - a) / 86400000) + 1;
      return Math.min(Math.max(dias, 1), CICLO_TOTAL_DIAS);
    }

    function cicloSemana(dia) {
      if (typeof dia !== 'number') return null;
      return Math.min(Math.max(Math.ceil(dia / 7), 1), CICLO_TOTAL_SEMANAS);
    }

    // Recalcula day/week a partir de startDate. Se o atleta não tiver
    // startDate utilizável, preserva o que veio gravado — degradar para "—"
    // esconderia atletas antigos da tabela sem aviso.
    function normalizarCiclo(a) {
      const dia = cicloDia(a && a.startDate);
      if (dia === null) return a;
      return Object.assign({}, a, { day: dia, week: cicloSemana(dia) });
    }


    let filteredAthletes = [...athletes];
    let sortState = { column: null, direction: 'asc' };

    // Tabela de rótulos de exibição do vocabulário de fase (Adendo 03,
    // AF-10). O valor gravado — Bulking | Cutting | Diet Break | Maintenance,
    // vocabulário fechado de _m2-validacao.ts/FASES_VALIDAS — nunca é
    // exibido direto. Só Maintenance precisa de tradução hoje: os outros três
    // já são o que a tela sempre mostrou, e ficam como estão para não mexer
    // em nada que já funciona. Mudar o texto da tela deixa de ser alteração
    // de banco — é exatamente o problema que a AF-08 teve de resolver, agora
    // resolvido de vez.

    // Situação de acompanhamento (Adendo 06). Ponto único de chamada a
    // derivarSituacao (packages/situacao, injetado acima) — antes da Fase 4,
    // não existe subcoleção de check-ins, então o segundo argumento é sempre
    // null (DA-06: derivação parcial aceita, contando a partir da promoção).
    // Quando a Fase 4 existir, só este função muda — nenhum dos nove pontos
    // de exibição que a chamam.
    function situacaoDoAtleta(athlete) {
      const createdAt = athlete && parseDate(athlete.createdAt);
      if (!createdAt) return null;
      return derivarSituacao(createdAt, null);
    }

    // Os quatro indicadores do topo são atualizados em dois pontos do painel
    // (Adendo 06, §6) — mesma duplicação que já existia para o status antigo.
    function atualizarKpisSituacao(lista) {
      const contagem = { 'recem-promovido': 0, 'no-prazo': 0, 'acima-7-dias': 0, 'acima-14-dias': 0 };
      lista.forEach(a => { const s = situacaoDoAtleta(a); if (s) contagem[s]++; });
      document.getElementById('kpi-recem-promovido').textContent = contagem['recem-promovido'];
      document.getElementById('kpi-no-prazo').textContent = contagem['no-prazo'];
      document.getElementById('kpi-acima-7-dias').textContent = contagem['acima-7-dias'];
      document.getElementById('kpi-acima-14-dias').textContent = contagem['acima-14-dias'];
    }

    // Fase 2 do plano de persistência (Esquema v3, seção 5): startDate deixou
    // de ser string "DD/MM/AAAA" e passou a Timestamp do Firestore. O
    // Firestore Web SDK devolve um objeto com .toDate(); um valor já
    // convertido no cliente (ex.: em teste) pode chegar como Date nativo.
    // A entrada em string fica como caminho defensivo, não o esperado —
    // nenhum atleta gravado pela Fase 2 em diante produz mais essa forma.
    function parseDate(v) {
      if (!v) return null;
      if (typeof v.toDate === 'function') return v.toDate();
      if (v instanceof Date) return v;
      if (typeof v === 'string') {
        const [d, m, y] = v.split('/');
        if (!d || !m || !y) return null;
        return new Date(+y, +m - 1, +d);
      }
      return null;
    }

    // Formata Timestamp/Date de startDate para exibição, no mesmo formato
    // DD/MM/AAAA que a tela sempre mostrou — a mudança é onde o dado mora,
    // não como ele aparece (princípio P1 do Esquema v3: dado é dado,
    // formatação é da interface).
    function formatarDataBr(v) {
      const d = parseDate(v);
      if (!d || isNaN(d.getTime())) return null;
      const dd = String(d.getDate()).padStart(2, '0');
      const mm = String(d.getMonth() + 1).padStart(2, '0');
      const yyyy = d.getFullYear();
      return `${dd}/${mm}/${yyyy}`;
    }

    // Idade a partir de birthDate — derivada na leitura, nunca armazenada
    // (Esquema v3, princípio P3; Fase 2 removeu o campo athlete.age).
    function idadeDeNascimento(v) {
      const d = parseDate(v);
      if (!d || isNaN(d.getTime())) return null;
      const hoje = new Date();
      let idade = hoje.getFullYear() - d.getFullYear();
      const antesDoAniversario = hoje.getMonth() < d.getMonth()
        || (hoje.getMonth() === d.getMonth() && hoje.getDate() < d.getDate());
      if (antesDoAniversario) idade -= 1;
      return idade;
    }

    function sortAthletes(column) {
      if (sortState.column === column) {
        sortState.direction = sortState.direction === 'asc' ? 'desc' : 'asc';
      } else {
        sortState.column = column;
        sortState.direction = 'asc';
      }

      filteredAthletes.sort((a, b) => {
        let aVal, bVal;
        if (column === 'date') {
          aVal = parseDate(a.startDate).getTime();
          bVal = parseDate(b.startDate).getTime();
        } else if (column === 'name') {
          aVal = a.name.toLowerCase();
          bVal = b.name.toLowerCase();
        } else if (column === 'cycle') {
          aVal = a.day;
          bVal = b.day;
        }

        if (sortState.direction === 'asc') {
          return aVal > bVal ? 1 : aVal < bVal ? -1 : 0;
        } else {
          return aVal < bVal ? 1 : aVal > bVal ? -1 : 0;
        }
      });

      updateSortArrows();
      renderTable();
    }

    function updateSortArrows() {
      document.querySelectorAll('.sort-arrow').forEach(arrow => {
        arrow.textContent = '↕';
      });
      
      if (sortState.column === 'date') {
        document.querySelector('button[onclick="sortAthletes(\'date\')"] .sort-arrow').textContent = sortState.direction === 'asc' ? '↑' : '↓';
      } else if (sortState.column === 'name') {
        document.querySelector('button[onclick="sortAthletes(\'name\')"] .sort-arrow').textContent = sortState.direction === 'asc' ? '↑' : '↓';
      } else if (sortState.column === 'cycle') {
        document.querySelector('button[onclick="sortAthletes(\'cycle\')"] .sort-arrow').textContent = sortState.direction === 'asc' ? '↑' : '↓';
      }
    }

    // ── RENDER TABLE ──
    function toggleDrawerMenu() {
      const dropdown = document.getElementById('drawer-tab-dropdown');
      const backdrop = document.getElementById('drawer-tab-backdrop');
      const isOpen = dropdown.classList.toggle('open');
      if (backdrop) {
        backdrop.classList.toggle('open', isOpen);
        backdrop.style.display = isOpen ? 'block' : 'none';
      }
    }

    function selectDrawerTab(tabId, label) {
      document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
      document.querySelectorAll('.tab-button').forEach(b => b.classList.remove('active'));
      document.querySelectorAll('.drawer-tab-opt').forEach(b => b.classList.remove('active'));
      document.getElementById('tab-' + tabId).classList.add('active');
      const desktopBtn = document.querySelector('.tab-button[data-tab="' + tabId + '"]');
      if (desktopBtn) desktopBtn.classList.add('active');
      const opt = document.querySelector('.drawer-tab-opt[data-tab="' + tabId + '"]');
      if (opt) opt.classList.add('active');
      // Fechar dropdown E backdrop
      const dropdown = document.getElementById('drawer-tab-dropdown');
      const backdrop = document.getElementById('drawer-tab-backdrop');
      if (dropdown) dropdown.classList.remove('open');
      if (backdrop) { backdrop.classList.remove('open'); backdrop.style.display = 'none'; }
      // Scroll ao topo: a aba carregada sempre aparece a partir do seu início
      const w = document.querySelector('.drawer-content-wrap');
      if (w) w.scrollTop = 0;
      // UC2b: centraliza a régua quando a aba Evolução fica visível
      if (tabId === 'evolution' && typeof evoOnReveal === 'function') evoOnReveal();
    }

    // ── Atualizar + Exportar CSV (top-level — onclick="..." no HTML precisa de escopo global) ──
    function atualizarLista() {
      renderTable();
      document.getElementById('kpi-total').textContent = athletes.length;
      atualizarKpisSituacao(athletes);
      renderIcons();
      const btn = document.querySelector('.btn-action-outline');
      if (btn) { btn.style.opacity = '0.5'; setTimeout(() => btn.style.opacity = '', 400); }
    }

    function exportarCSV() {
      const cols = ['ID','Nome','Email','Fase','Peso Inicial (kg)','Peso Atual (kg)','Variação','Situação','Início','Semana'];
      const rows = filteredAthletes.map(a => [
        a.id, a.name, a.email, rotuloFase(a.phase),
        a.weightInitialKg || '', a.weightCurrentKg || '',
        // weight_change saiu do contrato (Esquema v3, seção 5) — derivado aqui,
        // no único ponto que o lia, em vez de gravado.
        (a.weightInitialKg != null && a.weightCurrentKg != null) ? (a.weightCurrentKg - a.weightInitialKg) : '',
        SITUACAO_LABEL[situacaoDoAtleta(a)] || '', formatarDataBr(a.startDate) || '', a.week || ''
      ]);
      const csv = [cols, ...rows].map(r =>
        r.map(v => '"' + String(v == null ? '' : v).replace(/"/g, '""') + '"').join(',')
      ).join('\n');
      const blob = new Blob(['\uFEFF' + csv], { type: 'text/csv;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url; a.download = 'atletas-elite90-' + new Date().toISOString().slice(0,10) + '.csv';
      document.body.appendChild(a); a.click(); document.body.removeChild(a);
      setTimeout(() => URL.revokeObjectURL(url), 1000);
    }

