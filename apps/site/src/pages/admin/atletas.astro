            <span class="shr-opt-ico"><span data-lucide="message-circle"></span></span>
            <span class="shr-opt-txt"><span class="shr-opt-l">WhatsApp</span><span class="shr-opt-s" id="shr-wa-sub"></span></span>
            <span class="shr-opt-chev"><span data-lucide="external-link"></span></span>
          </button>
          <button class="shr-opt" onclick="shrEnviar('abrir')">
            <span class="shr-opt-ico"><span data-lucide="external-link"></span></span>
            <span class="shr-opt-txt"><span class="shr-opt-l">Abrir a página</span><span class="shr-opt-s">Ver o que o atleta verá</span></span>
