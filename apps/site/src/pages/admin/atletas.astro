      // é a ORIGEM do plano — e ela é da hospedeira porque `m2CarregarRascunho`
      // lê o campo `draft` do plano, onde a RN-14 proíbe o trabalho do delegado
      // de viver. A rota restrita tem origem própria.
      wkeAplicarPlano(athlete, wkePlanCache[athlete.id]);
