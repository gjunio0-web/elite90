    async function initWorkout(athlete) {
      if (!athlete) return;
      // ITEM 1.4 — o rascunho gravado tem precedência sobre tudo o mais.
      // Ordem deliberada: rascunho persistido > cache da sessão > plano-base.
      // O cache continua servindo à navegação entre atletas dentro da mesma
      // sessão, sem ida ao servidor a cada troca de gaveta.
      //
      // O comentário abaixo, escrito antes deste item, previa exatamente isto:
      // "quando o editor passar a ler plano real do banco, é aqui que a leitura
      // entra, e a segunda situação deixa de existir". A segunda situação é o
      // editor abrir VAZIO em produção, por ausência da maquete de demonstração.
      // Com rascunho gravado, deixa de acontecer.
      if (!wkePlanCache[athlete.id]) {
        const salvo = await m2CarregarRascunho('training', athlete.id);
        if (salvo) wkePlanCache[athlete.id] = salvo;
      }
      // Recupera plano do cache OU escala o plano-base p/ este atleta
      if (!wkePlanCache[athlete.id]) {
        const base = athlete.planStatus === 'none' ? null : wkeBuildBasePlan();
        if (!base) {
          // Duas situações caem aqui, e o estado vazio serve às duas:
          //  • atleta recém-chegado, sem plano publicado (planStatus 'none');
          //  • sem maquete de demonstração — o caso de PRODUÇÃO, onde
          //    /dados/plano-demo.json não é publicado. Ver filtrar-demo.mjs.
          // Quando o editor passar a ler plano real do banco, é aqui que a
          // leitura entra, e a segunda situação deixa de existir.
          wkePlanCache[athlete.id] = { order: [], days: {}, isNew: true };
        } else {
          // AC-18: a calibração é do núcleo, e roda SÓ neste ramo. O rascunho
          // persistido e o cache já vêm com as cargas deste atleta; recalibrá-los
          // a cada abertura faria as cargas subirem a cada vez.
          wkePlanCache[athlete.id] = wkeCalibrarPlano(base, athlete);
        }
      }
