    .pub-dot.live { animation: pub-pulse 1.6s ease-in-out infinite; }
    .pub-actions { margin-left: auto; display: flex; align-items: center; gap: 8px; flex-shrink: 0; }
    .pub-ts { font-family: var(--font-body); font-size: 0.62rem; color: var(--c-textsub); white-space: nowrap; }
    .btn-protocol { display: inline-flex; align-items: center; gap: 7px; padding: 9px 15px; background: transparent; border: 1px solid rgba(166, 195, 0, 0.50); border-radius: var(--radius-card); color: var(--c-lime); font-family: var(--font-label); font-size: 0.62rem; font-weight: var(--fw-label); text-transform: uppercase; letter-spacing: 0.08em; cursor: pointer; transition: background 140ms ease, border-color 140ms ease; white-space: nowrap; }
    .btn-protocol:hover { background: rgba(166, 195, 0, 0.12); border-color: var(--c-lime); }
    .btn-protocol [data-lucide] { width: 14px; height: 14px; }
    .btn-protocol.unpub { border-color: var(--c-status-new); color: var(--c-status-new); }
    .btn-protocol.unpub:hover { background: rgba(230,126,34,0.10); }
    .btn-report { display: inline-flex; align-items: center; gap: 7px; padding: 9px 16px; background: var(--grad-cta); border: none; border-radius: var(--radius-card); color: #000; font-family: var(--font-label); font-size: 0.62rem; font-weight: var(--fw-label); text-transform: uppercase; letter-spacing: 0.08em; cursor: pointer; transition: box-shadow 140ms ease; white-space: nowrap; }
    .btn-report:hover { box-shadow: var(--glow-lime); }
    .btn-report [data-lucide] { width: 14px; height: 14px; }
    /* ── UC2b · Aba Evolução (Motor de Evolução) ── */
    .evo-wsrow { display: flex; align-items: center; justify-content: space-between; margin-bottom: var(--space-5); }
    .evo-wk { font-family: var(--font-display); font-size: 1.05rem; color: var(--c-white); letter-spacing: 0.04em; }
    .evo-wk-dates { display: block; font-family: var(--font-body); font-size: 0.62rem; font-weight: var(--fw-body); color: var(--c-textsub); letter-spacing: 0.02em; margin-top: 2px; }
    .evo-evdate { display: block; font-family: var(--font-body); font-size: 0.5rem; font-weight: var(--fw-body); color: var(--c-textsub); letter-spacing: 0; text-transform: none; margin-top: 1px; }
    .evo-pill { display: inline-flex; align-items: center; gap: 5px; padding: 5px 11px; border-radius: var(--radius-pill); font-family: var(--font-label); font-size: 0.57rem; font-weight: var(--fw-label); text-transform: uppercase; letter-spacing: 0.08em; }
    .evo-pill.none  { background: rgba(153,153,153,0.10); color: var(--c-textsub); border: 1px solid rgba(153,153,153,0.25); }
    .evo-pill.gen   { background: rgba(74,144,217,0.10); color: var(--c-status-progress); border: 1px solid rgba(74,144,217,0.30); }
    .evo-pill.draft { background: rgba(230,126,34,0.10); color: var(--c-status-new); border: 1px solid rgba(230,126,34,0.30); }
    .evo-pill.pub   { background: rgba(166, 195, 0, 0.12); color: var(--c-lime); border: 1px solid rgba(166, 195, 0, 0.50); }
    .evo-dot { width: 6px; height: 6px; border-radius: 50%; background: currentColor; }
    .evo-dot.live { animation: pub-pulse 1.4s ease-in-out infinite; }
    .evo-capbar { background: var(--c-darkbg); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: var(--radius-card); padding: 12px 14px; margin-bottom: var(--space-3); }
    .evo-capttl { font-family: var(--font-label); font-size: 0.56rem; font-weight: var(--fw-label); text-transform: uppercase; letter-spacing: 0.12em; color: var(--c-textsub); margin-bottom: 9px; }
    .evo-caprow { display: flex; align-items: center; gap: 8px; margin-bottom: 7px; }
    .evo-caprow:last-child { margin-bottom: 0; }
    .evo-dots { display: flex; gap: 4px; align-items: center; }
    .evo-d { width: 8px; height: 8px; border-radius: 50%; }
    .evo-d.on { background: var(--c-lime); } .evo-d.off { background: rgba(255, 255, 255, 0.14); }
    .evo-d.over { background: var(--c-lime); box-shadow: 0 0 0 2px rgba(166,195,0,0.25); }
    .evo-dsep { width: 1px; height: 8px; background: rgba(255,255,255,0.18); margin: 0 1px; }
    .evo-caplbl { font-family: var(--font-body); font-size: 0.71rem; color: var(--c-textbody); }
    .evo-capcnt { margin-left: auto; font-family: var(--font-label); font-size: 0.6rem; font-weight: var(--fw-label); color: var(--c-textsub); text-transform: uppercase; letter-spacing: 0.06em; }
    .evo-capcnt.ok { color: var(--c-lime); }
    .evo-capcnt.low { color: var(--c-status-new); }
    .evo-capcnt.over { color: var(--c-lime); }
    .evo-capcnt.free { color: var(--c-textsub); }
    .evo-srcrow { display: flex; align-items: center; gap: 8px; margin-bottom: 7px; }
    .evo-srcrow:last-child { margin-bottom: 0; }
    .evo-srcico { width: 14px; height: 14px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; font-size: 0.6rem; color: var(--c-lime); border: 1px solid rgba(166, 195, 0, 0.50); border-radius: 50%; }
    .evo-srctag { margin-left: auto; font-family: var(--font-label); font-size: 0.52rem; font-weight: var(--fw-label); color: var(--c-textsub); text-transform: uppercase; letter-spacing: 0.05em; background: rgba(255,255,255,0.04); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 3px; padding: 2px 7px; }
    .evo-btn { display: block; width: 100%; padding: 13px 18px; border-radius: var(--radius-card); font-family: var(--font-label); font-size: 0.7rem; font-weight: var(--fw-label); text-transform: uppercase; letter-spacing: 0.1em; cursor: pointer; border: none; transition: opacity 140ms ease, box-shadow 140ms ease; margin-bottom: 7px; text-align: center; }
    .evo-btn.lime { background: var(--grad-cta); color: #000; }
    .evo-btn.lime:hover { box-shadow: var(--glow-lime); }
    .evo-btn.ghost { background: transparent; border: 1px solid rgba(255, 255, 255, 0.14); color: var(--c-textsub); }
    .evo-btn.ghost:hover { color: var(--c-textbody); }
    .evo-hint { font-family: var(--font-body); font-size: 0.67rem; color: var(--c-textsub); text-align: center; margin-top: -2px; margin-bottom: 13px; }
    .evo-gencard { background: var(--c-darkbg); border: 1px solid rgba(74,144,217,0.20); border-radius: var(--radius-card); padding: 20px; text-align: center; }
    .evo-spin { width: 25px; height: 25px; border: 2px solid rgba(255, 255, 255, 0.14); border-top-color: var(--c-lime); border-radius: 50%; animation: evo-spin 0.75s linear infinite; margin: 0 auto 11px; }
    @keyframes evo-spin { to { transform: rotate(360deg); } }
    .evo-genttl { font-family: var(--font-label); font-size: 0.6rem; font-weight: var(--fw-label); text-transform: uppercase; letter-spacing: 0.1em; color: var(--c-textbody); margin-bottom: 4px; }
    .evo-gensub { font-family: var(--font-body); font-size: 0.68rem; color: var(--c-textsub); }
    .evo-block { background: var(--c-surface-2); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: var(--radius-card); padding: 13px; margin-bottom: 9px; }
    .evo-blockhd { font-family: var(--font-label); font-size: 0.57rem; font-weight: var(--fw-label); text-transform: uppercase; letter-spacing: 0.14em; margin-bottom: 7px; }
    .evo-blockbd { font-family: var(--font-body); font-size: 0.78rem; color: var(--c-textbody); line-height: 1.65; }
    .evo-block.diag .evo-blockhd { color: var(--c-lime); }
    .evo-block.conn { border-left: 2px solid var(--c-lime); border-radius: 0 var(--radius-card) var(--radius-card) 0; }
    .evo-block.conn .evo-blockhd { color: var(--c-lime); }
    .evo-block.alrt { border-left: 2px solid var(--c-status-warning); border-radius: 0 var(--radius-card) var(--radius-card) 0; background: rgba(234,179,8,0.04); border-top-color: rgba(234,179,8,0.15); border-right-color: rgba(234,179,8,0.15); border-bottom-color: rgba(234,179,8,0.15); }
    .evo-block.alrt .evo-blockhd { color: var(--c-status-warning); }
    .evo-ajuste { background: var(--c-darkbg); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: var(--radius-card); padding: 9px 11px; margin-top: 8px; }
    .evo-ajustelbl { font-family: var(--font-label); font-size: 0.55rem; font-weight: var(--fw-label); text-transform: uppercase; letter-spacing: 0.12em; margin-bottom: 4px; }
    .evo-ajustelbl.tr { color: var(--c-lime); } .evo-ajustelbl.nu { color: #E6C200; }
    .evo-ajuste p { font-family: var(--font-body); font-size: 0.73rem; color: var(--c-textbody); line-height: 1.55; }
    .evo-loadref { display: flex; align-items: center; gap: 6px; margin-top: 8px; flex-wrap: wrap; }
    .evo-loadchip { font-family: var(--font-body); font-size: 0.64rem; color: rgba(166,195,0,0.85); background: rgba(166, 195, 0, 0.12); border: 1px solid rgba(166, 195, 0, 0.50); border-radius: 3px; padding: 3px 8px; }
    .evo-loadsrc { font-family: var(--font-label); font-size: 0.5rem; font-weight: var(--fw-label); color: var(--c-textsub); text-transform: uppercase; letter-spacing: 0.05em; background: rgba(255,255,255,0.04); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 3px; padding: 2px 6px; }
    .evo-alrtitem { display: flex; gap: 7px; align-items: flex-start; margin-bottom: 7px; font-size: 0.76rem; color: var(--c-textbody); }
    .evo-alrtitem:last-child { margin-bottom: 0; }
    .evo-alrtico { flex-shrink: 0; margin-top: 1px; }
    .evo-approvets { font-family: var(--font-body); font-size: 0.67rem; color: var(--c-textsub); margin-bottom: 12px; display: flex; align-items: center; gap: 6px; }
    .evo-approvets span { color: var(--c-lime); font-family: var(--font-label); font-weight: var(--fw-label); font-size: 0.6rem; text-transform: uppercase; letter-spacing: 0.07em; }
    .evo-rulersec { background: var(--c-darkbg); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: var(--radius-card); padding: 14px 12px 10px; }
    .evo-ruler { display: flex; align-items: center; gap: 4px; }
    .evo-rulertrack { display: flex; align-items: stretch; gap: 6px; overflow-x: auto; padding: 4px 2px 6px; scrollbar-width: none; flex: 1; scroll-behavior: smooth; }
    .evo-rulertrack::-webkit-scrollbar { display: none; }
    .evo-wkpill { flex-shrink: 0; position: relative; display: flex; flex-direction: column; align-items: center; gap: 6px; min-width: 46px; padding: 8px 10px 7px; border-radius: 8px; border: 1px solid rgba(255, 255, 255, 0.14); background: var(--c-black); color: var(--c-textsub); font-family: var(--font-label); font-size: 0.7rem; font-weight: var(--fw-label); text-transform: uppercase; letter-spacing: 0.04em; cursor: pointer; white-space: nowrap; transition: border-color 120ms ease, background 120ms ease, color 120ms ease; }
    .evo-wkpill:hover { border-color: rgba(166, 195, 0, 0.50); }
    .evo-wkpill .evo-wknum { line-height: 1; }
    .evo-wkpill .evo-wkcad { display: flex; gap: 3px; height: 5px; align-items: center; }
    .evo-wkpill .evo-cadmark { width: 5px; height: 5px; border-radius: 50%; background: transparent; border: 1px solid rgba(255, 255, 255, 0.14); opacity: 0.35; }
    .evo-wkpill.done { border-color: rgba(166,195,0,0.30); color: rgba(166,195,0,0.7); background: rgba(166,195,0,0.04); }
    .evo-wkpill.done .evo-wknum::after { content: ''; }
    .evo-wkpill.cur { background: var(--grad-cta); border-color: var(--c-lime); color: #0D0D0D; box-shadow: var(--glow-lime-sm); }
    .evo-wkpill.future { opacity: 0.4; cursor: default; }
    .evo-wkpill.future:hover { border-color: rgba(255, 255, 255, 0.14); }
    .evo-wkpill.current::after { content: 'atual'; position: absolute; bottom: -15px; left: 50%; transform: translateX(-50%); font-size: 0.44rem; font-family: var(--font-label); font-weight: var(--fw-label); text-transform: uppercase; letter-spacing: 0.08em; color: var(--c-lime); white-space: nowrap; }
    .evo-wkpill.cur.current::after { color: var(--c-lime); }
    /* Ponto pulsante: marca inconfundível da semana corrente do ciclo */
    .evo-wkpill.current::before { content: ''; position: absolute; top: 5px; right: 5px; width: 6px; height: 6px; border-radius: 50%; background: var(--c-lime); box-shadow: 0 0 0 0 var(--c-lime); animation: evo-curpulse 1.6s ease-in-out infinite; z-index: 1; }
    .evo-wkpill.cur.current::before { background: #0D0D0D; box-shadow: 0 0 0 0 rgba(13,13,13,0.6); animation-name: evo-curpulse-dark; }
    @keyframes evo-curpulse { 0% { box-shadow: 0 0 0 0 rgba(166,195,0,0.55); } 70% { box-shadow: 0 0 0 5px rgba(166,195,0,0); } 100% { box-shadow: 0 0 0 0 rgba(166,195,0,0); } }
    @keyframes evo-curpulse-dark { 0% { box-shadow: 0 0 0 0 rgba(13,13,13,0.5); } 70% { box-shadow: 0 0 0 5px rgba(13,13,13,0); } 100% { box-shadow: 0 0 0 0 rgba(13,13,13,0); } }
    @media (prefers-reduced-motion: reduce) { .evo-wkpill.current::before { animation: none; } }
    .evo-wkpill.viewing:not(.cur) { border-color: var(--c-lime); color: var(--c-lime); background: rgba(166,195,0,0.10); }
    .evo-rulersec .evo-navarr { flex-shrink: 0; }
    .evo-navarr { background: none; border: none; color: var(--c-textsub); font-size: 1.2rem; cursor: pointer; padding: 4px 2px; transition: color 120ms ease; }
    .evo-navarr:hover { color: var(--c-lime); }
    /* ── Overlays (preview + editor) ── */
