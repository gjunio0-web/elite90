    // Intervalo de datas de uma semana de ciclo, a partir de startDate.
    // Devolve null quando o atleta não tem data de início utilizável — nesse
    // caso o selo e os cabeçalhos ficam como estavam, só com "S1", "S3"…
    function evoWeekRange(n) {
      var a = wke04CurrentAthlete;
      if (!a || !a.startDate) return null;
      var ini = parseDate(a.startDate);
      if (!ini || isNaN(ini.getTime())) return null;
      var d0 = new Date(ini.getFullYear(), ini.getMonth(), ini.getDate());
      d0.setDate(d0.getDate() + (n - 1) * 7);
      var d1 = new Date(d0);
      d1.setDate(d1.getDate() + 6);
      function fmt(d, comAno) {
        var s = String(d.getDate()).padStart(2, '0') + '/' + String(d.getMonth() + 1).padStart(2, '0');
        return comAno ? s + '/' + d.getFullYear() : s;
      }
      return { curto: fmt(d0, false), intervalo: fmt(d0, false) + ' a ' + fmt(d1, true) };
    }

