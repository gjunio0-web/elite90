    function exportarCSV() {
      const cols = ['ID','Nome','Email','Fase','Peso Inicial (kg)','Peso Atual (kg)','Variação','Status','Início','Semana'];
      const statusLabel = { active: 'Ativo', checkin_sent: 'Check-in Enviado', awaiting_checkin: 'Aguardando Check-in' };
      const rows = filteredAthletes.map(a => [
        a.id, a.name, a.email, a.phase || '',
        a.weight_init || '', a.weight_now || '', a.weight_change || '',
        statusLabel[a.status] || a.status, a.startDate || '', a.week || ''
      ]);
      const csv = [cols, ...rows].map(r =>
        r.map(v => '"' + String(v == null ? '' : v).replace(/"/g, '""') + '"').join(',')
      ).join('\n');
      const blob = new Blob(['\uFEFF' + csv], { type: 'text/csv;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url; a.download = 'atletas-elite90-' + new Date().toISOString().slice(0,10) + '.csv';
      document.body.appendChild(a); a.click(); document.body.removeChild(a);
      setTimeout(() => URL.revokeObjectURL(url), 1000);
    }

