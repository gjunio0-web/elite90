    function doPublish(kind, label) {
      const p = getPlanRef(kind);
      if (!p) return;
      // AGUARDA A PERSISTÊNCIA DO M2 (Etapa 1, spec v2 no Drive, seção 8.2).
      // Hoje o congelamento grava numa estrutura em memória que some ao
      // recarregar a página: a regra está correta, mas nunca foi exercitada de
      // verdade. Quem implementar a persistência deve mover este bloco para a
      // função serverless que cria a versão, trocar _congeladoNoCliente pelo
      // carimbo do servidor em congeladoEm, e gravar o retrato dentro de
      // versions/{vNNN}.content — que é imutável.
      //
      // CORREÇÃO (26/08/2026): `p` é getPlanRef(kind) — só {status, publishedAt,
      // hasUnpublishedChanges}. NUNCA teve .days; nenhum outro ponto do arquivo
      // grava .days nele. O plano de verdade que o Coach edita mora em
      // ntePlanCache[athlete.id] (nteState.plan é a mesma referência, mas só
      // enquanto a gaveta daquele atleta está aberta — buscar pelo id, não pelo
      // estado da aba, é o que não depende dessa coincidência). Chamar
