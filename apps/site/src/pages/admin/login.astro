---
export const prerender = false;
---
<!DOCTYPE html>
<html lang="pt-BR" class="locked">
<head>

  <style is:inline>
    /* A classe 'locked' esconde todo o corpo da página e exibe apenas o vazio negro */
    html.locked body {
      display: none !important;
    }
    html.locked {
      background-color: #0A0A0A; /* Fundo Brutalista Noir */
    }
  </style>

  <script is:inline>
    // Função de interceptação (IIFE) executada em milissegundos
    (function() {
      const isUnlocked = sessionStorage.getItem('gateway_unlocked');
      
      if (!isUnlocked) {
        // Acesso direto detectado ou token ausente. Expulsão silenciosa.
        // Usa 'replace' para não deixar rastro no botão "Voltar" do navegador
        window.location.replace('/'); 
      } else {
        // Salvo-conduto validado. Destranca a interface para o formulário.
        document.documentElement.classList.remove('locked');
        
        // Opcional de Defesa Ativa: Apagar a chave após abrir a porta.
        // Se você quiser que recarregar a página exija os 5 cliques de novo, descomente a linha abaixo:
        // sessionStorage.removeItem('gateway_unlocked');
      }
    })();
  </script>

  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Elite 90 · Acesso ao Painel</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="icon" href="/favicon.ico" />
  <style>
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
    body{background:#080808;font-family:'Helvetica Neue',Arial,sans-serif;color:#ccc;min-height:100vh;display:flex;align-items:center;justify-content:center;padding:24px;}
    .login-wrap{width:100%;max-width:420px;}
    .login-logo{text-align:center;margin-bottom:40px;}
    .login-logo img{height:80px;width:auto;object-fit:contain;}
    .login-card{background:#1A1A1A;border:1px solid rgba(166,195,0,.2);border-radius:12px;padding:40px 36px;}
    .login-eyebrow{font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.2em;color:#A6C300;text-align:center;margin-bottom:8px;}
    .login-title{font-family:'Arial Black',sans-serif;font-size:26px;font-weight:900;color:#fff;text-align:center;letter-spacing:.04em;margin-bottom:32px;}
    .field{display:flex;flex-direction:column;gap:6px;margin-bottom:20px;}
    .field label{font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.12em;color:#999;}
    .field input{background:#0D0D0D;border:1px solid #2a2a2a;border-radius:6px;color:#fff;font-size:15px;padding:14px 16px;transition:border-color 200ms;}
    .field input:focus{outline:none;border-color:#A6C300;}
    .field input::placeholder{color:#444;}
    .btn-primary{width:100%;background:#A6C300;color:#000;font-weight:900;text-transform:uppercase;letter-spacing:.1em;padding:16px;border:none;border-radius:50px;cursor:pointer;font-size:13px;margin-top:8px;transition:box-shadow 200ms;}
    .btn-primary:hover{box-shadow:0 0 20px rgba(166,195,0,.4);}
    .btn-primary:disabled{opacity:.5;cursor:not-allowed;}
    .error-msg{color:#E74C3C;font-size:12px;text-align:center;margin-top:12px;min-height:18px;}
    .divider-or{display:flex;align-items:center;gap:12px;margin:20px 0;}
  .divider-or::before,.divider-or::after{content:"";flex:1;height:1px;background:#222;}
  .divider-or span{font-size:11px;color:#444;text-transform:uppercase;letter-spacing:.1em;}
  .btn-google{width:100%;background:transparent;border:1px solid #333;border-radius:50px;color:#ccc;font-weight:700;text-transform:uppercase;letter-spacing:.1em;padding:14px;display:flex;align-items:center;justify-content:center;gap:10px;cursor:pointer;font-size:12px;transition:border-color 200ms,background 200ms;}
  .btn-google:hover{border-color:#555;background:rgba(255,255,255,.04);}
  .btn-google:disabled{opacity:.5;cursor:not-allowed;}
  .google-error{color:#E74C3C;font-size:12px;text-align:center;margin-top:8px;min-height:16px;}
  .back-link{display:block;text-align:center;margin-top:24px;font-size:12px;color:#666;text-decoration:none;transition:color 200ms;}
    .back-link:hover{color:#A6C300;}

    /* --- AUTOFILL NEUTRALIZATION (CHROME/WEBKIT) --- */
    input:-webkit-autofill,
    input:-webkit-autofill:hover,
    input:-webkit-autofill:focus,
    input:-webkit-autofill:active {
      -webkit-box-shadow: 0 0 0px 1000px #0D0D0D inset !important;
      -webkit-text-fill-color: #ffffff !important;
      transition: background-color 5000s ease-in-out 0s;
      caret-color: #A6C300;
    }
  </style>
</head>
<body>
<body>
  <div class="login-wrap">
    <div class="login-logo">
      <img src="/images/brand/logo-hero.webp" alt="Coach Ruiz Elite 90" />
    </div>
    <div class="login-card">
      <p class="login-eyebrow">Area Restrita</p>
      <h1 class="login-title">Acesso ao Painel</h1>

      <form id="login-form" novalidate>
        <div class="field">
          <label for="l-email">E-MAIL</label>
          <input type="email" id="l-email" name="email" required
            placeholder="admin@coachruiz.com.br" autocomplete="email" />
        </div>
        <div class="field">
          <label for="l-password">SENHA</label>
          <input type="password" id="l-password" name="password" required
            placeholder="••••••••" autocomplete="current-password" />
        </div>
        <button class="btn-primary" type="submit" id="login-btn">ENTRAR</button>
        <p class="error-msg" id="login-error"></p>
      </form>

      <div class="divider-or"><span>Ou</span></div>
      <button class="btn-google" id="btn-google-auth-trigger" type="button">
        <svg class="google-icon" viewBox="0 0 24 24" style="width:16px; height:16px; display:inline-block; vertical-align:middle; margin-right:8px;">
          <path fill="#EA4335" d="M5.266 9.765A7.077 7.077 0 0 1 12 4.909c1.69 0 3.218.6 4.418 1.582L19.91 3C17.782 1.145 15.055 0 12 0 7.33 0 3.357 2.673 1.405 6.564l3.86 3.201z"/>
          <path fill="#4285F4" d="M23.49 12.275c0-.825-.075-1.62-.21-2.385H12v4.51h6.44c-.28 1.47-1.11 2.71-2.36 3.55l3.67 2.84c2.14-1.97 3.38-4.88 3.38-8.515z"/>
          <path fill="#FBBC05" d="M5.266 14.235L1.405 17.436A11.943 11.943 0 0 0 12 24c3.055 0 5.782-1.01 7.69-2.73l-3.67-2.84c-1.07.72-2.44 1.15-4.02 1.15-3.23 0-5.968-2.182-6.734-5.345z"/>
          <path fill="#34A853" d="M1.405 6.564l3.86 3.201c.766-3.163 3.504-5.345 6.735-5.345 1.58 0 2.95.43 4.02 1.15l3.67-2.84A11.943 11.943 0 0 0 12 0C7.33 0 3.357 2.673 1.405 6.564z"/>
        </svg>
        Entrar com o Google
      </button>
      <p class="error-msg" id="google-error-display"></p>

    </div>
    <a class="back-link" href="/">← Voltar ao site</a>
  </div>

  <script type="module">
    import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-app.js";
    import { getAuth, signInWithEmailAndPassword, GoogleAuthProvider, signInWithPopup } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-auth.js";

    const cfg = {
      apiKey:            document.querySelector('meta[name="fb-api"]')?.content,
      authDomain:        document.querySelector('meta[name="fb-auth"]')?.content,
      projectId:         document.querySelector('meta[name="fb-proj"]')?.content,
      storageBucket:     document.querySelector('meta[name="fb-bucket"]')?.content,
      messagingSenderId: document.querySelector('meta[name="fb-sender"]')?.content,
      appId:             document.querySelector('meta[name="fb-appid"]')?.content,
    };

    const app  = initializeApp(cfg);
    const auth = getAuth(app);

    const form   = document.getElementById("login-form");
    const btn    = document.getElementById("login-btn");
    const errEl  = document.getElementById("login-error");

    const errorMessages = {
      "auth/user-not-found":    "Conta nao encontrada.",
      "auth/wrong-password":    "Senha incorreta.",
      "auth/invalid-email":     "E-mail invalido.",
      "auth/too-many-requests": "Muitas tentativas. Aguarde alguns minutos.",
      "auth/invalid-credential":"E-mail ou senha incorretos.",
    };

    form.addEventListener("submit", async e => {
      e.preventDefault();
      btn.disabled = true;
      btn.textContent = "ENTRANDO...";
      errEl.textContent = "";

      const email    = document.getElementById("l-email").value;
      const password = document.getElementById("l-password").value;

      try {
        await signInWithEmailAndPassword(auth, email, password);
        window.location.href = "/admin";
      } catch (err) {
        errEl.textContent = errorMessages[err.code] ?? "Erro ao autenticar.";
        btn.disabled = false;
        btn.textContent = "ENTRAR";
      }
    });

    // If already logged in, redirect
    auth.onAuthStateChanged(user => {
      if (user) window.location.href = "/admin";
    });

    // Google sign-in (Fluxo Corrigido e Vinculado ao Botão Físico)
  const googleBtn = document.getElementById("btn-google-auth-trigger");
  const googleError = document.getElementById("google-error-display");
  const provider = new GoogleAuthProvider();

  // Injeção explícita de escopos para assegurar a leitura do e-mail administrativo
  provider.addScope('profile');
  provider.addScope('email');

  googleBtn?.addEventListener("click", async () => {
    googleBtn.disabled = true;
    if (googleError) googleError.textContent = "";
    try {
      await signInWithPopup(auth, provider);
      window.location.href = "/admin";
    } catch (err) {
      console.error("Erro na autenticação federada Google:", err);
      if (googleError) googleError.textContent = "Erro ao autenticar com a conta do Google.";
      googleBtn.disabled = false;
    }
  });
  </script>

  <meta name="fb-api"    content={import.meta.env.PUBLIC_FIREBASE_API_KEY} />
  <meta name="fb-auth"   content={import.meta.env.PUBLIC_FIREBASE_AUTH_DOMAIN} />
  <meta name="fb-proj"   content={import.meta.env.PUBLIC_FIREBASE_PROJECT_ID} />
  <meta name="fb-bucket" content={import.meta.env.PUBLIC_FIREBASE_STORAGE_BUCKET} />
  <meta name="fb-sender" content={import.meta.env.PUBLIC_FIREBASE_MESSAGING_SENDER_ID} />
  <meta name="fb-appid"  content={import.meta.env.PUBLIC_FIREBASE_APP_ID} />
</body>
</html>
