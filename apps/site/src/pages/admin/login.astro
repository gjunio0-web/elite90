---
export const prerender = false;
import '@fontsource/bebas-neue';
import '@fontsource/raleway/400.css';
import '@fontsource/raleway/700.css';
import '@fontsource/montserrat/400.css';
import '@fontsource/montserrat/700.css';
import '../../styles/tokens.css';
import '../../styles/global.css';
---
<!DOCTYPE html>
<html lang="pt-BR" class="locked">
<head>
  <!-- Anti-flash: esconde o body até que o JS valide o gateway -->
  <style is:inline>
    html.locked body { display: none !important; }
    html.locked { background-color: var(--c-black, #0D0D0D); }
  </style>
  <script is:inline>
    (function() {
      if (!sessionStorage.getItem('gateway_unlocked')) {
        window.location.replace('/');
      } else {
        document.documentElement.classList.remove('locked');
      }
    })();
  </script>

  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Elite 90 — Acesso ao Painel</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="icon" href="/favicon.ico" />

  <style is:global>
    /* ── LAYOUT ──────────────────────────────────────────────────────── */
    body {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: var(--space-5) var(--space-3);
    }

    .login-wrap {
      width: 100%;
      max-width: 420px;
    }

    /* ── LOGO ────────────────────────────────────────────────────────── */
    .login-logo {
      text-align: center;
      margin-bottom: var(--space-5);
    }
    .login-logo img {
      height: 110px;
      width: auto;
      max-width: 100%;
      object-fit: contain;
      margin: 0 auto;
      display: block;
    }

    /* ── CARD ────────────────────────────────────────────────────────── */
    .login-card {
      background: var(--c-darkbg);
      border: 1px solid rgba(166,195,0,0.2);
      border-top: 3px solid var(--c-lime);
      border-radius: var(--radius-card);
      padding: var(--space-6) var(--space-5);
    }

    .login-eyebrow {
      font-family: var(--font-label);
      font-size: var(--fs-label);
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.2em;
      color: var(--c-lime);
      text-align: center;
      margin-bottom: var(--space-2);
    }
    .login-title {
      font-family: var(--font-display);
      font-size: var(--fs-display-md);
      font-weight: 400;
      color: var(--c-white);
      text-transform: uppercase;
      text-align: center;
      letter-spacing: 0.05em;
      line-height: 1;
      margin-bottom: var(--space-6);
    }

    /* ── FIELDS ──────────────────────────────────────────────────────── */
    .field {
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
      margin-bottom: var(--space-4);
    }
    .field label {
      font-family: var(--font-label);
      font-size: var(--fs-label);
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: var(--c-textsub);
    }
    .field input {
      background: var(--c-black);
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: var(--radius-card);
      color: var(--c-white);
      font-family: var(--font-body);
      font-size: var(--fs-body-md);
      padding: 14px var(--space-4);
      transition: border-color var(--transition-base);
      outline: none;
    }
    .field input:focus { border-color: var(--c-lime); }
    .field input::placeholder { color: rgba(255,255,255,0.2); }

    /* ── BUTTONS ─────────────────────────────────────────────────────── */
    .btn-login {
      width: 100%;
      background: var(--c-lime);
      color: #000;
      font-family: var(--font-label);
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      padding: 16px;
      border: none;
      border-radius: var(--radius-pill);
      cursor: pointer;
      font-size: 0.8rem;
      margin-top: var(--space-2);
      transition: box-shadow var(--transition-base);
    }
    .btn-login:hover { box-shadow: var(--shadow-cta); }
    .btn-login:disabled { opacity: 0.5; cursor: not-allowed; }

    .divider-or {
      display: flex;
      align-items: center;
      gap: var(--space-3);
      margin: var(--space-5) 0;
    }
    .divider-or::before,
    .divider-or::after {
      content: "";
      flex: 1;
      height: 1px;
      background: rgba(255,255,255,0.06);
    }
    .divider-or span {
      font-family: var(--font-label);
      font-size: var(--fs-label);
      color: var(--c-textsub);
      text-transform: uppercase;
      letter-spacing: 0.1em;
    }

    .btn-google {
      width: 100%;
      background: transparent;
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: var(--radius-pill);
      color: var(--c-textbody);
      font-family: var(--font-label);
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      padding: 14px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: var(--space-2);
      cursor: pointer;
      font-size: 0.75rem;
      transition: border-color var(--transition-base), background var(--transition-base);
    }
    .btn-google:hover { border-color: rgba(255,255,255,0.25); background: rgba(255,255,255,0.03); }
    .btn-google:disabled { opacity: 0.5; cursor: not-allowed; }

    /* ── FEEDBACK ────────────────────────────────────────────────────── */
    .error-msg {
      font-family: var(--font-body);
      font-size: var(--fs-body-sm);
      color: #E74C3C;
      text-align: center;
      margin-top: var(--space-3);
      min-height: 1.2em;
    }

    /* ── BACK LINK ───────────────────────────────────────────────────── */
    .back-link {
      display: block;
      text-align: center;
      margin-top: var(--space-4);
      font-family: var(--font-label);
      font-size: var(--fs-label);
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--c-textsub);
      text-decoration: none;
      transition: color var(--transition-base);
    }
    .back-link:hover { color: var(--c-lime); }

    /* ── AUTOFILL (WEBKIT) ───────────────────────────────────────────── */
    input:-webkit-autofill,
    input:-webkit-autofill:hover,
    input:-webkit-autofill:focus,
    input:-webkit-autofill:active {
      -webkit-box-shadow: 0 0 0px 1000px var(--c-black) inset !important;
      -webkit-text-fill-color: var(--c-white) !important;
      transition: background-color 5000s ease-in-out 0s;
      caret-color: var(--c-lime);
    }
  </style>
</head>
<body>

  <div class="login-wrap">
    <div class="login-card">
      <div class="login-logo">
        <img src="/images/brand/logo-hero.webp" alt="Coach Ruiz Elite 90" />
      </div>
      <p class="login-eyebrow">Área Restrita</p>
      <h1 class="login-title">Acesso ao Painel</h1>

      <form id="login-form" novalidate>
        <div class="field">
          <label for="l-email">E-mail</label>
          <input type="email" id="l-email" name="email" required
            placeholder="admin@coachruiz.com.br" autocomplete="email" />
        </div>
        <div class="field">
          <label for="l-password">Senha</label>
          <input type="password" id="l-password" name="password" required
            placeholder="••••••••" autocomplete="current-password" />
        </div>
        <button class="btn-login" type="submit" id="login-btn">Entrar</button>
        <p class="error-msg" id="login-error" aria-live="polite"></p>
      </form>

      <div class="divider-or"><span>ou</span></div>

      <button class="btn-google" id="btn-google-auth-trigger" type="button">
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
          <path fill="#EA4335" d="M5.266 9.765A7.077 7.077 0 0 1 12 4.909c1.69 0 3.218.6 4.418 1.582L19.91 3C17.782 1.145 15.055 0 12 0 7.33 0 3.357 2.673 1.405 6.564l3.86 3.201z"/>
          <path fill="#4285F4" d="M23.49 12.275c0-.825-.075-1.62-.21-2.385H12v4.51h6.44c-.28 1.47-1.11 2.71-2.36 3.55l3.67 2.84c2.14-1.97 3.38-4.88 3.38-8.515z"/>
          <path fill="#FBBC05" d="M5.266 14.235L1.405 17.436A11.943 11.943 0 0 0 12 24c3.055 0 5.782-1.01 7.69-2.73l-3.67-2.84c-1.07.72-2.44 1.15-4.02 1.15-3.23 0-5.968-2.182-6.734-5.345z"/>
          <path fill="#34A853" d="M1.405 6.564l3.86 3.201c.766-3.163 3.504-5.345 6.735-5.345 1.58 0 2.95.43 4.02 1.15l3.67-2.84A11.943 11.943 0 0 0 12 0C7.33 0 3.357 2.673 1.405 6.564z"/>
        </svg>
        Entrar com o Google
      </button>
      <p class="error-msg" id="google-error-display" aria-live="polite"></p>
    </div>

    <a class="back-link" href="/">← Voltar ao site</a>
  </div>

  <script type="module">
    import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-app.js";
    import { getAuth, signOut, signInWithEmailAndPassword, GoogleAuthProvider, signInWithPopup }
      from "https://www.gstatic.com/firebasejs/10.12.0/firebase-auth.js";

    const cfg = {
      apiKey:            document.querySelector('meta[name="fb-api"]')?.content,
      authDomain:        document.querySelector('meta[name="fb-auth"]')?.content,
      projectId:         document.querySelector('meta[name="fb-proj"]')?.content,
      storageBucket:     document.querySelector('meta[name="fb-bucket"]')?.content,
      messagingSenderId: document.querySelector('meta[name="fb-sender"]')?.content,
      appId:             document.querySelector('meta[name="fb-appid"]')?.content,
    };
    const app  = initializeApp(cfg);
    const auth = getAuth(app);

    const ERROR_MESSAGES = {
      "auth/user-not-found":     "Conta não encontrada.",
      "auth/wrong-password":     "Senha incorreta.",
      "auth/invalid-email":      "E-mail inválido.",
      "auth/too-many-requests":  "Muitas tentativas. Aguarde alguns minutos.",
      "auth/invalid-credential": "E-mail ou senha incorretos.",
    };

    async function verificarAdminEAcessar(errorEl) {
      try {
        const tokenResult = await auth.currentUser.getIdTokenResult(true);
        if (tokenResult.claims.admin) {
          window.location.href = "/admin";
        } else {
          await signOut(auth);
          if (errorEl) errorEl.textContent = "Acesso não autorizado para esta conta.";
        }
      } catch {
        await signOut(auth);
        if (errorEl) errorEl.textContent = "Erro ao verificar permissões. Tente novamente.";
      }
    }

    // Redireciona se já autenticado e autorizado
    auth.onAuthStateChanged(async user => {
      if (!user) return;
      const tokenResult = await user.getIdTokenResult(true).catch(() => null);
      if (tokenResult?.claims.admin) window.location.href = "/admin";
    });

    // Login com e-mail/senha
    const form    = document.getElementById("login-form");
    const loginBtn = document.getElementById("login-btn");
    const loginErr = document.getElementById("login-error");

    form.addEventListener("submit", async e => {
      e.preventDefault();
      loginBtn.disabled = true;
      loginBtn.textContent = "Entrando...";
      loginErr.textContent = "";
      try {
        await signInWithEmailAndPassword(
          auth,
          document.getElementById("l-email").value,
          document.getElementById("l-password").value
        );
        await verificarAdminEAcessar(loginErr);
      } catch (err) {
        loginErr.textContent = ERROR_MESSAGES[err.code] ?? "Erro ao autenticar.";
      } finally {
        loginBtn.disabled = false;
        loginBtn.textContent = "Entrar";
      }
    });

    // Login com Google
    const googleBtn = document.getElementById("btn-google-auth-trigger");
    const googleErr = document.getElementById("google-error-display");
    const provider  = new GoogleAuthProvider();
    provider.addScope("profile");
    provider.addScope("email");

    googleBtn.addEventListener("click", async () => {
      googleBtn.disabled = true;
      googleErr.textContent = "";
      try {
        await signInWithPopup(auth, provider);
        await verificarAdminEAcessar(googleErr);
      } catch (err) {
        console.error("Erro na autenticação Google:", err);
        googleErr.textContent = "Erro ao autenticar com o Google.";
      } finally {
        googleBtn.disabled = false;
      }
    });
  </script>

  <meta name="fb-api"    content={import.meta.env.PUBLIC_FIREBASE_API_KEY} />
  <meta name="fb-auth"   content={import.meta.env.PUBLIC_FIREBASE_AUTH_DOMAIN} />
  <meta name="fb-proj"   content={import.meta.env.PUBLIC_FIREBASE_PROJECT_ID} />
  <meta name="fb-bucket" content={import.meta.env.PUBLIC_FIREBASE_STORAGE_BUCKET} />
  <meta name="fb-sender" content={import.meta.env.PUBLIC_FIREBASE_MESSAGING_SENDER_ID} />
  <meta name="fb-appid"  content={import.meta.env.PUBLIC_FIREBASE_APP_ID} />
</body>
</html>