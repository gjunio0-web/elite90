---
export const prerender = false;
import '@fontsource/bebas-neue';
import '@fontsource/raleway/400.css';
import '@fontsource/raleway/700.css';
import '@fontsource/montserrat/400.css';
import '@fontsource/montserrat/700.css';
import '../../styles/tokens.css';
import '../../styles/global.css';
import AdminHeader from '../../components/AdminHeader.astro';
---
{/*
  ELITE90 PRO · tela de profissionais — ADM-13 reduzida, Adendo 09 (AT-07, AT-20).

  DUAS ÁREAS, UMA TELA (AT-20). Titularidade por especialidade no topo, porque é
  o ATO PRIMÁRIO: o Coach define titulares, e todos os atletas passam a estar nas
  carteiras deles — não atribui carteira atleta a atleta. A lista de
  profissionais, com cadastro e atos de carteira por linha, vem abaixo, em
  entrega própria.

  DUAS ÁREAS, ENTREGUES EM BLOCOS. A titularidade veio primeiro; a equipe veio
  no bloco seguinte, com cadastro, edição, concessão de acesso e desativação.

  DOIS ATOS DA AT-07 AINDA NÃO ESTÃO AQUI, E ISSO É DECLARADO, NÃO ESQUECIDO:
  ENCERRAR CARTEIRA e ATRIBUIR A ATLETA QUE JÁ TEM PROFISSIONAL. Os dois exigem
  um identificador que nenhuma função devolve ao administrador hoje —
  `encerrar-carteira.ts` pede `assignmentId`, e a única leitura de carteira que
  existe (`listar-atletas-do-profissional.ts`) recusa token sem o papel
  `professional`, inclusive o do admin. A peça que falta é `listar-carteira.ts`,
  especificada por inteiro na AT-23.

  E ELA TEM PRAZO (§11 do adendo): entra na sequência imediatamente seguinte a
  este bloco, na mesma leva de trabalho, antes de qualquer outra fase abrir. A
  regra que a governança fixou é literal — "um bloco liberado como reduzido só é
  dado por fechado quando o último bloco planejado estiver em homologação, não
  quando o primeiro funcionar bem o suficiente para ninguém sentir falta do
  resto".

  A TELA NÃO DECIDE NADA (AT-07). Toda regra vive nas funções: quem pode ser
  titular, o que migra, o que se pergunta, o que se recusa. Aqui há chamada e
  exibição — e é por isso que uma recusa da função deve chegar ao Coach com o
  texto que a função mandou, não traduzida por esta página.

  OS TRÊS ESTADOS DA AT-08 (CT-31). Especialidade sem titular; titular
  desativado; contagem de atletas sem profissional. Os três vêm de
  listar-titulares.ts, e nenhum deles é inferido aqui.

  A CONTAGEM É POR ESPECIALIDADE, E NÃO SE SOMA. Um atleta sem profissional em
  treino E em nutrição aparece nas duas contagens: seis atletas podem produzir
  "1" e "6". Um total agregado diria sete, e não corresponderia a gente nenhuma.
  Por isso não há total — cada linha mostra a sua.

  DADOS EM JSON, MONTAGEM AQUI (AT-22). Diferente de aprovacoes.astro, que
  recebe HTML pronto porque há um DOCUMENTO a renderizar — o plano do atleta,
  pela mesma função que o atleta vê. Aqui não há documento, só listas.
*/}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ELITE90 PRO — Profissionais</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="icon" href="/favicon.ico" />

  <meta name="fb-api"    content={import.meta.env.PUBLIC_FIREBASE_API_KEY} />
  <meta name="fb-auth"   content={import.meta.env.PUBLIC_FIREBASE_AUTH_DOMAIN} />
  <meta name="fb-proj"   content={import.meta.env.PUBLIC_FIREBASE_PROJECT_ID} />
  <meta name="fb-bucket" content={import.meta.env.PUBLIC_FIREBASE_STORAGE_BUCKET} />
  <meta name="fb-sender" content={import.meta.env.PUBLIC_FIREBASE_MESSAGING_SENDER_ID} />
  <meta name="fb-appid"  content={import.meta.env.PUBLIC_FIREBASE_APP_ID} />

  <style is:global>
    .prf-main { max-width: 900px; margin: 0 auto; padding: 32px 24px 64px; }
    .prf-title { font-family: 'Bebas Neue', sans-serif; font-size: 2rem;
                 letter-spacing: .04em; margin: 0 0 8px; }
    .prf-sub { font-family: Montserrat, sans-serif; font-size: .9rem;
               opacity: .75; margin: 0 0 32px; }
    .prf-msg { font-family: Montserrat, sans-serif; padding: 24px;
               border: 1px solid rgba(255,255,255,.12); border-radius: 4px; }
    .prf-card { border: 1px solid rgba(255,255,255,.12); border-radius: 4px;
                margin-bottom: 20px; background: #1A1A1A; overflow: hidden; }
    .prf-card__topo { padding: 18px 20px; display: flex; flex-wrap: wrap;
                      align-items: baseline; gap: 8px 16px; }
    .prf-card__esp { font-family: 'Bebas Neue', sans-serif; font-size: 1.25rem;
                     letter-spacing: .04em; }
    .prf-card__titular { font-family: Raleway, sans-serif; font-weight: 700;
                         font-size: 1rem; }
    .prf-card__vazio { font-family: Montserrat, sans-serif; font-size: .85rem;
                       opacity: .7; }
    .prf-selo { font-family: Raleway, sans-serif; font-size: .68rem;
                text-transform: uppercase; letter-spacing: .06em;
                padding: 3px 8px; border-radius: 4px; border: 1px solid currentColor; }
    .prf-selo--ativo { color: var(--c-lime, #A6C300); }
    .prf-selo--inativo { color: #E67E22; }
    .prf-selo--ausente { color: #C0392B; }
    .prf-selo--sem { color: #999; }
    .prf-card__contagem { font-family: Montserrat, sans-serif; font-size: .8rem;
                          opacity: .8; width: 100%; }
    .prf-card__contagem button { background: none; border: none; padding: 0;
                                 color: var(--c-lime, #A6C300); cursor: pointer;
                                 font: inherit; text-decoration: underline; }
    .prf-amostra { margin: 8px 0 0; padding: 0; list-style: none; font-family: Montserrat, sans-serif;
                   font-size: .8rem; opacity: .95; }
    .prf-amostra__item { display: flex; align-items: center; gap: 8px; flex-wrap: wrap;
                         padding: 6px 0; border-top: 1px solid rgba(255,255,255,.06); }
    .prf-amostra__item span:first-child { flex: 1; min-width: 140px; }
    .prf-amostra__item select { background: #0D0D0D; border: 1px solid rgba(255,255,255,.15);
                                color: #EEE; font-family: Montserrat, sans-serif; font-size: .78rem;
                                padding: 4px; border-radius: 4px; }
    .prf-amostra__vazio { font-size: .75rem; opacity: .6; }
    .prf-card__acoes { display: flex; gap: 10px; padding: 14px 20px; flex-wrap: wrap;
                       border-top: 1px solid rgba(255,255,255,.08); }
    .prf-btn { font-family: Raleway, sans-serif; font-weight: 700; font-size: .75rem;
               text-transform: uppercase; letter-spacing: .05em; padding: 8px 14px;
               border-radius: 4px; cursor: pointer; border: none; }
    .prf-btn--principal { background: var(--c-lime, #A6C300); color: #0D0D0D; }
    .prf-btn--secundario { background: none; border: 1px solid rgba(255,255,255,.3); color: #EEE; }
    .prf-btn--perigo { background: none; border: 1px solid #C0392B; color: #C0392B; }
    .prf-btn[disabled] { opacity: .35; cursor: not-allowed; }
    .prf-form { width: 100%; margin-top: 10px; }
    .prf-form select { background: #0D0D0D; border: 1px solid rgba(255,255,255,.15);
                       color: #EEE; font-family: Montserrat, sans-serif;
                       font-size: .85rem; padding: 8px; border-radius: 4px; min-width: 260px; }
    .prf-pend { border-top: 1px solid rgba(255,255,255,.08); padding: 14px 20px; }
    .prf-pend__aviso { font-family: Montserrat, sans-serif; font-size: .8rem;
                       opacity: .75; margin: 0 0 12px; }
    .prf-pend__item { display: flex; align-items: center; gap: 10px; flex-wrap: wrap;
                      padding: 8px 0; border-top: 1px solid rgba(255,255,255,.06); }
    .prf-pend__nome { font-family: Raleway, sans-serif; font-size: .9rem; flex: 1; min-width: 180px; }
    /* Recado de ação — mesmo padrão semântico de exercicios.astro (#exc-recado):
       uma cor para sucesso, outra para erro, nunca silêncio. Generaliza o que
       antes só existia para erro (.prf-erro) — o sucesso não tinha feedback
       algum, e "a lista recarregou" não é confirmação: o Coach não sabe se foi
       a ação dele que mudou a lista ou uma atualização de outra pessoa. */
    .prf-recado { font-family: Montserrat, sans-serif; font-size: .8rem;
                  width: 100%; margin-top: 8px; padding: 7px 10px; border-radius: 4px; }
    .prf-recado--ok { color: var(--c-lime, #A6C300); background: rgba(166,195,0,.08);
                      border: 1px solid rgba(166,195,0,.3); }
    .prf-recado--erro { color: var(--c-pending, #E67E22); background: rgba(230,126,34,.08);
                        border: 1px solid rgba(230,126,34,.35); }
    /* Janela de confirmação — mesmo padrão de fichas.astro e exercicios.astro
       (classes .confirm-overlay/.confirm-box/.confirm-actions), com prefixo
       próprio porque esta tela ainda não compartilha um arquivo de estilo
       comum com aquelas. Reutilizada nas três ações que pedem confirmação:
       remover titular, conceder acesso, desativar — o texto muda, a janela é
       uma só. NÃO É window.confirm(): aquela caixa é do navegador, não pode
       ser estilizada, e nenhuma outra tela deste painel a usa para ação
       perigosa — usar aqui criaria um terceiro padrão onde já existem dois
       (fichas.astro e exercicios.astro) e o comentário deste último já avisa
       contra isso. */
    .prf-confirm-overlay { position: fixed; inset: 0; z-index: 300; display: flex;
                           align-items: center; justify-content: center;
                           background: rgba(0,0,0,.7); padding: 16px; }
    .prf-confirm-overlay[hidden] { display: none; }
    .prf-confirm-box { background: #1A1A1A; border: 1px solid var(--c-lime, #A6C300);
                       border-radius: 4px; max-width: 480px; width: 100%; padding: 24px; }
    .prf-confirm-title { font-family: 'Bebas Neue', sans-serif; font-size: 1.3rem;
                         color: #FFF; text-transform: uppercase; letter-spacing: .03em;
                         margin: 0 0 12px; }
    .prf-confirm-summary { font-family: Montserrat, sans-serif; font-size: .85rem;
                           color: #CCC; line-height: 1.7; margin: 0 0 20px; }
    .prf-confirm-actions { display: flex; gap: 10px; justify-content: flex-end; flex-wrap: wrap; }

    .prf-secao { margin-top: 44px; }
    .prf-secao__topo { display: flex; align-items: baseline; justify-content: space-between;
                       gap: 12px; flex-wrap: wrap; margin-bottom: 16px; }
    .prf-linha { border: 1px solid rgba(255,255,255,.12); border-radius: 4px;
                 background: #1A1A1A; margin-bottom: 12px; }
    .prf-linha--inativo { opacity: .55; }
    .prf-linha__topo { display: flex; align-items: baseline; gap: 8px 14px;
                       flex-wrap: wrap; padding: 14px 18px; }
    .prf-linha__nome { font-family: Raleway, sans-serif; font-weight: 700; font-size: .95rem; }
    .prf-linha__meta { font-family: Montserrat, sans-serif; font-size: .78rem; opacity: .7; }
    .prf-linha__acoes { display: flex; gap: 8px; flex-wrap: wrap; padding: 0 18px 14px; }
    .prf-campos { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
                  gap: 10px; padding: 14px 18px; border-top: 1px solid rgba(255,255,255,.08); }
    .prf-campo { display: flex; flex-direction: column; gap: 4px; }
    .prf-campo label { font-family: Raleway, sans-serif; font-size: .68rem;
                       text-transform: uppercase; letter-spacing: .06em; opacity: .7; }
    .prf-campo input, .prf-campo select {
      background: #0D0D0D; border: 1px solid rgba(255,255,255,.15); color: #EEE;
      font-family: Montserrat, sans-serif; font-size: .85rem; padding: 7px; border-radius: 4px;
      transition: border-color 120ms ease, box-shadow 120ms ease; }
    /* Mesmo padrão de EditorTreino.astro (M2, .wke-cell-input.invalid /
       .wke-cell-error, packages/editor-plano/nucleo.js) — borda vermelha no
       campo, mensagem pequena embaixo, com o mesmo token de cor
       (--c-status-rejected). Nomeado prf-* para ficar dentro do vocabulário
       desta tela, não porque o padrão em si seja diferente. */
    .prf-campo input.invalid, .prf-campo select.invalid {
      border-color: var(--c-status-rejected, #C0392B);
      box-shadow: 0 0 0 2px rgba(231,76,60,0.15); }
    /* min-height reserva o espaço da mensagem SEMPRE, mesmo vazia — sem isto,
       o texto aparecendo ao sair do campo empurra o resto da coluna para
       baixo, inclusive o botão "Salvar alterações" logo abaixo do grid. Um
       clique em sequência (sair do campo em branco, clicar em Salvar) então
       mira onde o botão estava ANTES do deslocamento, e erra o alvo — o
       clique nasce no mesmo gesto que desloca o botão. Reservar o espaço de
       antemão elimina o deslocamento, não só o sintoma num teste automatizado. */
    .prf-campo-erro { display: block; font-family: Montserrat, sans-serif; font-size: 10px;
                      line-height: 12px; height: 12px; overflow: hidden;
                      color: var(--c-status-rejected, #C0392B); margin-top: 2px; }
    .prf-campo--esp { display: flex; flex-direction: row; gap: 14px; align-items: center; }
    .prf-nota { font-family: Montserrat, sans-serif; font-size: .78rem; opacity: .65;
                border-top: 1px solid rgba(255,255,255,.08); margin-top: 28px; padding-top: 14px; }
  </style>
</head>
<body>
  <AdminHeader badge="Profissionais" backHref="/admin" />

  <main class="prf-main">
    <h1 class="prf-title">Titularidade</h1>
    <p class="prf-sub" id="prf-sub">Carregando…</p>

    <div id="prf-msg" class="prf-msg" hidden></div>
    <div id="prf-lista"></div>

    <div class="prf-confirm-overlay" id="prf-confirm-overlay" hidden>
      <div class="prf-confirm-box">
        <h3 class="prf-confirm-title" id="prf-confirm-title"></h3>
        <p class="prf-confirm-summary" id="prf-confirm-summary"></p>
        <div class="prf-confirm-actions">
          <button class="prf-btn prf-btn--secundario" id="prf-confirm-cancelar">Cancelar</button>
          <button class="prf-btn prf-btn--perigo" id="prf-confirm-ok">Confirmar</button>
        </div>
      </div>
    </div>

    <section class="prf-secao" id="prf-equipe" hidden>
      <div class="prf-secao__topo">
        <h2 class="prf-title" style="font-size:1.5rem; margin:0">Equipe</h2>
        <button class="prf-btn prf-btn--principal" id="prf-novo">Cadastrar profissional</button>
      </div>
      <div id="prf-form-novo"></div>
      <div id="prf-equipe-lista"></div>
      <p class="prf-nota">
        Encerrar uma carteira e atribuir um atleta que já tem profissional ainda não são
        feitos por esta tela — dependem de uma leitura de vínculos que está especificada
        e entra na sequência deste bloco.
      </p>
    </section>
  </main>

  <script type="module">
    import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-app.js";
    import { getAuth, onAuthStateChanged, signOut } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-auth.js";

    const cfg = {
      apiKey:            document.querySelector('meta[name="fb-api"]')?.content,
      authDomain:        document.querySelector('meta[name="fb-auth"]')?.content,
      projectId:         document.querySelector('meta[name="fb-proj"]')?.content,
      storageBucket:     document.querySelector('meta[name="fb-bucket"]')?.content,
      messagingSenderId: document.querySelector('meta[name="fb-sender"]')?.content,
      appId:             document.querySelector('meta[name="fb-appid"]')?.content,
    };
    const auth = getAuth(initializeApp(cfg));

    // Liga o botão de logout do AdminHeader compartilhado — ele só renderiza o
    // <button id="btn-logout">, sem comportamento algum, e cada página é quem
    // liga o clique à SUA PRÓPRIA instância de auth. Mesma ligação de
    // atletas.astro e fichas.astro. Sem isto, o botão existe visualmente e não
    // faz nada — é o defeito que aprovacoes.astro, exercicios.astro e
    // alimentos.astro também têm hoje; não copiar esse silêncio aqui.
    document.getElementById("btn-logout")?.addEventListener("click", async () => {
      await signOut(auth);
      window.location.href = "/admin/login";
    });

    const sub = document.getElementById("prf-sub");
    const msg = document.getElementById("prf-msg");
    const lista = document.getElementById("prf-lista");
    const equipe = document.getElementById("prf-equipe");
    const equipeLista = document.getElementById("prf-equipe-lista");
    const formNovo = document.getElementById("prf-form-novo");

    const CONSELHOS = ["CRN", "CREF", "CRM"];
    const CLASSIFICACOES = { internal: "Interno", external: "Externo" };
    // "active" fica FORA daqui de propósito: reativação é ação própria da tela
    // (botão Reativar), e não um campo do formulário de edição. A função de
    // servidor aceita `active: true` (Adendo 02, seção 7.2 — reativação É
    // edição do campo), mas nunca `active: false`, que é desativar-profissional.
    const CAMPOS_EDITAVEIS = ["name", "email", "phone", "council", "councilNumber", "councilState", "classification", "specialties"];

    const ROTULO_ESP = { training: "Treino", nutrition: "Nutrição" };
    let token = null;
    let profissionais = [];

    // ── JANELA DE CONFIRMAÇÃO (substitui window.confirm) ───────────────────
    const cfOverlay = document.getElementById("prf-confirm-overlay");
    const cfTitle = document.getElementById("prf-confirm-title");
    const cfSummary = document.getElementById("prf-confirm-summary");
    const cfOk = document.getElementById("prf-confirm-ok");
    const cfCancelar = document.getElementById("prf-confirm-cancelar");

    /** Devolve uma Promise<boolean>, no mesmo formato que confirm() devolvia
     *  de forma síncrona — os chamadores não mudam de estrutura, só ganham
     *  `await`. */
    function confirmarAcao(titulo, resumo) {
      cfTitle.textContent = titulo;
      cfSummary.textContent = resumo;
      cfOverlay.hidden = false;
      cfOk.focus();
      return new Promise((resolve) => {
        const limpar = () => {
          cfOverlay.hidden = true;
          cfOk.removeEventListener("click", onOk);
          cfCancelar.removeEventListener("click", onCancelar);
        };
        const onOk = () => { limpar(); resolve(true); };
        const onCancelar = () => { limpar(); resolve(false); };
        cfOk.addEventListener("click", onOk);
        cfCancelar.addEventListener("click", onCancelar);
      });
    }

    function mostrarMensagem(texto) {
      sub.textContent = ""; lista.innerHTML = "";
      msg.textContent = texto; msg.hidden = false;
    }

    async function chamar(fn, corpo) {
      return fetch("/.netlify/functions/" + fn, {
        method: "POST",
        headers: { "Content-Type": "application/json", "Authorization": `Bearer ${token}` },
        body: JSON.stringify(corpo ?? {}),
      });
    }

    // A recusa da função chega ao Coach COM O TEXTO DELA. A tela não traduz nem
    // resume: as mensagens de recusa carregam a regra — por que replaced é
    // reservado, por que trocar não é definir —, e reescrevê-las aqui as faria
    // divergir da função no dia em que uma das duas mudasse.
    async function erroDe(resp) {
      try { return (await resp.json()).erro || `Falha (${resp.status}).`; }
      catch { return `Falha (${resp.status}).`; }
    }

    async function carregar() {
      const [rTit, rProf] = await Promise.all([
        chamar("listar-titulares"),
        // Sem filtro de `active`: a área de equipe precisa mostrar também os
        // inativos — desativar não apaga, e uma lista que esconde o inativo faz
        // parecer que o cadastro sumiu. O seletor de titular filtra em memória.
        chamar("listar-profissionais"),
      ]);
      if (rTit.status === 403 || rProf.status === 403) {
        await signOut(auth);
        mostrarMensagem("Acesso não autorizado para esta conta.");
        return;
      }
      if (!rTit.ok || !rProf.ok) throw new Error("leitura");
      const dados = await rTit.json();
      profissionais = (await rProf.json()).itens ?? [];
      render(dados.especialidades ?? []);
      renderEquipe();
    }

    onAuthStateChanged(auth, async user => {
      if (!user) { window.location.href = "/admin/login"; return; }
      try {
        token = await user.getIdToken(true);
        await carregar();
      } catch {
        mostrarMensagem("Não foi possível carregar a titularidade agora. Tente novamente em instantes.");
      }
    });

    function render(especialidades) {
      msg.hidden = true;
      const semTitular = especialidades.filter(e => !e.titular).length;
      sub.textContent = semTitular === 0
        ? "Todas as especialidades têm titular."
        : semTitular === 1
          ? "1 especialidade sem titular."
          : `${semTitular} especialidades sem titular.`;
      lista.innerHTML = "";
      for (const e of especialidades) lista.appendChild(montarCard(e));
    }

    function montarCard(e) {
      const card = document.createElement("div");
      card.className = "prf-card";
      card.dataset.specialty = e.specialty;

      const topo = document.createElement("div");
      topo.className = "prf-card__topo";
      topo.innerHTML = `
        <span class="prf-card__esp">${ROTULO_ESP[e.specialty] ?? escapeHtml(e.specialty)}</span>
        ${montarTitular(e.titular)}
        ${montarContagem(e)}
      `;

      const acoes = document.createElement("div");
      acoes.className = "prf-card__acoes";
      acoes.innerHTML = e.titular
        ? `<button class="prf-btn prf-btn--secundario" data-acao="trocar">Trocar titular</button>
           <button class="prf-btn prf-btn--perigo" data-acao="remover">Remover titular</button>`
        : `<button class="prf-btn prf-btn--principal" data-acao="definir">Definir titular</button>`;

      card.append(topo, acoes);
      ligarAcoes(card, e, acoes);
      ligarAmostra(card, e);
      return card;
    }

    function montarTitular(t) {
      // Sem titular NÃO é falta: é estado válido (AT-08), e por isso tem selo
      // próprio em vez de espaço vazio.
      if (!t) {
        return `<span class="prf-card__vazio">Sem titular definido</span>
                <span class="prf-selo prf-selo--sem">Sem titular</span>`;
      }
      // "Ausente" e "inativo" são estados DIFERENTES, e listar-titulares.ts os
      // separa de propósito: um profissional desativado ainda está cadastrado;
      // um ausente teve o documento removido. A tela não os funde.
      const selo = t.ausente
        ? `<span class="prf-selo prf-selo--ausente">Cadastro ausente</span>`
        : t.active
          ? `<span class="prf-selo prf-selo--ativo">Ativo</span>`
          : `<span class="prf-selo prf-selo--inativo">Titular desativado</span>`;
      return `<span class="prf-card__titular">${escapeHtml(t.name ?? t.professionalId)}</span>${selo}`;
    }

    function montarContagem(e) {
      const n = e.atletasSemProfissional.total;
      if (n === 0) return `<span class="prf-card__contagem">Nenhum atleta sem profissional nesta especialidade.</span>`;
      const rotulo = n === 1 ? "1 atleta sem profissional" : `${n} atletas sem profissional`;
      return `<span class="prf-card__contagem">${rotulo} — <button data-amostra="1">ver quem</button></span>`;
    }

    function ligarAmostra(card, e) {
      const botao = card.querySelector("[data-amostra]");
      if (!botao) return;
      botao.addEventListener("click", () => {
        if (card.querySelector(".prf-amostra")) {
          card.querySelector(".prf-amostra").remove();
          botao.textContent = "ver quem";
          return;
        }
        const ul = document.createElement("ul");
        ul.className = "prf-amostra";
        const a = e.atletasSemProfissional;
        // Profissionais ATIVOS desta especialidade — mesmo filtro de
        // abrirEscolha(). Sem isso, o seletor ofereceria um profissional que
        // a própria atribuir-carteira.ts recusaria, e o erro só apareceria
        // depois do clique.
        const elegiveis = profissionais.filter(
          p => p.active && (p.specialties ?? []).includes(e.specialty),
        );
        ul.innerHTML = a.amostra.map(x => `
          <li class="prf-amostra__item" data-atleta="${x.athleteUid}">
            <span>${escapeHtml(x.name ?? x.athleteUid)}</span>
            ${elegiveis.length
              ? `<select>${elegiveis.map(p => `<option value="${p.id}">${escapeHtml(p.name)}</option>`).join("")}</select>
                 <button class="prf-btn prf-btn--secundario" data-atribuir="1">Atribuir</button>`
              : `<span class="prf-amostra__vazio">Nenhum profissional ativo com esta especialidade.</span>`}
          </li>`).join("")
          + (a.haMais ? `<li>e outros — a lista mostra os primeiros ${a.amostra.length}.</li>` : "");
        botao.parentElement.appendChild(ul);
        botao.textContent = "ocultar";

        // Um listener por item, não delegado no <ul> — cada linha precisa do
        // PRÓPRIO <select>, e delegar exigiria navegar de volta ao ancestral
        // a cada clique. O volume aqui é no máximo LIMITE_AMOSTRA (20).
        for (const li of ul.querySelectorAll("[data-atleta]")) {
          const btn = li.querySelector("[data-atribuir]");
          if (!btn) continue;
          btn.addEventListener("click", async () => {
            const athleteUid = li.dataset.atleta;
            const professionalId = li.querySelector("select").value;
            btn.disabled = true;
            li.querySelector(".prf-recado")?.remove();
            try {
              const resp = await chamar("atribuir-carteira", { athleteUid, professionalId, specialty: e.specialty });
              if (!resp.ok) throw new Error(await erroDe(resp));
              // O item some da lista — é a própria confirmação visual, mesmo
              // padrão da migração individual em abrirPendencias(). Um recado
              // de texto aqui seria redundante com o item desaparecendo.
              li.remove();
              if (!ul.querySelector("[data-atleta]")) {
                // Lista esvaziada: a contagem do card ficou desatualizada até
                // recarregar — que também busca listar-titulares de novo.
                await recarregar();
              }
            } catch (err) {
              btn.disabled = false;
              const aviso = document.createElement("p");
              aviso.className = "prf-recado prf-recado--erro";
              aviso.textContent = err?.message || "Não foi possível atribuir agora.";
              li.appendChild(aviso);
            }
          });
        }
      });
    }

    function ligarAcoes(card, e, acoes) {
      acoes.addEventListener("click", async (ev) => {
        const btn = ev.target.closest("button[data-acao]");
        if (!btn) return;
        const tipo = btn.dataset.acao;
        if (tipo === "remover") {
          const ok1 = await confirmarAcao(
            "Remover titular",
            "Remover o titular desta especialidade? Os vínculos atuais continuam ativos; apenas as próximas promoções deixam de gerar carteira.",
          );
          if (!ok1) return;
          await executarAcao(acoes, "remover-titular", { specialty: e.specialty }, "Titular removido.", card);
          return;
        }
        if (!card.querySelector(".prf-form")) abrirEscolha(card, acoes, e, tipo);
      });
    }

    function abrirEscolha(card, acoes, e, tipo) {
      const atual = e.titular?.professionalId ?? null;
      const opcoes = profissionais
        // Titular precisa estar ativo: a função recusaria um inativo, e oferecer
        // a opção seria convidar o Coach a um erro que só apareceria no envio.
        .filter(p => p.active && (p.specialties ?? []).includes(e.specialty) && p.id !== atual)
        .map(p => `<option value="${p.id}">${escapeHtml(p.name)}</option>`)
        .join("");

      const bloco = document.createElement("div");
      bloco.className = "prf-form";
      bloco.innerHTML = opcoes
        ? `<select>${opcoes}</select>
           <button class="prf-btn prf-btn--principal" data-confirmar="1" style="margin-left:8px">
             ${tipo === "trocar" ? "Confirmar troca" : "Confirmar titular"}
           </button>`
        : `<span class="prf-card__vazio">Nenhum profissional ativo com esta especialidade. Cadastre um antes.</span>`;
      acoes.appendChild(bloco);

      const confirmar = bloco.querySelector("[data-confirmar]");
      if (!confirmar) return;
      confirmar.addEventListener("click", async () => {
        const professionalId = bloco.querySelector("select").value;
        const fn = tipo === "trocar" ? "trocar-titular" : "definir-titular";
        const mensagem = tipo === "trocar" ? "Titular trocado." : "Titular definido.";
        await executarAcao(acoes, fn, { professionalId, specialty: e.specialty }, mensagem, card);
      });
    }

    // ── UMA SÓ FUNÇÃO PARA AS DUAS ÁREAS ────────────────────────────────────
    // `executar` (titularidade) e `agir` (equipe) faziam exatamente a mesma
    // coisa — chamar, desabilitar botões, recarregar — e tinham exatamente o
    // mesmo defeito: nenhuma delas confirmava sucesso. Consertar as duas em
    // separado repetiria o erro; unificadas, o conserto vale para as sete
    // ações que passam por aqui de uma vez.
    async function executarAcao(acoes, fn, corpo, mensagemOk, card) {
      for (const b of acoes.querySelectorAll("button")) b.disabled = true;
      acoes.querySelector(".prf-recado")?.remove();
      try {
        const resp = await chamar(fn, corpo);
        if (!resp.ok) throw new Error(await erroDe(resp));
        const dados = await resp.json().catch(() => ({}));
        // A troca pode voltar com vínculos explícitos a decidir. Enquanto
        // houver pendência, a tela NÃO recarrega: recarregar apagaria a lista
        // que o Coach está respondendo.
        if (fn === "trocar-titular" && (dados.pendentesDeEscolha ?? []).length) {
          abrirPendencias(card, dados);
          return;
        }
        if (mensagemOk) {
          mostrarRecado(acoes, mensagemOk, "ok");
          // A confirmação fica visível um instante antes de a lista recarregar
          // — recarregar() reconstrói o card/linha inteiro, e o recado some
          // junto com ele. Sem a pausa, o Coach nunca veria a mensagem: ela
          // nasceria e morreria no mesmo quadro.
          await new Promise((r) => setTimeout(r, 900));
        }
        formNovo.innerHTML = "";
        await recarregar();
      } catch (e) {
        for (const b of acoes.querySelectorAll("button")) b.disabled = false;
        mostrarRecado(acoes, e?.message || "Não foi possível concluir agora.", "erro");
      }
    }

    function mostrarRecado(container, texto, tipo) {
      container.querySelector(".prf-recado")?.remove();
      const aviso = document.createElement("p");
      aviso.className = `prf-recado prf-recado--${tipo}`;
      aviso.textContent = texto;
      container.appendChild(aviso);
    }

    // A METADE INTERATIVA DA TROCA (AT-16, AT-21).
    // A função migrou os vínculos `default` sozinha e devolveu os `explicit`
    // para o Coach decidir um a um — eles estão ali porque ELE escolheu aquele
    // profissional para aquele atleta, e migrá-los em massa desfaria a escolha.
    //
    // FECHAR A ABA AQUI É SEGURO. Os que sobrarem continuam com o titular
    // anterior — vínculos ativos e corretos, estado válido, não inconsistência.
    // Reabrir a troca sobre o mesmo par devolve os remanescentes (CT-34).
    function abrirPendencias(card, dados) {
      card.querySelector(".prf-form")?.remove();
      const bloco = document.createElement("div");
      bloco.className = "prf-pend";
      bloco.innerHTML = `<p class="prf-pend__aviso">
        ${dados.vinculosMigrados} vínculo(s) migrado(s) automaticamente.
        ${dados.pendentesDeEscolha.length} atleta(s) foram atribuídos individualmente ao titular anterior —
        decida um a um. Pode fechar a página: quem ficar sem resposta permanece com o profissional atual,
        e a troca pode ser retomada depois.
      </p>`;
      for (const p of dados.pendentesDeEscolha) {
        const item = document.createElement("div");
        item.className = "prf-pend__item";
        item.innerHTML = `
          <span class="prf-pend__nome">${escapeHtml(p.athleteUid)}</span>
          <button class="prf-btn prf-btn--principal" data-migrar="1">Migrar para o novo titular</button>
          <button class="prf-btn prf-btn--secundario" data-manter="1">Manter como está</button>
        `;
        item.querySelector("[data-manter]").addEventListener("click", () => concluir(item, bloco, card));
        item.querySelector("[data-migrar]").addEventListener("click", async (ev) => {
          for (const b of item.querySelectorAll("button")) b.disabled = true;
          try {
            // Cada resposta vira uma chamada a atribuir-carteira.ts, que já faz
            // substituição e já grava origin "explicit" (AT-16). Nenhuma função
            // nova para esta metade.
            const resp = await chamar("atribuir-carteira", {
              athleteUid: p.athleteUid,
              professionalId: dados.professionalId,
              specialty: dados.specialty,
            });
            if (!resp.ok) throw new Error(await erroDe(resp));
            concluir(item, bloco, card);
          } catch (e) {
            for (const b of item.querySelectorAll("button")) b.disabled = false;
            // O item desaparecer da lista JÁ É a confirmação de sucesso aqui —
            // não precisa de recado de "ok" além disso. O de erro, sim.
            const aviso = document.createElement("span");
            aviso.className = "prf-recado prf-recado--erro";
            aviso.textContent = e?.message || "Não foi possível migrar agora.";
            item.appendChild(aviso);
          }
        });
        bloco.appendChild(item);
      }
      card.appendChild(bloco);
    }

    function concluir(item, bloco, card) {
      item.remove();
      if (!bloco.querySelector(".prf-pend__item")) recarregar();
    }

    async function recarregar() {
      try {
        sub.textContent = "Atualizando…";
        await carregar();
      } catch {
        mostrarMensagem("A ação foi concluída, mas não foi possível recarregar a tela. Atualize a página.");
      }
    }

    // ── ÁREA 2 · EQUIPE ──────────────────────────────────────────────────
    // Quatro dos nove atos da AT-07: cadastrar, editar, conceder acesso e
    // desativar. Atribuir carteira entra pela área de titularidade, a partir
    // dos atletas sem profissional. Os dois que faltam estão declarados no
    // cabeçalho e na nota ao pé da seção.

    function renderEquipe() {
      equipe.hidden = false;
      equipeLista.innerHTML = "";
      if (!profissionais.length) {
        const vazio = document.createElement("p");
        vazio.className = "prf-card__vazio";
        vazio.textContent = "Nenhum profissional cadastrado ainda.";
        equipeLista.appendChild(vazio);
        return;
      }
      for (const p of profissionais) equipeLista.appendChild(montarLinha(p));
    }

    function montarLinha(p) {
      const linha = document.createElement("div");
      linha.className = p.active ? "prf-linha" : "prf-linha prf-linha--inativo";
      const esp = (p.specialties ?? []).map(e => ROTULO_ESP[e] ?? e).join(" e ");
      linha.innerHTML = `
        <div class="prf-linha__topo">
          <span class="prf-linha__nome">${escapeHtml(p.name)}</span>
          <span class="prf-selo ${p.active ? "prf-selo--ativo" : "prf-selo--inativo"}">${p.active ? "Ativo" : "Inativo"}</span>
          <span class="prf-linha__meta">${escapeHtml(p.council)} ${escapeHtml(p.councilNumber)}${p.councilState ? "/" + escapeHtml(p.councilState) : ""} · ${CLASSIFICACOES[p.classification] ?? escapeHtml(p.classification)} · ${escapeHtml(esp)}</span>
          <span class="prf-linha__meta">${escapeHtml(p.email)}</span>
        </div>
        <div class="prf-linha__acoes">
          <button class="prf-btn prf-btn--secundario" data-editar="1">Editar</button>
          ${p.active
            ? `<button class="prf-btn prf-btn--secundario" data-acesso="1">Conceder acesso</button>
               <button class="prf-btn prf-btn--perigo" data-desativar="1">Desativar</button>`
            // Reativar chama atualizar-profissional com { active: true } — a
            // mesma função de editar, não desativar-profissional ao contrário.
            // É o que o Adendo 02 (seção 7.2) determina: reativação É edição
            // do campo, não uma quarta ação de rastreabilidade própria.
            : `<button class="prf-btn prf-btn--secundario" data-reativar="1">Reativar</button>`}
        </div>
      `;
      const acoes = linha.querySelector(".prf-linha__acoes");
      linha.querySelector("[data-editar]").addEventListener("click", () => abrirEdicao(linha, p));
      linha.querySelector("[data-acesso]")?.addEventListener("click", async () => {
        // A concessão é idempotente do lado da função; a confirmação existe
        // porque ela dispara e-mail e cria conta — efeito fora do banco.
        const ok2 = await confirmarAcao("Conceder acesso", `Conceder acesso ao portal para ${p.name}?`);
        if (!ok2) return;
        await executarAcao(acoes, "criar-conta-profissional", { professionalId: p.id }, "Acesso concedido.");
      });
      linha.querySelector("[data-reativar]")?.addEventListener("click", async () => {
        const ok4 = await confirmarAcao("Reativar profissional", `Reativar ${p.name}? Ele volta a poder receber carteira e conceder acesso.`);
        if (!ok4) return;
        await executarAcao(acoes, "atualizar-profissional", { professionalId: p.id, active: true }, "Profissional reativado.");
      });
      linha.querySelector("[data-desativar]")?.addEventListener("click", async () => {
        const ok3 = await confirmarAcao(
          "Desativar profissional",
          `Desativar ${p.name}? As carteiras dele permanecem como estão — desativar não encerra vínculo.`,
        );
        if (!ok3) return;
        await executarAcao(acoes, "desativar-profissional", { professionalId: p.id }, "Profissional desativado.");
      });
      return linha;
    }

    function abrirEdicao(linha, p) {
      // O ALVO DO TOGGLE É O ENVOLTÓRIO INTEIRO (.prf-edicao), NÃO O GRID DE
      // CAMPOS SOZINHO. `montarCampos()` devolve um `<div>` sem classe, com o
      // grid (.prf-campos) dentro; os botões Salvar/Cancelar são irmãos desse
      // grid, dentro do MESMO envoltório. Checar e remover só `.prf-campos`
      // apagava o grid e deixava o envoltório — e os botões — órfãos na tela;
      // o próximo clique em Editar não encontrava mais `.prf-campos` e montava
      // tudo de novo, empilhando um segundo par de botões ao lado do órfão.
      const existente = linha.querySelector(".prf-edicao");
      if (existente) { existente.remove(); return; }

      const bloco = montarCampos(p);
      bloco.classList.add("prf-edicao");
      const acoes = document.createElement("div");
      acoes.className = "prf-linha__acoes";
      acoes.innerHTML = `
        <button class="prf-btn prf-btn--principal" data-salvar="1">Salvar alterações</button>
        <button class="prf-btn prf-btn--secundario" data-cancelar="1">Cancelar</button>
      `;
      bloco.appendChild(acoes);
      acoes.querySelector("[data-cancelar]").addEventListener("click", () => bloco.remove());
      acoes.querySelector("[data-salvar]").addEventListener("click", async () => {
        // Só os campos ALTERADOS vão no corpo. A função responde
        // `alterado: false` quando nada mudou, e mandar tudo faria toda edição
        // parecer alteração de nove campos na rastreabilidade.
        const carga = { professionalId: p.id };
        for (const [chave, valor] of Object.entries(lerCampos(bloco))) {
          let atual = chave === "specialties" ? (p.specialties ?? []).join(",") : (p[chave] ?? "");
          let novo = chave === "specialties" ? valor.join(",") : (valor ?? "");
          // Telefone é comparado por DÍGITOS, não pela string formatada. O
          // campo entra na tela já com máscara (formatarTelefone), e o valor
          // gravado em `p.phone` pode ser de antes desta máscara existir —
          // sem esta normalização, abrir a edição e salvar SEM tocar no
          // telefone ainda o marcaria como alterado, só por causa dos
          // parênteses e do traço que a máscara acrescenta.
          if (chave === "phone") {
            atual = String(atual).replace(/\D/g, "");
            novo = String(novo).replace(/\D/g, "");
          }
          if (String(atual) !== String(novo)) carga[chave] = valor;
        }
        if (Object.keys(carga).length === 1) {
          // Nada mudou. Fechar em silêncio aqui não é o mesmo problema do
          // sucesso sem feedback: não houve ação nenhuma a confirmar, e um
          // recado de "nada para salvar" seria ruído para quem só queria
          // olhar os campos e fechar.
          bloco.remove();
          return;
        }
        // Mesma proteção do cadastro: campo obrigatório que o Coach deixou em
        // branco vira `null` em silêncio (lerCampos) e só falharia no
        // servidor, sem apontar qual campo foi. Verifica só os que estão de
        // fato no corpo desta edição — os que não mudaram nem entram em jogo.
        const faltando = [
          ["name", "o nome"],
          ["email", "o e-mail"],
          ["councilNumber", "o número do conselho"],
        ].filter(([k]) => k in carga && !carga[k]).map(([, r]) => r);
        if ("specialties" in carga && !carga.specialties.length) {
          faltando.push("ao menos uma especialidade");
        }
        if (faltando.length) {
          mostrarRecado(acoes, `Falta preencher ${faltando.join(", ")}.`, "erro");
          return;
        }
        await executarAcao(acoes, "atualizar-profissional", carga, "Alterações salvas.");
      });
      linha.appendChild(bloco);
    }

    /**
     * Formata telefone brasileiro enquanto o Coach digita — (11) 91234-5678 ou
     * (11) 1234-5678, conforme o total de dígitos. Não existe precedente de
     * máscara no projeto (nenhuma outra tela formata telefone); esta é
     * puramente JavaScript, sem biblioteca nova, no mesmo espírito do resto do
     * arquivo.
     *
     * O VALOR GRAVADO É O FORMATADO, NÃO SÓ DÍGITOS. `phone` é
     * `textoOpcional`, sem formato imposto pelo servidor (_m2-validacao.ts) —
     * não há norma para a tela impor além dela mesma. Guardar "(11)
     * 91234-5678" em vez de "11912345678" é mais legível para quem olhar o
     * cadastro depois, e a tela não pode ficar mais rígida que o servidor: um
     * número fora do padrão de 11 dígitos (DDI, ramal) ainda é aceito — só
     * sai sem máscara completa.
     */
    function formatarTelefone(valor) {
      const todos = valor.replace(/\D/g, "");
      const d = todos.slice(0, 11);
      // O que passa de 11 dígitos (DDI, ramal) é PRESERVADO, só sem entrar na
      // máscara — descartá-lo aqui apagaria dígitos de um número existente
      // que ninguém pediu para editar. Sem isto, abrir a edição de um
      // profissional com telefone fora do padrão e salvar sem tocar no campo
      // reescreveria o telefone truncado, por a exibição inicial já ter
      // perdido os dígitos que o comparador de diff depois compara contra o
      // valor original intacto.
      const extra = todos.slice(11);
      let base;
      if (d.length <= 2) base = d.length ? `(${d}` : "";
      else if (d.length <= 6) base = `(${d.slice(0, 2)}) ${d.slice(2)}`;
      else if (d.length <= 10) base = `(${d.slice(0, 2)}) ${d.slice(2, 6)}-${d.slice(6)}`;
      else base = `(${d.slice(0, 2)}) ${d.slice(2, 7)}-${d.slice(7)}`;
      return base + extra;
    }

    function montarCampos(p) {
      const bloco = document.createElement("div");
      const campos = document.createElement("div");
      campos.className = "prf-campos";
      const v = (k) => escapeHtml(p?.[k] ?? "");
      campos.innerHTML = `
        <div class="prf-campo"><label>Nome</label><input data-c="name" value="${v("name")}" />
          <span class="prf-campo-erro" data-erro="name"></span></div>
        <div class="prf-campo"><label>E-mail</label><input type="email" data-c="email" value="${v("email")}" />
          <span class="prf-campo-erro" data-erro="email"></span></div>
        <div class="prf-campo"><label>Telefone</label><input type="tel" data-c="phone" value="${formatarTelefone(p?.phone ?? "")}" /></div>
        <div class="prf-campo"><label>Conselho</label><select data-c="council">
          ${CONSELHOS.map(c => `<option value="${c}"${p?.council === c ? " selected" : ""}>${c}</option>`).join("")}
        </select></div>
        <div class="prf-campo"><label>Número</label><input data-c="councilNumber" value="${v("councilNumber")}" />
          <span class="prf-campo-erro" data-erro="councilNumber"></span></div>
        <div class="prf-campo"><label>UF</label><input data-c="councilState" maxlength="2" value="${v("councilState")}" /></div>
        <div class="prf-campo"><label>Classificação</label><select data-c="classification">
          ${Object.entries(CLASSIFICACOES).map(([k, r]) => `<option value="${k}"${p?.classification === k ? " selected" : ""}>${r}</option>`).join("")}
        </select></div>
        <div class="prf-campo"><label>Especialidades</label><span class="prf-campo--esp">
          ${Object.entries(ROTULO_ESP).map(([k, r]) => `<label style="text-transform:none;opacity:1"><input type="checkbox" data-esp="${k}"${(p?.specialties ?? []).includes(k) ? " checked" : ""} /> ${r}</label>`).join("")}
        </span></div>
      `;

      // Telefone: reformata a cada tecla — a máscara acima. Cursor sempre vai
      // para o fim; para um campo curto como telefone, isso não incomoda o
      // suficiente para justificar a lógica de preservar posição do cursor.
      campos.querySelector('[data-c="phone"]').addEventListener("input", (ev) => {
        ev.target.value = formatarTelefone(ev.target.value);
      });

      // E-mail e UF: o SERVIDOR já normaliza os dois — email para minúsculas,
      // councilState para maiúsculas (cadastrar-profissional.ts e
      // atualizar-profissional.ts, nas duas direções). Sem espelhar isso aqui,
      // reescrever o mesmo e-mail com caixa diferente numa edição passa no
      // comparador de diff como "mudou", dispara uma chamada e grava um
      // `profissional.editado` por uma alteração que não existe — o servidor
      // ia normalizar para o valor idêntico de qualquer forma. Não é
      // invenção: é a tela deixar de divergir do que o back-end já decide.
      // SEM setSelectionRange: `input[type="email"]` recusa o método com
      // InvalidStateError na maioria dos navegadores — mesma restrição de
      // type="number". Descoberto testando em execução, não por leitura: o
      // campo quebraria assim que alguém digitasse uma maiúscula. O cursor
      // pula para o fim a cada tecla — aceitável num campo curto, mesmo
      // trade-off já assumido na máscara de telefone acima.
      campos.querySelector('[data-c="email"]').addEventListener("input", (ev) => {
        ev.target.value = ev.target.value.toLowerCase();
      });
      campos.querySelector('[data-c="councilState"]').addEventListener("input", (ev) => {
        ev.target.value = ev.target.value.toUpperCase();
      });

      // ── VALIDAÇÃO POR CAMPO, AO SAIR DO CAMPO ───────────────────────────
      // Mesmo padrão visual de EditorTreino.astro (M2, aba Treino — o editor
      // de séries da gaveta do atleta): borda vermelha no campo mais uma
      // mensagem pequena logo abaixo, escrita e revelada quando o Coach sai
      // do campo, não só no envio do formulário.
      //
      // UM DESVIO DELIBERADO DO ORIGINAL: lá o disparo é `onchange`, que só
      // dispara quando o VALOR MUDOU — faz sentido numa tabela de séries já
      // preenchida, onde o Coach está corrigindo um valor existente. Aqui o
      // formulário nasce vazio (cadastro) ou parcialmente preenchido
      // (edição), e um campo obrigatório em branco também precisa acusar ao
      // ser abandonado, mesmo sem o Coach ter digitado nada nele. Por isso o
      // gatilho é `blur` puro, que dispara sempre — é o que corresponde a
      // "assim que o foco seja retirado do campo".
      //
      // SÓ NOME, E-MAIL E NÚMERO DO CONSELHO. Telefone e UF não têm formato a
      // violar além do que a própria máscara/normalização já impede ao
      // digitar (a seção acima). Conselho e Classificação são <select>, sempre
      // preenchidos com um valor válido por padrão do navegador. Especialidades
      // é grupo de checkbox, sem um único campo para o `blur` mirar — continua
      // verificado só no envio, no recado de resumo já existente.
      function validarCampo(chave, mensagemSeVazio) {
        const input = campos.querySelector(`[data-c="${chave}"]`);
        const erro = campos.querySelector(`[data-erro="${chave}"]`);
        input.addEventListener("blur", () => {
          const valor = input.value.trim();
          let msg = null;
          if (!valor) {
            msg = mensagemSeVazio;
          } else if (chave === "email" && !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(valor)) {
            // Mesma expressão de _m2-validacao.ts (validarProfissional) — a
            // tela não pode ser nem mais nem menos rígida que o servidor.
            msg = "E-mail em formato inválido.";
          }
          input.classList.toggle("invalid", !!msg);
          // Nunca `hidden`: o span fica sempre no layout (min-height reserva
          // o espaço em CSS), só o texto muda — [hidden] removeria a caixa e
          // devolveria o deslocamento que esta abordagem existe para evitar.
          erro.textContent = msg ?? "";
        });
      }
      validarCampo("name", "Nome é obrigatório.");
      validarCampo("email", "E-mail é obrigatório.");
      validarCampo("councilNumber", "Número do conselho é obrigatório.");

      bloco.appendChild(campos);
      return bloco;
    }

    function lerCampos(bloco) {
      const dados = {};
      for (const el of bloco.querySelectorAll("[data-c]")) {
        const valor = el.value.trim();
        dados[el.dataset.c] = valor === "" ? null : valor;
      }
      dados.specialties = [...bloco.querySelectorAll("[data-esp]")].filter(c => c.checked).map(c => c.dataset.esp);
      return dados;
    }

    function abrirCadastro() {
      if (formNovo.firstChild) { formNovo.innerHTML = ""; return; }
      const bloco = montarCampos(null);
      bloco.className = "prf-linha";
      const acoes = document.createElement("div");
      acoes.className = "prf-linha__acoes";
      acoes.innerHTML = `<button class="prf-btn prf-btn--principal" data-criar="1">Cadastrar</button>
                         <button class="prf-btn prf-btn--secundario" data-cancelar="1">Cancelar</button>`;
      bloco.appendChild(acoes);
      acoes.querySelector("[data-cancelar]").addEventListener("click", () => { formNovo.innerHTML = ""; });
      acoes.querySelector("[data-criar]").addEventListener("click", async () => {
        const carga = lerCampos(bloco);
        // Validação de tela é conveniência; a garantia é do servidor
        // (validarProfissional, em _m2-validacao.ts). Ela existe aqui só para
        // não gastar uma ida à rede num cadastro obviamente incompleto — e
        // para apontar QUAL campo falta, o que o erro do servidor não faz
        // sozinho. Mesmo padrão de exercicios.astro (criarExercicio).
        const faltando = [
          ["name", "o nome"],
          ["email", "o e-mail"],
          ["councilNumber", "o número do conselho"],
        ].filter(([k]) => !carga[k]).map(([, r]) => r);
        if (!carga.specialties.length) faltando.push("ao menos uma especialidade");
        if (faltando.length) {
          mostrarRecado(acoes, `Falta preencher ${faltando.join(", ")}.`, "erro");
          return;
        }
        await executarAcao(acoes, "cadastrar-profissional", carga, "Profissional cadastrado.");
      });
      formNovo.appendChild(bloco);
    }

    document.getElementById("prf-novo").addEventListener("click", abrirCadastro);

    function escapeHtml(s) {
      const d = document.createElement("div");
      d.textContent = s ?? "";
      return d.innerHTML;
    }
  </script>
</body>
</html>
