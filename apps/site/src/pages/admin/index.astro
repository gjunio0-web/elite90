---
export const prerender = false;
import '@fontsource/bebas-neue';
import '@fontsource/raleway/400.css';
import '@fontsource/raleway/700.css';
import '@fontsource/montserrat/400.css';
import '@fontsource/montserrat/700.css';
import '../../styles/tokens.css';
import '../../styles/global.css';
import AdminHeader from '../../components/AdminHeader.astro';
---
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ELITE90 PRO — Painel de Controle</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="icon" href="/favicon.ico" />
  <style is:global>
    /* ── LAYOUT ─────────────────────────────────────────────────────── */
    body { min-height: 100vh; }

    .dash-main {
      max-width: 1100px;
      margin: 0 auto;
      padding: var(--space-7) var(--space-5);
    }

    /* ── PAGE HEADER ─────────────────────────────────────────────────── */
    .dash-eyebrow {
      font-family: var(--font-label);
      font-size: var(--fs-label);
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.18em;
      color: var(--c-textsub);
      margin-bottom: var(--space-2);
    }
    .dash-title {
      font-family: var(--font-display);
      font-size: var(--fs-display-lg);
      font-weight: 400;
      color: var(--c-white);
      text-transform: uppercase;
      line-height: 1;
      margin-bottom: var(--space-7);
    }
    .dash-title span { color: var(--c-lime); }

    /* ── MODULE GRID ─────────────────────────────────────────────────── */
    .modules {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: var(--space-4);
    }

    .mod-card {
      background: var(--c-darkbg);
      border: 1px solid rgba(255,255,255,0.05);
      border-radius: var(--radius-card);
      display: flex;
      flex-direction: column;
      overflow: hidden;
      transition: border-color var(--transition-base);
      text-decoration: none;
    }
    .mod-card:hover { border-color: rgba(166,195,0,0.25); }
    .mod-card--disabled {
      opacity: 0.4;
      pointer-events: none;
    }

    .mod-bar {
      height: 3px;
      background: linear-gradient(to right, var(--c-lime), var(--c-olive));
      flex-shrink: 0;
    }
    .mod-bar--blue  { background: linear-gradient(to right, #4A90D9, #2C5F8A); }
    .mod-bar--muted { background: rgba(255,255,255,0.06); }

    .mod-body {
      padding: var(--space-5) var(--space-5) var(--space-4);
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
    }

    .mod-eyebrow {
      font-family: var(--font-label);
      font-size: var(--fs-label);
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.15em;
      color: var(--c-lime);
    }
    .mod-eyebrow--blue  { color: var(--c-status-progress); }
    .mod-eyebrow--muted { color: rgba(255,255,255,0.2); }

    .mod-title {
      font-family: var(--font-display);
      font-size: var(--fs-display-sm);
      font-weight: 400;
      color: var(--c-white);
      text-transform: uppercase;
      line-height: 1.1;
    }
    .mod-title--muted { color: rgba(255,255,255,0.2); }

    .mod-sub {
      font-family: var(--font-label);
      font-size: var(--fs-label);
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--c-textsub);
    }
    .mod-sub--muted { color: rgba(255,255,255,0.12); }

    .mod-desc {
      font-family: var(--font-body);
      font-size: var(--fs-body-sm);
      color: var(--c-textsub);
      line-height: 1.7;
      flex: 1;
      margin-top: var(--space-1);
    }
    .mod-desc--muted { color: rgba(255,255,255,0.15); }

    .mod-footer {
      border-top: 1px solid rgba(255,255,255,0.05);
      padding: var(--space-3) var(--space-5);
    }
    .mod-link {
      font-family: var(--font-label);
      font-size: var(--fs-label);
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: var(--c-lime);
      display: flex;
      align-items: center;
      justify-content: space-between;
      text-decoration: none;
    }
    .mod-link--muted { color: rgba(255,255,255,0.15); }

    /* ── GUIDE CARD ──────────────────────────────────────────────────── */
    /* Fica FORA da grade .modules de propósito. A grade responde "o que
       gerenciar"; o guia não é um módulo que se gerencia, e um quarto cartão
       idêntico faria a tela parecer ter quatro módulos quando tem dois.
       Daí a diferença deliberada: largura inteira, sem barra colorida no topo,
       fundo transparente com borda tracejada, ícone à esquerda. */
    /* ── BASES DE DOMÍNIO ──
       Ficam ENTRE os módulos e o cartão do guia, e são visualmente
       subordinadas de propósito (decisão 4 da spec do catálogo): não são um
       quarto módulo. Um módulo é uma área do produto; uma base é o insumo que
       as áreas consomem. Daí nome em Raleway e não em Bebas Neue, barra oliva
       em vez das cores de módulo, e borda sólida — o cartão do guia fica com a
       tracejada que já tinha, e assim os três níveis não se confundem. */
    .bases { margin-top: var(--space-6); }
    .bases__titulo {
      font-family: var(--font-label); font-weight: var(--fw-label);
      font-size: var(--fs-label); letter-spacing: var(--tracking-label);
      text-transform: uppercase; color: var(--c-textsub); margin: 0 0 var(--space-3);
    }
    .base-card {
      display: flex; align-items: center; gap: var(--space-4);
      background: var(--c-darkbg); border: 1px solid var(--c-line-muted);
      border-left: 3px solid var(--c-olive);
      border-radius: 0 var(--radius-card) var(--radius-card) 0;
      padding: var(--space-4) var(--space-5); margin-bottom: var(--space-2);
      text-decoration: none;
      transition: border-color var(--transition-base), background var(--transition-base);
    }
    .base-card:hover { border-left-color: var(--c-lime); background: rgba(166,195,0,0.04); }
    .base-card--futura { opacity: 0.45; pointer-events: none; }
    .base-card__icone { color: var(--c-lime); flex-shrink: 0; display: flex; }
    .base-card--futura .base-card__icone { color: var(--c-textsub); }
    .base-card__corpo { flex: 1; min-width: 0; }
    .base-card__nome { font-family: var(--font-label); font-weight: var(--fw-label); font-size: var(--fs-body-md); color: var(--c-white); display: block; }
    .base-card__sub { font-size: var(--fs-body-sm); color: var(--c-textsub); display: block; margin-top: 2px; }
    .base-card__selo {
      font-family: var(--font-label); font-weight: var(--fw-label); font-size: 0.625rem;
      letter-spacing: 0.08em; text-transform: uppercase; white-space: nowrap;
      padding: 4px 10px; border-radius: var(--radius-pill);
      color: var(--c-pending); border: 1px solid rgba(230,126,34,0.45); background: rgba(230,126,34,0.12);
    }
    .base-card__selo--neutro { color: var(--c-textsub); border-color: var(--c-line-muted); background: transparent; }
    .base-card__seta { color: var(--c-lime); flex-shrink: 0; display: flex; }
    @media (max-width: 600px) {
      .base-card { flex-wrap: wrap; gap: var(--space-3); }
      .base-card__corpo { flex-basis: 100%; order: 2; }
    }

    .guide-card {
      margin-top: var(--space-4);
      background: transparent;
      border: 1px dashed rgba(166,195,0,0.28);
      border-radius: var(--radius-card);
      padding: var(--space-4) var(--space-5);
      display: flex;
      align-items: flex-start;
      gap: var(--space-4);
      text-decoration: none;
      transition: border-color var(--transition-base), background var(--transition-base);
    }
    .guide-card:hover {
      border-color: rgba(166,195,0,0.6);
      background: rgba(166,195,0,0.03);
    }
    .guide-card__icon {
      color: var(--c-lime);
      flex-shrink: 0;
      margin-top: 2px;
    }
    .guide-card__body { flex: 1; min-width: 220px; }
    .guide-card__eyebrow {
      font-family: var(--font-label);
      font-size: var(--fs-label);
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.15em;
      color: var(--c-textsub);
      margin-bottom: var(--space-1);
    }
    .guide-card__title {
      font-family: var(--font-display);
      font-size: var(--fs-display-sm);
      font-weight: 400;
      color: var(--c-white);
      text-transform: uppercase;
      line-height: 1.1;
      margin-bottom: var(--space-2);
    }
    .guide-card__desc {
      font-family: var(--font-body);
      font-size: var(--fs-body-sm);
      color: var(--c-textsub);
      line-height: 1.7;
      max-width: 62ch;
      margin: 0;
    }
    .guide-card__link {
      font-family: var(--font-label);
      font-size: var(--fs-label);
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: var(--c-lime);
      display: flex;
      align-items: center;
      gap: var(--space-2);
      flex-shrink: 0;
      align-self: center;
    }

    /* ── STATUS BAR ──────────────────────────────────────────────────── */
    .status-bar {
      margin-top: var(--space-7);
      background: var(--c-darkbg);
      border: 1px solid rgba(255,255,255,0.05);
      border-radius: var(--radius-card);
      padding: var(--space-3) var(--space-5);
      display: flex;
      align-items: center;
      gap: var(--space-3);
    }
    .status-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--c-lime);
      flex-shrink: 0;
      box-shadow: 0 0 8px rgba(166,195,0,0.5);
    }
    .status-text {
      font-family: var(--font-body);
      font-size: var(--fs-body-sm);
      color: var(--c-textsub);
    }
    .status-text strong { color: var(--c-white); font-weight: 700; }

    @media (max-width: 600px) {
      .dash-main { padding: var(--space-5) var(--space-3); }
      .dash-title { font-size: var(--fs-display-md); margin-bottom: var(--space-5); }
      .modules { grid-template-columns: 1fr; }
      .guide-card { flex-wrap: wrap; gap: var(--space-3); }
      .guide-card__link { align-self: flex-start; }
    }
  </style>
</head>
<body>

  <AdminHeader badge="Admin" />

  <main class="dash-main">
    <p class="dash-eyebrow">Painel de Controle</p>
    <h1 class="dash-title">Escolha o que <span>gerenciar</span></h1>

    <div class="modules">

      <!-- Módulo 1: Captação & Triagem -->
      <a class="mod-card" href="/admin/fichas">
        <div class="mod-bar"></div>
        <div class="mod-body">
          <p class="mod-eyebrow">Captação &amp; Triagem</p>
          <h2 class="mod-title">Fichas de Triagem</h2>
          <p class="mod-sub">Gestão de Leads</p>
          <p class="mod-desc">Acesse todas as fichas preenchidas pelos atletas, filtre por status, visualize os dados completos, altere o andamento de cada lead e exporte para CSV com um clique.</p>
        </div>
        <div class="mod-footer">
          <span class="mod-link">Acessar fichas <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></span>
        </div>
      </a>

      <!-- Módulo 2: Acompanhamento do Atleta -->
      <a class="mod-card" href="/admin/atletas">
        <div class="mod-bar mod-bar--blue"></div>
        <div class="mod-body">
          <p class="mod-eyebrow mod-eyebrow--blue">Acompanhamento do Atleta</p>
          <h2 class="mod-title">Ciclo de 90 Dias</h2>
          <p class="mod-sub">Treinos, Nutrição &amp; Evolução</p>
          <p class="mod-desc">Acompanhe cada atleta do Elite90. Acesse check-ins semanais, treinos personalizados, plano nutricional e fotos evolutivas. Ainda, gere e envie relatórios de avaliação com a apoio de IA.</p>
        </div>
        <div class="mod-footer">
          <span class="mod-link" style="color:var(--c-status-progress)">Acessar atletas <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></span>
        </div>
      </a>

      <!-- Módulo 3: Gestão & Resultados (ainda não implementado) -->
      <div class="mod-card mod-card--disabled">
        <div class="mod-bar mod-bar--muted"></div>
        <div class="mod-body">
          <p class="mod-eyebrow mod-eyebrow--muted">Gestão &amp; Resultados</p>
          <h2 class="mod-title mod-title--muted">Dashboard Executivo</h2>
          <p class="mod-sub mod-sub--muted">Financeiro, BI &amp; Conteúdo</p>
          <p class="mod-desc mod-desc--muted">Visualize KPIs de faturamento, taxas de conversão e churn. Gerencie pagamentos, conteúdo premium e comunidade VIP com dados em tempo real.</p>
        </div>
        <div class="mod-footer">
          <span class="mod-link mod-link--muted">Em desenvolvimento (Sprint 2+)</span>
        </div>
      </div>

    </div>

    <section class="bases" aria-labelledby="bases-titulo">
      <h2 class="bases__titulo" id="bases-titulo">Bases de domínio</h2>

      <a class="base-card" href="/admin/exercicios">
        <span class="base-card__icone" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 4v16M18 4v16M2 8v8M22 8v8M6 12h12"/></svg>
        </span>
        <span class="base-card__corpo">
          <span class="base-card__nome">Catálogo de Exercícios</span>
          <span class="base-card__sub" id="bases-ex-sub">Nomes, instruções e classificação dos exercícios</span>
        </span>
        <span class="base-card__selo base-card__selo--neutro" id="bases-ex-selo">carregando…</span>
        <span class="base-card__seta" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </span>
      </a>

      <div class="base-card base-card--futura" aria-disabled="true">
        <span class="base-card__icone" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 3v8a2 2 0 0 0 4 0V3M9 11v10M17 3c-1.7 0-3 2-3 5s1 4 3 4v9"/></svg>
        </span>
        <span class="base-card__corpo">
          <span class="base-card__nome">Base de Alimentos</span>
          <span class="base-card__sub">TACO e curadoria própria</span>
        </span>
        <span class="base-card__selo base-card__selo--neutro">Em desenvolvimento</span>
      </div>
    </section>

    <a class="guide-card" href="/admin/guia">
      <div class="guide-card__icon" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="9"/>
          <path d="M9.2 9.2a2.9 2.9 0 0 1 5.6 1c0 1.9-2.8 2.4-2.8 4"/>
          <line x1="12" y1="17.4" x2="12" y2="17.4"/>
        </svg>
      </div>
      <div class="guide-card__body">
        <p class="guide-card__eyebrow">Referência rápida</p>
        <h2 class="guide-card__title">Como o painel funciona</h2>
        <p class="guide-card__desc">Da candidatura que chega sozinha ao atleta aceito no programa: o que o sistema faz por conta própria, onde a inteligência artificial ajuda e o que só você decide. Inclui a composição da nota de triagem e o significado de cada aviso de saúde.</p>
      </div>
      <span class="guide-card__link">Abrir guia <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></span>
    </a>

    <div class="status-bar">
      <span class="status-dot"></span>
      <span class="status-text"><strong id="adm-email">Carregando...</strong> está autenticado e pode gerenciar o ELITE90 PRO com segurança.</span>
    </div>
  </main>

  <script type="module">
    import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-app.js";
    import { getAuth, signOut, onAuthStateChanged } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-auth.js";

    const cfg = {
      apiKey:            document.querySelector('meta[name="fb-api"]')?.content,
      authDomain:        document.querySelector('meta[name="fb-auth"]')?.content,
      projectId:         document.querySelector('meta[name="fb-proj"]')?.content,
      storageBucket:     document.querySelector('meta[name="fb-bucket"]')?.content,
      messagingSenderId: document.querySelector('meta[name="fb-sender"]')?.content,
      appId:             document.querySelector('meta[name="fb-appid"]')?.content,
    };
    const app  = initializeApp(cfg);
    const auth = getAuth(app);

    onAuthStateChanged(auth, user => {
      if (!user) { window.location.href = "/admin/login"; return; }
      const el = document.getElementById("adm-email");
      if (el) el.textContent = user.email ?? "";
      contarExercicios(user);
    });

    // Selo de pendências da base de exercícios. Falha em SILÊNCIO de propósito:
    // o hub é a porta de entrada do painel, e uma base de domínio fora do ar não
    // pode encher a tela de erro nem atrasar o resto. Sem resposta, o selo some
    // — ausente é melhor que número inventado, e o caminho para a tela continua.
    async function contarExercicios(user) {
      const selo = document.getElementById("bases-ex-selo");
      const sub  = document.getElementById("bases-ex-sub");
      if (!selo) return;
      try {
        const resp = await fetch("/.netlify/functions/listar-exercicios", {
          method: "POST",
          headers: { "Content-Type": "application/json", "Authorization": `Bearer ${await user.getIdToken(false)}` },
          body: JSON.stringify({ estado: "aguardando", porPagina: 1 }),
        });
        if (!resp.ok) throw new Error(String(resp.status));
        const { contadores: c } = await resp.json();
        if (sub) sub.textContent = `${c.total} exercícios · 8 grupos musculares`;
        if (c.aguardando > 0) {
          selo.textContent = `${c.aguardando} aguardando revisão`;
          selo.classList.remove("base-card__selo--neutro");
        } else {
          selo.textContent = "tudo revisado";
        }
      } catch {
        selo.remove();
      }
    }

    document.getElementById("btn-logout")?.addEventListener("click", async () => {
      await signOut(auth);
      window.location.href = "/admin/login";
    });
  </script>

  <meta name="fb-api"    content={import.meta.env.PUBLIC_FIREBASE_API_KEY} />
  <meta name="fb-auth"   content={import.meta.env.PUBLIC_FIREBASE_AUTH_DOMAIN} />
  <meta name="fb-proj"   content={import.meta.env.PUBLIC_FIREBASE_PROJECT_ID} />
  <meta name="fb-bucket" content={import.meta.env.PUBLIC_FIREBASE_STORAGE_BUCKET} />
  <meta name="fb-sender" content={import.meta.env.PUBLIC_FIREBASE_MESSAGING_SENDER_ID} />
  <meta name="fb-appid"  content={import.meta.env.PUBLIC_FIREBASE_APP_ID} />
</body>
</html>