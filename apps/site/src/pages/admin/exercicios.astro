---
// ELITE90 PRO · /admin/exercicios — Catálogo de Exercícios
//
// Passos 2 a 6 da ordem de execução da especificação (24/08/2026): lista,
// filtros e painel de edição (2), revisão em bloco (3), faixa no hub e atalho
// do construtor (4), versão de celular (5) e cadastro de exercício novo, com
// arquivar (6). Ficam para os passos 7 e 8 o bloco nomeado em firestore.rules
// e a seção no guia — nenhum dos dois bloqueia o uso: a coleção já está
// fechada pela negação genérica do fim do arquivo, e a ausência no celular já
// se explica sozinha nas duas camadas descritas abaixo.
//
// CELULAR (spec 6) — as regras estreitas vivem em três lugares, de propósito:
// no bloco @media de 600px (o que some), na função aplicarCorte (o que muda de
// comportamento, não só de aparência) e nas duas camadas de comunicação —
// avisarDoQueFicaNoComputador, ao salvar, e a janela #exc-limites. A terceira
// camada é o guia, no passo 8.
//
// CADASTRO E ARQUIVAR (spec 5.4, 5.5) — abrirNovo() reusa a gaveta de edição em
// vez de duplicar o formulário; a variável `modo` distingue os dois caminhos
// de salvar. `alternarArquivo()` é o par arquivar/desarquivar — a especificação
// só nomeia o primeiro, mas a decisão 14 dispensou exclusão definitiva
// justamente por arquivar ser reversível, e sem o par inverso essa reversão
// não existiria de fato.
//
// POR QUE ESTA TELA EXISTE
// Os campos revisadoPor e revisadoEm estão no esquema e nada os preenchia com
// gente de verdade: quem carimbava era um script, em bloco, com o valor
// sentinela 'coach:aprovacao-lote-NN', porque não havia sessão autenticada do
// Coach em ponto nenhum do fluxo de revisão. Aqui há.
//
// DE ONDE VÊM OS DADOS — e por que não do arquivo estático
// A leitura é pela função listar-exercicios, não por /dados/exercicios.json. O
// arquivo passa pelo portão de contexto e em produção traz somente os já
// revisados — hoje zero de 519. Esta tela precisa exatamente do complemento
// disso. O cabeçalho de listar-exercicios.ts detalha.
//
// SEM BARRA DE ABAS, de propósito (decisão 3): AdminHeader com etiqueta e seta
// de voltar, igual a atletas, fichas e guia.
export const prerender = false;
import '@fontsource/bebas-neue';
import '@fontsource/raleway/400.css';
import '@fontsource/raleway/700.css';
import '@fontsource/montserrat/400.css';
import '@fontsource/montserrat/700.css';
import '../../styles/tokens.css';
import '../../styles/global.css';
import AdminHeader from '../../components/AdminHeader.astro';
---
<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="robots" content="noindex, nofollow" />
<!-- Configuração pública do Firebase, no mesmo mecanismo de fichas.astro: vem
     das variáveis PUBLIC_* em tempo de build e é lida pelo script via meta. -->
<meta name="fb-api"    content={import.meta.env.PUBLIC_FIREBASE_API_KEY} />
<meta name="fb-auth"   content={import.meta.env.PUBLIC_FIREBASE_AUTH_DOMAIN} />
<meta name="fb-proj"   content={import.meta.env.PUBLIC_FIREBASE_PROJECT_ID} />
<meta name="fb-bucket" content={import.meta.env.PUBLIC_FIREBASE_STORAGE_BUCKET} />
<meta name="fb-sender" content={import.meta.env.PUBLIC_FIREBASE_MESSAGING_SENDER_ID} />
<meta name="fb-appid"  content={import.meta.env.PUBLIC_FIREBASE_APP_ID} />
<title>Catálogo de Exercícios · ELITE90 PRO</title>
<!-- is:global como nas cinco telas vizinhas do painel. NÃO é preferência de
     estilo: as linhas da tabela e os chips do painel são criados por innerHTML,
     e o escopo do Astro marca só os elementos que estavam no template. Com
     estilo escopado, tudo que o script cria fica sem CSS — a tabela renderizava
     com as linhas sobrepostas e o display:grid simplesmente não pegava. -->
<style is:global>
  body { background: var(--c-black); color: var(--c-textbody); font-family: var(--font-body); }
  .exc-main { max-width: var(--max-w-content); margin: 0 auto; padding: var(--space-5) var(--space-5) var(--space-8); }

  .exc-topo { display: flex; align-items: flex-end; justify-content: space-between; gap: var(--space-4); flex-wrap: wrap; margin-bottom: var(--space-5); }
  .exc-titulo { font-family: var(--font-display); font-size: var(--fs-display-md); color: var(--c-white); letter-spacing: var(--tracking-display); line-height: var(--lh-display); margin: 0; }
  .exc-contadores { font-size: var(--fs-body-sm); color: var(--c-textsub); margin-top: var(--space-1); }
  .exc-contadores strong { color: var(--c-textbody); font-weight: var(--fw-body-bold); }
  /* Vazado, e não lima: cadastrar é o ato raro desta tela — o acervo veio de
     fora e o que se faz aqui é curar. O botão cheio disputaria atenção com a
     faixa de revisão em bloco, que é a peça central. */
  .exc-btn-novo { background: transparent; border: 1px solid rgba(166,195,0,0.35); color: var(--c-lime);
    border-radius: var(--radius-card); padding: 10px 16px; font-family: var(--font-label);
    font-weight: var(--fw-label); font-size: var(--fs-label); letter-spacing: var(--tracking-cta);
    text-transform: uppercase; cursor: pointer; white-space: nowrap;
    transition: background var(--dur-fast) var(--ease-std), border-color var(--dur-fast) var(--ease-std); }
  .exc-btn-novo:hover { background: rgba(166,195,0,0.08); border-color: var(--c-lime); }

  .exc-filtros { display: flex; gap: var(--space-2); flex-wrap: wrap; margin-bottom: var(--space-3); }
  .exc-campo { background: var(--c-darkbg); border: 1px solid var(--c-line-muted); border-radius: var(--radius-card); color: var(--c-textbody); font-family: var(--font-body); font-size: var(--fs-body-sm); padding: 9px 12px; }
  .exc-campo:focus { outline: none; border-color: var(--c-lime); box-shadow: var(--glow-lime-sm); }
  #exc-busca { flex: 1; min-width: 220px; }

  /* Faixa deslizante de grupos: nasce oculta e só o corte de celular a acende.
     Rola no eixo x sem barra visível — o corte do último item na borda é o que
     conta que há mais para o lado. */
  .exc-grupos-faixa { display: none; gap: var(--space-2); margin-bottom: var(--space-3);
    overflow-x: auto; scrollbar-width: none; -webkit-overflow-scrolling: touch;
    scroll-snap-type: x proximity; }
  .exc-grupos-faixa::-webkit-scrollbar { display: none; }
  .exc-grupos-faixa .exc-estado { flex: 0 0 auto; scroll-snap-align: start; }

  .exc-estados { display: flex; gap: var(--space-2); flex-wrap: wrap; margin-bottom: var(--space-5); }
  .exc-estado { font-family: var(--font-label); font-weight: var(--fw-label); font-size: var(--fs-label); letter-spacing: var(--tracking-label); text-transform: uppercase; padding: 6px 14px; border-radius: var(--radius-pill); background: transparent; border: 1px solid var(--c-line-muted); color: var(--c-textsub); cursor: pointer; transition: color var(--dur-fast) var(--ease-std), border-color var(--dur-fast) var(--ease-std); }
  .exc-estado:hover { color: var(--c-textbody); }
  .exc-estado[aria-pressed="true"] { background: rgba(166,195,0,0.12); border-color: rgba(166,195,0,0.4); color: var(--c-lime); }

  /* Faixa de revisão em bloco. Só existe com o filtro em "aguardando" e com
     resultado — é a peça central da tela, mas some quando não há o que aprovar
     para não virar mais um aviso que se aprende a ignorar. */
  .exc-lote { display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); flex-wrap: wrap;
    background: rgba(230,126,34,0.09); border: 1px solid rgba(230,126,34,0.3);
    border-radius: var(--radius-card); padding: 12px var(--space-4); margin-bottom: var(--space-3);
    font-size: var(--fs-body-sm); color: var(--c-pending); }
  .exc-lote-btn { background: transparent; border: 1px solid var(--c-pending); color: var(--c-pending);
    border-radius: var(--radius-card); padding: 7px 14px; font-family: var(--font-label);
    font-weight: var(--fw-label); font-size: var(--fs-label); letter-spacing: var(--tracking-label);
    text-transform: uppercase; cursor: pointer; white-space: nowrap; }
  .exc-lote-btn:hover { background: rgba(230,126,34,0.14); }
  .exc-lote-btn[disabled] { opacity: 0.5; cursor: default; }
  .exc-lote--confirmando { background: rgba(230,126,34,0.16); border-color: var(--c-pending); }

  .exc-tabela { border: 1px solid var(--c-line-muted); border-radius: var(--radius-card); overflow: hidden; }
  .exc-cab, .exc-linha { display: grid; grid-template-columns: 1fr 130px 140px 150px; gap: var(--space-3); padding: 11px var(--space-4); align-items: center; }
  .exc-cab { background: var(--c-darkbg); font-family: var(--font-label); font-weight: var(--fw-label); font-size: var(--fs-label); letter-spacing: var(--tracking-label); text-transform: uppercase; color: var(--c-textsub); }
  .exc-linha { border-top: 1px solid rgba(255,255,255,0.05); cursor: pointer; background: transparent; border-left: 0; border-right: 0; border-bottom: 0; width: 100%; text-align: left; font: inherit; color: inherit; }
  .exc-linha:hover, .exc-linha:focus-visible { background: rgba(166,195,0,0.06); outline: none; }
  .exc-linha:focus-visible { box-shadow: inset 0 0 0 1px var(--c-lime); }
  .exc-nome { font-size: var(--fs-body-sm); color: var(--c-white); }
  .exc-col { font-size: var(--fs-body-sm); color: var(--c-textsub); }
  .exc-selo { display: inline-block; margin-top: 5px; font-family: var(--font-label); font-weight: var(--fw-label); font-size: 0.625rem; letter-spacing: 0.08em; text-transform: uppercase; padding: 2px 9px; border-radius: var(--radius-pill); }
  .exc-selo--pend { color: var(--c-pending); border: 1px solid rgba(230,126,34,0.45); background: rgba(230,126,34,0.12); }
  .exc-selo--ok { color: var(--c-lime); border: 1px solid rgba(166,195,0,0.4); background: rgba(166,195,0,0.12); }
  .exc-selo--arq { color: var(--c-textsub); border: 1px solid var(--c-line-muted); }
  /* Triângulo de músculo a conferir (spec 5.1). Marca herdada da base de origem;
     não é estado de revisão, e por isso não vira selo. */
  .exc-aviso-musculo { color: var(--c-pending); margin-left: 6px; font-size: var(--fs-label); }

  .exc-vazio, .exc-carregando { padding: var(--space-6); text-align: center; font-size: var(--fs-body-sm); color: var(--c-textsub); }
  .exc-erro { padding: var(--space-4); border: 1px solid rgba(230,126,34,0.4); background: rgba(230,126,34,0.08); border-radius: var(--radius-card); color: var(--c-pending); font-size: var(--fs-body-sm); }

  .exc-paginacao { display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); margin-top: var(--space-3); font-size: var(--fs-body-sm); color: var(--c-textsub); }
  .exc-pag-btn { background: transparent; border: 1px solid var(--c-line-muted); color: var(--c-textbody); border-radius: var(--radius-card); padding: 6px 12px; font-family: var(--font-label); font-size: var(--fs-label); cursor: pointer; }
  .exc-pag-btn[disabled] { opacity: 0.35; cursor: default; }

  /* ── Painel de edição — mesmo padrão de gaveta lateral de atletas.astro ── */
  .exc-gaveta { position: fixed; inset: 0; z-index: 100; display: flex; justify-content: flex-end; background: rgba(0,0,0,0); transition: background var(--dur-med) var(--ease-std); }
  .exc-gaveta[hidden] { display: none !important; }
  .exc-gaveta.aberta { background: rgba(0,0,0,0.6); }
  .exc-painel { width: min(440px, 100%); height: 100%; background: var(--c-darkbg); border-left: 1px solid var(--c-line-muted); padding: var(--space-5); overflow-y: auto; transform: translateX(100%); transition: transform var(--dur-med) var(--ease-out); }
  .exc-gaveta.aberta .exc-painel { transform: translateX(0); }
  .exc-painel-topo { display: flex; align-items: flex-start; justify-content: space-between; gap: var(--space-3); }
  .exc-painel-nome { font-family: var(--font-display); font-size: var(--fs-display-sm); color: var(--c-white); letter-spacing: var(--tracking-display); line-height: var(--lh-tight); }
  .exc-fechar { background: transparent; border: 0; color: var(--c-textsub); font-size: 1.25rem; cursor: pointer; line-height: 1; padding: 0 4px; }
  /* Os dois glifos moram no HTML e trocam por CSS: no computador o painel é
     gaveta e fecha com "×"; no celular ele é a tela inteira, e ali "×" mente —
     não há nada por baixo para revelar, o gesto é voltar. */
  .exc-fechar-x { display: inline; }
  .exc-fechar-voltar { display: none; }
  .exc-rotulo { display: block; font-family: var(--font-label); font-weight: var(--fw-label); font-size: var(--fs-label); letter-spacing: var(--tracking-label); text-transform: uppercase; color: var(--c-textsub); margin: var(--space-4) 0 6px; }
  .exc-rotulo--musculo { display: flex; align-items: center; gap: 8px; text-transform: none; letter-spacing: 0; }
  .exc-rotulo--musculo[hidden] { display: none; }
  .exc-input, .exc-select, .exc-area { width: 100%; background: var(--c-black); border: 1px solid var(--c-line-muted); border-radius: var(--radius-card); color: var(--c-white); font-family: var(--font-body); font-size: var(--fs-body-sm); padding: 10px 12px; }
  .exc-area { line-height: var(--lh-body); resize: vertical; min-height: 96px; }
  .exc-input:focus, .exc-select:focus, .exc-area:focus { outline: none; border-color: var(--c-lime); box-shadow: var(--glow-lime-sm); }
  .exc-dupla { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-3); }
  .exc-secundarios { display: flex; gap: 6px; flex-wrap: wrap; }
  .exc-chip { display: inline-flex; align-items: center; gap: 6px; font-family: var(--font-label); font-size: 0.6875rem; padding: 5px 10px; border-radius: var(--radius-pill); border: 1px solid var(--c-line-muted); background: rgba(255,255,255,0.04); color: var(--c-textbody); }
  .exc-chip button { background: transparent; border: 0; color: var(--c-textsub); cursor: pointer; font-size: 0.8125rem; line-height: 1; padding: 0; }
  .exc-proc { margin-top: var(--space-5); padding-top: var(--space-4); border-top: 1px solid rgba(255,255,255,0.07); font-size: 0.6875rem; color: var(--c-textsub); line-height: 1.85; }
  .exc-proc b { color: var(--c-textbody); font-weight: var(--fw-body); }
  /* No computador o bloco nasce aberto e o triângulo de <details> seria um
     controle que não controla nada — some, e o resumo volta a ser rótulo. */
  .exc-proc-resumo { list-style: none; cursor: default; }
  .exc-proc-resumo::-webkit-details-marker { display: none; }
  .exc-proc-resumo::marker { content: ""; }
  .exc-acoes { display: flex; gap: var(--space-2); margin-top: var(--space-5); }
  .exc-btn-lime { flex: 1; background: var(--grad-cta); color: var(--c-black); border: 0; border-radius: var(--radius-card); padding: 12px; font-family: var(--font-label); font-weight: var(--fw-label); font-size: var(--fs-label); letter-spacing: var(--tracking-cta); text-transform: uppercase; cursor: pointer; }
  .exc-btn-vazado { background: transparent; border: 1px solid rgba(255,255,255,0.18); color: var(--c-textbody); border-radius: var(--radius-card); padding: 12px 16px; font-family: var(--font-label); font-size: var(--fs-label); cursor: pointer; }
  .exc-btn-lime[disabled], .exc-btn-vazado[disabled] { opacity: 0.45; cursor: default; }
  .exc-desfazer { margin-top: var(--space-3); background: transparent; border: 0; padding: 0; color: var(--c-textsub); font-family: var(--font-label); font-size: var(--fs-label); letter-spacing: var(--tracking-label); text-transform: uppercase; text-decoration: underline; text-underline-offset: 3px; cursor: pointer; }
  .exc-desfazer:hover { color: var(--c-pending); }
  .exc-lote--desfazer { background: rgba(255,255,255,0.03); border-color: var(--c-line-muted); color: var(--c-textsub); }
  .exc-lote--desfazer .exc-lote-btn { border-color: var(--c-textsub); color: var(--c-textbody); }
  .exc-lote--desfazer .exc-lote-btn:hover { background: rgba(255,255,255,0.06); }
  .exc-nota { margin-top: var(--space-3); background: rgba(255,255,255,0.03); border-left: 2px solid var(--c-olive); padding: 10px 12px; font-size: 0.6875rem; color: var(--c-textsub); line-height: 1.65; }
  .exc-recado { margin-top: var(--space-3); font-size: var(--fs-body-sm); padding: 10px 12px; border-radius: var(--radius-card); }
  .exc-recado--ok { color: var(--c-lime); background: rgba(166,195,0,0.08); border: 1px solid rgba(166,195,0,0.3); }
  .exc-recado--erro { color: var(--c-pending); background: rgba(230,126,34,0.08); border: 1px solid rgba(230,126,34,0.35); }

  /* ── Janela de confirmação — mesmas classes e medidas de fichas.astro,
       onde ela já serve a confirmar, excluir e promover. Reconstruir um
       diálogo próprio aqui seria criar um segundo padrão para a mesma coisa.

       POR QUE JANELA, E NÃO CONFIRMAÇÃO NA PRÓPRIA FAIXA
       A primeira versão confirmava em linha: a faixa trocava de conteúdo e o
       "Sim, marcar 68" nascia no MESMO lugar do botão recém-clicado. Um duplo
       clique, ou um clique apressado, cairia no confirmar. Para uma ação que
       libera até 96 exercícios aos atletas e não tem desfazer, isso é pouco.
       A janela tira o botão de baixo do cursor e ocupa a tela inteira. */
  .confirm-overlay { position: fixed; inset: 0; z-index: 300; display: flex; align-items: center; justify-content: center; background: rgba(0,0,0,0.7); backdrop-filter: blur(2px); padding: var(--space-4); }
  .confirm-overlay[hidden] { display: none; }
  .confirm-box { background: var(--c-darkbg); border: var(--border-lime); border-radius: var(--radius-card); max-width: 520px; width: 100%; padding: var(--space-5); max-height: 85vh; overflow-y: auto; }
  .confirm-title { font-family: var(--font-display); font-size: var(--fs-display-sm); color: var(--c-white); text-transform: uppercase; letter-spacing: 0.05em; margin: 0 0 var(--space-3); }
  .confirm-title span { color: var(--c-pending); }
  .confirm-summary { font-family: var(--font-body); font-size: var(--fs-body-sm); color: var(--c-textsub); line-height: 1.7; margin-bottom: var(--space-4); }
  .confirm-summary strong { color: var(--c-textbody); }
  .confirm-actions { display: flex; gap: var(--space-3); flex-wrap: wrap; justify-content: flex-end; }
  .btn-sm { font-family: var(--font-label); font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; padding: 10px 20px; border-radius: var(--radius-card); cursor: pointer; border: none; transition: background var(--transition-base), color var(--transition-base); }
  .btn-outline { background: transparent; color: var(--c-lime); border: 1px solid rgba(166,195,0,0.3); }
  .btn-outline:hover { background: rgba(166,195,0,0.05); border-color: var(--c-lime); }
  .btn-perigo { background: transparent; color: var(--c-pending); border: 1px solid var(--c-pending); }
  .btn-perigo:hover { background: rgba(230,126,34,0.1); }
  .btn-perigo:disabled { opacity: 0.5; cursor: default; }

  /* ── Janela "O que fica no computador" (camada 2 da spec 6.3) ──
     Reaproveita a mesma janela da confirmação em bloco. A lista não nomeia
     recursos, nomeia resultados: "revisão em lote" não diz nada a quem está
     parado na academia; "aprovar os 68 de Costas de uma vez" diz. */
  .exc-limites-lista { list-style: none; padding: 0; margin: 0 0 var(--space-4); }
  .exc-limites-lista li { padding: var(--space-3) 0; border-bottom: 1px solid rgba(255,255,255,0.07); }
  .exc-limites-lista li:last-child { border-bottom: 0; }
  .exc-limites-lista b { display: block; color: var(--c-textbody); font-weight: var(--fw-body-bold); font-size: var(--fs-body-sm); margin-bottom: 3px; }
  .exc-limites-lista span { display: block; font-size: 0.6875rem; color: var(--c-textsub); line-height: 1.65; }
  /* Fecha dizendo o que DÁ para fazer aqui. Sem isso a janela lê como lista de
     amputações, e a tela de celular passa a parecer versão capenga da outra. */
  .exc-limites-pode { background: rgba(166,195,0,0.07); border-left: 2px solid var(--c-lime);
    padding: 10px 12px; font-size: 0.6875rem; color: var(--c-textsub); line-height: 1.7; margin-bottom: var(--space-4); }
  .exc-limites-pode b { color: var(--c-lime); font-weight: var(--fw-body-bold); }

  /* Aviso da camada 1: nasce ABAIXO da confirmação de salvamento e separado
     dela. Juntas, as duas frases deixariam dúvida sobre se a gravação deu
     certo; separadas, a primeira confirma o ato e a segunda informa o estado. */
  .exc-aviso-desktop { margin-top: var(--space-3); border: 1px dashed rgba(230,126,34,0.4);
    border-radius: var(--radius-card); padding: 10px 12px; font-size: 0.6875rem;
    color: var(--c-textsub); line-height: 1.7; }
  .exc-aviso-desktop b { color: var(--c-pending); font-weight: var(--fw-body-bold); }
  .exc-aviso-desktop button { display: inline; background: none; border: 0; padding: 0;
    color: var(--c-lime); font: inherit; text-decoration: underline; text-underline-offset: 3px; cursor: pointer; }

  /* O item de menu da camada 2 só existe abaixo do corte: no computador não há
     restrição nenhuma a explicar, e o ícone seria ruído entre guia e sair. */
  #exc-limites-abrir { display: none; }

  /* Entre 600 e 900px cai só a coluna de músculo — quatro colunas fixas não
     cabem. Continua sendo a tela de computador: revisar, revisar em bloco e
     todos os filtros seguem no lugar. */
  @media (max-width: 900px) {
    .exc-cab, .exc-linha { grid-template-columns: 1fr 120px 130px; }
    .exc-cab--musculo, .exc-col--musculo { display: none; }
  }

  /* ─────────────────────────── CELULAR · spec 6 ───────────────────────────
     Corte em 600px, o mesmo do hub.

     O que sai daqui não sai por caber mal. Marcar como revisado é o ato que
     libera o exercício aos atletas, e a revisão em bloco faz isso com dezenas
     de uma vez: num aparelho de toque, o custo de um encostão é alto demais
     para o ganho. Cadastrar exige redigir instrução, que é trabalho de
     teclado. Fica o que justifica abrir o catálogo no celular — encontrar um
     exercício e corrigir o que está errado nele.

     A ausência é EXPLICADA no ponto onde é sentida, não num aviso no topo:
     ver .exc-aviso-desktop (ao salvar) e a janela #exc-limites. */
  @media (max-width: 600px) {
    .exc-main { padding: var(--space-4) var(--space-3) var(--space-6); }

    /* Filtro por estado sai (spec 6.1). Sem ele a tela precisa mostrar TODOS os
       ativos, não só os aguardando: o exercício que o Coach quer corrigir pode
       já estar revisado, e sem filtro para trocar ele ficaria inalcançável.
       Quem força o estado é o script, no mesmo ponto que lê o corte. */
    #exc-estados { display: none; }
    /* Revisão em bloco sai — e some por completo, para não deixar a faixa
       laranja anunciando uma ação que não existe aqui. */
    #exc-lote { display: none; }
    /* Só o filtro por grupo, e em faixa deslizante (spec 6.1). O equipamento e
       o <select> de grupo saem; a busca fica com a linha inteira, porque é ela
       que encontra o exercício a corrigir. */
    #exc-equipamento, #exc-grupo { display: none; }
    #exc-busca { flex: 1 1 100%; min-width: 0; }
    .exc-grupos-faixa { display: flex; }

    /* A tabela vira cartões empilhados, com toda a largura para o nome. */
    .exc-cab { display: none; }
    /* Respiro lateral menor que no computador: a 412px de tela, 24px de cada
       lado comem 12% da largura que a spec manda dar ao nome. */
    .exc-linha { display: block; padding: var(--space-3); }
    .exc-nome { display: block; font-size: var(--fs-body-md); line-height: var(--lh-tight); }
    .exc-col { font-size: 0.6875rem; }
    .exc-col--grupo, .exc-col--equip { display: inline; }
    .exc-col--equip::before { content: " · "; }

    /* Painel em tela cheia, com seta de voltar no lugar do "×" (spec 6.2). */
    .exc-painel { width: 100%; border-left: 0; padding: var(--space-4) var(--space-3) var(--space-6); }
    .exc-painel-topo { flex-direction: row-reverse; justify-content: flex-end; align-items: center; }
    .exc-fechar { font-size: 1.5rem; padding: 0 8px 0 0; }
    .exc-fechar-x { display: none; }
    .exc-fechar-voltar { display: inline; }

    /* Cadastrar exige redigir instrução — trabalho de teclado (spec 6.1). */
    #exc-novo { display: none; }

    /* Um único botão (spec 6.2). "Salvar e marcar como revisado" some, e o que
       resta assume o peso de ação principal — o rótulo troca no script. */
    #exc-salvar-revisar { display: none; }
    #exc-desrevisar { display: none; }
    .exc-acoes .exc-btn-vazado { flex: 1; background: var(--grad-cta); color: var(--c-black);
      border: 0; font-weight: var(--fw-label); letter-spacing: var(--tracking-cta); text-transform: uppercase; }

    /* Aqui o resumo vira controle de verdade, e ganha o afordance de tal. */
    .exc-proc-resumo { cursor: pointer; display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 6px 0; }
    .exc-proc-resumo::after { content: "▾"; color: var(--c-textsub); transition: transform var(--dur-fast) var(--ease-std); }
    #exc-proc[open] .exc-proc-resumo::after { transform: rotate(180deg); }

    #exc-limites-abrir { display: inline-flex; }
  }
</style>
</head>
<body>
<!-- O item entra DENTRO do menu "⋮" e como primeiro da lista, acima de "Como o
     painel funciona" (spec 6.3). O gatilho de três pontos não pode ser trocado:
     é ele que, em tela estreita, agrupa guia, voltar e encerrar sessão. -->
<AdminHeader badge="Exercícios" backHref="/admin">
  <button slot="primeiro" class="adm-btn-icon adm-btn-icon--guide" id="exc-limites-abrir" type="button" aria-label="O que fica no computador">
    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
      <rect x="2" y="4" width="20" height="13" rx="2"/><path d="M8 21h8M12 17v4"/>
    </svg>
    <span class="adm-btn-icon__label">O que fica no computador</span>
  </button>
</AdminHeader>

<main class="exc-main">
  <div class="exc-topo">
    <div>
      <h1 class="exc-titulo">Catálogo de Exercícios</h1>
      <div class="exc-contadores" id="exc-contadores">Carregando…</div>
    </div>
    <button class="exc-btn-novo" id="exc-novo" type="button">+ Novo exercício</button>
  </div>

  <div class="exc-filtros">
    <input class="exc-campo" id="exc-busca" type="search" placeholder="Buscar por nome, em português ou inglês…" autocomplete="off" />
    <select class="exc-campo" id="exc-grupo"><option value="">Todos os grupos</option></select>
    <select class="exc-campo" id="exc-equipamento"><option value="">Todos os equipamentos</option></select>
  </div>

  <!-- Faixa de grupos — só existe no celular (spec 6.1). Lá o <select> nativo
       abre uma roleta que esconde a tela inteira para escolher entre oito
       valores; a faixa mostra os oito e resolve com um toque. No computador o
       <select> continua sendo o certo, porque convive com os outros filtros
       numa linha só. Os dois espelham o MESMO estado.grupo. -->
  <div class="exc-grupos-faixa" id="exc-grupos-faixa" role="group" aria-label="Filtrar por grupo"></div>

  <div class="exc-estados" id="exc-estados" role="group" aria-label="Filtrar por estado"></div>

  <div id="exc-lote"></div>

  <div class="exc-tabela">
    <div class="exc-cab"><span>Exercício</span><span>Grupo</span><span>Equipamento</span><span class="exc-cab--musculo">Músculo</span></div>
    <div id="exc-linhas"><div class="exc-carregando">Carregando o catálogo…</div></div>
  </div>

  <div class="exc-paginacao">
    <span id="exc-resumo"></span>
    <span>
      <button class="exc-pag-btn" id="exc-anterior" type="button" disabled>Anterior</button>
      <button class="exc-pag-btn" id="exc-proxima" type="button" disabled>Próxima</button>
    </span>
  </div>
</main>

<div class="confirm-overlay" id="exc-lote-janela" hidden>
  <div class="confirm-box" role="dialog" aria-modal="true" aria-labelledby="exc-lote-titulo">
    <h3 class="confirm-title" id="exc-lote-titulo">Marcar como <span>revisados</span></h3>
    <p class="confirm-summary" id="exc-lote-texto"></p>
    <div class="confirm-actions">
      <button class="btn-sm btn-outline" id="exc-lote-nao" type="button">Cancelar</button>
      <button class="btn-sm btn-perigo" id="exc-lote-sim" type="button"></button>
    </div>
  </div>
</div>

<!-- Camada 2 da spec 6.3. Os números não são ilustrativos: Costas tem mesmo 68
     exercícios e Pernas, 96 — conferidos contra scripts/dados-exercicios/
     catalogo-fonte.json em 25/08/2026. Se o acervo mudar muito, conferir. -->
<div class="confirm-overlay" id="exc-limites" hidden>
  <div class="confirm-box" role="dialog" aria-modal="true" aria-labelledby="exc-limites-titulo">
    <h3 class="confirm-title" id="exc-limites-titulo">O que fica no <span>computador</span></h3>
    <p class="confirm-summary">Três coisas o catálogo só faz na tela grande. Não é limitação do aparelho — é que o custo de um toque errado, nas três, é alto:</p>
    <ul class="exc-limites-lista">
      <li>
        <b>Liberar um exercício para os atletas</b>
        <span>Marcar como revisado é o que tira o exercício da fila e o coloca no construtor de treino. É o ato que muda o que o atleta vê, e um encostão no bolso não deveria bastar para ele acontecer.</span>
      </li>
      <li>
        <b>Aprovar os 68 de Costas de uma vez</b>
        <span>A revisão em bloco libera o grupo inteiro numa ação — até 96, que é o tamanho de Pernas. Desfazer é possível, mas o registro de quem aprovou se perde no caminho.</span>
      </li>
      <li>
        <b>Cadastrar um exercício que não existe no acervo</b>
        <span>Todo exercício novo precisa de instrução de execução escrita. É trabalho de teclado, e digitar isso no celular produz instrução curta demais para servir ao atleta.</span>
      </li>
    </ul>
    <p class="exc-limites-pode"><b>Aqui você corrige.</b> Buscar pelo nome, ajustar nome, instrução, grupo, equipamento, músculo e nível, e salvar — que é o que resolve o erro percebido na hora, com o aparelho na mão.</p>
    <div class="confirm-actions">
      <button class="btn-sm btn-outline" id="exc-limites-fechar" type="button">Entendi</button>
    </div>
  </div>
</div>

<div class="exc-gaveta" id="exc-gaveta" hidden>
  <aside class="exc-painel" role="dialog" aria-modal="true" aria-labelledby="exc-painel-nome">
    <div class="exc-painel-topo">
      <div class="exc-painel-nome" id="exc-painel-nome"></div>
      <button class="exc-fechar" id="exc-fechar" type="button" aria-label="Fechar"><span class="exc-fechar-x" aria-hidden="true">✕</span><span class="exc-fechar-voltar" aria-hidden="true">←</span></button>
    </div>
    <div id="exc-painel-selo"></div>

    <label class="exc-rotulo" for="exc-f-nome">Nome em português</label>
    <input class="exc-input" id="exc-f-nome" type="text" />

    <label class="exc-rotulo" for="exc-f-instrucao">Instrução</label>
    <textarea class="exc-area" id="exc-f-instrucao"></textarea>

    <div class="exc-dupla">
      <div><label class="exc-rotulo" for="exc-f-grupo">Grupo</label><select class="exc-select" id="exc-f-grupo"></select></div>
      <div><label class="exc-rotulo" for="exc-f-equipamento">Equipamento</label><select class="exc-select" id="exc-f-equipamento"></select></div>
      <div><label class="exc-rotulo" for="exc-f-mecanica">Mecânica</label><select class="exc-select" id="exc-f-mecanica"></select></div>
      <div><label class="exc-rotulo" for="exc-f-nivel">Nível</label><select class="exc-select" id="exc-f-nivel"></select></div>
    </div>

    <label class="exc-rotulo" for="exc-f-musculo">Músculo principal</label>
    <select class="exc-select" id="exc-f-musculo"></select>

    <label class="exc-rotulo">Músculos auxiliares</label>
    <div class="exc-secundarios" id="exc-f-secundarios"></div>
    <select class="exc-select" id="exc-f-add-secundario" style="margin-top:8px"></select>

    <!-- display:flex vive em classe, não em style inline: inline venceria a
         regra [hidden] do navegador, e abrirNovo() precisa esconder este rótulo
         de verdade quando não há acervo de origem para justificar o aviso. -->
    <label class="exc-rotulo exc-rotulo--musculo" for="exc-f-revisar-musculo">
      <input type="checkbox" id="exc-f-revisar-musculo" />
      <span>Classificação de músculo a conferir</span>
    </label>

    <!-- Procedência recolhida no celular (spec 6.2). <details> nativo em vez de
         div com script: o navegador já dá o teclado, o leitor de tela e o
         estado. Quem abre e fecha conforme o corte é o script — CSS sozinho não
         alcança o atributo open — e no computador ele nasce aberto, como era. -->
    <details class="exc-proc" id="exc-proc">
      <summary class="exc-proc-resumo"><span class="exc-rotulo" style="margin:0">Procedência · somente leitura</span></summary>
      <div id="exc-proc-corpo"></div>
    </details>

    <div class="exc-acoes">
      <button class="exc-btn-lime" id="exc-salvar-revisar" type="button">Salvar e marcar como revisado</button>
      <button class="exc-btn-vazado" id="exc-salvar" type="button">Salvar</button>
    </div>
    <div id="exc-recado"></div>
    <!-- Os dois desfazeres são ligação discreta, não botão: consertam engano e
         não fazem parte do fluxo de trabalho, que é revisar e corrigir. -->
    <button class="exc-desfazer" id="exc-desrevisar" type="button" hidden>Devolver à fila de revisão</button>
    <button class="exc-desfazer" id="exc-arquivar" type="button" hidden>Arquivar exercício</button>

    <!-- Sem prometer prazo: nada dispara publicação sozinho hoje (ver o
         cabeçalho de atualizar-exercicio.ts, "SOBRE A CHEGADA AO PORTAL"). Dizer
         "leva alguns minutos" seria uma garantia que a arquitetura não cumpre —
         o próximo build é que traz a mudança, e o próximo build depende de
         alguém publicar código, não desta gravação. -->
    <p class="exc-nota">A alteração é gravada no banco imediatamente. A chegada ao portal acontece na próxima publicação do site — se a busca do construtor de treino ainda mostrar o valor antigo, não é falha do salvamento; é que o site ainda não foi publicado de novo.</p>
  </aside>
</div>

<script type="module" is:inline>
  import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-app.js";
  import { getAuth, signOut, onAuthStateChanged } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-auth.js";

  const meta = (n) => document.querySelector(`meta[name="${n}"]`)?.content;
  const app = initializeApp({
    apiKey: meta('fb-api'), authDomain: meta('fb-auth'), projectId: meta('fb-proj'),
    storageBucket: meta('fb-bucket'), messagingSenderId: meta('fb-sender'), appId: meta('fb-appid'),
  });
  const auth = getAuth(app);

  // Vocabulário fechado. Espelha netlify/functions/_vocabulario-exercicios.ts,
  // que é quem de fato valida — aqui é conveniência de formulário. Se as listas
  // divergirem, o servidor recusa e a tela mostra o motivo; nunca o contrário.
  const GRUPOS = ['Peito','Costas','Ombros','Bíceps','Tríceps','Antebraço','Pernas','Abdômen'];
  const MUSCULOS = ['Peitoral','Dorsal','Trapézio','Lombar','Deltoide','Bíceps','Tríceps','Antebraço',
    'Quadríceps','Posterior de Coxa','Glúteo','Panturrilha','Adutor','Abdutor','Abdômen','Oblíquo'];
  const EQUIPAMENTOS = ['Barra','Halteres','Polia','Máquina','Peso Corporal','Barra W','Kettlebell'];
  const MECANICAS = ['composto','isolado'];
  const NIVEIS = ['iniciante','intermediario','avancado'];

  const ESTADOS = [
    { valor: 'aguardando', rotulo: 'Aguardando revisão' },
    { valor: 'revisados',  rotulo: 'Revisados' },
    { valor: 'arquivados', rotulo: 'Arquivados' },
  ];

  const $ = (id) => document.getElementById(id);
  const esc = (s) => String(s ?? '').replace(/[&<>"']/g, (c) => (
    { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

  let estado = { estado: 'aguardando', grupo: '', equipamento: '', busca: '', pagina: 1 };
  let itens = [];
  let emEdicao = null;
  let secundarios = [];
  // 'editar' ou 'criar'. A gaveta é a mesma nos dois: são os mesmos nove campos,
  // com o mesmo vocabulário fechado e a mesma validação do outro lado. Um
  // segundo formulário só duplicaria a chance de os dois divergirem.
  let modo = 'editar';

  // Token sempre fresco: o SDK renova sozinho, e guardar o valor numa variável
  // daria erro de sessão uma hora depois — mesma nota de fichas.astro.
  async function token() {
    const u = auth.currentUser;
    if (!u) throw new Error('Sessão expirada. Recarregue a página.');
    return u.getIdToken(false);
  }

  async function chamar(rota, corpo) {
    const resp = await fetch(`/.netlify/functions/${rota}`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${await token()}` },
      body: JSON.stringify(corpo),
    });
    const texto = await resp.text();
    let dados = {};
    try { dados = texto ? JSON.parse(texto) : {}; } catch { dados = { erro: texto }; }
    if (!resp.ok) throw new Error(dados.erro || dados.detalhes?.join('; ') || `Falha ${resp.status}`);
    return dados;
  }

  function opcoes(sel, lista, vazio) {
    sel.innerHTML = (vazio ? `<option value="">${vazio}</option>` : '') +
      lista.map((v) => `<option value="${esc(v)}">${esc(v)}</option>`).join('');
  }

  function pintarEstados() {
    $('exc-estados').innerHTML = ESTADOS.map((e) =>
      `<button type="button" class="exc-estado" data-estado="${e.valor}" aria-pressed="${e.valor === estado.estado}">${e.rotulo}</button>`
    ).join('');
  }

  /** Faixa de grupos do celular. Reusa a ficha de .exc-estado — é o mesmo gesto
   *  (escolher um entre poucos) e merece a mesma forma; um segundo desenho para
   *  a mesma coisa só faria a tela parecer costurada de retalhos. */
  function pintarGrupos() {
    $('exc-grupos-faixa').innerHTML = [{ valor: '', rotulo: 'Todos' }, ...GRUPOS.map((g) => ({ valor: g, rotulo: g }))]
      .map((g) => `<button type="button" class="exc-estado" data-grupo="${esc(g.valor)}" aria-pressed="${g.valor === estado.grupo}">${esc(g.rotulo)}</button>`)
      .join('');
  }

  /** Um só caminho para trocar de grupo, venha do <select> ou da faixa: os dois
   *  espelham estado.grupo, e deixar cada um com sua própria atualização é como
   *  se perde a sincronia quando o aparelho gira no meio da filtragem. */
  function trocarGrupo(valor) {
    estado.grupo = valor;
    estado.pagina = 1;
    $('exc-grupo').value = valor;
    pintarGrupos();
    carregar();
  }

  function pintarLinhas(dados) {
    itens = dados.itens;
    const c = dados.contadores;
    $('exc-contadores').innerHTML =
      `<strong>${c.total}</strong> exercícios · <strong>${c.revisados}</strong> revisados · <strong>${c.aguardando}</strong> aguardando` +
      (c.arquivados ? ` · <strong>${c.arquivados}</strong> arquivados` : '');

    if (!itens.length) {
      $('exc-linhas').innerHTML = '<div class="exc-vazio">Nenhum exercício para este filtro.</div>';
    } else {
      $('exc-linhas').innerHTML = itens.map((e, i) => {
        const selo = !e.ativo
          ? '<span class="exc-selo exc-selo--arq">arquivado</span>'
          : e.revisado
            ? '<span class="exc-selo exc-selo--ok">revisado</span>'
            : '<span class="exc-selo exc-selo--pend">aguardando</span>';
        const aviso = e.revisarMusculo
          ? '<span class="exc-aviso-musculo" title="Classificação de músculo herdada da origem — conferir ao revisar">▲</span>'
          : '';
        // As colunas levam modificador porque o celular esconde a de músculo e
        // junta grupo e equipamento numa linha só (spec 6.2). Sem nome próprio,
        // a única forma de alcançá-las no CSS seria por :nth-child, que quebra
        // silenciosamente na primeira vez que alguém reordenar as colunas.
        return `<button type="button" class="exc-linha" data-i="${i}">
          <span class="exc-nome">${esc(e.nome_pt)}${aviso}<br>${selo}</span>
          <span class="exc-col exc-col--grupo">${esc(e.grupo)}</span>
          <span class="exc-col exc-col--equip">${esc(e.equipamento)}</span>
          <span class="exc-col exc-col--musculo">${esc(e.musculoPrimario)}</span>
        </button>`;
      }).join('');
    }

    const de = dados.encontrados ? (dados.pagina - 1) * dados.porPagina + 1 : 0;
    const ate = Math.min(dados.pagina * dados.porPagina, dados.encontrados);
    $('exc-resumo').textContent = dados.encontrados
      ? `Mostrando ${de}–${ate} de ${dados.encontrados}`
      : 'Nenhum resultado';
    estado.pagina = dados.pagina;
    $('exc-anterior').disabled = dados.pagina <= 1;
    $('exc-proxima').disabled = dados.pagina >= dados.paginas;
  }

  // Estado da confirmação. A spec exige confirmar com o número explícito: são
  // até 96 exercícios liberados de uma vez para os atletas, e um clique acidental
  // não deve bastar.
  let ultimoLote = 0;

  function pintarLote(dados) {
    const faixa = $('exc-lote');
    ultimoLote = dados.encontrados;
    // Só em "aguardando": nos outros estados não há pendência para aprovar, e a
    // faixa seria um botão sem sentido — ou pior, um que recarimbaria revisados.
    // Em "aguardando" a faixa aprova; em "revisados" ela desfaz. Nos demais
    // estados não há nada em bloco a fazer e ela some.
    const sentido = estado.estado === 'aguardando' ? 'marcar'
      : estado.estado === 'revisados' ? 'desfazer' : null;
    if (!sentido || !dados.encontrados) { faixa.innerHTML = ''; return; }
    const n = dados.encontrados;
    faixa.innerHTML = sentido === 'marcar'
      ? `<div class="exc-lote">
           <span>${n} exercício${n > 1 ? 's' : ''} ${escopoLote()} aguardando sua revisão</span>
           <button type="button" class="exc-lote-btn" id="exc-lote-abrir">Marcar ${n === 1 ? 'o' : `os ${n}`} como revisado${n > 1 ? 's' : ''}</button>
         </div>`
      : `<div class="exc-lote exc-lote--desfazer">
           <span>${n} exercício${n > 1 ? 's' : ''} ${escopoLote()} revisado${n > 1 ? 's' : ''}</span>
           <button type="button" class="exc-lote-btn" id="exc-lote-abrir">Desfazer ${n === 1 ? 'a revisão' : `as ${n} revisões`}</button>
         </div>`;
  }

  function escopoLote() {
    return estado.grupo ? `de ${esc(estado.grupo)}`
      : estado.equipamento ? `de ${esc(estado.equipamento)}`
      : estado.busca ? 'deste filtro' : 'do catálogo';
  }

  function abrirJanelaLote() {
    const n = ultimoLote;
    if (!n) return;
    const desfazendo = estado.estado === 'revisados';
    $('exc-lote-titulo').innerHTML = desfazendo
      ? 'Desfazer <span>revisões</span>'
      : 'Marcar como <span>revisados</span>';
    $('exc-lote-texto').innerHTML = desfazendo
      ? `Você está prestes a devolver <strong>${n} exercício${n > 1 ? 's' : ''} ${escopoLote()}</strong> ` +
        `à fila de revisão. ${n > 1 ? 'Eles saem' : 'Ele sai'} do catálogo dos atletas na próxima publicação, ` +
        `e ${n > 1 ? 'voltam' : 'volta'} a aparecer aqui como aguardando.<br><br>` +
        `Nada é apagado — quem já tem ${n > 1 ? 'esses exercícios' : 'esse exercício'} num plano ` +
        `continua com ${n > 1 ? 'eles' : 'ele'}. O que se perde é o registro de quem aprovou e quando.`
      : `Você está prestes a marcar <strong>${n} exercício${n > 1 ? 's' : ''} ${escopoLote()}</strong> como revisado${n > 1 ? 's' : ''}. ` +
        `Isso ${n > 1 ? 'os libera' : 'o libera'} para os atletas na próxima publicação do site.<br><br>` +
        `Dá para desfazer depois, pelo filtro <strong>Revisados</strong> ou exercício a exercício — ` +
        `mas o registro de quem aprovou se perde ao desfazer.`;
    $('exc-lote-sim').textContent = desfazendo
      ? (n > 1 ? `Desfazer ${n} revisões` : 'Desfazer a revisão')
      : (n > 1 ? `Confirmar ${n} revisões` : 'Confirmar a revisão');
    $('exc-lote-sim').disabled = false;
    $('exc-lote-janela').hidden = false;
    // O foco vai para Cancelar, não para Confirmar: quem chegou aqui por engano
    // sai com um Enter, e quem quer mesmo confirmar dá um Tab a mais.
    $('exc-lote-nao').focus();
  }

  function fecharJanelaLote() { $('exc-lote-janela').hidden = true; }

  async function aplicarLote(n) {
    const btn = $('exc-lote-sim');
    if (btn) { btn.disabled = true; btn.textContent = 'Marcando…'; }
    try {
      // Manda o FILTRO e o número prometido, não a lista de ids: a tela mostra 25
      // por página e a faixa promete o conjunto inteiro. O servidor refaz o
      // filtro e recusa se o número não bater — ver o comentário da função.
      const r = await chamar('atualizar-exercicio', {
        operacao: estado.estado === 'revisados' ? 'desrevisar-lote' : 'revisar-lote',
        filtro: { grupo: estado.grupo, equipamento: estado.equipamento, busca: estado.busca },
        esperados: n,
      });
      fecharJanelaLote();
      await carregar();
      $('exc-lote').insertAdjacentHTML('afterbegin',
        `<div class="exc-recado exc-recado--ok" style="margin:0 0 12px">${
          r.desrevisados != null
            ? `${r.desrevisados} exercício(s) devolvido(s) à fila de revisão.`
            : `${r.revisados} exercício(s) marcado(s) como revisado(s).`
        }</div>`);
    } catch (e) {
      fecharJanelaLote();
      $('exc-lote').innerHTML = `<div class="exc-recado exc-recado--erro" style="margin:0 0 12px">${esc(e.message)}</div>`;
    }
  }

  let pedido = 0;
  async function carregar() {
    const meu = ++pedido;
    try {
      const dados = await chamar('listar-exercicios', estado);
      // Descarta resposta de pedido antigo: digitar rápido na busca dispara
      // várias, e a lenta pode chegar depois da rápida e repintar dado velho.
      if (meu !== pedido) return;
      pintarLinhas(dados);
      pintarLote(dados);
    } catch (e) {
      if (meu !== pedido) return;
      $('exc-linhas').innerHTML = `<div class="exc-erro">Não foi possível carregar o catálogo. ${esc(e.message)}</div>`;
    }
  }

  function pintarSecundarios() {
    $('exc-f-secundarios').innerHTML = secundarios.length
      ? secundarios.map((m, i) => `<span class="exc-chip">${esc(m)}<button type="button" data-rm="${i}" aria-label="Remover ${esc(m)}">✕</button></span>`).join('')
      : '<span style="font-size:0.6875rem;color:var(--c-textsub)">nenhum</span>';
    opcoes($('exc-f-add-secundario'), MUSCULOS.filter((m) => !secundarios.includes(m)), '+ adicionar auxiliar');
  }

  function abrir(i) {
    const e = itens[i];
    if (!e) return;
    modo = 'editar';
    emEdicao = e;
    secundarios = [...(e.musculosSecundarios || [])];
    $('exc-painel-nome').textContent = e.nome_pt;
    $('exc-painel-selo').innerHTML = !e.ativo
      ? '<span class="exc-selo exc-selo--arq">arquivado</span>'
      : e.revisado
        ? `<span class="exc-selo exc-selo--ok">revisado${e.revisadoEm ? ' em ' + new Date(e.revisadoEm).toLocaleDateString('pt-BR') : ''}</span>`
        : '<span class="exc-selo exc-selo--pend">aguardando validação do Coach</span>';
    // O que abrirNovo esconde, abrir() devolve — os dois compartilham a mesma
    // gaveta e cada um deixa a marca do modo anterior se não desfizer.
    $('exc-proc').hidden = false;
    $('exc-f-revisar-musculo').closest('label').hidden = false;
    $('exc-f-nome').value = e.nome_pt ?? '';
    $('exc-f-instrucao').value = e.instrucao_pt ?? '';
    $('exc-f-grupo').value = e.grupo ?? '';
    $('exc-f-equipamento').value = e.equipamento ?? '';
    $('exc-f-mecanica').value = e.mecanica ?? '';
    $('exc-f-nivel').value = e.nivel ?? '';
    $('exc-f-musculo').value = e.musculoPrimario ?? '';
    $('exc-f-revisar-musculo').checked = !!e.revisarMusculo;
    pintarSecundarios();
    $('exc-proc-corpo').innerHTML =
      `Nome de origem · <b>${esc(e.nome_en ?? '—')}</b><br>` +
      `Fonte · <b>${esc(e.origem?.fonte ?? '—')}</b><br>` +
      `Criado por · <b>${esc(e.criadoPor ?? '—')}</b><br>` +
      `Última alteração · <b>${e.atualizadoEm ? esc(new Date(e.atualizadoEm).toLocaleString('pt-BR')) : '—'}</b>`;
    $('exc-recado').innerHTML = '';
    // Recolhe a procedência de novo a cada abertura no celular: deixá-la aberta
    // porque o exercício anterior foi expandido empurraria os campos para fora
    // da primeira tela justamente em quem já mostrou não se importar com ela.
    $('exc-proc').open = !noCelular();
    $('exc-salvar-revisar').hidden = e.revisado;
    // Desfazer individual só aparece no que está revisado, e é ligação discreta
    // e não botão: é conserto de engano, não parte do fluxo de trabalho.
    $('exc-desrevisar').hidden = !e.revisado;
    // Revisão e arquivamento são eixos independentes (ver o comentário da
    // função no servidor): um exercício arquivado pode estar revisado ou não, e
    // o rótulo segue o estado ATUAL, não o que a ação vai produzir invertido.
    $('exc-arquivar').hidden = false;
    $('exc-arquivar').textContent = e.ativo === false ? 'Desarquivar exercício' : 'Arquivar exercício';
    const g = $('exc-gaveta');
    g.hidden = false;
    requestAnimationFrame(() => g.classList.add('aberta'));
  }

  function fechar() {
    const g = $('exc-gaveta');
    g.classList.remove('aberta');
    setTimeout(() => { g.hidden = true; emEdicao = null; }, 250);
  }

  /** O formulário inteiro, como valores. */
  function valores() {
    return {
      nome_pt: $('exc-f-nome').value.trim(),
      instrucao_pt: $('exc-f-instrucao').value.trim(),
      grupo: $('exc-f-grupo').value,
      equipamento: $('exc-f-equipamento').value,
      mecanica: $('exc-f-mecanica').value || null,
      nivel: $('exc-f-nivel').value,
      musculoPrimario: $('exc-f-musculo').value,
      musculosSecundarios: secundarios,
      revisarMusculo: $('exc-f-revisar-musculo').checked,
    };
  }

  /** Só o que mudou. Mandar o documento inteiro faria toda edição carregar
   *  campos que ninguém tocou, multiplicando a chance de sobrescrever com dado
   *  velho — a função aceita parcial justamente por isso. Criar não tem esse
   *  problema nem essa saída: lá vai o conjunto inteiro, porque não há
   *  documento anterior de onde o que faltar possa vir. */
  function alterados() {
    const e = emEdicao;
    const novo = valores();
    const diff = {};
    for (const [k, v] of Object.entries(novo)) {
      const atual = e[k];
      const igual = Array.isArray(v)
        ? Array.isArray(atual) && v.length === atual.length && v.every((x, i) => x === atual[i])
        : v === (atual ?? (typeof v === 'boolean' ? false : ''));
      if (!igual) diff[k] = v;
    }
    return diff;
  }

  function recado(texto, tipo) {
    $('exc-recado').innerHTML = `<div class="exc-recado exc-recado--${tipo}">${esc(texto)}</div>`;
  }

  // ── Corte de celular (spec 6) ──
  // Uma fonte só de verdade para "estamos no celular". O CSS corta em 600px e o
  // script precisa do MESMO número, porque aqui a decisão não é de aparência:
  // é quais operações existem. matchMedia, e não innerWidth, para que girar o
  // aparelho reavalie sozinho — sem isso, quem abrisse em retrato e deitasse o
  // telefone ficaria com a tela larga e as regras estreitas.
  const CORTE = window.matchMedia('(max-width: 600px)');
  const noCelular = () => CORTE.matches;

  function aplicarCorte(recarregar) {
    const m = noCelular();
    // No computador o painel é gaveta e fecha; no celular ele é a tela toda, e
    // o gesto é voltar. O rótulo acessível acompanha o glifo.
    $('exc-fechar').setAttribute('aria-label', m ? 'Voltar' : 'Fechar');
    // Um único botão no celular (spec 6.2) — o que sobra herda o peso do que saiu.
    $('exc-salvar').textContent = m ? 'Salvar alterações' : 'Salvar';
    $('exc-proc').open = !m;
    // Sem filtro por estado, a tela PRECISA mostrar todos os ativos. O exercício
    // que o Coach quer corrigir pode já estar revisado, e com o filtro preso em
    // "aguardando" ele seria inalcançável — a tela de celular existe para
    // corrigir, e não poderia esconder metade do que há para corrigir.
    // Ao voltar para a tela grande o estado fica onde está: o filtro reaparece
    // marcado em "Todos", e trocar volta a ser escolha de quem usa.
    if (m && estado.estado !== 'todos') {
      estado.estado = 'todos';
      estado.pagina = 1;
      pintarEstados();
      if (recarregar) carregar();
    }
  }

  // ── Camada 2 (spec 6.3): a janela "O que fica no computador" ──
  function abrirLimites() { $('exc-limites').hidden = false; $('exc-limites-fechar').focus(); }
  function fecharLimites() { $('exc-limites').hidden = true; }

  // ── Camada 1 (spec 6.3) ──
  // Entra ABAIXO da confirmação de salvamento e separada dela. Misturar as duas
  // frases deixaria ambíguo se a gravação funcionou; separadas, a primeira
  // confirma o ato e a segunda informa o estado em que o exercício ficou.
  function avisarDoQueFicaNoComputador() {
    $('exc-recado').insertAdjacentHTML('beforeend',
      `<div class="exc-aviso-desktop">
         <b>Este exercício continua aguardando validação.</b> Marcar como revisado é o que o libera para os atletas, e essa ação fica no computador.
         <button type="button" data-abrir-limites>Ver o que fica no computador</button>
       </div>`);
  }

  async function salvar(tambemRevisar) {
    if (modo === 'criar') return criarExercicio(tambemRevisar);
    if (!emEdicao) return;
    const botoes = [$('exc-salvar'), $('exc-salvar-revisar')];
    botoes.forEach((b) => (b.disabled = true));
    try {
      const diff = alterados();
      if (Object.keys(diff).length) {
        await chamar('atualizar-exercicio', { operacao: 'editar', exerciseId: emEdicao.id, campos: diff });
      }
      if (tambemRevisar) {
        await chamar('atualizar-exercicio', { operacao: 'revisar', exerciseId: emEdicao.id });
      }
      recado(
        tambemRevisar ? 'Salvo e marcado como revisado.'
          : Object.keys(diff).length ? 'Alterações salvas.' : 'Nada havia mudado.',
        'ok',
      );
      // Só no celular, e só enquanto o exercício continuar aguardando: no que já
      // está revisado não há nada a avisar, e repetir o aviso ali o transformaria
      // em ruído que se aprende a ignorar (decisão 8 da spec).
      if (noCelular() && !tambemRevisar && !emEdicao.revisado) avisarDoQueFicaNoComputador();
      await carregar();
      if (tambemRevisar) setTimeout(fechar, 900);
    } catch (e) {
      recado(e.message, 'erro');
    } finally {
      botoes.forEach((b) => (b.disabled = false));
    }
  }

  // ── Cadastro (spec 5.5) ──
  // Abre a MESMA gaveta em modo de criação. O que muda é o que não faz sentido
  // num documento que ainda não existe: não há procedência para mostrar, não há
  // selo de revisão para exibir e não há o que arquivar nem desrevisar.
  function abrirNovo() {
    modo = 'criar';
    emEdicao = null;
    secundarios = [];
    $('exc-painel-nome').textContent = 'Novo exercício';
    $('exc-painel-selo').innerHTML =
      '<span class="exc-selo exc-selo--ok">curadoria do Coach</span>';
    $('exc-f-nome').value = '';
    $('exc-f-instrucao').value = '';
    // Vazio, e não pré-escolhido: um grupo sugerido é o grupo que a metade
    // apressada dos cadastros vai herdar sem ninguém ter decidido nada.
    $('exc-f-grupo').value = '';
    $('exc-f-equipamento').value = '';
    $('exc-f-mecanica').value = '';
    $('exc-f-nivel').value = '';
    $('exc-f-musculo').value = '';
    $('exc-f-revisar-musculo').checked = false;
    pintarSecundarios();
    $('exc-recado').innerHTML = '';
    $('exc-proc').hidden = true;
    $('exc-desrevisar').hidden = true;
    $('exc-arquivar').hidden = true;
    // A marca de "músculo a conferir" fala de classificação herdada de acervo.
    // Num exercício que o Coach está classificando agora ela não tem sentido, e
    // o servidor a grava como falsa de qualquer forma.
    $('exc-f-revisar-musculo').closest('label').hidden = true;
    $('exc-salvar-revisar').hidden = false;
    const g = $('exc-gaveta');
    g.hidden = false;
    requestAnimationFrame(() => g.classList.add('aberta'));
    $('exc-f-nome').focus();
  }

  async function criarExercicio(revisar) {
    const botoes = [$('exc-salvar'), $('exc-salvar-revisar')];
    botoes.forEach((b) => (b.disabled = true));
    try {
      const campos = valores();
      // Validação de tela é conveniência; a garantia é do servidor. Ela existe
      // aqui só para não gastar uma ida à rede num formulário obviamente
      // incompleto — e para apontar o campo, que o erro do servidor não faz.
      const faltando = [
        ['nome_pt', 'o nome em português'], ['instrucao_pt', 'a instrução'],
        ['grupo', 'o grupo'], ['musculoPrimario', 'o músculo principal'],
        ['equipamento', 'o equipamento'], ['nivel', 'o nível'],
      ].filter(([k]) => !campos[k]).map(([, r]) => r);
      if (faltando.length) {
        recado(`Falta preencher ${faltando.join(', ')}.`, 'erro');
        return;
      }
      const r = await chamar('atualizar-exercicio', { operacao: 'criar', campos, revisar });
      recado(revisar
        ? 'Exercício criado e marcado como revisado.'
        : 'Exercício criado. Ele entra na fila aguardando sua revisão.', 'ok');
      // Leva o filtro para onde o exercício novo de fato está, senão o Coach
      // cria algo e volta para uma lista onde ele não aparece — e conclui que a
      // gravação falhou.
      estado.estado = revisar ? 'revisados' : 'aguardando';
      estado.busca = campos.nome_pt;
      $('exc-busca').value = campos.nome_pt;
      estado.pagina = 1;
      pintarEstados();
      await carregar();
      setTimeout(fechar, 1100);
      return r;
    } catch (e) {
      recado(e.message, 'erro');
    } finally {
      botoes.forEach((b) => (b.disabled = false));
    }
  }

  // ── Arquivar e desarquivar (spec 5.4) ──
  async function alternarArquivo() {
    if (!emEdicao) return;
    const b = $('exc-arquivar');
    const arquivando = emEdicao.ativo !== false;
    b.disabled = true;
    try {
      await chamar('atualizar-exercicio', {
        operacao: arquivando ? 'arquivar' : 'desarquivar',
        exerciseId: emEdicao.id,
      });
      recado(arquivando
        ? 'Arquivado. Some do seletor de planos novos; quem já o tem num plano continua com ele.'
        : 'Desarquivado. Volta a aparecer no seletor de planos novos.', 'ok');
      await carregar();
      // Fecha: o exercício saiu do filtro em que a lista está, e deixar a gaveta
      // aberta sobre um item que não está mais na tela convida a salvar em cima
      // de um documento que ninguém está vendo.
      setTimeout(fechar, 1100);
    } catch (e) {
      recado(e.message, 'erro');
    } finally { b.disabled = false; }
  }

  // ── Ligações ──
  opcoes($('exc-grupo'), GRUPOS, 'Todos os grupos');
  opcoes($('exc-equipamento'), EQUIPAMENTOS, 'Todos os equipamentos');
  opcoes($('exc-f-grupo'), GRUPOS);
  opcoes($('exc-f-equipamento'), EQUIPAMENTOS);
  opcoes($('exc-f-mecanica'), MECANICAS, '—');
  opcoes($('exc-f-nivel'), NIVEIS);
  opcoes($('exc-f-musculo'), MUSCULOS);
  pintarEstados();
  pintarGrupos();

  let debounce;
  $('exc-busca').addEventListener('input', (ev) => {
    clearTimeout(debounce);
    debounce = setTimeout(() => { estado.busca = ev.target.value.trim(); estado.pagina = 1; carregar(); }, 250);
  });
  $('exc-grupo').addEventListener('change', (ev) => trocarGrupo(ev.target.value));
  $('exc-grupos-faixa').addEventListener('click', (ev) => {
    const b = ev.target.closest('[data-grupo]');
    if (b) trocarGrupo(b.dataset.grupo);
  });
  $('exc-equipamento').addEventListener('change', (ev) => { estado.equipamento = ev.target.value; estado.pagina = 1; carregar(); });
  $('exc-estados').addEventListener('click', (ev) => {
    const b = ev.target.closest('[data-estado]');
    if (!b) return;
    estado.estado = b.dataset.estado; estado.pagina = 1;
    pintarEstados(); carregar();
  });
  $('exc-lote').addEventListener('click', (ev) => {
    if (ev.target.closest('#exc-lote-abrir')) abrirJanelaLote();
  });
  $('exc-limites-abrir').addEventListener('click', abrirLimites);
  $('exc-limites-fechar').addEventListener('click', fecharLimites);
  $('exc-limites').addEventListener('click', (ev) => { if (ev.target.id === 'exc-limites') fecharLimites(); });
  // A ligação da camada 1 nasce dentro de #exc-recado, que é reescrito a cada
  // salvamento — por isso a escuta fica no contêiner, e não no botão.
  $('exc-recado').addEventListener('click', (ev) => {
    if (ev.target.closest('[data-abrir-limites]')) abrirLimites();
  });
  $('exc-lote-nao').addEventListener('click', fecharJanelaLote);
  $('exc-lote-sim').addEventListener('click', () => aplicarLote(ultimoLote));
  $('exc-lote-janela').addEventListener('click', (ev) => { if (ev.target.id === 'exc-lote-janela') fecharJanelaLote(); });
  $('exc-linhas').addEventListener('click', (ev) => {
    const b = ev.target.closest('.exc-linha');
    if (b) abrir(Number(b.dataset.i));
  });
  $('exc-anterior').addEventListener('click', () => { estado.pagina--; carregar(); });
  $('exc-proxima').addEventListener('click', () => { estado.pagina++; carregar(); });
  $('exc-fechar').addEventListener('click', fechar);
  $('exc-gaveta').addEventListener('click', (ev) => { if (ev.target.id === 'exc-gaveta') fechar(); });
  // Escape fecha a camada mais alta primeiro: janelas antes da gaveta.
  document.addEventListener('keydown', (ev) => {
    if (ev.key !== 'Escape') return;
    if (!$('exc-limites').hidden) { fecharLimites(); return; }
    if (!$('exc-lote-janela').hidden) { fecharJanelaLote(); return; }
    if (!$('exc-gaveta').hidden) fechar();
  });
  $('exc-f-secundarios').addEventListener('click', (ev) => {
    const b = ev.target.closest('[data-rm]');
    if (!b) return;
    secundarios.splice(Number(b.dataset.rm), 1);
    pintarSecundarios();
  });
  $('exc-f-add-secundario').addEventListener('change', (ev) => {
    if (!ev.target.value) return;
    secundarios.push(ev.target.value);
    pintarSecundarios();
  });
  $('exc-desrevisar').addEventListener('click', async () => {
    if (!emEdicao) return;
    const b = $('exc-desrevisar');
    b.disabled = true;
    try {
      await chamar('atualizar-exercicio', { operacao: 'desrevisar', exerciseId: emEdicao.id });
      recado('Devolvido à fila de revisão.', 'ok');
      await carregar();
      b.hidden = true;
      $('exc-salvar-revisar').hidden = false;
      $('exc-painel-selo').innerHTML = '<span class="exc-selo exc-selo--pend">aguardando validação do Coach</span>';
    } catch (e) {
      recado(e.message, 'erro');
    } finally { b.disabled = false; }
  });
  $('exc-salvar').addEventListener('click', () => salvar(false));
  $('exc-salvar-revisar').addEventListener('click', () => salvar(true));
  $('exc-novo').addEventListener('click', abrirNovo);
  $('exc-arquivar').addEventListener('click', alternarArquivo);

  // Aplica o corte antes de qualquer carga: assim o primeiro carregar() já sai
  // com o estado certo, em vez de buscar "aguardando" e refazer o pedido.
  CORTE.addEventListener('change', () => aplicarCorte(true));
  aplicarCorte(false);

  // Guarda de autenticação, no padrão de fichas.astro: sessão E claim de admin.
  // "Autenticado" não é "autorizado" — qualquer pessoa consegue criar conta
  // neste projeto, e a autorização real é o claim.
  onAuthStateChanged(auth, async (user) => {
    if (!user) { window.location.href = '/admin/login'; return; }
    try {
      const r = await user.getIdTokenResult(true);
      if (!r.claims.admin) { await signOut(auth); window.location.href = '/admin/login?erro=acesso-negado'; return; }
    } catch {
      await signOut(auth); window.location.href = '/admin/login'; return;
    }
    const el = document.getElementById('adm-email');
    if (el) el.textContent = user.email ?? '';
    carregar();
  });
</script>
</body>
</html>
