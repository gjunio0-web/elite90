---
// ELITE90 PRO · /admin/exercicios — Catálogo de Exercícios
//
// Passo 2 da ordem de execução da especificação (24/08/2026): lista, filtros e
// painel de edição. Ficam para os passos seguintes a revisão em bloco (3), a
// faixa no hub e o atalho do construtor (4), a versão de celular (5) e o
// cadastro de exercício novo (6).
//
// POR QUE ESTA TELA EXISTE
// Os campos revisadoPor e revisadoEm estão no esquema e nada os preenchia com
// gente de verdade: quem carimbava era um script, em bloco, com o valor
// sentinela 'coach:aprovacao-lote-NN', porque não havia sessão autenticada do
// Coach em ponto nenhum do fluxo de revisão. Aqui há.
//
// DE ONDE VÊM OS DADOS — e por que não do arquivo estático
// A leitura é pela função listar-exercicios, não por /dados/exercicios.json. O
// arquivo passa pelo portão de contexto e em produção traz somente os já
// revisados — hoje zero de 519. Esta tela precisa exatamente do complemento
// disso. O cabeçalho de listar-exercicios.ts detalha.
//
// SEM BARRA DE ABAS, de propósito (decisão 3): AdminHeader com etiqueta e seta
// de voltar, igual a atletas, fichas e guia.
export const prerender = false;
import '@fontsource/bebas-neue';
import '@fontsource/raleway/400.css';
import '@fontsource/raleway/700.css';
import '@fontsource/montserrat/400.css';
import '@fontsource/montserrat/700.css';
import '../../styles/tokens.css';
import '../../styles/global.css';
import AdminHeader from '../../components/AdminHeader.astro';
---
<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="robots" content="noindex, nofollow" />
<!-- Configuração pública do Firebase, no mesmo mecanismo de fichas.astro: vem
     das variáveis PUBLIC_* em tempo de build e é lida pelo script via meta. -->
<meta name="fb-api"    content={import.meta.env.PUBLIC_FIREBASE_API_KEY} />
<meta name="fb-auth"   content={import.meta.env.PUBLIC_FIREBASE_AUTH_DOMAIN} />
<meta name="fb-proj"   content={import.meta.env.PUBLIC_FIREBASE_PROJECT_ID} />
<meta name="fb-bucket" content={import.meta.env.PUBLIC_FIREBASE_STORAGE_BUCKET} />
<meta name="fb-sender" content={import.meta.env.PUBLIC_FIREBASE_MESSAGING_SENDER_ID} />
<meta name="fb-appid"  content={import.meta.env.PUBLIC_FIREBASE_APP_ID} />
<title>Catálogo de Exercícios · ELITE90 PRO</title>
<!-- is:global como nas cinco telas vizinhas do painel. NÃO é preferência de
     estilo: as linhas da tabela e os chips do painel são criados por innerHTML,
     e o escopo do Astro marca só os elementos que estavam no template. Com
     estilo escopado, tudo que o script cria fica sem CSS — a tabela renderizava
     com as linhas sobrepostas e o display:grid simplesmente não pegava. -->
<style is:global>
  body { background: var(--c-black); color: var(--c-textbody); font-family: var(--font-body); }
  .exc-main { max-width: var(--max-w-content); margin: 0 auto; padding: var(--space-5) var(--space-5) var(--space-8); }

  .exc-topo { display: flex; align-items: flex-end; justify-content: space-between; gap: var(--space-4); flex-wrap: wrap; margin-bottom: var(--space-5); }
  .exc-titulo { font-family: var(--font-display); font-size: var(--fs-display-md); color: var(--c-white); letter-spacing: var(--tracking-display); line-height: var(--lh-display); margin: 0; }
  .exc-contadores { font-size: var(--fs-body-sm); color: var(--c-textsub); margin-top: var(--space-1); }
  .exc-contadores strong { color: var(--c-textbody); font-weight: var(--fw-body-bold); }

  .exc-filtros { display: flex; gap: var(--space-2); flex-wrap: wrap; margin-bottom: var(--space-3); }
  .exc-campo { background: var(--c-darkbg); border: 1px solid var(--c-line-muted); border-radius: var(--radius-card); color: var(--c-textbody); font-family: var(--font-body); font-size: var(--fs-body-sm); padding: 9px 12px; }
  .exc-campo:focus { outline: none; border-color: var(--c-lime); box-shadow: var(--glow-lime-sm); }
  #exc-busca { flex: 1; min-width: 220px; }

  .exc-estados { display: flex; gap: var(--space-2); flex-wrap: wrap; margin-bottom: var(--space-5); }
  .exc-estado { font-family: var(--font-label); font-weight: var(--fw-label); font-size: var(--fs-label); letter-spacing: var(--tracking-label); text-transform: uppercase; padding: 6px 14px; border-radius: var(--radius-pill); background: transparent; border: 1px solid var(--c-line-muted); color: var(--c-textsub); cursor: pointer; transition: color var(--dur-fast) var(--ease-std), border-color var(--dur-fast) var(--ease-std); }
  .exc-estado:hover { color: var(--c-textbody); }
  .exc-estado[aria-pressed="true"] { background: rgba(166,195,0,0.12); border-color: rgba(166,195,0,0.4); color: var(--c-lime); }

  .exc-tabela { border: 1px solid var(--c-line-muted); border-radius: var(--radius-card); overflow: hidden; }
  .exc-cab, .exc-linha { display: grid; grid-template-columns: 1fr 130px 140px 150px; gap: var(--space-3); padding: 11px var(--space-4); align-items: center; }
  .exc-cab { background: var(--c-darkbg); font-family: var(--font-label); font-weight: var(--fw-label); font-size: var(--fs-label); letter-spacing: var(--tracking-label); text-transform: uppercase; color: var(--c-textsub); }
  .exc-linha { border-top: 1px solid rgba(255,255,255,0.05); cursor: pointer; background: transparent; border-left: 0; border-right: 0; border-bottom: 0; width: 100%; text-align: left; font: inherit; color: inherit; }
  .exc-linha:hover, .exc-linha:focus-visible { background: rgba(166,195,0,0.06); outline: none; }
  .exc-linha:focus-visible { box-shadow: inset 0 0 0 1px var(--c-lime); }
  .exc-nome { font-size: var(--fs-body-sm); color: var(--c-white); }
  .exc-col { font-size: var(--fs-body-sm); color: var(--c-textsub); }
  .exc-selo { display: inline-block; margin-top: 5px; font-family: var(--font-label); font-weight: var(--fw-label); font-size: 10px; letter-spacing: 0.08em; text-transform: uppercase; padding: 2px 9px; border-radius: var(--radius-pill); }
  .exc-selo--pend { color: var(--c-pending); border: 1px solid rgba(230,126,34,0.45); background: rgba(230,126,34,0.12); }
  .exc-selo--ok { color: var(--c-lime); border: 1px solid rgba(166,195,0,0.4); background: rgba(166,195,0,0.12); }
  .exc-selo--arq { color: var(--c-textsub); border: 1px solid var(--c-line-muted); }
  /* Triângulo de músculo a conferir (spec 5.1). Marca herdada da base de origem;
     não é estado de revisão, e por isso não vira selo. */
  .exc-aviso-musculo { color: var(--c-pending); margin-left: 6px; font-size: 12px; }

  .exc-vazio, .exc-carregando { padding: var(--space-6); text-align: center; font-size: var(--fs-body-sm); color: var(--c-textsub); }
  .exc-erro { padding: var(--space-4); border: 1px solid rgba(230,126,34,0.4); background: rgba(230,126,34,0.08); border-radius: var(--radius-card); color: var(--c-pending); font-size: var(--fs-body-sm); }

  .exc-paginacao { display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); margin-top: var(--space-3); font-size: var(--fs-body-sm); color: var(--c-textsub); }
  .exc-pag-btn { background: transparent; border: 1px solid var(--c-line-muted); color: var(--c-textbody); border-radius: var(--radius-card); padding: 6px 12px; font-family: var(--font-label); font-size: var(--fs-label); cursor: pointer; }
  .exc-pag-btn[disabled] { opacity: 0.35; cursor: default; }

  /* ── Painel de edição — mesmo padrão de gaveta lateral de atletas.astro ── */
  .exc-gaveta { position: fixed; inset: 0; z-index: 100; display: flex; justify-content: flex-end; background: rgba(0,0,0,0); transition: background var(--dur-med) var(--ease-std); }
  .exc-gaveta[hidden] { display: none !important; }
  .exc-gaveta.aberta { background: rgba(0,0,0,0.6); }
  .exc-painel { width: min(440px, 100%); height: 100%; background: var(--c-darkbg); border-left: 1px solid var(--c-line-muted); padding: var(--space-5); overflow-y: auto; transform: translateX(100%); transition: transform var(--dur-med) var(--ease-out); }
  .exc-gaveta.aberta .exc-painel { transform: translateX(0); }
  .exc-painel-topo { display: flex; align-items: flex-start; justify-content: space-between; gap: var(--space-3); }
  .exc-painel-nome { font-family: var(--font-display); font-size: var(--fs-display-sm); color: var(--c-white); letter-spacing: var(--tracking-display); line-height: var(--lh-tight); }
  .exc-fechar { background: transparent; border: 0; color: var(--c-textsub); font-size: 20px; cursor: pointer; line-height: 1; padding: 0 4px; }
  .exc-rotulo { display: block; font-family: var(--font-label); font-weight: var(--fw-label); font-size: var(--fs-label); letter-spacing: var(--tracking-label); text-transform: uppercase; color: var(--c-textsub); margin: var(--space-4) 0 6px; }
  .exc-input, .exc-select, .exc-area { width: 100%; background: var(--c-black); border: 1px solid var(--c-line-muted); border-radius: var(--radius-card); color: var(--c-white); font-family: var(--font-body); font-size: var(--fs-body-sm); padding: 10px 12px; }
  .exc-area { line-height: var(--lh-body); resize: vertical; min-height: 96px; }
  .exc-input:focus, .exc-select:focus, .exc-area:focus { outline: none; border-color: var(--c-lime); box-shadow: var(--glow-lime-sm); }
  .exc-dupla { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-3); }
  .exc-secundarios { display: flex; gap: 6px; flex-wrap: wrap; }
  .exc-chip { display: inline-flex; align-items: center; gap: 6px; font-family: var(--font-label); font-size: 11px; padding: 5px 10px; border-radius: var(--radius-pill); border: 1px solid var(--c-line-muted); background: rgba(255,255,255,0.04); color: var(--c-textbody); }
  .exc-chip button { background: transparent; border: 0; color: var(--c-textsub); cursor: pointer; font-size: 13px; line-height: 1; padding: 0; }
  .exc-proc { margin-top: var(--space-5); padding-top: var(--space-4); border-top: 1px solid rgba(255,255,255,0.07); font-size: 11px; color: var(--c-textsub); line-height: 1.85; }
  .exc-proc b { color: var(--c-textbody); font-weight: var(--fw-body); }
  .exc-acoes { display: flex; gap: var(--space-2); margin-top: var(--space-5); }
  .exc-btn-lime { flex: 1; background: var(--grad-cta); color: var(--c-black); border: 0; border-radius: var(--radius-card); padding: 12px; font-family: var(--font-label); font-weight: var(--fw-label); font-size: var(--fs-label); letter-spacing: var(--tracking-cta); text-transform: uppercase; cursor: pointer; }
  .exc-btn-vazado { background: transparent; border: 1px solid rgba(255,255,255,0.18); color: var(--c-textbody); border-radius: var(--radius-card); padding: 12px 16px; font-family: var(--font-label); font-size: var(--fs-label); cursor: pointer; }
  .exc-btn-lime[disabled], .exc-btn-vazado[disabled] { opacity: 0.45; cursor: default; }
  .exc-nota { margin-top: var(--space-3); background: rgba(255,255,255,0.03); border-left: 2px solid var(--c-olive); padding: 10px 12px; font-size: 11px; color: var(--c-textsub); line-height: 1.65; }
  .exc-recado { margin-top: var(--space-3); font-size: var(--fs-body-sm); padding: 10px 12px; border-radius: var(--radius-card); }
  .exc-recado--ok { color: var(--c-lime); background: rgba(166,195,0,0.08); border: 1px solid rgba(166,195,0,0.3); }
  .exc-recado--erro { color: var(--c-pending); background: rgba(230,126,34,0.08); border: 1px solid rgba(230,126,34,0.35); }

  @media (max-width: 900px) {
    .exc-cab { display: none; }
    .exc-linha { grid-template-columns: 1fr; gap: 4px; }
    .exc-painel { width: 100%; border-left: 0; }
  }
</style>
</head>
<body>
<AdminHeader badge="Exercícios" backHref="/admin" />

<main class="exc-main">
  <div class="exc-topo">
    <div>
      <h1 class="exc-titulo">Catálogo de Exercícios</h1>
      <div class="exc-contadores" id="exc-contadores">Carregando…</div>
    </div>
  </div>

  <div class="exc-filtros">
    <input class="exc-campo" id="exc-busca" type="search" placeholder="Buscar por nome, em português ou inglês…" autocomplete="off" />
    <select class="exc-campo" id="exc-grupo"><option value="">Todos os grupos</option></select>
    <select class="exc-campo" id="exc-equipamento"><option value="">Todos os equipamentos</option></select>
  </div>

  <div class="exc-estados" id="exc-estados" role="group" aria-label="Filtrar por estado"></div>

  <div class="exc-tabela">
    <div class="exc-cab"><span>Exercício</span><span>Grupo</span><span>Equipamento</span><span>Músculo</span></div>
    <div id="exc-linhas"><div class="exc-carregando">Carregando o catálogo…</div></div>
  </div>

  <div class="exc-paginacao">
    <span id="exc-resumo"></span>
    <span>
      <button class="exc-pag-btn" id="exc-anterior" type="button" disabled>Anterior</button>
      <button class="exc-pag-btn" id="exc-proxima" type="button" disabled>Próxima</button>
    </span>
  </div>
</main>

<div class="exc-gaveta" id="exc-gaveta" hidden>
  <aside class="exc-painel" role="dialog" aria-modal="true" aria-labelledby="exc-painel-nome">
    <div class="exc-painel-topo">
      <div class="exc-painel-nome" id="exc-painel-nome"></div>
      <button class="exc-fechar" id="exc-fechar" type="button" aria-label="Fechar">✕</button>
    </div>
    <div id="exc-painel-selo"></div>

    <label class="exc-rotulo" for="exc-f-nome">Nome em português</label>
    <input class="exc-input" id="exc-f-nome" type="text" />

    <label class="exc-rotulo" for="exc-f-instrucao">Instrução</label>
    <textarea class="exc-area" id="exc-f-instrucao"></textarea>

    <div class="exc-dupla">
      <div><label class="exc-rotulo" for="exc-f-grupo">Grupo</label><select class="exc-select" id="exc-f-grupo"></select></div>
      <div><label class="exc-rotulo" for="exc-f-equipamento">Equipamento</label><select class="exc-select" id="exc-f-equipamento"></select></div>
      <div><label class="exc-rotulo" for="exc-f-mecanica">Mecânica</label><select class="exc-select" id="exc-f-mecanica"></select></div>
      <div><label class="exc-rotulo" for="exc-f-nivel">Nível</label><select class="exc-select" id="exc-f-nivel"></select></div>
    </div>

    <label class="exc-rotulo" for="exc-f-musculo">Músculo principal</label>
    <select class="exc-select" id="exc-f-musculo"></select>

    <label class="exc-rotulo">Músculos auxiliares</label>
    <div class="exc-secundarios" id="exc-f-secundarios"></div>
    <select class="exc-select" id="exc-f-add-secundario" style="margin-top:8px"></select>

    <label class="exc-rotulo" for="exc-f-revisar-musculo" style="display:flex;align-items:center;gap:8px;text-transform:none;letter-spacing:0">
      <input type="checkbox" id="exc-f-revisar-musculo" />
      <span>Classificação de músculo a conferir</span>
    </label>

    <div class="exc-proc">
      <span class="exc-rotulo" style="margin:0 0 8px">Procedência · somente leitura</span>
      <div id="exc-proc-corpo"></div>
    </div>

    <div class="exc-acoes">
      <button class="exc-btn-lime" id="exc-salvar-revisar" type="button">Salvar e marcar como revisado</button>
      <button class="exc-btn-vazado" id="exc-salvar" type="button">Salvar</button>
    </div>
    <div id="exc-recado"></div>

    <p class="exc-nota">A alteração é gravada no banco imediatamente. A chegada ao portal acontece na próxima publicação do site, que leva alguns minutos — se a busca do construtor de treino ainda mostrar o valor antigo, não é falha do salvamento.</p>
  </aside>
</div>

<script type="module" is:inline>
  import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-app.js";
  import { getAuth, signOut, onAuthStateChanged } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-auth.js";

  const meta = (n) => document.querySelector(`meta[name="${n}"]`)?.content;
  const app = initializeApp({
    apiKey: meta('fb-api'), authDomain: meta('fb-auth'), projectId: meta('fb-proj'),
    storageBucket: meta('fb-bucket'), messagingSenderId: meta('fb-sender'), appId: meta('fb-appid'),
  });
  const auth = getAuth(app);

  // Vocabulário fechado. Espelha netlify/functions/_vocabulario-exercicios.ts,
  // que é quem de fato valida — aqui é conveniência de formulário. Se as listas
  // divergirem, o servidor recusa e a tela mostra o motivo; nunca o contrário.
  const GRUPOS = ['Peito','Costas','Ombros','Bíceps','Tríceps','Antebraço','Pernas','Abdômen'];
  const MUSCULOS = ['Peitoral','Dorsal','Trapézio','Lombar','Deltoide','Bíceps','Tríceps','Antebraço',
    'Quadríceps','Posterior de Coxa','Glúteo','Panturrilha','Adutor','Abdutor','Abdômen','Oblíquo'];
  const EQUIPAMENTOS = ['Barra','Halteres','Polia','Máquina','Peso Corporal','Barra W','Kettlebell'];
  const MECANICAS = ['composto','isolado'];
  const NIVEIS = ['iniciante','intermediario','avancado'];

  const ESTADOS = [
    { valor: 'aguardando', rotulo: 'Aguardando revisão' },
    { valor: 'revisados',  rotulo: 'Revisados' },
    { valor: 'arquivados', rotulo: 'Arquivados' },
  ];

  const $ = (id) => document.getElementById(id);
  const esc = (s) => String(s ?? '').replace(/[&<>"']/g, (c) => (
    { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

  let estado = { estado: 'aguardando', grupo: '', equipamento: '', busca: '', pagina: 1 };
  let itens = [];
  let emEdicao = null;
  let secundarios = [];

  // Token sempre fresco: o SDK renova sozinho, e guardar o valor numa variável
  // daria erro de sessão uma hora depois — mesma nota de fichas.astro.
  async function token() {
    const u = auth.currentUser;
    if (!u) throw new Error('Sessão expirada. Recarregue a página.');
    return u.getIdToken(false);
  }

  async function chamar(rota, corpo) {
    const resp = await fetch(`/.netlify/functions/${rota}`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${await token()}` },
      body: JSON.stringify(corpo),
    });
    const texto = await resp.text();
    let dados = {};
    try { dados = texto ? JSON.parse(texto) : {}; } catch { dados = { erro: texto }; }
    if (!resp.ok) throw new Error(dados.erro || dados.detalhes?.join('; ') || `Falha ${resp.status}`);
    return dados;
  }

  function opcoes(sel, lista, vazio) {
    sel.innerHTML = (vazio ? `<option value="">${vazio}</option>` : '') +
      lista.map((v) => `<option value="${esc(v)}">${esc(v)}</option>`).join('');
  }

  function pintarEstados() {
    $('exc-estados').innerHTML = ESTADOS.map((e) =>
      `<button type="button" class="exc-estado" data-estado="${e.valor}" aria-pressed="${e.valor === estado.estado}">${e.rotulo}</button>`
    ).join('');
  }

  function pintarLinhas(dados) {
    itens = dados.itens;
    const c = dados.contadores;
    $('exc-contadores').innerHTML =
      `<strong>${c.total}</strong> exercícios · <strong>${c.revisados}</strong> revisados · <strong>${c.aguardando}</strong> aguardando` +
      (c.arquivados ? ` · <strong>${c.arquivados}</strong> arquivados` : '');

    if (!itens.length) {
      $('exc-linhas').innerHTML = '<div class="exc-vazio">Nenhum exercício para este filtro.</div>';
    } else {
      $('exc-linhas').innerHTML = itens.map((e, i) => {
        const selo = !e.ativo
          ? '<span class="exc-selo exc-selo--arq">arquivado</span>'
          : e.revisado
            ? '<span class="exc-selo exc-selo--ok">revisado</span>'
            : '<span class="exc-selo exc-selo--pend">aguardando</span>';
        const aviso = e.revisarMusculo
          ? '<span class="exc-aviso-musculo" title="Classificação de músculo herdada da origem — conferir ao revisar">▲</span>'
          : '';
        return `<button type="button" class="exc-linha" data-i="${i}">
          <span class="exc-nome">${esc(e.nome_pt)}${aviso}<br>${selo}</span>
          <span class="exc-col">${esc(e.grupo)}</span>
          <span class="exc-col">${esc(e.equipamento)}</span>
          <span class="exc-col">${esc(e.musculoPrimario)}</span>
        </button>`;
      }).join('');
    }

    const de = dados.encontrados ? (dados.pagina - 1) * dados.porPagina + 1 : 0;
    const ate = Math.min(dados.pagina * dados.porPagina, dados.encontrados);
    $('exc-resumo').textContent = dados.encontrados
      ? `Mostrando ${de}–${ate} de ${dados.encontrados}`
      : 'Nenhum resultado';
    estado.pagina = dados.pagina;
    $('exc-anterior').disabled = dados.pagina <= 1;
    $('exc-proxima').disabled = dados.pagina >= dados.paginas;
  }

  let pedido = 0;
  async function carregar() {
    const meu = ++pedido;
    try {
      const dados = await chamar('listar-exercicios', estado);
      // Descarta resposta de pedido antigo: digitar rápido na busca dispara
      // várias, e a lenta pode chegar depois da rápida e repintar dado velho.
      if (meu !== pedido) return;
      pintarLinhas(dados);
    } catch (e) {
      if (meu !== pedido) return;
      $('exc-linhas').innerHTML = `<div class="exc-erro">Não foi possível carregar o catálogo. ${esc(e.message)}</div>`;
    }
  }

  function pintarSecundarios() {
    $('exc-f-secundarios').innerHTML = secundarios.length
      ? secundarios.map((m, i) => `<span class="exc-chip">${esc(m)}<button type="button" data-rm="${i}" aria-label="Remover ${esc(m)}">✕</button></span>`).join('')
      : '<span style="font-size:11px;color:var(--c-textsub)">nenhum</span>';
    opcoes($('exc-f-add-secundario'), MUSCULOS.filter((m) => !secundarios.includes(m)), '+ adicionar auxiliar');
  }

  function abrir(i) {
    const e = itens[i];
    if (!e) return;
    emEdicao = e;
    secundarios = [...(e.musculosSecundarios || [])];
    $('exc-painel-nome').textContent = e.nome_pt;
    $('exc-painel-selo').innerHTML = e.revisado
      ? `<span class="exc-selo exc-selo--ok">revisado${e.revisadoEm ? ' em ' + new Date(e.revisadoEm).toLocaleDateString('pt-BR') : ''}</span>`
      : '<span class="exc-selo exc-selo--pend">aguardando validação do Coach</span>';
    $('exc-f-nome').value = e.nome_pt ?? '';
    $('exc-f-instrucao').value = e.instrucao_pt ?? '';
    $('exc-f-grupo').value = e.grupo ?? '';
    $('exc-f-equipamento').value = e.equipamento ?? '';
    $('exc-f-mecanica').value = e.mecanica ?? '';
    $('exc-f-nivel').value = e.nivel ?? '';
    $('exc-f-musculo').value = e.musculoPrimario ?? '';
    $('exc-f-revisar-musculo').checked = !!e.revisarMusculo;
    pintarSecundarios();
    $('exc-proc-corpo').innerHTML =
      `Nome de origem · <b>${esc(e.nome_en ?? '—')}</b><br>` +
      `Fonte · <b>${esc(e.origem?.fonte ?? '—')}</b><br>` +
      `Criado por · <b>${esc(e.criadoPor ?? '—')}</b><br>` +
      `Última alteração · <b>${e.atualizadoEm ? esc(new Date(e.atualizadoEm).toLocaleString('pt-BR')) : '—'}</b>`;
    $('exc-recado').innerHTML = '';
    $('exc-salvar-revisar').hidden = e.revisado;
    const g = $('exc-gaveta');
    g.hidden = false;
    requestAnimationFrame(() => g.classList.add('aberta'));
  }

  function fechar() {
    const g = $('exc-gaveta');
    g.classList.remove('aberta');
    setTimeout(() => { g.hidden = true; emEdicao = null; }, 250);
  }

  /** Só o que mudou. Mandar o documento inteiro faria toda edição carregar
   *  campos que ninguém tocou, multiplicando a chance de sobrescrever com dado
   *  velho — a função aceita parcial justamente por isso. */
  function alterados() {
    const e = emEdicao;
    const novo = {
      nome_pt: $('exc-f-nome').value.trim(),
      instrucao_pt: $('exc-f-instrucao').value.trim(),
      grupo: $('exc-f-grupo').value,
      equipamento: $('exc-f-equipamento').value,
      mecanica: $('exc-f-mecanica').value || null,
      nivel: $('exc-f-nivel').value,
      musculoPrimario: $('exc-f-musculo').value,
      musculosSecundarios: secundarios,
      revisarMusculo: $('exc-f-revisar-musculo').checked,
    };
    const diff = {};
    for (const [k, v] of Object.entries(novo)) {
      const atual = e[k];
      const igual = Array.isArray(v)
        ? Array.isArray(atual) && v.length === atual.length && v.every((x, i) => x === atual[i])
        : v === (atual ?? (typeof v === 'boolean' ? false : ''));
      if (!igual) diff[k] = v;
    }
    return diff;
  }

  function recado(texto, tipo) {
    $('exc-recado').innerHTML = `<div class="exc-recado exc-recado--${tipo}">${esc(texto)}</div>`;
  }

  async function salvar(tambemRevisar) {
    if (!emEdicao) return;
    const botoes = [$('exc-salvar'), $('exc-salvar-revisar')];
    botoes.forEach((b) => (b.disabled = true));
    try {
      const diff = alterados();
      if (Object.keys(diff).length) {
        await chamar('atualizar-exercicio', { operacao: 'editar', exerciseId: emEdicao.id, campos: diff });
      }
      if (tambemRevisar) {
        await chamar('atualizar-exercicio', { operacao: 'revisar', exerciseId: emEdicao.id });
      }
      recado(
        tambemRevisar ? 'Salvo e marcado como revisado.'
          : Object.keys(diff).length ? 'Alterações salvas.' : 'Nada havia mudado.',
        'ok',
      );
      await carregar();
      if (tambemRevisar) setTimeout(fechar, 900);
    } catch (e) {
      recado(e.message, 'erro');
    } finally {
      botoes.forEach((b) => (b.disabled = false));
    }
  }

  // ── Ligações ──
  opcoes($('exc-grupo'), GRUPOS, 'Todos os grupos');
  opcoes($('exc-equipamento'), EQUIPAMENTOS, 'Todos os equipamentos');
  opcoes($('exc-f-grupo'), GRUPOS);
  opcoes($('exc-f-equipamento'), EQUIPAMENTOS);
  opcoes($('exc-f-mecanica'), MECANICAS, '—');
  opcoes($('exc-f-nivel'), NIVEIS);
  opcoes($('exc-f-musculo'), MUSCULOS);
  pintarEstados();

  let debounce;
  $('exc-busca').addEventListener('input', (ev) => {
    clearTimeout(debounce);
    debounce = setTimeout(() => { estado.busca = ev.target.value.trim(); estado.pagina = 1; carregar(); }, 250);
  });
  $('exc-grupo').addEventListener('change', (ev) => { estado.grupo = ev.target.value; estado.pagina = 1; carregar(); });
  $('exc-equipamento').addEventListener('change', (ev) => { estado.equipamento = ev.target.value; estado.pagina = 1; carregar(); });
  $('exc-estados').addEventListener('click', (ev) => {
    const b = ev.target.closest('[data-estado]');
    if (!b) return;
    estado.estado = b.dataset.estado; estado.pagina = 1;
    pintarEstados(); carregar();
  });
  $('exc-linhas').addEventListener('click', (ev) => {
    const b = ev.target.closest('.exc-linha');
    if (b) abrir(Number(b.dataset.i));
  });
  $('exc-anterior').addEventListener('click', () => { estado.pagina--; carregar(); });
  $('exc-proxima').addEventListener('click', () => { estado.pagina++; carregar(); });
  $('exc-fechar').addEventListener('click', fechar);
  $('exc-gaveta').addEventListener('click', (ev) => { if (ev.target.id === 'exc-gaveta') fechar(); });
  document.addEventListener('keydown', (ev) => { if (ev.key === 'Escape' && !$('exc-gaveta').hidden) fechar(); });
  $('exc-f-secundarios').addEventListener('click', (ev) => {
    const b = ev.target.closest('[data-rm]');
    if (!b) return;
    secundarios.splice(Number(b.dataset.rm), 1);
    pintarSecundarios();
  });
  $('exc-f-add-secundario').addEventListener('change', (ev) => {
    if (!ev.target.value) return;
    secundarios.push(ev.target.value);
    pintarSecundarios();
  });
  $('exc-salvar').addEventListener('click', () => salvar(false));
  $('exc-salvar-revisar').addEventListener('click', () => salvar(true));

  // Guarda de autenticação, no padrão de fichas.astro: sessão E claim de admin.
  // "Autenticado" não é "autorizado" — qualquer pessoa consegue criar conta
  // neste projeto, e a autorização real é o claim.
  onAuthStateChanged(auth, async (user) => {
    if (!user) { window.location.href = '/admin/login'; return; }
    try {
      const r = await user.getIdTokenResult(true);
      if (!r.claims.admin) { await signOut(auth); window.location.href = '/admin/login?erro=acesso-negado'; return; }
    } catch {
      await signOut(auth); window.location.href = '/admin/login'; return;
    }
    const el = document.getElementById('adm-email');
    if (el) el.textContent = user.email ?? '';
    carregar();
  });
</script>
</body>
</html>
