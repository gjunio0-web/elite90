---
export const prerender = false;
import '@fontsource/bebas-neue';
import '@fontsource/raleway/400.css';
import '@fontsource/raleway/700.css';
import '@fontsource/montserrat/400.css';
import '@fontsource/montserrat/700.css';
import '../../styles/tokens.css';
import '../../styles/global.css';
import AdminHeader from '../../components/AdminHeader.astro';
---
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Elite 90 - Fichas de Triagem</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="icon" href="/favicon.ico" />
  <style is:global>
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
    
    body {
      background-color: var(--c-black);
      color: var(--c-textbody);
      font-family: var(--font-body);
      min-height: 100vh;
      scrollbar-width: thin;
      scrollbar-color: var(--c-lime) var(--c-darkbg);
      -webkit-font-smoothing: antialiased;
    }
    body::-webkit-scrollbar { width: 6px; }
    body::-webkit-scrollbar-track { background: var(--c-darkbg); }
    body::-webkit-scrollbar-thumb { background: var(--c-lime); border-radius: 3px; }

    /* BOTOES E UTILITARIOS */
    .btn-sm {
      font-family: var(--font-label);
      font-size: 0.7rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      padding: 10px 20px;
      border-radius: var(--radius-card);
      cursor: pointer;
      border: none;
      transition: background var(--transition-base), color var(--transition-base), box-shadow var(--transition-base);
    }
    .btn-outline {
      background: transparent;
      color: var(--c-lime);
      border: 1px solid rgba(166, 195, 0, 0.3);
    }
    .btn-outline:hover {
      background: rgba(166, 195, 0, 0.05);
      border-color: var(--c-lime);
    }
    .btn-primary {
      background: var(--c-lime);
      color: #000;
    }
    .btn-primary:hover {
      box-shadow: var(--shadow-cta);
    }
    
    /* LAYOUT PRINCIPAL */
    main { max-width: 1200px; margin: 0 auto; padding: var(--space-6) var(--space-5); }
    
    .page-header { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: var(--space-6); gap: var(--space-4); flex-wrap: wrap; }
    .page-title-block .page-eyebrow {
      font-family: var(--font-label);
      font-size: var(--fs-label);
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.18em;
      color: var(--c-textsub);
      margin-bottom: var(--space-2);
    }
    .page-title {
      font-family: var(--font-display);
      font-size: 2.75rem;
      font-weight: 400;
      letter-spacing: 0.06em;
      color: var(--c-white);
      text-transform: uppercase;
      line-height: 1;
    }
    .page-title span { 
      color: var(--c-lime); 
    }
    .page-actions { display: flex; gap: var(--space-3); flex-wrap: wrap; }
    
    /* CARDS DE ESTATISTICAS */
    .stats-row { display: flex; gap: var(--space-4); margin-bottom: var(--space-6); flex-wrap: wrap; }
    .stat-card {
      background: var(--c-darkbg);
      border: 1px solid rgba(255,255,255,0.06);
      border-radius: var(--radius-card);
      padding: var(--space-4) var(--space-5);
      min-width: 160px;
    }
    .stat-card--total {
      border-left: 3px solid var(--c-lime);
      background: linear-gradient(135deg, rgba(166,195,0,0.06) 0%, var(--c-darkbg) 60%);
    }
    .stat-card__label {
      font-family: var(--font-label);
      font-size: var(--fs-label);
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: var(--c-textsub);
      margin-bottom: var(--space-2);
    }
    .stat-card--total .stat-card__label { color: var(--c-lime); }
    .stat-card__value {
      font-family: var(--font-display);
      font-size: var(--fs-display-md);
      color: var(--c-lime);
      line-height: 1;
    }
    .stat-card--total .stat-card__value {
      font-size: var(--fs-display-lg);
      color: var(--c-white);
    }

    /* TOOLBAR DA TABELA */
    .toolbar { display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--space-4); flex-wrap: wrap; gap: var(--space-3); }
    .toolbar-left { display: flex; gap: var(--space-3); flex-wrap: wrap; align-items: center; flex: 1; }
    .filter-select {
      background: var(--c-darkbg);
      border: 1px solid rgba(255,255,255,0.1);
      color: var(--c-white);
      padding: 10px 16px;
      border-radius: var(--radius-card);
      font-family: var(--font-body);
      font-size: var(--fs-body-sm);
      cursor: pointer;
      outline: none;
    }
    .filter-select:focus { border-color: var(--c-lime); }
    .search-input {
      background: var(--c-darkbg);
      border: 1px solid rgba(255,255,255,0.1);
      color: var(--c-white);
      padding: 10px 16px 10px 38px;
      border-radius: var(--radius-card);
      font-family: var(--font-body);
      font-size: var(--fs-body-sm);
      outline: none;
      min-width: 220px;
      flex: 1;
      max-width: 320px;
      background-image: url("data:image/svg+xml;charset=US-ASCII,%3Csvg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='%23999999' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3E%3Ccircle cx='11' cy='11' r='8'/%3E%3Cpath d='m21 21-4.3-4.3'/%3E%3C/svg%3E");
      background-repeat: no-repeat;
      background-position: 12px center;
    }
    .search-input::placeholder { color: var(--c-textsub); }
    .search-input:focus { border-color: var(--c-lime); }
    .leads-count {
      font-family: var(--font-label);
      font-size: var(--fs-label);
      font-weight: 700;
      color: var(--c-textsub);
      text-transform: uppercase;
      letter-spacing: 0.1em;
      white-space: nowrap;
    }

    /* BADGES DE STATUS */
    .status-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-family: var(--font-label);
      font-size: 0.65rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      padding: 5px 10px;
      border-radius: 2px;
      border: 1px solid currentColor;
      line-height: 1;
    }
    .status-badge::before {
      content: "";
      display: block;
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: currentColor;
      flex-shrink: 0;
    }
    .status-badge--novo       { color: var(--c-status-new); }
    .status-badge--em_analise { color: var(--c-status-progress); }
    .status-badge--aprovado   { color: var(--c-status-approved); }
    .status-badge--recusado   { color: var(--c-status-rejected); }
    .status-badge--avaliacao_enviada { color: var(--c-lime); }

    /* SELETOR DE STATUS (cor dinâmica via classe) */
    .status-sel {
      background-color: transparent;
      border: 1px solid currentColor;
      color: var(--c-textsub);
      padding: 6px 28px 6px 12px;
      border-radius: 2px;
      font-family: var(--font-label);
      font-size: 0.65rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      cursor: pointer;
      outline: none;
      appearance: none;
      -webkit-appearance: none;
      background-repeat: no-repeat;
      background-position: right 10px center;
      transition: all var(--transition-base);
      opacity: 0.85;
    }
    .status-sel:focus, .status-sel:hover { opacity: 1; }
    .status-sel option { background: var(--c-darkbg); color: var(--c-textbody); }
    .status-sel--novo       { color: var(--c-status-new); background-image: url("data:image/svg+xml;charset=US-ASCII,%3Csvg width='10' height='10' viewBox='0 0 10 10' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M2 3.5L5 6.5L8 3.5' stroke='%23E67E22' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E"); }
    .status-sel--em_analise { color: var(--c-status-progress); background-image: url("data:image/svg+xml;charset=US-ASCII,%3Csvg width='10' height='10' viewBox='0 0 10 10' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M2 3.5L5 6.5L8 3.5' stroke='%234A90D9' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E"); }
    .status-sel--aprovado   { color: var(--c-status-approved); background-image: url("data:image/svg+xml;charset=US-ASCII,%3Csvg width='10' height='10' viewBox='0 0 10 10' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M2 3.5L5 6.5L8 3.5' stroke='%2327AE60' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E"); }
    .status-sel--recusado   { color: var(--c-status-rejected); background-image: url("data:image/svg+xml;charset=US-ASCII,%3Csvg width='10' height='10' viewBox='0 0 10 10' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M2 3.5L5 6.5L8 3.5' stroke='%23C0392B' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E"); }
    .status-sel--avaliacao_enviada { color: var(--c-lime); background-image: url("data:image/svg+xml;charset=US-ASCII,%3Csvg width='10' height='10' viewBox='0 0 10 10' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M2 3.5L5 6.5L8 3.5' stroke='%23A6C300' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E"); }

    /* TABELA DE LEADS (NOIR EDITORIAL) */
    .table-wrap {
      overflow-x: auto;
      scrollbar-width: thin;
      scrollbar-color: var(--c-lime) transparent;
      margin-top: var(--space-5);
    }
    .table-wrap::-webkit-scrollbar { height: 4px; }
    .table-wrap::-webkit-scrollbar-track { background: transparent; }
    .table-wrap::-webkit-scrollbar-thumb { background: rgba(166,195,0,0.3); border-radius: 2px; }
    
    table { width: 100%; border-collapse: collapse; min-width: 1000px; text-align: left; }
    
    th {
      font-family: var(--font-label);
      font-size: 0.65rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.18em;
      color: var(--c-lime);
      padding: var(--space-3) var(--space-4);
      border-bottom: 1px solid rgba(255,255,255,0.08);
      background: transparent;
    }
    
    .td {
      padding: 1.25rem var(--space-4);
      border-bottom: 1px solid rgba(255,255,255,0.04);
      vertical-align: middle;
      font-family: var(--font-body);
      font-size: 0.8rem;
      color: var(--c-textsub);
      transition: background var(--transition-base);
    }
    .td--name { font-weight: 700; color: var(--c-white); font-size: 0.9rem; letter-spacing: 0.02em; }
    .td--goal { color: var(--c-textbody); max-width: 250px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-size: 0.75rem; }

    tbody tr:nth-child(even) .td { background: rgba(255,255,255,0.012); }
    tr:hover .td { background: rgba(166, 195, 0, 0.04); }

    /* RESPONSIVE: CARD LIST (mobile) */
    .leads-cards { display: none; }
    .lead-card {
      background: var(--c-darkbg);
      border: 1px solid rgba(255,255,255,0.06);
      border-radius: var(--radius-card);
      padding: var(--space-4);
      margin-bottom: var(--space-3);
    }
    .lead-card__hdr {
      display: flex; justify-content: space-between; align-items: flex-start;
      gap: var(--space-3); margin-bottom: var(--space-3);
    }
    .lead-card__name { font-weight: 700; color: var(--c-white); font-size: 0.95rem; letter-spacing: 0.02em; }
    .lead-card__date {
      font-family: var(--font-label); font-size: 0.65rem; font-weight: 700;
      color: var(--c-textsub); text-transform: uppercase; letter-spacing: 0.1em;
      white-space: nowrap;
    }
    .lead-card__row { font-size: 0.8rem; color: var(--c-textsub); margin-bottom: var(--space-2); }
    .lead-card__row strong { color: var(--c-textbody); font-weight: 400; }
    .lead-card__goal { color: var(--c-textbody); font-size: 0.78rem; margin-bottom: var(--space-3); }
    .lead-card__status {
      margin-bottom: var(--space-3); padding-top: var(--space-3);
      border-top: 1px solid rgba(255,255,255,0.04);
    }
    .lead-card__status .status-sel { width: 100%; text-align: left; }
    .lead-card__actions {
      display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-2);
    }
    .btn-card-action {
      display: inline-flex; align-items: center; justify-content: center; gap: 8px;
      background: var(--c-black);
      border: 1px solid rgba(255,255,255,0.1);
      color: var(--c-textbody);
      font-family: var(--font-label);
      font-size: 0.7rem; font-weight: 700;
      text-transform: uppercase; letter-spacing: 0.1em;
      padding: 12px 0;
      border-radius: var(--radius-card);
      cursor: pointer;
      transition: all var(--transition-base);
    }
    .btn-card-action svg { width: 14px; height: 14px; flex-shrink: 0; }
    .btn-card-action:active, .btn-card-action:hover {
      border-color: var(--c-lime); color: var(--c-lime);
      background: rgba(166, 195, 0, 0.06);
    }

    @media (max-width: 760px) {
      .table-wrap { display: none; }
      .leads-cards { display: block; }
      main { padding: var(--space-5) var(--space-3); }
      .page-title { font-size: 2.25rem; }
      .stats-row { gap: var(--space-2); }
      .stat-card { min-width: 0; flex: 1 1 calc(50% - var(--space-2)); padding: var(--space-3) var(--space-4); }
      .search-input { max-width: none; }
    }

    /* SKELETON LOADING */
    .skel {
      background: linear-gradient(90deg, rgba(255,255,255,0.04) 25%, rgba(255,255,255,0.09) 37%, rgba(255,255,255,0.04) 63%);
      background-size: 400% 100%;
      animation: skel-pulse 1.4s ease infinite;
      border-radius: 3px;
      display: inline-block;
    }
    @keyframes skel-pulse {
      0% { background-position: 100% 50%; }
      100% { background-position: 0 50%; }
    }
    .skel-row .td { padding: 1.25rem var(--space-4); }
    .skel-line { height: 12px; width: 100%; }
    .skel-line--sm { width: 60%; }
    .skel-card { height: 18px; }
    /* ACTION LINKS ELEGANTES (Substituindo botões) */
    .btn-action-link {
      background: transparent;
      color: var(--c-textsub);
      border: none;
      padding: 8px 0;
      font-size: 0.65rem;
      font-family: var(--font-label);
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      cursor: pointer;
      text-decoration: none;
      border-bottom: 1px solid transparent;
      transition: all var(--transition-base);
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }
    .btn-action-link svg { width: 13px; height: 13px; flex-shrink: 0; }
    .btn-action-link:hover { 
      color: var(--c-lime); 
      border-bottom-color: rgba(166, 195, 0, 0.4); 
    }
    .action-sep { 
      color: rgba(255, 255, 255, 0.1); 
      margin: 0 10px; 
      font-size: 0.8rem; 
      font-weight: 300;
    }

    /* STATUS BAR INFERIOR */
    .status-bar {
      margin-top: var(--space-6);
      background: var(--c-darkbg);
      border: 1px solid rgba(255,255,255,0.05);
      border-radius: var(--radius-card);
      padding: var(--space-4) var(--space-5);
      display: flex;
      align-items: center;
      gap: var(--space-3);
    }
    .status-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--c-lime); flex-shrink: 0; box-shadow: 0 0 8px rgba(166,195,0,0.5); }
    .status-text { font-family: var(--font-body); font-size: var(--fs-body-sm); color: var(--c-textsub); }
    .status-text strong { color: var(--c-white); font-weight: 700; }

    /* DRAWERS (GAVETAS) */
    .drawer {
      position: fixed; inset: 0; z-index: 200;
      display: flex; align-items: flex-start; justify-content: flex-end;
      background: rgba(0,0,0,0.85); backdrop-filter: blur(4px);
    }
    .drawer[hidden] { display: none; }
    .drawer-panel {
      background: var(--c-black);
      width: min(640px, 95vw);
      height: 100%;
      overflow-y: auto;
      overflow-x: hidden;
      padding: var(--space-6);
      border-left: var(--border-lime);
      box-shadow: -10px 0 40px rgba(0,0,0,0.9);
      scrollbar-width: thin;
      scrollbar-color: var(--c-lime) var(--c-black);
    }
    .drawer-panel::-webkit-scrollbar { width: 6px; }
    .drawer-panel::-webkit-scrollbar-thumb { background: var(--c-lime); border-radius: 3px; }
    
    .drawer-hdr {
      display: flex; justify-content: space-between; align-items: center;
      margin-bottom: var(--space-6);
      border-bottom: 1px solid rgba(255,255,255,0.05);
      padding-bottom: var(--space-4);
    }
    .drawer-title {
      font-family: var(--font-display);
      font-size: var(--fs-display-md);
      color: var(--c-white);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      line-height: 1;
    }
    .drawer-title span { color: var(--c-lime); font-family: inherit; }
    .drawer-close {
      background: none; border: none;
      color: var(--c-textsub);
      cursor: pointer;
      line-height: 1;
      transition: color var(--transition-base);
      display: inline-flex; align-items: center; justify-content: center;
      width: 40px; height: 40px; flex-shrink: 0;
      margin: -8px -8px 0 0;
    }
    .drawer-close svg { width: 22px; height: 22px; }
    .drawer-close:hover { color: var(--c-lime); }

    @media (max-width: 760px) {
      .drawer-panel { width: 100vw; padding: var(--space-4); }
    }

    /* TABELA DE DETALHES DA FICHA DO ATLETA — SEÇÕES */
    .detail-section { margin-bottom: var(--space-5); }
    .detail-section__title {
      font-family: var(--font-label);
      font-size: var(--fs-label);
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.18em;
      color: var(--c-lime);
      margin-bottom: var(--space-1);
      padding-bottom: var(--space-2);
      border-bottom: 1px solid rgba(166, 195, 0, 0.15);
    }
    .detail-table { width: 100%; border-collapse: collapse; table-layout: fixed; }
    .detail-th {
      font-family: var(--font-label);
      font-size: 0.65rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.15em;
      color: var(--c-textsub);
      padding: 1rem 0;
      vertical-align: top;
      width: 220px;
      border-bottom: 1px solid rgba(255,255,255,0.02);
    }
    .detail-td {
      font-family: var(--font-body);
      font-size: 0.85rem;
      color: var(--c-white);
      padding: 1rem 0 1rem var(--space-4);
      border-bottom: 1px solid rgba(255,255,255,0.02);
      line-height: 1.8;
      overflow-wrap: anywhere;
      word-break: break-word;
    }
    .detail-row--alert .detail-th,
    .detail-row--alert .detail-td { color: var(--c-status-alert); }
    .detail-row--alert .detail-td { font-weight: 700; }
    .detail-alert-tag {
      display: inline-flex; align-items: center; gap: 6px;
      font-family: var(--font-label); font-size: 0.6rem; font-weight: 700;
      text-transform: uppercase; letter-spacing: 0.1em;
      color: var(--c-status-alert);
      border: 1px solid var(--c-status-alert);
      border-radius: 2px; padding: 2px 8px; margin-left: var(--space-3);
    }

    @media (max-width: 760px) {
      .detail-table, .detail-table tbody, .detail-table tr { display: block; }
      .detail-th, .detail-td {
        display: block; width: 100%; padding: 0.4rem 0; border-bottom: none;
      }
      .detail-th { color: var(--c-textsub); padding-top: 0.75rem; }
      .detail-td { padding-bottom: 0.6rem; }
    }

    /* FORMULARIO DE AVALIACAO (EVAL) */
    .eval-label {
      font-family: var(--font-label);
      font-size: var(--fs-label);
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: var(--c-lime);
      display: block;
      margin-bottom: var(--space-2);
      margin-top: var(--space-5);
    }
    .eval-ta {
      width: 100%;
      background: var(--c-darkbg);
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 4px;
      color: var(--c-white);
      padding: var(--space-4);
      font-family: var(--font-body);
      font-size: var(--fs-body-sm);
      line-height: 1.7;
      resize: vertical;
      min-height: 120px;
      transition: border-color var(--transition-base), box-shadow var(--transition-base);
    }
    .eval-ta:focus {
      outline: none;
      border-color: var(--c-lime);
      box-shadow: 0 0 0 1px var(--c-lime);
    }
    .eval-ta::-webkit-scrollbar { width: 6px; }
    .eval-ta::-webkit-scrollbar-thumb { background: var(--c-lime); border-radius: 3px; }
    
    .eval-status {
      font-family: var(--font-body);
      font-size: var(--fs-body-sm);
      color: var(--c-lime);
      font-weight: 600;
      margin: var(--space-3) 0;
      min-height: 18px;
    }
    .eval-actions { display: flex; gap: var(--space-3); flex-wrap: wrap; margin-top: var(--space-4); }

    /* BOTAO IA EM DESTAQUE */
    .btn-ai {
      background: rgba(166, 195, 0, 0.08);
      color: var(--c-lime);
      border: 1px solid var(--c-lime);
      display: inline-flex; align-items: center; gap: 8px;
    }
    .btn-ai:hover { background: rgba(166, 195, 0, 0.15); box-shadow: var(--shadow-cta); }
    .btn-ai svg { width: 14px; height: 14px; }

    /* TEXTAREA EM ESTADO DE CARREGAMENTO */
    .eval-ta--loading {
      background-image: linear-gradient(90deg, rgba(166,195,0,0.06) 25%, rgba(166,195,0,0.14) 37%, rgba(166,195,0,0.06) 63%);
      background-size: 400% 100%;
      animation: skel-pulse 1.4s ease infinite;
    }

    /* NOTAS INTERNAS - CONTAINER DIFERENCIADO */
    .eval-internal {
      margin-top: var(--space-6);
      padding: var(--space-4);
      border: 1px dashed rgba(255,255,255,0.15);
      border-radius: 4px;
      background: rgba(255,255,255,0.015);
    }
    .eval-internal .eval-label {
      color: var(--c-textsub);
      margin-top: 0;
      display: flex; align-items: center; gap: 8px;
    }
    .eval-internal .eval-label svg { width: 14px; height: 14px; flex-shrink: 0; }
    .eval-internal .eval-ta { background: var(--c-black); }

    /* MODAL DE CONFIRMACAO */
    .confirm-overlay {
      position: fixed; inset: 0; z-index: 300;
      display: flex; align-items: center; justify-content: center;
      background: rgba(0,0,0,0.7); backdrop-filter: blur(2px);
      padding: var(--space-4);
    }
    .confirm-overlay[hidden] { display: none; }
    .confirm-box {
      background: var(--c-darkbg);
      border: var(--border-lime);
      border-radius: var(--radius-card);
      max-width: 520px; width: 100%;
      padding: var(--space-5);
      max-height: 85vh; overflow-y: auto;
    }
    .confirm-title {
      font-family: var(--font-display);
      font-size: var(--fs-display-sm);
      color: var(--c-white);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: var(--space-3);
    }
    .confirm-title span { color: var(--c-lime); }
    .confirm-summary {
      font-family: var(--font-body);
      font-size: var(--fs-body-sm);
      color: var(--c-textsub);
      line-height: 1.7;
      margin-bottom: var(--space-4);
    }
    .confirm-preview {
      background: var(--c-black);
      border: 1px solid rgba(255,255,255,0.06);
      border-radius: 4px;
      padding: var(--space-4);
      margin-bottom: var(--space-5);
      max-height: 240px;
      overflow-y: auto;
    }
    .confirm-preview h4 {
      font-family: var(--font-label);
      font-size: var(--fs-label);
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: var(--c-lime);
      margin: var(--space-3) 0 var(--space-1);
    }
    .confirm-preview h4:first-child { margin-top: 0; }
    .confirm-preview p {
      font-family: var(--font-body);
      font-size: 0.8rem;
      color: var(--c-textbody);
      line-height: 1.7;
      white-space: pre-wrap;
    }
    .confirm-actions { display: flex; gap: var(--space-3); flex-wrap: wrap; justify-content: flex-end; }

    /* GALERIA DE FOTOS DO ATLETA */
    .fotos-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
      gap: var(--space-3);
      margin-top: var(--space-3);
    }
    .foto-thumb {
      display: block;
      aspect-ratio: 1;
      overflow: hidden;
      border-radius: var(--radius-card);
      border: 1px solid rgba(255,255,255,0.08);
      transition: border-color var(--transition-base), transform var(--transition-base);
    }
    .foto-thumb:hover {
      border-color: var(--c-lime);
      transform: scale(1.02);
    }
    .foto-thumb img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    /* ZONA DE PRIVACIDADE / LGPD */
    .detail-section--danger {
      margin-top: var(--space-6);
      padding: var(--space-4);
      border: 1px solid rgba(192, 57, 43, 0.3);
      border-radius: var(--radius-card);
      background: rgba(192, 57, 43, 0.04);
    }
    .detail-section__title--danger {
      color: var(--c-status-rejected) !important;
      border-bottom-color: rgba(192, 57, 43, 0.2) !important;
    }
    .privacy-note {
      font-family: var(--font-body);
      font-size: 0.78rem;
      color: var(--c-textsub);
      line-height: 1.7;
      margin: var(--space-3) 0 var(--space-4);
    }
    .btn-danger {
      background: transparent;
      color: var(--c-status-rejected);
      border: 1px solid var(--c-status-rejected);
    }
    .btn-danger:hover { background: rgba(192, 57, 43, 0.1); }
    .btn-danger:disabled { opacity: 0.5; cursor: default; }
  </style>
</head>
<body>

  <AdminHeader badge="Fichas" backHref="/admin" />

  <main>
    <div class="page-header">
      <div class="page-title-block">
        <p class="page-eyebrow">Módulo 1 - Fichas</p>
        <h1 class="page-title">Triagem <span>&amp; Leads</span></h1>
      </div>
      <div class="page-actions">
        <button class="btn-sm btn-outline" id="btn-refresh">Atualizar</button>
        <button class="btn-sm btn-primary" id="btn-csv">Exportar CSV</button>
      </div>
    </div>

    <div class="stats-row">
      <div class="stat-card stat-card--total"><div class="stat-card__label">Total</div><div class="stat-card__value" id="stat-total">0</div></div>
      <div class="stat-card"><div class="stat-card__label">Novos</div><div class="stat-card__value" id="stat-new" style="color:var(--c-status-new)">0</div></div>
      <div class="stat-card"><div class="stat-card__label">Em análise</div><div class="stat-card__value" id="stat-progress" style="color:var(--c-status-progress)">0</div></div>
      <div class="stat-card"><div class="stat-card__label">Aprovados</div><div class="stat-card__value" id="stat-app" style="color:var(--c-status-approved)">0</div></div>
      <div class="stat-card"><div class="stat-card__label">Recusados</div><div class="stat-card__value" id="stat-rejected" style="color:var(--c-status-rejected)">0</div></div>
      <div class="stat-card"><div class="stat-card__label">Avaliados</div><div class="stat-card__value" id="stat-eval" style="color:var(--c-status-sent)">0</div></div>
    </div>

    <div class="toolbar">
      <div class="toolbar-left">
        <input type="search" class="search-input" id="search-input" placeholder="Buscar por nome ou e-mail..." aria-label="Buscar fichas por nome ou e-mail" />
        <select class="filter-select" id="status-filter">
          <option value="">Todos os status</option>
          <option value="novo">Novo</option>
          <option value="em_analise">Em análise</option>
          <option value="aprovado">Aprovado</option>
          <option value="recusado">Recusado</option>
          <option value="avaliacao_enviada">Avaliação enviada</option>
        </select>
      </div>
      <span class="leads-count" id="leads-count"></span>
    </div>

    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Data</th><th>Nome</th><th>E-mail</th><th>Objetivo</th>
            <th>Status</th><th>Ações</th>
          </tr>
        </thead>
        <tbody id="leads-tbody">
          <tr><td class="td" colspan="6" style="text-align:center;color:var(--c-textsub)">Carregando...</td></tr>
        </tbody>
      </table>
    </div>

    <div class="leads-cards" id="leads-cards"></div>
 
    <div class="status-bar">
      <span class="status-dot"></span>
      <span class="status-text"><strong id="adm-email">Carregando...</strong> está autenticado e pode gerenciar o Elite 90 com segurança.</span>
    </div>
  </main>

  <!-- Detail drawer -->
  <div class="drawer" id="detail-drawer" hidden>
    <div class="drawer-panel">
      <div class="drawer-hdr">
        <span class="drawer-title">Ficha do atleta</span>
        <button class="drawer-close" id="detail-close" aria-label="Fechar ficha do atleta">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square" stroke-linejoin="miter"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
      <div id="detail-content"></div>
    </div>
  </div>

  <!-- Eval drawer -->
  <div class="drawer" id="eval-drawer" hidden>
    <div class="drawer-panel">
      <div class="drawer-hdr">
        <span class="drawer-title">Avaliação - <span id="eval-name"></span></span>
        <button class="drawer-close" id="eval-close" aria-label="Fechar avaliação">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square" stroke-linejoin="miter"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
      <div class="eval-actions">
        <button class="btn-sm btn-ai" id="btn-gen-ai">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v3M12 18v3M3 12h3M18 12h3M5.6 5.6l2.1 2.1M16.3 16.3l2.1 2.1M5.6 18.4l2.1-2.1M16.3 7.7l2.1-2.1"/><circle cx="12" cy="12" r="2.5"/></svg>
          Gerar rascunho com IA (Gemini)
        </button>
      </div>
      <p class="eval-status" id="eval-status"></p>
      <label class="eval-label" for="eval-s1">01 - Diagnóstico Estético</label>
      <textarea class="eval-ta" id="eval-s1" rows="5" placeholder="Descreva o ponto de partida estético do atleta, áreas prioritárias e expectativa realista de evolução em 90 dias."></textarea>
      <label class="eval-label" for="eval-s2">02 - Planejamento de Treino</label>
      <textarea class="eval-ta" id="eval-s2" rows="5" placeholder="Divisão de treino, volume e progressão recomendados para o ciclo, considerando objetivo e disponibilidade do atleta."></textarea>
      <label class="eval-label" for="eval-s3">03 - Protocolo de Saúde</label>
      <textarea class="eval-ta" id="eval-s3" rows="5" placeholder="Recomendações de saúde, cuidados e pontos de atenção com base nas respostas do atleta na triagem."></textarea>
      <label class="eval-label" for="eval-s4">04 - Estratégia de Competição</label>
      <textarea class="eval-ta" id="eval-s4" rows="5" placeholder="Orientações específicas para preparação de competição, se aplicável, ou plano de evolução contínua."></textarea>
      <label class="eval-label" for="eval-s5">05 - Alinhamento Operacional</label>
      <textarea class="eval-ta" id="eval-s5" rows="5" placeholder="Próximos passos, frequência de acompanhamento e expectativas de comunicação com o coach."></textarea>

      <div class="eval-internal">
        <label class="eval-label" for="eval-notes">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          Notas internas (não enviadas ao atleta)
        </label>
        <textarea class="eval-ta" id="eval-notes" rows="3" placeholder="Observações privadas para a equipe — não farão parte do e-mail enviado."></textarea>
      </div>

      <div class="eval-actions" style="margin-top:24px">
        <button class="btn-sm btn-primary" id="btn-send-eval">Enviar avaliação ao atleta</button>
      </div>
    </div>
  </div>

  <!-- Confirmation modal -->
  <div class="confirm-overlay" id="confirm-overlay" hidden>
    <div class="confirm-box">
      <h3 class="confirm-title">Revisar e <span>enviar avaliação</span></h3>
      <p class="confirm-summary">Esta ação enviará um e-mail com a avaliação abaixo para <strong id="confirm-name"></strong>. As notas internas não serão incluídas. Esta ação não pode ser desfeita.</p>
      <div class="confirm-preview" id="confirm-preview"></div>
      <div class="confirm-actions">
        <button class="btn-sm btn-outline" id="confirm-cancel">Voltar e revisar</button>
        <button class="btn-sm btn-primary" id="confirm-send">Confirmar envio</button>
      </div>
    </div>
  </div>

  <!-- Delete confirmation modal -->
  <div class="confirm-overlay" id="delete-overlay" hidden>
    <div class="confirm-box">
      <h3 class="confirm-title">Excluir <span>ficha permanentemente</span></h3>
      <p class="confirm-summary">
        Você está prestes a excluir <strong id="delete-name"></strong> e todos os dados pessoais
        e de saúde associados a esta ficha. Esta ação é <strong>irreversível</strong> e não pode
        ser desfeita — os dados não poderão ser recuperados.
      </p>
      <div class="confirm-actions">
        <button class="btn-sm btn-outline" id="delete-cancel">Cancelar</button>
        <button class="btn-sm btn-danger" id="delete-confirm">Confirmar exclusão definitiva</button>
      </div>
    </div>
  </div>

  <script type="module">
    import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-app.js";
    import { getAuth, signOut, onAuthStateChanged } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-auth.js";
    import { getFirestore, collection, getDocs, doc, updateDoc, deleteDoc, query, orderBy, serverTimestamp }
      from "https://www.gstatic.com/firebasejs/10.12.0/firebase-firestore.js";
      
    const cfg={apiKey:document.querySelector('meta[name="fb-api"]')?.content,authDomain:document.querySelector('meta[name="fb-auth"]')?.content,projectId:document.querySelector('meta[name="fb-proj"]')?.content,storageBucket:document.querySelector('meta[name="fb-bucket"]')?.content,messagingSenderId:document.querySelector('meta[name="fb-sender"]')?.content,appId:document.querySelector('meta[name="fb-appid"]')?.content};
    const app=initializeApp(cfg);
    const auth=getAuth(app);
    const db=getFirestore(app);

    let leads=[], currentLeadId=null, currentDetailLeadId=null;

    // Obtém sempre um token fresco (o SDK renova automaticamente se expirado).
    // NUNCA armazenar o idToken em variável — tokens Firebase expiram em 1h.
    async function getFreshToken(){
      const user = auth.currentUser;
      if(!user) throw new Error("Sessão expirada. Recarregue a página.");
      return user.getIdToken(/* forceRefresh */ false);
    }
    
    // Auth guard
    onAuthStateChanged(auth, async user => {
      if (!user) { window.location.href="/admin/login"; return; }
      const el=document.getElementById("adm-email");
      if(el)el.textContent=user.email??"";
      loadLeads();
    });
    
    document.getElementById("btn-logout")?.addEventListener("click", async()=>{await signOut(auth);window.location.href="/admin/login";});

    // Load leads with Error Boundary
    async function loadLeads(){
      renderSkeleton();
      try {
        const snap=await getDocs(query(collection(db,"leads"),orderBy("createdAt","desc")));
        leads=snap.docs.map(d=>({id:d.id,...d.data()}));
        renderStats(); renderTable();
      } catch (err) {
        console.error("Erro sistêmico ao carregar fichas:", err);
        document.getElementById("leads-tbody").innerHTML=`<tr><td class="td" colspan="6" style="text-align:center;color:var(--c-status-alert);font-weight:700;">[ FALHA DE ACESSO ] Permissão negada ou erro de rede. Verifique as regras do Firestore.</td></tr>`;
        document.getElementById("leads-cards").innerHTML=`<div class="lead-card" style="color:var(--c-status-alert);font-weight:700;text-align:center;">[ FALHA DE ACESSO ] Permissão negada ou erro de rede.</div>`;
      }
    }

    function renderSkeleton(){
      const skelRow=`<tr class="skel-row">
        <td class="td"><span class="skel skel-line skel-line--sm"></span></td>
        <td class="td"><span class="skel skel-line"></span></td>
        <td class="td"><span class="skel skel-line"></span></td>
        <td class="td"><span class="skel skel-line"></span></td>
        <td class="td"><span class="skel skel-line skel-line--sm"></span></td>
        <td class="td"><span class="skel skel-line skel-line--sm"></span></td>
      </tr>`;
      document.getElementById("leads-tbody").innerHTML=skelRow.repeat(4);
      const skelCard=`<div class="lead-card">
        <div class="lead-card__hdr"><span class="skel skel-card" style="width:50%"></span><span class="skel skel-card" style="width:25%"></span></div>
        <span class="skel skel-line" style="margin-bottom:8px"></span>
        <span class="skel skel-line skel-line--sm"></span>
      </div>`;
      document.getElementById("leads-cards").innerHTML=skelCard.repeat(3);
      document.getElementById("leads-count").textContent="";
    }

    function renderStats(){
      document.getElementById("stat-total").textContent=leads.length;
      document.getElementById("stat-new").textContent=leads.filter(l=>l.status==="novo").length;
      document.getElementById("stat-progress").textContent=leads.filter(l=>l.status==="em_analise").length;
      document.getElementById("stat-app").textContent=leads.filter(l=>l.status==="aprovado").length;
      document.getElementById("stat-rejected").textContent=leads.filter(l=>l.status==="recusado").length;
      document.getElementById("stat-eval").textContent=leads.filter(l=>l.status==="avaliacao_enviada").length;
    }

    const STATUS_LABEL={"novo":"Novo","em_analise":"Em análise","aprovado":"Aprovado","recusado":"Recusado","avaliacao_enviada":"Avaliação enviada"};

    // Quando status é "avaliacao_enviada", exibe badge somente-leitura — não permitir reversão manual,
    // pois o estado é criado exclusivamente pelo fluxo de envio (send-evaluation) e
    // revertê-lo manualmente causaria inconsistência com a coleção "avaliacoes".
    function statusControl(lead){
      if(lead.status==="avaliacao_enviada"){
        return `<span class="status-badge status-badge--avaliacao_enviada">Avaliação enviada</span>`;
      }
      return `<select class="status-sel status-sel--${lead.status}" data-id="${lead.id}" onchange="window.__updStatus(this)">
        <option value="novo" ${lead.status==="novo"?"selected":""}>Novo</option>
        <option value="em_analise" ${lead.status==="em_analise"?"selected":""}>Em análise</option>
        <option value="aprovado" ${lead.status==="aprovado"?"selected":""}>Aprovado</option>
        <option value="recusado" ${lead.status==="recusado"?"selected":""}>Recusado</option>
      </select>`;
    }

    function renderTable(){
      const filter=document.getElementById("status-filter").value;
      const search=document.getElementById("search-input").value.trim().toLowerCase();
      let filtered=filter?leads.filter(l=>l.status===filter):leads;
      if(search){
        filtered=filtered.filter(l=>
          (l.nome??"").toLowerCase().includes(search) ||
          (l.email??"").toLowerCase().includes(search)
        );
      }
      document.getElementById("leads-count").textContent=`${filtered.length} ficha${filtered.length!==1?"s":""}`;

      if(!filtered.length){
        document.getElementById("leads-tbody").innerHTML=`<tr><td class="td" colspan="6" style="text-align:center;color:var(--c-textsub)">Nenhuma ficha encontrada.</td></tr>`;
        document.getElementById("leads-cards").innerHTML=`<div class="lead-card" style="text-align:center;color:var(--c-textsub)">Nenhuma ficha encontrada.</div>`;
        return;
      }

      document.getElementById("leads-tbody").innerHTML=filtered.map(lead=>{
        const date=lead.createdAt?.toDate?.()?.toLocaleDateString("pt-BR")??"--";
        return `<tr>
          <td class="td">${date}</td>
          <td class="td td--name">${lead.nome??""}</td>
          <td class="td">${lead.email??""}</td>
          <td class="td td--goal">${(lead.objetivo??"").slice(0,50)}</td>
          <td class="td">${statusControl(lead)}</td>
          <td class="td" style="white-space: nowrap;">
            <button class="btn-action-link" onclick="window.__openDetail('${lead.id}')">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7Z"/><circle cx="12" cy="12" r="3"/></svg>
              Ver ficha
            </button>
            <span class="action-sep">/</span>
            <button class="btn-action-link" onclick="window.__openEval('${lead.id}')">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
              Avaliar
            </button>
          </td>
        </tr>`;
      }).join("");

      document.getElementById("leads-cards").innerHTML=filtered.map(lead=>{
        const date=lead.createdAt?.toDate?.()?.toLocaleDateString("pt-BR")??"--";
        return `<div class="lead-card">
          <div class="lead-card__hdr">
            <span class="lead-card__name">${lead.nome??""}</span>
            <span class="lead-card__date">${date}</span>
          </div>
          <div class="lead-card__row">${lead.email??""}</div>
          <div class="lead-card__goal">${(lead.objetivo??"").slice(0,80)}</div>
          <div class="lead-card__status">
            ${statusControl(lead)}
          </div>
          <div class="lead-card__actions">
            <button class="btn-card-action" onclick="window.__openDetail('${lead.id}')">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7Z"/><circle cx="12" cy="12" r="3"/></svg>
              Ver ficha
            </button>
            <button class="btn-card-action" onclick="window.__openEval('${lead.id}')">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
              Avaliar
            </button>
          </div>
        </div>`;
      }).join("");
    }

    // Update Status with Rollback
    window.__updStatus=async function(sel){
      const originalValue = leads.find(l=>l.id===sel.dataset.id)?.status;
      try {
        await updateDoc(doc(db,"leads",sel.dataset.id),{status:sel.value, updatedAt: serverTimestamp()});
        leads=leads.map(l=>l.id===sel.dataset.id?{...l,status:sel.value}:l);
        renderStats(); renderTable();
      } catch (err) {
        console.error("Erro sistêmico ao atualizar status:", err);
        alert("[ERRO] Falha de permissão ao tentar atualizar a ficha. A operação será revertida.");
        if (originalValue) sel.value = originalValue;
      }
    };

    // Detail drawer — campos que indicam alerta de saúde quando valor afirmativo
    const HEALTH_ALERT_VALUES=["sim","Sim","SIM","yes","Yes"];
    function isAlert(val){ return HEALTH_ALERT_VALUES.includes((val??"").toString().trim()); }

    // Formata números no padrão pt-BR (vírgula decimal) com unidade e casas decimais fixas
    function formatNumberBR(value, decimals, unit){
      if(value===undefined || value===null || value==="") return "";
      const n=Number(value);
      if(isNaN(n)) return `${value}${unit?` ${unit}`:""}`;
      const formatted=n.toFixed(decimals).replace(".", ",");
      return `${formatted}${unit?` ${unit}`:""}`;
    }

    function detailRow(label, value, alertFlag){
      const v = value || "--";
      const alertCls = alertFlag ? " detail-row--alert" : "";
      const tag = alertFlag ? `<span class="detail-alert-tag">Atenção</span>` : "";
      return `<tr class="detail-row${alertCls}"><th class="detail-th">${label}</th><td class="detail-td">${v}${tag}</td></tr>`;
    }

    window.__openDetail=function(id){
      const lead=leads.find(l=>l.id===id);if(!lead)return;
      currentDetailLeadId=id;

      const secIdentificacao=[
        detailRow("Nome", lead.nome),
        detailRow("E-mail", lead.email ? `<a href="mailto:${lead.email}" style="color: var(--c-lime); text-decoration: underline;">${lead.email}</a>` : ""),
        detailRow("CPF", lead.cpf),
        detailRow("Nascimento", lead.data_nascimento),
      ];

      const secPerfil=[
        detailRow("Altura", lead.altura!==undefined && lead.altura!==null && lead.altura!=="" ? formatNumberBR(lead.altura, 2, "m") : ""),
        detailRow("Peso", lead.peso!==undefined && lead.peso!==null && lead.peso!=="" ? formatNumberBR(lead.peso, 1, "kg") : ""),
        detailRow("Atividade Física", lead.atividade_fisica),
        detailRow("Tempo de Atividade", lead.tempo_atividade ? `${lead.tempo_atividade} anos` : ""),
        detailRow("Frequência Semanal", lead.frequencia_semanal),
        detailRow("Disponibilidade Diária", lead.disponibilidade_diaria),
        detailRow("Personal Trainer", lead.personal_trainer),
      ];

      const secObjetivo=[
        detailRow("Objetivo", lead.objetivo),
        detailRow("Competição", (lead.competicao||"") + (lead.competicao_detalhe ? ` - ${lead.competicao_detalhe}` : "")),
        detailRow("Conhece Coach", lead.conhece_coach),
      ];

      const secSaude=[
        detailRow("Médico do Esporte", lead.medico_esporte),
        detailRow("Uso de TRT", (lead.trt||"") + (lead.trt_detalhe ? ` - ${lead.trt_detalhe}` : ""), isAlert(lead.trt)),
        detailRow("Condição Cardíaca", lead.condicao_cardiaca, isAlert(lead.condicao_cardiaca)),
        detailRow("Diabetes", lead.diabetes, isAlert(lead.diabetes)),
        detailRow("Doença Crônica", lead.doenca_cronica, isAlert(lead.doenca_cronica)),
        detailRow("Lesão Prévia", (lead.lesao||"") + (lead.lesao_detalhe ? ` - ${lead.lesao_detalhe}` : ""), isAlert(lead.lesao)),
      ];

      const secNutricao=[
        detailRow("Dieta Atual", lead.dieta),
        detailRow("Refeições por Dia", lead.refeicoes_dia),
        detailRow("Suplementação", (lead.suplementos||"") + (lead.suplementos_detalhe ? ` - ${lead.suplementos_detalhe}` : "")),
        detailRow("Consumo de Água", lead.agua_litros ? formatNumberBR(lead.agua_litros, 1, "L") : ""),
      ];

      const section=(title, rows)=>`<div class="detail-section">
        <div class="detail-section__title">${title}</div>
        <table class="detail-table"><tbody>${rows.join("")}</tbody></table>
      </div>`;

      const privacySection=`<div class="detail-section detail-section--danger">
        <div class="detail-section__title detail-section__title--danger">Privacidade &amp; LGPD</div>
        <p class="privacy-note">
          O titular destes dados pode solicitar a exclusão definitiva desta ficha
          a qualquer momento (Art. 18, VI da LGPD). Esta ação remove permanentemente
          os dados pessoais e de saúde do atleta e não pode ser desfeita.
        </p>
        <button class="btn-sm btn-danger" id="btn-delete-lead">Excluir ficha permanentemente</button>
      </div>`;

      const fotosPaths = Array.isArray(lead.fotos_paths) ? lead.fotos_paths :
                         Array.isArray(lead.fotos_urls)  ? lead.fotos_urls  : []; // fallback legado

      let fotosSection = "";
      if (fotosPaths.length > 0) {
        // Busca Signed URLs temporárias (15 min) via function autenticada
        try {
          const token = await getFreshToken();
          const res = await fetch("/.netlify/functions/get-foto-urls", {
            method: "POST",
            headers: { "content-type": "application/json", "Authorization": `Bearer ${token}` },
            body: JSON.stringify({ paths: fotosPaths }),
          });
          if (res.ok) {
            const { urls } = await res.json();
            fotosSection = `<div class="detail-section">
              <div class="detail-section__title">Fotos de referência</div>
              <p class="privacy-note" style="margin-bottom:var(--space-3)">Links temporários — expiram em 15 minutos por segurança.</p>
              <div class="fotos-grid">
                ${(urls as string[]).map((url, i) => `
                  <a href="${url}" target="_blank" rel="noopener" class="foto-thumb" aria-label="Abrir foto ${i+1} em tamanho completo">
                    <img src="${url}" alt="Foto ${i+1}" loading="lazy" />
                  </a>`).join("")}
              </div>
            </div>`;
          } else {
            fotosSection = `<div class="detail-section"><div class="detail-section__title">Fotos de referência</div><p class="privacy-note">Não foi possível carregar as fotos agora. Tente reabrir a ficha.</p></div>`;
          }
        } catch {
          fotosSection = `<div class="detail-section"><div class="detail-section__title">Fotos de referência</div><p class="privacy-note">Erro ao gerar links das fotos.</p></div>`;
        }
      }

      document.getElementById("detail-content").innerHTML=
        section("Identificação", secIdentificacao) +
        section("Perfil Físico", secPerfil) +
        section("Objetivo & Treino", secObjetivo) +
        section("Saúde", secSaude) +
        section("Nutrição", secNutricao) +
        fotosSection +
        privacySection;

      document.getElementById("detail-drawer").hidden=false;
    };
    
    document.getElementById("detail-close")?.addEventListener("click",()=>{document.getElementById("detail-drawer").hidden=true;});
    document.getElementById("detail-drawer")?.addEventListener("click",e=>{if(e.target===document.getElementById("detail-drawer"))document.getElementById("detail-drawer").hidden=true;});

    // Delete lead — opens confirmation modal (delegated, since button is injected via innerHTML)
    document.getElementById("detail-content")?.addEventListener("click",e=>{
      if(e.target.id!=="btn-delete-lead")return;
      const lead=leads.find(l=>l.id===currentDetailLeadId);
      document.getElementById("delete-name").textContent=lead?.nome??"este atleta";
      document.getElementById("delete-overlay").hidden=false;
    });

    document.getElementById("delete-cancel")?.addEventListener("click",()=>{document.getElementById("delete-overlay").hidden=true;});
    document.getElementById("delete-overlay")?.addEventListener("click",e=>{if(e.target===document.getElementById("delete-overlay"))document.getElementById("delete-overlay").hidden=true;});

    document.getElementById("delete-confirm")?.addEventListener("click",async()=>{
      if(!currentDetailLeadId)return;
      const btn=document.getElementById("delete-confirm");
      btn.disabled=true; btn.textContent="Excluindo...";
      try{
        await deleteDoc(doc(db,"leads",currentDetailLeadId));
        leads=leads.filter(l=>l.id!==currentDetailLeadId);
        document.getElementById("delete-overlay").hidden=true;
        document.getElementById("detail-drawer").hidden=true;
        renderStats(); renderTable();
      }catch(err){
        console.error("Erro ao excluir ficha:",err);
        alert("Não foi possível excluir a ficha agora. Tente novamente em instantes.");
      }finally{
        btn.disabled=false; btn.textContent="Confirmar exclusão definitiva";
      }
    });

    // Eval drawer
    const SECTION_TITLES={
      s1:"01 - Diagnóstico Estético",
      s2:"02 - Planejamento de Treino",
      s3:"03 - Protocolo de Saúde",
      s4:"04 - Estratégia de Competição",
      s5:"05 - Alinhamento Operacional"
    };

    window.__openEval=function(id){
      currentLeadId=id;
      const lead=leads.find(l=>l.id===id);
      document.getElementById("eval-name").textContent=lead?.nome??"";
      ["s1","s2","s3","s4","s5","notes"].forEach(k=>{document.getElementById(`eval-${k}`).value="";});
      document.getElementById("eval-status").textContent="";
      document.getElementById("eval-drawer").hidden=false;
    };
    document.getElementById("eval-close")?.addEventListener("click",()=>{document.getElementById("eval-drawer").hidden=true;});
    document.getElementById("eval-drawer")?.addEventListener("click",e=>{if(e.target===document.getElementById("eval-drawer"))document.getElementById("eval-drawer").hidden=true;});

    document.getElementById("btn-gen-ai")?.addEventListener("click",async()=>{
      if(!currentLeadId)return;
      const statusEl=document.getElementById("eval-status");
      const taIds=["s1","s2","s3","s4","s5"];
      taIds.forEach(k=>document.getElementById(`eval-${k}`).classList.add("eval-ta--loading"));
      statusEl.textContent="Gerando rascunho com Gemini 2.5 Flash...";
      try{
        const res=await fetch("/.netlify/functions/generate-evaluation",{method:"POST",headers:{"content-type":"application/json","Authorization":`Bearer ${await getFreshToken()}`},body:JSON.stringify({leadId:currentLeadId})});
        if(!res.ok)throw new Error(await res.text());
        const {sections}=await res.json();
        taIds.forEach(k=>{document.getElementById(`eval-${k}`).value=sections[k]??"";});
        statusEl.textContent="Rascunho gerado. Revise antes de enviar.";
      }catch(e){
        console.error("Erro ao gerar avaliação:",e);
        statusEl.textContent="Não foi possível gerar o rascunho agora. Tente novamente em instantes ou preencha manualmente.";
      }finally{
        taIds.forEach(k=>document.getElementById(`eval-${k}`).classList.remove("eval-ta--loading"));
      }
    });

    // Confirmation modal before sending
    document.getElementById("btn-send-eval")?.addEventListener("click",()=>{
      if(!currentLeadId)return;
      const lead=leads.find(l=>l.id===currentLeadId);
      document.getElementById("confirm-name").textContent=lead?.nome??"o atleta";
      const preview=["s1","s2","s3","s4","s5"].map(k=>{
        const val=document.getElementById(`eval-${k}`).value.trim();
        return `<h4>${SECTION_TITLES[k]}</h4><p>${val||"(em branco)"}</p>`;
      }).join("");
      document.getElementById("confirm-preview").innerHTML=preview;
      document.getElementById("confirm-overlay").hidden=false;
    });

    document.getElementById("confirm-cancel")?.addEventListener("click",()=>{document.getElementById("confirm-overlay").hidden=true;});
    document.getElementById("confirm-overlay")?.addEventListener("click",e=>{if(e.target===document.getElementById("confirm-overlay"))document.getElementById("confirm-overlay").hidden=true;});

    document.getElementById("confirm-send")?.addEventListener("click",async()=>{
      if(!currentLeadId)return;
      document.getElementById("confirm-overlay").hidden=true;
      const statusEl=document.getElementById("eval-status");
      const sections={};
      ["s1","s2","s3","s4","s5"].forEach(k=>{sections[k]=document.getElementById(`eval-${k}`).value;});
      const coachNotes=document.getElementById("eval-notes").value;
      statusEl.textContent="Enviando...";
      try{
        const res=await fetch("/.netlify/functions/send-evaluation",{method:"POST",headers:{"content-type":"application/json","Authorization":`Bearer ${await getFreshToken()}`},body:JSON.stringify({leadId:currentLeadId,sections,coachNotes})});
        if(!res.ok)throw new Error(await res.text());
        statusEl.textContent="Avaliação enviada com sucesso.";
        await loadLeads();
      }catch(e){
        console.error("Erro ao enviar avaliação:",e);
        statusEl.textContent="Não foi possível enviar a avaliação agora. Tente novamente em instantes.";
      }
    });
    
    // Export CSV
    document.getElementById("btn-csv")?.addEventListener("click",()=>{
      const headers=["Data","Nome","Email","CPF","Nascimento","Altura","Peso","Objetivo","Atividade","Tempo","Frequencia","Disponibilidade","Personal","Competicao","Coach BB","Medico","TRT","Cardiaca","Diabetes","Cronica","Lesao","Dieta","Refeicoes","Suplementos","Agua","Status","Fotos (paths)"];
      const rows=leads.map(l=>[l.createdAt?.toDate?.()?.toLocaleDateString("pt-BR")??"",l.nome??"",l.email??"",l.cpf??"",l.data_nascimento??"",l.altura??"",l.peso??"",l.objetivo??"",l.atividade_fisica??"",l.tempo_atividade??"",l.frequencia_semanal??"",l.disponibilidade_diaria??"",l.personal_trainer??"",`${l.competicao??""}${l.competicao_detalhe?` - ${l.competicao_detalhe}`:""}`,l.conhece_coach??"",l.medico_esporte??"",`${l.trt??""}${l.trt_detalhe?` - ${l.trt_detalhe}`:""}`,l.condicao_cardiaca??"",l.diabetes??"",l.doenca_cronica??"",`${l.lesao??""}${l.lesao_detalhe?` - ${l.lesao_detalhe}`:""}`,l.dieta??"",l.refeicoes_dia??"",`${l.suplementos??""}${l.suplementos_detalhe?` - ${l.suplementos_detalhe}`:""}`,l.agua_litros??"",l.status??"",(l.fotos_paths??l.fotos_urls??[]).join(" | ")]);
      const csv=[headers,...rows].map(r=>r.map(c=>`"${String(c).replace(/"/g,'""')}"`).join(",")).join("\n");
      const blob=new Blob(["\uFEFF"+csv],{type:"text/csv;charset=utf-8;"});
      const url=URL.createObjectURL(blob);
      const a=document.createElement("a");a.href=url;a.download=`elite90-leads-${new Date().toISOString().slice(0,10)}.csv`;a.click();URL.revokeObjectURL(url);
    });

    document.getElementById("status-filter")?.addEventListener("change",renderTable);
    document.getElementById("search-input")?.addEventListener("input",renderTable);
    document.getElementById("btn-refresh")?.addEventListener("click",loadLeads);
  </script>

  <meta name="fb-api"    content={import.meta.env.PUBLIC_FIREBASE_API_KEY} />
  <meta name="fb-auth"   content={import.meta.env.PUBLIC_FIREBASE_AUTH_DOMAIN} />
  <meta name="fb-proj"   content={import.meta.env.PUBLIC_FIREBASE_PROJECT_ID} />
  <meta name="fb-bucket" content={import.meta.env.PUBLIC_FIREBASE_STORAGE_BUCKET} />
  <meta name="fb-sender" content={import.meta.env.PUBLIC_FIREBASE_MESSAGING_SENDER_ID} />
  <meta name="fb-appid"  content={import.meta.env.PUBLIC_FIREBASE_APP_ID} />
</body>
</html>