        console.error("Erro ao gerar avaliação:",e);
        statusEl.textContent="Não foi possível gerar o rascunho agora. Tente novamente em instantes ou preencha manualmente.";
      }finally{
        taIds.forEach(k=>document.getElementById(`eval-${k}`).classList.remove("eval-ta--loading"));
        btnGen.disabled = false;
        btnGen.textContent = "Gerar rascunho com IA (Gemini)";
