---
export const prerender = false;
import '../../styles/tokens.css';
import '../../styles/global.css';
---
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Elite 90 - Fichas de Triagem</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="icon" href="/favicon.ico" />
  <style>
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
    
    body {
      background-color: var(--c-black);
      color: var(--c-textbody);
      font-family: var(--font-body);
      min-height: 100vh;
      scrollbar-width: thin;
      scrollbar-color: var(--c-lime) var(--c-darkbg);
      -webkit-font-smoothing: antialiased;
    }
    body::-webkit-scrollbar { width: 6px; }
    body::-webkit-scrollbar-track { background: var(--c-darkbg); }
    body::-webkit-scrollbar-thumb { background: var(--c-lime); border-radius: 3px; }

    /* HEADER */
    .adm-header {
      background: var(--c-darkbg);
      border-bottom: 1px solid rgba(166, 195, 0, 0.15);
      padding: 0 var(--space-5);
      height: 64px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: sticky;
      top: 0;
      z-index: 100;
    }
    .adm-header__left { display: flex; align-items: center; gap: var(--space-3); }
    .adm-logo {
      font-family: var(--font-display);
      font-size: var(--fs-display-sm);
      font-weight: 400;
      letter-spacing: 0.05em;
      color: var(--c-lime);
      text-transform: uppercase;
      text-decoration: none;
    }
    .adm-badge {
      font-family: var(--font-label);
      font-size: var(--fs-label);
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      background: rgba(166, 195, 0, 0.1);
      color: var(--c-lime);
      border: 1px solid rgba(166, 195, 0, 0.25);
      border-radius: 3px;
      padding: 4px 10px;
    }
    .adm-header__right { display: flex; align-items: center; gap: var(--space-2); }
    
    /* BOTOES E UTILITARIOS */
    .btn-sm {
      font-family: var(--font-label);
      font-size: 0.7rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      padding: 10px 20px;
      border-radius: var(--radius-card);
      cursor: pointer;
      border: none;
      transition: background var(--transition-base), color var(--transition-base), box-shadow var(--transition-base);
    }
    .btn-outline {
      background: transparent;
      color: var(--c-lime);
      border: 1px solid rgba(166, 195, 0, 0.3);
    }
    .btn-outline:hover {
      background: rgba(166, 195, 0, 0.05);
      border-color: var(--c-lime);
    }
    .btn-primary {
      background: var(--c-lime);
      color: #000;
    }
    .btn-primary:hover {
      box-shadow: var(--shadow-cta);
    }
    
    /* LAYOUT PRINCIPAL */
    main { max-width: 1200px; margin: 0 auto; padding: var(--space-6) var(--space-5); }
    
    .page-header { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: var(--space-6); gap: var(--space-4); flex-wrap: wrap; }
    .page-title-block .page-eyebrow {
      font-family: var(--font-label);
      font-size: var(--fs-label);
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.18em;
      color: var(--c-textsub);
      margin-bottom: var(--space-2);
    }
    .page-title {
      font-family: var(--font-display);
      font-size: 2.75rem;
      font-weight: 400;
      letter-spacing: 0.06em;
      color: var(--c-white);
      text-transform: uppercase;
      line-height: 1;
    }
    .page-title span { 
      color: var(--c-lime); 
      font-family: var(--font-label); 
      font-style: italic; 
      font-weight: 400;
      letter-spacing: 0.04em;
    }
    .page-actions { display: flex; gap: var(--space-3); flex-wrap: wrap; }
    
    /* CARDS DE ESTATISTICAS */
    .stats-row { display: flex; gap: var(--space-4); margin-bottom: var(--space-6); flex-wrap: wrap; }
    .stat-card {
      background: var(--c-darkbg);
      border: 1px solid rgba(255,255,255,0.06);
      border-radius: var(--radius-card);
      padding: var(--space-4) var(--space-5);
      min-width: 160px;
    }
    .stat-card__label {
      font-family: var(--font-label);
      font-size: var(--fs-label);
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: var(--c-textsub);
      margin-bottom: var(--space-2);
    }
    .stat-card__value {
      font-family: var(--font-display);
      font-size: var(--fs-display-md);
      color: var(--c-lime);
      line-height: 1;
    }

    /* TOOLBAR DA TABELA */
    .toolbar { display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--space-4); flex-wrap: wrap; gap: var(--space-3); }
    .filter-select {
      background: var(--c-darkbg);
      border: 1px solid rgba(255,255,255,0.1);
      color: var(--c-white);
      padding: 10px 16px;
      border-radius: var(--radius-card);
      font-family: var(--font-body);
      font-size: var(--fs-body-sm);
      cursor: pointer;
      outline: none;
    }
    .filter-select:focus { border-color: var(--c-lime); }
    .leads-count {
      font-family: var(--font-label);
      font-size: var(--fs-label);
      font-weight: 700;
      color: var(--c-textsub);
      text-transform: uppercase;
      letter-spacing: 0.1em;
    }

    /* TABELA DE LEADS (NOIR EDITORIAL) */
    .table-wrap {
      overflow-x: auto;
      scrollbar-width: thin;
      scrollbar-color: var(--c-lime) transparent;
      margin-top: var(--space-5);
    }
    .table-wrap::-webkit-scrollbar { height: 4px; }
    .table-wrap::-webkit-scrollbar-track { background: transparent; }
    .table-wrap::-webkit-scrollbar-thumb { background: rgba(166,195,0,0.3); border-radius: 2px; }
    
    table { width: 100%; border-collapse: collapse; min-width: 1000px; text-align: left; }
    
    th {
      font-family: var(--font-label);
      font-size: 0.65rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.18em;
      color: var(--c-lime);
      padding: var(--space-3) var(--space-4);
      border-bottom: 1px solid rgba(255,255,255,0.08);
      background: transparent;
    }
    
    .td {
      padding: 1.5rem var(--space-4);
      border-bottom: 1px solid rgba(255,255,255,0.02);
      vertical-align: middle;
      font-family: var(--font-body);
      font-size: 0.8rem;
      color: var(--c-textsub);
      transition: background var(--transition-base);
    }
    .td--name { font-weight: 700; color: var(--c-white); font-size: 0.9rem; letter-spacing: 0.02em; }
    .td--goal { color: var(--c-textbody); max-width: 250px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-size: 0.75rem; }
    
    tr:hover .td { background: rgba(166, 195, 0, 0.02); }

    /* SELETOR ESTILO BADGE OBLIQUO */
    .status-sel {
      background-color: transparent;
      border: 1px solid rgba(166, 195, 0, 0.3);
      color: var(--c-lime);
      padding: 6px 28px 6px 12px;
      border-radius: 2px;
      font-family: var(--font-label);
      font-size: 0.65rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      cursor: pointer;
      outline: none;
      appearance: none;
      -webkit-appearance: none;
      background-image: url("data:image/svg+xml;charset=US-ASCII,%3Csvg width='10' height='10' viewBox='0 0 10 10' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M2 3.5L5 6.5L8 3.5' stroke='%23A6C300' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E");
      background-repeat: no-repeat;
      background-position: right 10px center;
      transition: all var(--transition-base);
    }
    .status-sel:focus, .status-sel:hover { 
      border-color: var(--c-lime); 
      background-color: rgba(166, 195, 0, 0.05); 
    }
    .status-sel option { background: var(--c-darkbg); color: var(--c-textbody); }

    /* ACTION LINKS ELEGANTES (Substituindo botões) */
    .btn-action-link {
      background: transparent;
      color: var(--c-textsub);
      border: none;
      padding: 0;
      font-size: 0.65rem;
      font-family: var(--font-label);
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      cursor: pointer;
      text-decoration: none;
      border-bottom: 1px solid transparent;
      transition: all var(--transition-base);
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }
    .btn-action-link:hover { 
      color: var(--c-lime); 
      border-bottom-color: rgba(166, 195, 0, 0.4); 
    }
    .action-sep { 
      color: rgba(255, 255, 255, 0.1); 
      margin: 0 10px; 
      font-size: 0.8rem; 
      font-weight: 300;
    }

    /* STATUS BAR INFERIOR */
    .status-bar {
      margin-top: var(--space-6);
      background: var(--c-darkbg);
      border: 1px solid rgba(255,255,255,0.05);
      border-radius: var(--radius-card);
      padding: var(--space-4) var(--space-5);
      display: flex;
      align-items: center;
      gap: var(--space-3);
    }
    .status-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--c-lime); flex-shrink: 0; box-shadow: 0 0 8px rgba(166,195,0,0.5); }
    .status-text { font-family: var(--font-body); font-size: var(--fs-body-sm); color: var(--c-textsub); }
    .status-text strong { color: var(--c-white); font-weight: 700; }

    /* DRAWERS (GAVETAS) */
    .drawer {
      position: fixed; inset: 0; z-index: 200;
      display: flex; align-items: flex-start; justify-content: flex-end;
      background: rgba(0,0,0,0.85); backdrop-filter: blur(4px);
    }
    .drawer[hidden] { display: none; }
    .drawer-panel {
      background: var(--c-black);
      width: min(640px, 95vw);
      height: 100%;
      overflow-y: auto;
      padding: var(--space-6);
      border-left: var(--border-lime);
      box-shadow: -10px 0 40px rgba(0,0,0,0.9);
      scrollbar-width: thin;
      scrollbar-color: var(--c-lime) var(--c-black);
    }
    .drawer-panel::-webkit-scrollbar { width: 6px; }
    .drawer-panel::-webkit-scrollbar-thumb { background: var(--c-lime); border-radius: 3px; }
    
    .drawer-hdr {
      display: flex; justify-content: space-between; align-items: center;
      margin-bottom: var(--space-6);
      border-bottom: 1px solid rgba(255,255,255,0.05);
      padding-bottom: var(--space-4);
    }
    .drawer-title {
      font-family: var(--font-display);
      font-size: var(--fs-display-md);
      color: var(--c-white);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      line-height: 1;
    }
    .drawer-title span { color: var(--c-lime); font-family: inherit; }
    .drawer-close {
      background: none; border: none;
      color: var(--c-textsub);
      font-size: 1.8rem;
      cursor: pointer;
      line-height: 1;
      transition: color var(--transition-base);
    }
    .drawer-close:hover { color: var(--c-lime); }

    /* TABELA DE DETALHES DA FICHA DO ATLETA (DESCOMPRIMIDA) */
    .detail-table { width: 100%; border-collapse: collapse; margin-top: var(--space-4); }
    .detail-th {
      font-family: var(--font-label);
      font-size: 0.65rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.15em;
      color: var(--c-textsub);
      padding: 1.25rem 0;
      vertical-align: top;
      width: 220px;
      border-bottom: 1px solid rgba(255,255,255,0.02);
    }
    .detail-td {
      font-family: var(--font-body);
      font-size: 0.85rem;
      color: var(--c-white);
      padding: 1.25rem 0 1.25rem var(--space-4);
      border-bottom: 1px solid rgba(255,255,255,0.02);
      line-height: 1.8;
    }

    /* FORMULARIO DE AVALIACAO (EVAL) */
    .eval-label {
      font-family: var(--font-label);
      font-size: var(--fs-label);
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: var(--c-lime);
      display: block;
      margin-bottom: var(--space-2);
      margin-top: var(--space-5);
    }
    .eval-ta {
      width: 100%;
      background: var(--c-darkbg);
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 4px;
      color: var(--c-white);
      padding: var(--space-4);
      font-family: var(--font-body);
      font-size: var(--fs-body-sm);
      line-height: 1.7;
      resize: vertical;
      min-height: 120px;
      transition: border-color var(--transition-base), box-shadow var(--transition-base);
    }
    .eval-ta:focus {
      outline: none;
      border-color: var(--c-lime);
      box-shadow: 0 0 0 1px var(--c-lime);
    }
    .eval-ta::-webkit-scrollbar { width: 6px; }
    .eval-ta::-webkit-scrollbar-thumb { background: var(--c-lime); border-radius: 3px; }
    
    .eval-status {
      font-family: var(--font-body);
      font-size: var(--fs-body-sm);
      color: var(--c-lime);
      font-weight: 600;
      margin: var(--space-3) 0;
      min-height: 18px;
    }
    .eval-actions { display: flex; gap: var(--space-3); flex-wrap: wrap; margin-top: var(--space-4); }
  </style>
</head>
<body>

  <header class="adm-header">
    <div class="adm-header__left">
      <a href="/" class="adm-logo">Coach Ruiz</a>
      <span class="adm-badge">Fichas</span>
    </div>
    <div class="adm-header__right">     
      <button class="btn-sm btn-outline" onclick="window.location.href='/admin'" aria-label="Voltar para o menu do painel" style="display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; padding: 0; min-width: 44px;">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square" stroke-linejoin="miter">
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
      </button>
      <button class="btn-sm btn-outline" id="btn-logout" aria-label="Encerrar sessão e sair" style="display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; padding: 0; min-width: 44px;">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square" stroke-linejoin="miter">
          <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"/>
        </svg>
      </button>
    </div>
  </header>

  <main>
    <div class="page-header">
      <div class="page-title-block">
        <p class="page-eyebrow">Módulo 1 - Fichas</p>
        <h1 class="page-title">Triagem <span>&amp; Leads</span></h1>
      </div>
      <div class="page-actions">
        <button class="btn-sm btn-outline" id="btn-refresh">Atualizar</button>
        <button class="btn-sm btn-primary" id="btn-csv">Exportar CSV</button>
      </div>
    </div>

    <div class="stats-row">
      <div class="stat-card"><div class="stat-card__label">Total</div><div class="stat-card__value" id="stat-total">0</div></div>
      <div class="stat-card"><div class="stat-card__label">Novos</div><div class="stat-card__value" id="stat-new" style="color:#E67E22">0</div></div>
      <div class="stat-card"><div class="stat-card__label">Aprovados</div><div class="stat-card__value" id="stat-app" style="color:#27AE60">0</div></div>
      <div class="stat-card"><div class="stat-card__label">Avaliados</div><div class="stat-card__value" id="stat-eval" style="color:#4A90D9">0</div></div>
    </div>

    <div class="toolbar">
      <select class="filter-select" id="status-filter">
        <option value="">Todos os status</option>
        <option value="novo">Novo</option>
        <option value="em_analise">Em análise</option>
        <option value="aprovado">Aprovado</option>
        <option value="recusado">Recusado</option>
        <option value="avaliacao_enviada">Avaliação enviada</option>
      </select>
      <span class="leads-count" id="leads-count"></span>
    </div>

    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Data</th><th>Nome</th><th>E-mail</th><th>Objetivo</th>
            <th>Status</th><th>Ações</th>
          </tr>
        </thead>
        <tbody id="leads-tbody">
          <tr><td class="td" colspan="6" style="text-align:center;color:var(--c-textsub)">Carregando...</td></tr>
        </tbody>
      </table>
    </div>
 
    <div class="status-bar">
      <span class="status-dot"></span>
      <span class="status-text"><strong id="adm-email">Carregando...</strong> está autenticado e pode gerenciar o Elite 90 com segurança.</span>
    </div>
  </main>

  <!-- Detail drawer -->
  <div class="drawer" id="detail-drawer" hidden>
    <div class="drawer-panel">
      <div class="drawer-hdr">
        <span class="drawer-title">Ficha do atleta</span>
        <button class="drawer-close" id="detail-close">x</button>
      </div>
      <div id="detail-content"></div>
    </div>
  </div>

  <!-- Eval drawer -->
  <div class="drawer" id="eval-drawer" hidden>
    <div class="drawer-panel">
      <div class="drawer-hdr">
        <span class="drawer-title">Avaliação - <span id="eval-name"></span></span>
        <button class="drawer-close" id="eval-close">x</button>
      </div>
      <div class="eval-actions">
        <button class="btn-sm btn-outline" id="btn-gen-ai">Gerar com IA (Gemini)</button>
      </div>
      <p class="eval-status" id="eval-status"></p>
      <label class="eval-label" for="eval-s1">01 - Diagnóstico Estético</label>
      <textarea class="eval-ta" id="eval-s1" rows="5"></textarea>
      <label class="eval-label" for="eval-s2">02 - Planejamento de Treino</label>
      <textarea class="eval-ta" id="eval-s2" rows="5"></textarea>
      <label class="eval-label" for="eval-s3">03 - Protocolo de Saúde</label>
      <textarea class="eval-ta" id="eval-s3" rows="5"></textarea>
      <label class="eval-label" for="eval-s4">04 - Estratégia de Competição</label>
      <textarea class="eval-ta" id="eval-s4" rows="5"></textarea>
      <label class="eval-label" for="eval-s5">05 - Alinhamento Operacional</label>
      <textarea class="eval-ta" id="eval-s5" rows="5"></textarea>
      <label class="eval-label" for="eval-notes">Notas internas (não enviadas)</label>
    
      <textarea class="eval-ta" id="eval-notes" rows="3"></textarea>
      <div class="eval-actions" style="margin-top:24px">
        <button class="btn-sm btn-primary" id="btn-send-eval">Enviar avaliação ao atleta</button>
      </div>
    </div>
  </div>

  <script type="module">
    import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-app.js";
    import { getAuth, signOut, onAuthStateChanged } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-auth.js";
    import { getFirestore, collection, getDocs, doc, updateDoc, query, orderBy }
      from "https://www.gstatic.com/firebasejs/10.12.0/firebase-firestore.js";
      
    const cfg={apiKey:document.querySelector('meta[name="fb-api"]')?.content,authDomain:document.querySelector('meta[name="fb-auth"]')?.content,projectId:document.querySelector('meta[name="fb-proj"]')?.content,storageBucket:document.querySelector('meta[name="fb-bucket"]')?.content,messagingSenderId:document.querySelector('meta[name="fb-sender"]')?.content,appId:document.querySelector('meta[name="fb-appid"]')?.content};
    const app=initializeApp(cfg);
    const auth=getAuth(app);
    const db=getFirestore(app);

    let leads=[], currentLeadId=null, idToken="";
    
    // Auth guard
    onAuthStateChanged(auth, async user => {
      if (!user) { window.location.href="/admin/login"; return; }
      const el=document.getElementById("adm-email");
      if(el)el.textContent=user.email??"";
      idToken = await user.getIdToken();
      loadLeads();
    });
    
    document.getElementById("btn-logout")?.addEventListener("click", async()=>{await signOut(auth);window.location.href="/admin/login";});

    // Load leads with Error Boundary
    async function loadLeads(){
      try {
        const snap=await getDocs(query(collection(db,"leads"),orderBy("createdAt","desc")));
        leads=snap.docs.map(d=>({id:d.id,...d.data()}));
        renderStats(); renderTable();
      } catch (err) {
        console.error("Erro sistêmico ao carregar fichas:", err);
        document.getElementById("leads-tbody").innerHTML=`<tr><td class="td" colspan="6" style="text-align:center;color:#E67E22;font-weight:700;">[ FALHA DE ACESSO ] Permissão negada ou erro de rede. Verifique as regras do Firestore.</td></tr>`;
      }
    }

    function renderStats(){
      document.getElementById("stat-total").textContent=leads.length;
      document.getElementById("stat-new").textContent=leads.filter(l=>l.status==="novo").length;
      document.getElementById("stat-app").textContent=leads.filter(l=>l.status==="aprovado").length;
      document.getElementById("stat-eval").textContent=leads.filter(l=>l.status==="avaliacao_enviada").length;
    }

    function renderTable(){
      const filter=document.getElementById("status-filter").value;
      const filtered=filter?leads.filter(l=>l.status===filter):leads;
      document.getElementById("leads-count").textContent=`${filtered.length} ficha${filtered.length!==1?"s":""}`;
      const statusLabel={"novo":"Novo","em_analise":"Em análise","aprovado":"Aprovado","recusado":"Recusado","avaliacao_enviada":"Avaliação enviada"};
      document.getElementById("leads-tbody").innerHTML=filtered.map(lead=>{
        const date=lead.createdAt?.toDate?.()?.toLocaleDateString("pt-BR")??"--";
        return `<tr>
          <td class="td">${date}</td>
          <td class="td td--name">${lead.nome??""}</td>
          <td class="td">${lead.email??""}</td>
          <td class="td td--goal">${(lead.objetivo??"").slice(0,50)}</td>
          <td class="td">
            <select class="status-sel" data-id="${lead.id}" onchange="window.__updStatus(this)">
              <option value="novo" ${lead.status==="novo"?"selected":""}>Novo</option>
              <option value="em_analise" ${lead.status==="em_analise"?"selected":""}>Em análise</option>
              <option value="aprovado" ${lead.status==="aprovado"?"selected":""}>Aprovado</option>
              <option value="recusado" ${lead.status==="recusado"?"selected":""}>Recusado</option>
              <option value="avaliacao_enviada" ${lead.status==="avaliacao_enviada"?"selected":""}>Avaliação enviada</option>
            </select>
          </td>
          <td class="td" style="white-space: nowrap;">
            <button class="btn-action-link" onclick="window.__openDetail('${lead.id}')">
              Ver ficha ↗
            </button>
            <span class="action-sep">/</span>
            <button class="btn-action-link" onclick="window.__openEval('${lead.id}')">
              Avaliar ↗
            </button>
          </td>
        </tr>`;
      }).join("") || `<tr><td class="td" colspan="6" style="text-align:center;color:var(--c-textsub)">Nenhuma ficha encontrada.</td></tr>`;
    }

    // Update Status with Rollback
    window.__updStatus=async function(sel){
      const originalValue = leads.find(l=>l.id===sel.dataset.id)?.status;
      try {
        await updateDoc(doc(db,"leads",sel.dataset.id),{status:sel.value});
        leads=leads.map(l=>l.id===sel.dataset.id?{...l,status:sel.value}:l);
        renderStats();
      } catch (err) {
        console.error("Erro sistêmico ao atualizar status:", err);
        alert("[ERRO] Falha de permissão ao tentar atualizar a ficha. A operação será revertida.");
        if (originalValue) sel.value = originalValue;
      }
    };

    // Detail drawer
    window.__openDetail=function(id){
      const lead=leads.find(l=>l.id===id);if(!lead)return;
      const rows=[
        ["Nome", lead.nome],
        ["E-mail", lead.email ? `<a href="mailto:${lead.email}" style="color: var(--c-lime); text-decoration: underline;">${lead.email}</a>` : ""],
        ["CPF", lead.cpf],
        ["Nascimento", lead.data_nascimento],
        ["Altura", lead.altura],
        ["Peso", lead.peso],
        ["Objetivo", lead.objetivo],
        ["Atividade Física", lead.atividade_fisica],
        ["Tempo de Atividade", lead.tempo_atividade ? `${lead.tempo_atividade} anos` : ""],
        ["Frequência Semanal", lead.frequencia_semanal],
        ["Disponibilidade Diária", lead.disponibilidade_diaria],
        ["Personal Trainer", lead.personal_trainer],
        ["Competição", lead.competicao + (lead.competicao_detalhe ? ` - ${lead.competicao_detalhe}` : "")],
        ["Conhece Coach", lead.conhece_coach],
        ["Médico do Esporte", lead.medico_esporte],
        ["Uso de TRT", lead.trt + (lead.trt_detalhe ? ` - ${lead.trt_detalhe}` : "")],
        ["Condição Cardíaca", lead.condicao_cardiaca],
        ["Diabetes", lead.diabetes],
        ["Doença Crônica", lead.doenca_cronica],
        ["Lesão Prévia", lead.lesao + (lead.lesao_detalhe ? ` - ${lead.lesao_detalhe}` : "")],
        ["Dieta Atual", lead.dieta],
        ["Refeições por Dia", lead.refeicoes_dia],
        ["Suplementação", lead.suplementos + (lead.suplementos_detalhe ? ` - ${lead.suplementos_detalhe}` : "")],
        ["Consumo de Água", lead.agua_litros ? `${lead.agua_litros} Litros` : ""]
      ];
      document.getElementById("detail-content").innerHTML=`<table class="detail-table">${rows.map(([k,v])=>`<tr><th class="detail-th">${k}</th><td class="detail-td">${v||"--"}</td></tr>`).join("")}</table>`;
      document.getElementById("detail-drawer").hidden=false;
    };
    
    document.getElementById("detail-close")?.addEventListener("click",()=>{document.getElementById("detail-drawer").hidden=true;});
    document.getElementById("detail-drawer")?.addEventListener("click",e=>{if(e.target===document.getElementById("detail-drawer"))document.getElementById("detail-drawer").hidden=true;});

    // Eval drawer
    window.__openEval=function(id){
      currentLeadId=id;
      const lead=leads.find(l=>l.id===id);
      document.getElementById("eval-name").textContent=lead?.nome??"";
      ["s1","s2","s3","s4","s5","notes"].forEach(k=>{document.getElementById(`eval-${k}`).value="";});
      document.getElementById("eval-status").textContent="";
      document.getElementById("eval-drawer").hidden=false;
    };
    document.getElementById("eval-close")?.addEventListener("click",()=>{document.getElementById("eval-drawer").hidden=true;});

    document.getElementById("btn-gen-ai")?.addEventListener("click",async()=>{
      if(!currentLeadId)return;
      const statusEl=document.getElementById("eval-status");
      statusEl.textContent="Gerando com Gemini 2.0 Flash...";
      try{
        const res=await fetch("/.netlify/functions/generate-evaluation",{method:"POST",headers:{"content-type":"application/json","Authorization":`Bearer ${idToken}`},body:JSON.stringify({leadId:currentLeadId})});
        if(!res.ok)throw new Error(await res.text());
        const {sections}=await res.json();
        ["s1","s2","s3","s4","s5"].forEach(k=>{document.getElementById(`eval-${k}`).value=sections[k]??"";});
        statusEl.textContent="Rascunho gerado. Revise e envie.";
      }catch(e){statusEl.textContent="Erro ao gerar: "+e.message;}
    });
    
    document.getElementById("btn-send-eval")?.addEventListener("click",async()=>{
      if(!currentLeadId)return;
      const statusEl=document.getElementById("eval-status");
      const sections={};
      ["s1","s2","s3","s4","s5"].forEach(k=>{sections[k]=document.getElementById(`eval-${k}`).value;});
      const coachNotes=document.getElementById("eval-notes").value;
      statusEl.textContent="Enviando...";
      try{
        const res=await fetch("/.netlify/functions/send-evaluation",{method:"POST",headers:{"content-type":"application/json","Authorization":`Bearer ${idToken}`},body:JSON.stringify({leadId:currentLeadId,sections,coachNotes})});
        if(!res.ok)throw new Error(await res.text());
        statusEl.textContent="Avaliação enviada com sucesso.";
        await loadLeads();
      }catch(e){statusEl.textContent="Erro: "+e.message;}
    });
    
    // Export CSV
    document.getElementById("btn-csv")?.addEventListener("click",()=>{
      const headers=["Data","Nome","Email","CPF","Nascimento","Altura","Peso","Objetivo","Atividade","Tempo","Frequencia","Disponibilidade","Personal","Competicao","Coach BB","Medico","TRT","Cardiaca","Diabetes","Cronica","Lesao","Dieta","Refeicoes","Suplementos","Agua","Status"];
      const rows=leads.map(l=>[l.createdAt?.toDate?.()?.toLocaleDateString("pt-BR")??"",l.nome??"",l.email??"",l.cpf??"",l.data_nascimento??"",l.altura??"",l.peso??"",l.objetivo??"",l.atividade_fisica??"",l.tempo_atividade??"",l.frequencia_semanal??"",l.disponibilidade_diaria??"",l.personal_trainer??"",`${l.competicao??""}${l.competicao_detalhe?` - ${l.competicao_detalhe}`:""}`,l.conhece_coach??"",l.medico_esporte??"",`${l.trt??""}${l.trt_detalhe?` - ${l.trt_detalhe}`:""}`,l.condicao_cardiaca??"",l.diabetes??"",l.doenca_cronica??"",`${l.lesao??""}${l.lesao_detalhe?` - ${l.lesao_detalhe}`:""}`,l.dieta??"",l.refeicoes_dia??"",`${l.suplementos??""}${l.suplementos_detalhe?` - ${l.suplementos_detalhe}`:""}`,l.agua_litros??"",l.status??""]);
      const csv=[headers,...rows].map(r=>r.map(c=>`"${String(c).replace(/"/g,'""')}"`).join(",")).join("\n");
      const blob=new Blob(["\uFEFF"+csv],{type:"text/csv;charset=utf-8;"});
      const url=URL.createObjectURL(blob);
      const a=document.createElement("a");a.href=url;a.download=`elite90-leads-${new Date().toISOString().slice(0,10)}.csv`;a.click();URL.revokeObjectURL(url);
    });

    document.getElementById("status-filter")?.addEventListener("change",renderTable);
    document.getElementById("btn-refresh")?.addEventListener("click",loadLeads);
  </script>

  <meta name="fb-api"    content={import.meta.env.PUBLIC_FIREBASE_API_KEY} />
  <meta name="fb-auth"   content={import.meta.env.PUBLIC_FIREBASE_AUTH_DOMAIN} />
  <meta name="fb-proj"   content={import.meta.env.PUBLIC_FIREBASE_PROJECT_ID} />
  <meta name="fb-bucket" content={import.meta.env.PUBLIC_FIREBASE_STORAGE_BUCKET} />
  <meta name="fb-sender" content={import.meta.env.PUBLIC_FIREBASE_MESSAGING_SENDER_ID} />
  <meta name="fb-appid"  content={import.meta.env.PUBLIC_FIREBASE_APP_ID} />
</body>
</html>