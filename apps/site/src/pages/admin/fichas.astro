    // ── CUSTOM DROPDOWNS (mobile) ─────────────────────────────────────────────
    function __createMenu(items) {
      const ul = document.createElement("ul");
      ul.className = "status-dropdown-menu";
      ul.hidden = true;
      ul.innerHTML = items.map(({value, label}) =>
        `<li><button type="button" data-value="${value}">${label}</button></li>`
      ).join("");
      document.body.appendChild(ul);
      return ul;
    }

    function __positionMenu(menu, trigger) {
      const r = trigger.getBoundingClientRect();
      menu.style.left = `${r.left}px`;
      menu.style.minWidth = `${r.width}px`;
      menu.style.top = "-9999px";
      menu.hidden = false;
      const menuH = menu.offsetHeight;
      menu.style.top = (window.innerHeight - r.bottom) > menuH
        ? `${r.bottom + 4}px`
        : `${r.top - menuH - 4}px`;
    }

    const __sdMenu = __createMenu([
      {value:"novo",             label:"Novo"},
      {value:"em_analise",       label:"Em análise"},
      {value:"aprovado",         label:"Aprovado"},
      {value:"recusado",         label:"Recusado"},
    ]);
    let __sdActiveId = null;

    const FILTER_LABELS = {...STATUS_LABEL, "":"Todos os status"};
    const __filterMenu = __createMenu([
      {value:"",                  label:"Todos os status"},
      {value:"novo",              label:"Novo"},
      {value:"em_analise",        label:"Em análise"},
      {value:"aprovado",          label:"Aprovado"},
      {value:"recusado",          label:"Recusado"},
      {value:"avaliacao_enviada", label:"Avaliação enviada"},
    ]);

    function __closeAll() {
      __sdMenu.hidden = true; __sdActiveId = null;
      __filterMenu.hidden = true;
    }

    document.addEventListener("click", e => {
      const trigger = e.target.closest(".status-dropdown-trigger");
      if (trigger) {
        const isOpen = !__sdMenu.hidden && __sdActiveId === trigger.dataset.id;
        __closeAll();
        if (!isOpen) { __sdActiveId = trigger.dataset.id; __positionMenu(__sdMenu, trigger); }
        return;
      }
      if (__sdMenu.contains(e.target)) {
        const opt = e.target.closest("button[data-value]");
        if (opt && __sdActiveId) { const id = __sdActiveId; __closeAll(); window.__updStatus({ dataset: { id }, value: opt.dataset.value }); }
        return;
      }
      if (__filterMenu.contains(e.target)) {
        const opt = e.target.closest("button[data-value]");
        if (opt) {
          const val = opt.dataset.value;
          document.getElementById("filter-dropdown-label").textContent = FILTER_LABELS[val] ?? "Todos os status";
          document.getElementById("status-filter").value = val;
          __closeAll();
          renderTable();
        }
        return;
      }
      __closeAll();
    });

    document.getElementById("filter-dropdown-btn")?.addEventListener("click", e => {
      e.stopPropagation();
      const isOpen = !__filterMenu.hidden;
      __closeAll();
      if (!isOpen) __positionMenu(__filterMenu, e.currentTarget);
    });

    window.addEventListener("scroll", __closeAll, { passive: true });

    document.getElementById("status-filter")?.addEventListener("change",renderTable);
    document.getElementById("search-input")?.addEventListener("input",renderTable);
    document.querySelectorAll(".th-sortable").forEach(th=>{
      th.addEventListener("click",()=>{
        const field=th.dataset.sort;
        if(sortField===field){
          sortDir=sortDir==="asc"?"desc":"asc";
        } else {
          sortField=field;
          sortDir=field==="nome"?"asc":"desc";
        }
        renderTable();
      });
    });
    document.getElementById("btn-refresh")?.addEventListener("click",loadLeads);
  
  // Abre a gaveta para leitura da avaliação enviada diretamente do Firestore
    window.__viewSentEval = async function(id) {
      const lead = leads.find(l=>l.id===id); if(!lead) return;
      document.getElementById("view-eval-name").textContent = lead.nome ?? "";
      document.getElementById("view-eval-date").textContent = "Carregando registros do banco...";
      document.getElementById("view-eval-body").innerHTML = `<p style="color: var(--c-textsub); font-size:0.85rem;">Buscando dados criptografados do atleta...</p>`;
      document.getElementById("view-eval-drawer").hidden = false;

      try {
        const q = query(collection(db, "avaliacoes"), where("leadId", "==", id));
        const snap = await getDocs(q);
        const todasdolead = snap.docs.map(d => ({id: d.id, ...d.data()}));

        if (!todasdolead.length) {
          document.getElementById("view-eval-body").innerHTML = `<p style="color: var(--c-status-alert);">Nenhum registro físico de envio localizado para este atleta no banco.</p>`;
          return;
        }

        // Multi-Ficha: Garante isolamento ordenando estritamente por segundos decrescentes do servidor
        todasdolead.sort((a, b) => {
          const tA = a.createdAt && typeof a.createdAt.seconds === 'number' ? a.createdAt.seconds : 0;
          const tB = b.createdAt && typeof b.createdAt.seconds === 'number' ? b.createdAt.seconds : 0;
          return tB - tA;
        });

        const atual = todasdolead[0];
        currentViewEval = { id: atual.id, token: atual.token, nome: atual.nome ?? lead.nome, email: atual.email ?? lead.email };
        document.getElementById("view-eval-actions").hidden = false;

        let dataEnvio = "--";
        if (atual.createdAt) {
          if (typeof atual.createdAt.toDate === "function") {
            dataEnvio = atual.createdAt.toDate().toLocaleString("pt-BR");
          } else if (atual.createdAt.seconds) {
            dataEnvio = new Date(atual.createdAt.seconds * 1000).toLocaleString("pt-BR");
          }
        }
        document.getElementById("view-eval-date").textContent = `Enviado em: ${dataEnvio}`;

        const chavesLabels = {
          s1: "01 - Diagnóstico Estético",
          s2: "02 - Planejamento de Treino",
          s3: "03 - Protocolo de Saúde",
          s4: "04 - Estratégia de Competição",
          s5: "05 - Alinhamento Operacional"
        };

        // Acessa as chaves reais de dentro do mapa aninhado 'sections' extraído do banco
        const mapaDeSecoes = atual.sections || {};

        const htmlCorpo = Object.entries(chavesLabels).map(([chave, label]) => {
          const textoReal = mapaDeSecoes[chave] ? mapaDeSecoes[chave].trim() : "";
          return `
            <div style="margin-bottom: 24px; border-bottom: 1px solid rgba(255,255,255,0.04); padding-bottom: 16px;">
              <h4 style="font-family: var(--font-label); font-size: 0.75rem; color: var(--c-lime); text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 8px;">${label}</h4>
              <p style="font-family: var(--font-body); font-size: 0.85rem; color: var(--c-white); line-height: 1.7; white-space: pre-wrap;">${textoReal || "(Seção em branco ou não preenchida)"}</p>
            </div>
          `;
        }).join("");

        const notasHtml = atual.coachNotes 
          ? `<div style="margin-top: 32px; padding: 16px; border: 1px dashed rgba(255,255,255,0.1); background: rgba(255,255,255,0.01);">
              <h4 style="font-family: var(--font-label); font-size: 0.7rem; color: var(--c-textsub); text-transform: uppercase; margin-bottom: 6px;">Notas Internas de Backstage</h4>
              <p style="font-family: var(--font-body); font-size: 0.8rem; color: var(--c-textsub); white-space: pre-wrap;">${atual.coachNotes}</p>
             </div>`
          : "";

        document.getElementById("view-eval-body").innerHTML = htmlCorpo + notasHtml;
      } catch (err) {
        console.error("Erro ao lire avaliação do Firestore:", err);
        document.getElementById("view-eval-body").innerHTML = `<p style="color: var(--c-status-alert);">Erro crítico de permissão ao tentar acessar o Firestore.</p>`;
      }
    };

    function closeViewEvalDrawer() {
      document.getElementById("view-eval-drawer").hidden = true;
      document.getElementById("view-eval-actions").hidden = true;
      currentViewEval = null;
    }
    document.getElementById("view-eval-close")?.addEventListener("click", closeViewEvalDrawer);
    document.getElementById("view-eval-drawer")?.addEventListener("click", e => { if (e.target === document.getElementById("view-eval-drawer")) closeViewEvalDrawer(); });

    // ── COPIAR LINK ─────────────────────────────────────────────────────────
    document.getElementById("btn-copy-eval-link")?.addEventListener("click", async () => {
      if (!currentViewEval?.token) return;
      const url = `${window.location.origin}/avaliacao/${currentViewEval.token}`;

      let copied = false;
      try {
        await navigator.clipboard.writeText(url);
        copied = true;
      } catch {
        // Fallback para mobile browsers que bloqueiam a Clipboard API
        const ta = document.createElement("textarea");
        ta.value = url;
        ta.style.cssText = "position:fixed;top:0;left:0;opacity:0;";
        document.body.appendChild(ta);
        ta.focus();
        ta.select();
        try { document.execCommand("copy"); copied = true; } catch {}
        document.body.removeChild(ta);
      }

      if (copied) {
        updateDoc(doc(db, "avaliacoes", currentViewEval.id), { lastLinkCopiedAt: serverTimestamp() }).catch(() => {});
        showToast("Link copiado. Compartilhe apenas com o atleta — este link dá acesso direto à avaliação.", "warning");
      } else {
        showToast("Não foi possível copiar o link. Tente novamente.", "warning");
      }
    });

    // ── REENVIAR EMAIL ───────────────────────────────────────────────────────
    document.getElementById("btn-resend-eval")?.addEventListener("click", () => {
      if (!currentViewEval) return;
      document.getElementById("resend-name").textContent = currentViewEval.nome?.split(" ")[0] ?? currentViewEval.nome ?? "";
      document.getElementById("resend-overlay").hidden = false;
    });

    document.getElementById("resend-modal-cancel")?.addEventListener("click", () => {
      document.getElementById("resend-overlay").hidden = true;
    });
    document.getElementById("resend-overlay")?.addEventListener("click", e => {
      if (e.target === document.getElementById("resend-overlay")) document.getElementById("resend-overlay").hidden = true;
    });

    document.getElementById("resend-modal-confirm")?.addEventListener("click", async () => {
      if (!currentViewEval) return;
      const btn = document.getElementById("resend-modal-confirm");
      btn.disabled = true;
      btn.textContent = "Reenviando...";
      try {
        const idToken = await auth.currentUser.getIdToken();
        const res = await fetch("/.netlify/functions/resend-evaluation", {
          method: "POST",
          headers: { "Content-Type": "application/json", Authorization: `Bearer ${idToken}` },
          body: JSON.stringify({ evalId: currentViewEval.id }),
        });
        if (!res.ok) {
          const err = await res.json().catch(() => ({}));
          throw new Error(err.error ?? `Erro ${res.status}`);
        }
        document.getElementById("resend-overlay").hidden = true;
        showToast(`E-mail reenviado para ${currentViewEval.nome?.split(" ")[0] ?? "o atleta"} com sucesso.`);
      } catch (err) {
        showToast(`Falha no reenvio: ${err.message}`, "warning");
      } finally {
        btn.disabled = false;
        btn.textContent = "Confirmar reenvio";
      }
    });
  
  </script>

