        toast.style.width = "100%";
        toast.style.background = "#0A0A0A";
        toast.style.border = "1px solid var(--c-lime)";
        toast.style.padding = "24px";
        toast.style.display = "flex";
        toast.style.justifyContent = "space-between";
        toast.style.alignItems = "flex-start";
        toast.style.boxShadow = "0 10px 40px rgba(0,0,0,0.9)";
        toast.style.animation = "sIn 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards";
        
        toast.innerHTML = `
          <div style="display: flex; align-items: flex-start; gap: 16px; flex: 1;">
            <span style="color: var(--c-lime); font-size: 1.2rem; font-family: var(--font-label, sans-serif); line-height: 1.2;">[✓]</span>
            <span style="color: #FFFFFF; font-family: var(--font-label, sans-serif); font-size: 0.9rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; line-height: 1.5;">
              PLANEJAMENTO ESTRATÉGICO SALVO E ENVIADO POR E-MAIL AO ATLETA!
            </span>
          </div>
          <button onclick="this.parentElement.remove()" aria-label="Fechar notificação" style="background: transparent; border: none; color: #FFFFFF; font-size: 1.2rem; cursor: pointer; padding: 0 0 0 16px; opacity: 0.4; transition: opacity 0.2s; line-height: 1;">
            ✖
          </button>
        `;
        
        container.appendChild(toast);
        setTimeout(() => { 
          if(toast.parentElement) {
            toast.style.animation = "sOut 0.3s ease-in forwards"; 
            setTimeout(() => toast.remove(), 300); 
          }
        }, 5000);

        const botoesAtleta = document.querySelectorAll(`[data-lead-id="${currentLeadId}"]`);
        botoesAtleta.forEach(btn => {
          btn.textContent = "Avaliação";
          btn.setAttribute("onclick", `window.__viewSentEval('${currentLeadId}')`);
          btn.style.color = "var(--c-lime)";
          btn.style.borderColor = "var(--c-lime)";
        });

        await loadLeads();
      }catch(e){
        console.error("Erro ao enviar avaliação:",e);
        statusEl.textContent="Não foi possível enviar a avaliação agora. Tente novamente.";
      }finally{
        btnConfirm.disabled = false;
        btnConfirm.textContent = "Confirmar envio";
      }
    });
    
    // Export CSV
