    document.getElementById("eval-drawer")?.addEventListener("click",e=>{if(e.target===document.getElementById("eval-drawer"))document.getElementById("eval-drawer").hidden=true;});

    document.getElementById("btn-gen-ai")?.addEventListener("click",async()=>{
      if(!currentLeadId)return;
      const btnGen = document.getElementById("btn-gen-ai");
      const statusEl=document.getElementById("eval-status");
      const alertBox = document.getElementById("ia-truncation-alert");
      const taIds=["s1","s2","s3","s4","s5"];
      
      if (alertBox) { alertBox.hidden = true; alertBox.innerHTML = ""; }
      btnGen.disabled = true;
      btnGen.textContent = "Processando...";
      taIds.forEach(k=>document.getElementById(`eval-${k}`).classList.add("eval-ta--loading"));
      statusEl.textContent="Estruturando matriz analítica com o Gemini...";
      statusEl.style.color = "var(--c-lime)";
      
      try{
        const res=await fetch("/.netlify/functions/generate-evaluation",{method:"POST",headers:{"content-type":"application/json","Authorization":`Bearer ${await getFreshToken()}`},body:JSON.stringify({leadId:currentLeadId})});
        if(!res.ok)throw new Error(await res.text());
        
        const dados = await res.json();
        const secoesRecebidas = dados.sections || {};
        
        // Preenche os campos textareas com o mapa aninhado correto
        taIds.forEach(k=>{document.getElementById(`eval-${k}`).value=secoesRecebidas[k]??"";});
        updateSendBtnState();
        
        // Validação Full Stack: Verifica flag do backend ou ausência de qualquer bloco essencial
        const possuiSecaoIncompleta = taIds.some(k => !secoesRecebidas[k] || secoesRecebidas[k].trim() === "");
        
        if (dados.truncated || possuiSecaoIncompleta) {
          statusEl.style.color = "var(--c-status-new)";
          statusEl.textContent = "Rascunho integrado com ressalvas estruturais.";
          
          if (alertBox) {
            alertBox.innerHTML = `<strong>[ALERTA DE CAPACIDADE DE CONTEXTO]</strong><br>O rascunho foi gerado com sucesso, mas atingiu a capacidade máxima de texto suportada pela inteligência artificial nesta execução. Parte do conteúdo final pode ter sido interrompido. Você pode revisar as caixas e complementar o texto manualmente se necessário.`;
            alertBox.hidden = false;
          }
