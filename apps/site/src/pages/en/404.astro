---
// --- ELITE90 PRO · Página 404 (en)
// Pré-renderizada: o Astro emite dist/en/404.html. O Netlify procura o
// 404.html mais próximo na árvore de diretórios, então endereços inexistentes
// sob /en/ caem nesta versão em inglês.
export const prerender = true;

import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import TriageModal from "../../components/TriageModal.astro";
import ToastContainer from "../../components/sections/ToastContainer.astro";
import NotFoundSection from "../../components/sections/NotFoundSection.astro";
import { useTranslations } from "../../i18n/utils";

const locale = "en";
const t = useTranslations(locale);
---

<Layout
  title={t.notFound.metaTitle}
  description={t.notFound.metaDescription}
  locale={locale}
  noindex={true}
>
  <Header t={t} locale={locale} hrefBase="/en/" />
  <NotFoundSection t={t} hrefBase="/en/" />
  <Footer t={t} />
  <TriageModal t={t} locale={locale} />
  <ToastContainer />
</Layout>

<style is:global>
  html, body { overflow-x: hidden; max-width: 100%; }
</style>
