---
export const prerender = true;
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import TriageModal from "../../components/TriageModal.astro";
import StickyCtaMobile from "../../components/StickyCtaMobile.astro";
import HeroSection from "../../components/sections/HeroSection.astro";
import QualifierSection from "../../components/sections/QualifierSection.astro";
import ScheduleSection from "../../components/sections/ScheduleSection.astro";
import CoachSection from "../../components/sections/CoachSection.astro";
import PillarsSection from "../../components/sections/PillarsSection.astro";
import ObjectionSection from "../../components/sections/ObjectionSection.astro";
import ResultsSection from "../../components/sections/ResultsSection.astro";
import ProcessSection from "../../components/sections/ProcessSection.astro";
import MotivationalSection from "../../components/sections/MotivationalSection.astro";
import TestimonialsSection from "../../components/sections/TestimonialsSection.astro";
import PartnersSection from "../../components/sections/PartnersSection.astro";
import FaqSection from "../../components/sections/FaqSection.astro";
import CtaFinalSection from "../../components/sections/CtaFinalSection.astro";
import ToastContainer from "../../components/sections/ToastContainer.astro";
import { useTranslations } from "../../i18n/utils";

const locale = "en";
const t = useTranslations(locale);
---

<Layout
  title={t.meta.title}
  description={t.meta.description}
  ogTitle={t.meta.ogTitle}
  ogDescription={t.meta.ogDescription}
  locale={locale}
>
  <Header t={t} locale={locale} />
  <HeroSection t={t} />
  <QualifierSection t={t} />
  <ScheduleSection t={t} />
  <div class="divider container" role="presentation"></div>
  <CoachSection t={t} />
  <div class="divider container" role="presentation"></div>
  <PillarsSection t={t} />
  <ObjectionSection t={t} />
  <div class="divider container" role="presentation"></div>
  <ResultsSection t={t} />
  <div class="divider container" role="presentation"></div>
  <ProcessSection t={t} />
  <MotivationalSection t={t} />
  <div class="divider container" role="presentation"></div>
  <TestimonialsSection t={t} />
  <PartnersSection t={t} />
  <div class="divider container" role="presentation"></div>
  <FaqSection t={t} />
  <CtaFinalSection t={t} />
  <Footer t={t} />
  <TriageModal t={t} locale={locale} />
  <StickyCtaMobile
    stage1={t.nav.applyCta}
    stage2={t.nav.applyCta}
    stage3={t.nav.applyCta}
    targetId="triagem" 
  />
  <ToastContainer />
</Layout>

<style>
  html, body { overflow-x: hidden; max-width: 100%; }
</style>
