const BLOCO_PENDENCIA = { p01: "ia", p02: "ia", p03: "ia", p04: "ia", p05: "programa", p06: "programa", p07: "programa", p08: "programa" };

function estadoVazio() {
  return { itens: {}, novas: [], fases: {}, pendencias: {}, assistente: {} };
}

function keyFor(grupoId, idx) { return grupoId + "-" + idx; }

let state = estadoVazio();
let saveTimer = null;

async function chamar(fn, corpo) {
  const resp = await fetch("/.netlify/functions/" + fn, {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify(corpo || {}),
  });
  if (!resp.ok) throw new Error("Falha em " + fn);
  return resp.json();
}

function render() {
  const container = document.getElementById("grupos");
  container.innerHTML = "";
  let respondidas = 0;

  GRUPOS.forEach(grupo => {
    const h3 = document.createElement("h3");
    h3.textContent = grupo.nome;
    container.appendChild(h3);

    grupo.perguntas.forEach((texto, idx) => {
      const k = keyFor(grupo.id, idx);
      const item = state.itens[k] || { status: null, textoEditado: "" };
      if (item.status) respondidas++;

      const ex = EXEMPLOS[k];
      const div = document.createElement("div");
      div.className = "item" + (item.status === "removido" ? " status-removido" : "");
      div.innerHTML =
        '<div class="item-text">' + texto + '</div>' +
        '<div class="actions">' +
          '<button class="btn ' + (item.status === "aprovado" ? "active-aprovado" : "") + '" data-k="' + k + '" data-act="aprovado">Aprovar</button>' +
          '<button class="btn ' + (item.status === "editado" ? "active-editado" : "") + '" data-k="' + k + '" data-act="editado">Editar</button>' +
          '<button class="btn ' + (item.status === "removido" ? "active-removido" : "") + '" data-k="' + k + '" data-act="removido">Remover</button>' +
          (ex ? '<button class="btn btn-preview" data-preview="' + k + '">👁 Ver exemplo</button>' : '') +
        '</div>' +
        '<textarea class="edit-box ' + (item.status === "editado" ? "show" : "") + '" data-k="' + k + '" placeholder="Escreva o novo texto...">' + (item.textoEditado || "") + '</textarea>' +
        (ex ? '<div class="preview-box" id="preview-' + k + '">' +
          '<div class="preview-row"><span class="pill pill-nao">Não</span><span class="preview-text">' + ex.nao + '</span></div>' +
          '<div class="preview-row"><span class="pill pill-sim">Sim</span><span class="preview-text">' + ex.sim + '</span></div>' +
        '</div>' : '');
      container.appendChild(div);
    });

    (state.novas || []).filter(n => n.grupo === grupo.id).forEach((n) => {
      const div = document.createElement("div");
      div.className = "item new-item";
      div.innerHTML = '<div class="item-text"><em>Pergunta acrescentada por você:</em><br>' + n.texto + '</div>';
      container.appendChild(div);
    });

    const addRow = document.createElement("div");
    addRow.className = "add-row";
    addRow.innerHTML =
      '<textarea placeholder="Acrescentar pergunta nova neste grupo..." data-grupo="' + grupo.id + '"></textarea>' +
      '<button class="btn-add" data-grupo-add="' + grupo.id + '">Acrescentar</button>';
    container.appendChild(addRow);
  });

  atualizarContadores();

  container.querySelectorAll(".btn-preview").forEach(btn => {
    btn.addEventListener("click", () => {
      const box = document.getElementById("preview-" + btn.dataset.preview);
      box.classList.toggle("show");
      btn.textContent = box.classList.contains("show") ? "👁 Ocultar exemplo" : "👁 Ver exemplo";
    });
  });
  container.querySelectorAll(".btn[data-act]").forEach(btn => {
    btn.addEventListener("click", () => {
      const k = btn.dataset.k, act = btn.dataset.act;
      const cur = state.itens[k] || {};
      state.itens[k] = { status: act, textoEditado: cur.textoEditado || "" };
      render();
      agendarSalvamento();
    });
  });
  container.querySelectorAll(".edit-box").forEach(box => {
    box.addEventListener("input", () => {
      const k = box.dataset.k;
      state.itens[k] = state.itens[k] || { status: "editado" };
      state.itens[k].textoEditado = box.value;
      agendarSalvamento();
    });
  });
  container.querySelectorAll(".btn-add").forEach(btn => {
    btn.addEventListener("click", () => {
      const grupoId = btn.dataset.grupoAdd;
      const ta = container.querySelector('textarea[data-grupo="' + grupoId + '"]');
      if (!ta.value.trim()) return;
      state.novas = state.novas || [];
      state.novas.push({ grupo: grupoId, texto: ta.value.trim() });
      render();
      agendarSalvamento();
    });
  });
}

function renderPendencias() {
  const containers = {
    ia: document.getElementById("pendencias-ia"),
    programa: document.getElementById("pendencias-programa")
  };
  containers.ia.innerHTML = "";
  containers.programa.innerHTML = "";
  PENDENCIAS.forEach(p => {
    const container = containers[BLOCO_PENDENCIA[p.id]];
    const valor = (state.pendencias && state.pendencias[p.id]) || "";
    const div = document.createElement("div");
    div.className = "pend-card";
    div.innerHTML =
      '<div class="pend-titulo">' + p.titulo + '</div>' +
      '<button class="pend-toggle" data-pend-toggle="' + p.id + '">Ver contexto completo</button>' +
      '<div class="pend-descricao" id="pend-desc-' + p.id + '">' + p.descricao + '</div>' +
      '<textarea class="pend-resposta" data-pend="' + p.id + '" placeholder="Escreva sua resposta aqui...">' + valor + '</textarea>';
    container.appendChild(div);
  });

  document.querySelectorAll("[data-pend-toggle]").forEach(btn => {
    btn.addEventListener("click", () => {
      const box = document.getElementById("pend-desc-" + btn.dataset.pendToggle);
      box.classList.toggle("show");
      btn.textContent = box.classList.contains("show") ? "Ocultar contexto" : "Ver contexto completo";
    });
  });
  document.querySelectorAll(".pend-resposta").forEach(ta => {
    ta.addEventListener("input", () => {
      state.pendencias = state.pendencias || {};
      state.pendencias[ta.dataset.pend] = ta.value;
      atualizarContadores();
      agendarSalvamento();
    });
  });
}

function escapar(t) {
  return String(t).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
}

function botaoEscolha(grupo, chave, valor, rotulo, classeAtiva, atual) {
  return '<button class="btn ' + (atual === valor ? classeAtiva : "") + '" data-as-grupo="' + grupo +
    '" data-as-chave="' + escapar(chave) + '" data-as-valor="' + valor + '">' + rotulo + '</button>';
}

function renderAssistente() {
  const a = state.assistente || {};
  const container = document.getElementById("assistente");
  let html = "";

  // Decision: trigger words
  const P = ASSISTENTE.palavras, pal = a.palavras || {};
  html += '<div class="pend-card"><div class="pend-titulo">' + P.titulo + '</div>' +
    '<button class="pend-toggle" data-as-toggle="palavras">Ver contexto completo</button>' +
    '<div class="pend-descricao" id="as-desc-palavras">' + P.contexto + '</div>' +
    '<div class="as-lista">' + P.itens.map(w =>
      '<div class="as-linha"><span class="as-rotulo">' + escapar(w) + '</span><span class="actions">' +
      botaoEscolha("palavras", w, "manter", "Manter", "active-aprovado", pal[w]) +
      botaoEscolha("palavras", w, "retirar", "Retirar", "active-removido", pal[w]) +
      '</span></div>').join("") + '</div>' +
    '<div class="as-sub">Acrescentar</div>' +
    '<textarea class="pend-resposta" data-as-campo="palavrasAcrescentadas" placeholder="' + escapar(P.campo) + '">' + escapar(a.palavrasAcrescentadas || "") + '</textarea></div>';

  // Decision: level-1 boundary
  const E = ASSISTENTE.exemplos, ex = a.exemplos || {};
  html += '<div class="pend-card"><div class="pend-titulo">' + E.titulo + '</div>' +
    '<button class="pend-toggle" data-as-toggle="exemplos">Ver contexto completo</button>' +
    '<div class="pend-descricao" id="as-desc-exemplos">' + E.contexto + '</div>' +
    '<div class="as-lista">' + E.itens.map(it =>
      '<div class="as-linha"><span class="as-rotulo">' + escapar(it.texto) + '</span><span class="actions">' +
      botaoEscolha("exemplos", it.id, "sozinho", "Responde sozinho", "active-aprovado", ex[it.id]) +
      botaoEscolha("exemplos", it.id, "coach", "Passa para mim", "active-editado", ex[it.id]) +
      '</span></div>').join("") + '</div>' +
    '<div class="as-sub">Regra geral</div>' +
    '<textarea class="pend-resposta" data-as-campo="regraGeral" placeholder="' + escapar(E.campo) + '">' + escapar(a.regraGeral || "") + '</textarea></div>';

  // Decision: library tags
  const T = ASSISTENTE.etiquetas, et = a.etiquetas || {};
  html += '<div class="pend-card"><div class="pend-titulo">' + T.titulo + '</div>' +
    '<button class="pend-toggle" data-as-toggle="etiquetas">Ver contexto completo</button>' +
    '<div class="pend-descricao" id="as-desc-etiquetas">' + T.contexto + '</div>' +
    '<div class="as-lista">' + T.itens.map(w =>
      '<div class="as-linha"><span class="as-rotulo">' + escapar(w) + '</span><span class="actions">' +
      botaoEscolha("etiquetas", w, "manter", "Manter", "active-aprovado", et[w]) +
      botaoEscolha("etiquetas", w, "retirar", "Retirar", "active-removido", et[w]) +
      '</span></div>').join("") + '</div>' +
    '<div class="as-sub">Acrescentar</div>' +
    '<textarea class="pend-resposta" data-as-campo="etiquetasAcrescentadas" placeholder="' + escapar(T.campo) + '">' + escapar(a.etiquetasAcrescentadas || "") + '</textarea></div>';

  container.innerHTML = html;

  container.querySelectorAll("[data-as-toggle]").forEach(btn => {
    btn.addEventListener("click", () => {
      const box = document.getElementById("as-desc-" + btn.dataset.asToggle);
      box.classList.toggle("show");
      btn.textContent = box.classList.contains("show") ? "Ocultar contexto" : "Ver contexto completo";
    });
  });
  container.querySelectorAll("[data-as-grupo]").forEach(btn => {
    btn.addEventListener("click", () => {
      const g = btn.dataset.asGrupo, k = btn.dataset.asChave, v = btn.dataset.asValor;
      state.assistente = state.assistente || {};
      state.assistente[g] = state.assistente[g] || {};
      state.assistente[g][k] = v;
      renderAssistente();
      agendarSalvamento();
    });
  });
  container.querySelectorAll("[data-as-campo]").forEach(ta => {
    ta.addEventListener("input", () => {
      state.assistente = state.assistente || {};
      state.assistente[ta.dataset.asCampo] = ta.value;
      atualizarContadores();
      agendarSalvamento();
    });
  });
  atualizarContadores();
}

// One counter per block, required items only. Totals: block 1 = 25 + 3 + 4; block 2 = 8 + 5 + 11; block 3 = 4.
// The three free-text fields of block 2 are optional: saved, but never counted.
function atualizarContadores() {
  const preenchido = v => typeof v === "string" && v.trim() !== "";
  let ia = 0, as = 0, pr = 0;
  GRUPOS.forEach(g => g.perguntas.forEach((_, i) => { if ((state.itens[keyFor(g.id, i)] || {}).status) ia++; }));
  ["bulking", "cutting", "dietbreak"].forEach(k => { if (preenchido((state.fases || {})[k])) ia++; });
  PENDENCIAS.forEach(p => {
    if (!preenchido((state.pendencias || {})[p.id])) return;
    if (BLOCO_PENDENCIA[p.id] === "ia") ia++; else pr++;
  });
  const a = state.assistente || {};
  ASSISTENTE.palavras.itens.forEach(w => { if ((a.palavras || {})[w]) as++; });
  ASSISTENTE.exemplos.itens.forEach(it => { if ((a.exemplos || {})[it.id]) as++; });
  ASSISTENTE.etiquetas.itens.forEach(w => { if ((a.etiquetas || {})[w]) as++; });
  const put = (id, n) => { const el = document.getElementById(id); if (el) el.textContent = n; };
  put("progIA", ia); put("progAS", as); put("progPR", pr);
}

function agendarSalvamento() {
  const el = document.getElementById("saveStatus");
  el.textContent = "Salvando...";
  el.classList.remove("saved");
  clearTimeout(saveTimer);
  saveTimer = setTimeout(salvar, 700);
}

async function salvar() {
  const el = document.getElementById("saveStatus");
  try {
    await chamar("salvar-decisoes-coach", { itens: state.itens, novas: state.novas, fases: state.fases, pendencias: state.pendencias, assistente: state.assistente });
    el.textContent = "Respostas salvas";
    el.classList.add("saved");
  } catch (e) {
    el.textContent = "Não foi possível salvar agora — tente novamente em instantes";
  }
}

["bulking","cutting","dietbreak"].forEach(k => {
  const ta = document.getElementById("phase-" + k);
  ta.addEventListener("input", () => {
    state.fases = state.fases || {};
    state.fases[k] = ta.value;
    atualizarContadores();
    agendarSalvamento();
  });
});

document.getElementById("btnReset").addEventListener("click", () => {
  document.getElementById("confirmOverlay").classList.add("show");
});
document.getElementById("btnConfirmCancel").addEventListener("click", () => {
  document.getElementById("confirmOverlay").classList.remove("show");
});
document.getElementById("btnConfirmOk").addEventListener("click", async () => {
  document.getElementById("confirmOverlay").classList.remove("show");
  state = estadoVazio();
  ["bulking","cutting","dietbreak"].forEach(k => { document.getElementById("phase-" + k).value = ""; });
  render();
  renderPendencias();
  renderAssistente();
  await salvar();
});

async function init() {
  try {
    const dados = await chamar("ler-decisoes-coach", {});
    state = { itens: dados.itens || {}, novas: dados.novas || [], fases: dados.fases || {}, pendencias: dados.pendencias || {}, assistente: dados.assistente || {} };
  } catch (e) {
    state = estadoVazio();
  }
  render();
  renderPendencias();
  renderAssistente();
  document.getElementById("saveStatus").textContent = "Aguardando suas respostas";
  if (state.fases) {
    if (state.fases.bulking) document.getElementById("phase-bulking").value = state.fases.bulking;
    if (state.fases.cutting) document.getElementById("phase-cutting").value = state.fases.cutting;
    if (state.fases.dietbreak) document.getElementById("phase-dietbreak").value = state.fases.dietbreak;
  }
}

init();
</script>
</body>
</html>
