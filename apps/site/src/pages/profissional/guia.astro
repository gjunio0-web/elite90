<script>
  // Destaque da seção corrente. Progressivo de propósito: se o navegador não
  // tiver IntersectionObserver, ou se algum alvo sumir do documento, os onze
  // itens seguem funcionando como links comuns. O índice não depende disto
  // para servir — o destaque é orientação, não navegação.
  //
  // Fica FORA do script que importa o Firebase de propósito: orientação dentro
  // do documento não deve depender de autenticação.
  if ("IntersectionObserver" in window) {
    const marcas = document.querySelectorAll<HTMLElement>("[data-idx]");
    const ids = [...new Set([...marcas].map((m) => m.dataset.idx))]
      .filter((id): id is string => !!id);

    // Observa-se o BLOCO que contém a âncora, não a âncora: títulos de altura
    // mínima entram e saem da faixa de observação num piscar, e o último do
    // documento nunca chega a entrar, porque a rolagem acaba antes.
    const alvos: HTMLElement[] = [];
    for (const id of ids) {
      const ancora = document.getElementById(id);
      if (!ancora) continue;
      const bloco = (ancora.closest("section, .etapa") as HTMLElement | null) ?? ancora;
      bloco.dataset.secao = id;
      alvos.push(bloco);
    }

    const visiveis = new Set<string>();
    const pintar = () => {
      // Entre as seções visíveis, vence a que está mais acima na página —
      // é a que o leitor acabou de alcançar ao rolar para baixo.
      let corrente: string | null = null;
      for (const alvo of alvos) {
        const secao = alvo.dataset.secao;
        if (secao && visiveis.has(secao)) { corrente = secao; break; }
      }
      // No fim do documento a regra acima não alcança a última seção: a
      // rolagem termina antes de ela subir ao topo. Chegando ao fim, a última
      // vence.
      const noFim = window.innerHeight + window.scrollY
        >= document.documentElement.scrollHeight - 2;
      if (noFim && alvos.length) {
        corrente = alvos[alvos.length - 1].dataset.secao ?? corrente;
      }
      marcas.forEach((m) => {
        if (m.dataset.idx === corrente) m.setAttribute("aria-current", "true");
        else m.removeAttribute("aria-current");
      });
    };

    const observador = new IntersectionObserver((entradas) => {
      entradas.forEach((e) => {
        const secao = (e.target as HTMLElement).dataset.secao;
        if (!secao) return;
        if (e.isIntersecting) visiveis.add(secao);
        else visiveis.delete(secao);
      });
      pintar();
    }, { rootMargin: "-80px 0px -55% 0px" });

    alvos.forEach((alvo) => observador.observe(alvo));

    // A regra de fim de documento depende da posição de rolagem, que o
    // observador não reporta sozinho: chegar ao fim pode não cruzar nenhuma
    // fronteira de seção.
    window.addEventListener("scroll", pintar, { passive: true });
  }
</script>

