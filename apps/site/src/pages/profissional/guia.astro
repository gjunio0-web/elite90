---
export const prerender = false;
import '@fontsource/bebas-neue';
import '@fontsource/raleway/400.css';
import '@fontsource/raleway/700.css';
import '@fontsource/montserrat/400.css';
import '@fontsource/montserrat/700.css';
import '../../styles/tokens.css';
import '../../styles/global.css';
import AdminHeader from '../../components/AdminHeader.astro';

// Gêmeo de /admin/guia para a rota restrita. MESMO design system, MESMA
// estrutura de índice e MESMAS classes — o que muda é para quem o texto fala.
//
// Sem parâmetro "from": a área do profissional tem uma tela só, e o retorno é
// sempre /profissional. Não há tela de origem a preservar, e um parâmetro de
// caminho aqui abriria superfície de redirecionamento sem servir a nada.
const backHref = '/profissional';

// Índice do guia — fonte única dos destinos, consumida duas vezes: pela coluna
// lateral e pelo bloco que vai ao menu "⋮" do cabeçalho. Mesma razão de
// /admin/guia: duplicar a lista no HTML seria garantir que uma envelhecesse.
const indice = [
  { id: 'inicio',      titulo: 'Início',                   chave: '',     etapa: false },
  { id: 'papeis',      titulo: 'Três papéis',              chave: '',     etapa: false },
  { id: 'acesso',      titulo: 'Seu primeiro acesso',      chave: '01',   etapa: true  },
  { id: 'carteira',    titulo: 'Sua carteira',             chave: '02',   etapa: true  },
  { id: 'montar',      titulo: 'Montar o plano',           chave: '03',   etapa: true  },
  { id: 'enviar',      titulo: 'Enviar ao Coach',          chave: '04',   etapa: true  },
  { id: 'resposta',    titulo: 'A resposta do Coach',      chave: '05',   etapa: true  },
  { id: 'exercicios',  titulo: 'O catálogo de exercícios', chave: 'Base', etapa: false },
  { id: 'alimentos',   titulo: 'A base de alimentos',      chave: 'Base', etapa: false },
  { id: 'privacidade', titulo: 'O que você vê do atleta',  chave: '',     etapa: false },
  { id: 'regras',      titulo: 'Quatro regras',            chave: '',     etapa: false },
];
const antesDaJornada = indice.filter((s) => !s.etapa && ['inicio', 'papeis'].includes(s.id));
const etapasDaJornada = indice.filter((s) => s.etapa);
const depoisDaJornada = indice.filter((s) => !s.etapa && !['inicio', 'papeis'].includes(s.id));
---
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ELITE90 PRO — Guia do Profissional</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="icon" href="/favicon.ico" />
  <style is:global>

  :root{
    /* Codigo de autoria — quem age em cada etapa do guia */
    --ator-sistema:#4A90D9; --ator-voce:#A6C300; --ator-coach:#27AE60;
    --line: 1px solid rgba(255,255,255,0.08);
  }
  *{box-sizing:border-box}
  html{scroll-behavior:smooth}

  :focus-visible{outline:2px solid var(--c-lime); outline-offset:3px}
  .wrap{max-width:1080px; margin:0 auto; padding:0 var(--space-4)}

  /* ── Cabeçalho ───────────────────────────────── */
  .top{
    border-bottom:4px solid var(--c-lime);
    background:linear-gradient(180deg,#0D0D0D 0%,#141414 100%);
    padding:var(--space-7) 0 var(--space-6);
  }
  .eyebrow{
    font-family:var(--font-label); font-size:.7rem; font-weight:700;
    letter-spacing:var(--tracking-label); text-transform:uppercase; color:var(--c-lime);
  }
  h1{
    font-family:var(--font-display); font-weight:400;
    font-size:clamp(2.6rem,8vw,5.2rem); line-height:.95; letter-spacing:var(--tracking-display);
    text-transform:uppercase; color:var(--c-white); margin:var(--space-3) 0 var(--space-3);
  }
  h1 em{font-style:normal; color:var(--c-lime)}
  .top p{max-width:62ch; color:var(--c-textsub); margin:0}
  .top .stamp{
    margin-top:var(--space-5); padding-top:var(--space-3); border-top:var(--line);
    font-family:var(--font-label); font-size:.7rem; letter-spacing:.08em;
    text-transform:uppercase; color:var(--c-textsub);
  }

  /* ── Blocos ──────────────────────────────────── */
  section{padding:var(--space-7) 0}
  section + section{border-top:var(--line)}
  h2{
    font-family:var(--font-display); font-weight:400;
    font-size:clamp(1.7rem,4vw,2.6rem); line-height:1.1; letter-spacing:var(--tracking-display);
    text-transform:uppercase; color:var(--c-white); margin:var(--space-2) 0 var(--space-4);
  }
  h3{
    font-family:var(--font-label); font-size:.72rem; font-weight:700;
    letter-spacing:var(--tracking-label); text-transform:uppercase;
    color:var(--c-textsub); margin:0 0 var(--space-3);
  }
  p{margin:0 0 var(--space-3)}
  .lead{font-size:1.05rem; color:var(--c-textbody); max-width:64ch}
  strong{color:var(--c-white); font-weight:600}

  /* ── Código de autoria ───────────────────────── */
  .atores{display:grid; gap:var(--space-3); grid-template-columns:repeat(auto-fit,minmax(260px,1fr))}
  .ator{
    background:var(--c-darkbg); border:var(--line); border-left:4px solid var(--cor);
    border-radius:var(--radius-card); padding:var(--space-4);
  }
  .ator .n{
    font-family:var(--font-label); font-size:.72rem; font-weight:700;
    letter-spacing:var(--tracking-label); text-transform:uppercase; color:var(--cor);
    display:flex; align-items:center; gap:var(--space-2);
  }
  .ator .n::before{content:""; width:10px; height:10px; border-radius:50%; background:var(--cor); flex:none}
  .ator .verbo{
    font-family:var(--font-display); font-size:1.9rem; line-height:1;
    letter-spacing:var(--tracking-display); text-transform:uppercase;
    color:var(--c-white); margin:var(--space-2) 0 var(--space-2);
  }
  .ator p{font-size:.875rem; color:var(--c-textsub); margin:0}

  .chip{
    display:inline-flex; align-items:center; gap:6px;
    font-family:var(--font-label); font-size:.62rem; font-weight:700;
    letter-spacing:.1em; text-transform:uppercase;
    padding:4px 10px; border-radius:var(--radius-pill);
    border:1px solid var(--cor); color:var(--cor); background:rgba(255,255,255,.02);
    white-space:nowrap;
  }
  .chip::before{content:""; width:6px; height:6px; border-radius:50%; background:var(--cor)}
  .c-sis{--cor:var(--ator-sistema)} .c-voce{--cor:var(--ator-voce)} .c-coach{--cor:var(--ator-coach)}

  /* ── Esteira de etapas ───────────────────────── */
  .etapa{position:relative; padding-left:calc(var(--space-6) + var(--space-2)); margin-bottom:var(--space-6)}
  .etapa::before{
    content:""; position:absolute; left:22px; top:56px; bottom:-var(--space-6);
    width:1px; background:linear-gradient(180deg,rgba(166,195,0,.5),rgba(166,195,0,.05));
  }
  .etapa:last-child::before{display:none}
  .etapa .num{
    position:absolute; left:0; top:0; width:46px; height:46px;
    display:flex; align-items:center; justify-content:center;
    border:1px solid var(--c-lime); border-radius:50%; background:var(--c-black);
    font-family:var(--font-display); font-size:1.4rem; color:var(--c-lime); letter-spacing:.02em;
  }
  .etapa-hd{display:flex; align-items:center; gap:var(--space-3); flex-wrap:wrap; min-height:46px}
  .etapa-hd h2{margin:0}
  .etapa-body{margin-top:var(--space-4)}

  .card{
    background:var(--c-darkbg); border:var(--line); border-radius:var(--radius-card);
    padding:var(--space-4); transition:border-color var(--transition-base);
  }
  .card:hover{border-color:rgba(166,195,0,.3)}
  .grid-2{display:grid; gap:var(--space-3); grid-template-columns:repeat(auto-fit,minmax(280px,1fr))}
  .grid-3{display:grid; gap:var(--space-3); grid-template-columns:repeat(auto-fit,minmax(220px,1fr))}

  ul.clean{list-style:none; margin:0; padding:0}
  ul.clean li{position:relative; padding-left:var(--space-4); margin-bottom:var(--space-2); font-size:.925rem}
  ul.clean li::before{
    content:""; position:absolute; left:0; top:.62em;
    width:8px; height:2px; background:var(--c-lime);
  }
  ul.clean li:last-child{margin-bottom:0}

  /* ── A RÉGUA (elemento assinatura) ───────────── */
  .regua{
    background:var(--c-surface-2); border:var(--line); border-radius:var(--radius-card);
    padding:var(--space-5) var(--space-4) var(--space-4); margin-top:var(--space-3);
  }
  .regua-titulo{
    font-family:var(--font-display); font-size:1.5rem; letter-spacing:var(--tracking-display);
    text-transform:uppercase; color:var(--c-white); margin-bottom:var(--space-1);
  }
  .regua-sub{font-size:.85rem; color:var(--c-textsub); margin-bottom:var(--space-5)}

  /* Trilho de estados — mesma família visual da escala de /admin/guia, aqui
     com quatro paradas nomeadas em vez de uma barra proporcional. */
  .trilho{display:grid; gap:2px; grid-template-columns:repeat(auto-fit,minmax(150px,1fr)); margin-bottom:var(--space-5)}
  .parada{background:var(--c-black); border-top:3px solid var(--cor); padding:var(--space-3)}
  .parada .p{font-family:var(--font-display); font-size:1.35rem; color:var(--cor); line-height:1}
  .parada .r{font-family:var(--font-label); font-size:.65rem; font-weight:700; letter-spacing:.1em;
             text-transform:uppercase; color:var(--c-textsub); margin-top:4px}
  .parada .d{font-size:.82rem; color:var(--c-textsub); margin-top:var(--space-2)}

  .faixas{display:grid; gap:2px; grid-template-columns:repeat(auto-fit,minmax(150px,1fr)); margin-top:var(--space-4)}
  .faixa{background:var(--c-black); border-top:3px solid var(--cor); padding:var(--space-3)}
  .faixa .p{font-family:var(--font-display); font-size:1.6rem; color:var(--cor); line-height:1}
  .faixa .r{font-family:var(--font-label); font-size:.65rem; font-weight:700; letter-spacing:.1em;
            text-transform:uppercase; color:var(--c-textsub); margin-top:4px}

  /* ── Entra / Sai ─────────────────────────────── */
  .fluxo{display:grid; gap:var(--space-3); grid-template-columns:repeat(auto-fit,minmax(240px,1fr))}
  .fluxo .col{background:var(--c-darkbg); border:var(--line); border-radius:var(--radius-card); padding:var(--space-4)}
  .fluxo .col.destaque{border-color:rgba(166,195,0,.4); box-shadow:var(--shadow-cta)}
  .fluxo .col h3{color:var(--c-lime)}

  /* ── Avisos e garantias ──────────────────────── */
  .aviso{
    border-left:3px solid var(--cor); background:rgba(255,255,255,.02);
    padding:var(--space-3) var(--space-4); border-radius:0 var(--radius-card) var(--radius-card) 0;
    margin-bottom:var(--space-3);
  }
  .aviso .t{
    font-family:var(--font-label); font-size:.68rem; font-weight:700; letter-spacing:.12em;
    text-transform:uppercase; color:var(--cor); margin-bottom:6px;
  }
  .aviso p{margin:0; font-size:.9rem}
  .a-laranja{--cor:var(--c-status-alert)} .a-lime{--cor:var(--c-lime)} .a-azul{--cor:var(--c-status-progress)}

  .garantias{display:grid; gap:2px; grid-template-columns:repeat(auto-fit,minmax(240px,1fr)); background:rgba(255,255,255,.09)}
  .g{background:var(--c-black); padding:var(--space-5) var(--space-4)}
  .g .k{
    font-family:var(--font-display); font-size:2.4rem; line-height:1; color:var(--c-lime);
    letter-spacing:var(--tracking-display); margin-bottom:var(--space-2);
  }
  .g p{font-size:.9rem; margin:0; color:var(--c-textsub)}
  .g p b{color:var(--c-white); font-weight:600}

  /* ── Rodapé ──────────────────────────────────── */
  footer{border-top:4px solid var(--c-lime); padding:var(--space-6) 0 var(--space-7); background:#141414}
  footer .marca{
    font-family:var(--font-display); font-size:2rem; letter-spacing:.08em;
    text-transform:uppercase; color:var(--c-white);
  }
  footer .marca span{color:var(--c-lime)}
  footer p{font-size:.8rem; color:var(--c-textsub); max-width:60ch; margin-top:var(--space-2)}

  /* ── Índice ──────────────────────────────────
     Compensação de rolagem: o cabeçalho é fixo e tem 64px em qualquer
     largura. Sem isto, TODO salto de âncora deposita o alvo atrás dele. */
  [id]{scroll-margin-top:80px}

  .idx-g{
    font-family:var(--font-label); font-size:.62rem; font-weight:700;
    letter-spacing:var(--tracking-label); text-transform:uppercase;
    color:var(--c-textsub);
  }
  .idx-a{
    display:flex; gap:10px; align-items:baseline; text-decoration:none;
    color:var(--c-textbody); font-size:.8rem; line-height:1.3;
    transition:color var(--transition-base), background var(--transition-base);
  }
  .idx-a:hover{color:var(--c-white); background:rgba(255,255,255,.03)}
  .idx-k{
    font-family:var(--font-label); font-size:.58rem; font-weight:700;
    letter-spacing:.08em; text-transform:uppercase; color:var(--c-textsub);
    min-width:30px;
  }
  .idx-a[aria-current="true"]{color:var(--c-lime); background:rgba(166,195,0,.08)}
  .idx-a[aria-current="true"] .idx-k{color:var(--c-lime)}

  /* Coluna lateral — aparece onde o gatilho "⋮" NÃO aparece. As duas faixas
     são complementares por construção: ver o @media no fim deste bloco. */
  .idx--coluna{
    position:fixed; left:0; top:64px; bottom:0; width:264px; z-index:90;
    overflow-y:auto; background:var(--c-black);
    border-right:var(--line); padding:var(--space-5) var(--space-3) var(--space-6);
  }
  .idx--coluna .idx-g{margin:0 0 var(--space-3) 10px}
  .idx--coluna .idx-g--jornada{margin-top:var(--space-4); margin-bottom:var(--space-2)}
  .idx--coluna .idx-a{
    padding:7px 10px; border-left:2px solid transparent; border-radius:0 3px 3px 0;
  }
  .idx--coluna .idx-a[aria-current="true"]{border-left-color:var(--c-lime)}
  .idx-sub{border-left:1px solid rgba(166,195,0,.18); margin-left:16px}
  .idx-sub .idx-a{padding-left:12px}
  .doc{padding-left:264px}

  /* Bloco do menu "⋮" — herda a moldura do painel do cabeçalho, que já traz
     fundo, borda e raio; aqui só as linhas. */
  .idx--menu .idx-g{
    padding:12px var(--space-4) 6px; background:rgba(255,255,255,.02);
    border-bottom:1px solid rgba(255,255,255,.06);
  }
  .idx--menu .idx-a{
    padding:11px var(--space-4);
    border-bottom:1px solid rgba(255,255,255,.06);
  }
  .idx--menu .idx-a--sub{padding-left:calc(var(--space-4) + 12px)}
  .idx--menu .idx-a[aria-current="true"]{box-shadow:inset 2px 0 0 var(--c-lime)}

  /* A regra de faixas, num lugar só: onde o gatilho "⋮" existe, o índice mora
     no menu e a coluna some. Fora daí, o inverso. A condição é copiada de
     AdminHeader.astro de propósito — se lá mudar, muda aqui junto. */
  @media (max-width:760px) and (orientation:portrait){
    .idx--coluna{display:none}
    .doc{padding-left:0}
  }

  @media (max-width:640px){
    .etapa{padding-left:0}
    .etapa::before{display:none}
    .etapa .num{position:static; margin-bottom:var(--space-3)}
  }
  @media (prefers-reduced-motion:reduce){*{transition:none !important; scroll-behavior:auto !important}}

  </style>
</head>
<body>
  <AdminHeader badge="Guia" backHref={backHref} showGuide={false} logoHref="/profissional">
    <nav slot="navegacao" class="idx idx--menu" aria-label="Índice do guia">
      <div class="idx-g">Neste guia</div>
      {antesDaJornada.map((s) => (
        <a class="idx-a" href={`#${s.id}`} data-idx={s.id}>
          <span class="idx-k">{s.chave}</span><span>{s.titulo}</span>
        </a>
      ))}
      <div class="idx-g">Do convite ao plano publicado</div>
      {etapasDaJornada.map((s) => (
        <a class="idx-a idx-a--sub" href={`#${s.id}`} data-idx={s.id}>
          <span class="idx-k">{s.chave}</span><span>{s.titulo}</span>
        </a>
      ))}
      {depoisDaJornada.map((s) => (
        <a class="idx-a" href={`#${s.id}`} data-idx={s.id}>
          <span class="idx-k">{s.chave}</span><span>{s.titulo}</span>
        </a>
      ))}
    </nav>
  </AdminHeader>

  <nav class="idx idx--coluna" aria-label="Índice do guia">
    <div class="idx-g">Neste guia</div>
    {antesDaJornada.map((s) => (
      <a class="idx-a" href={`#${s.id}`} data-idx={s.id}>
        <span class="idx-k">{s.chave}</span><span>{s.titulo}</span>
      </a>
    ))}
    <div class="idx-g idx-g--jornada">Do convite ao plano publicado</div>
    <div class="idx-sub">
      {etapasDaJornada.map((s) => (
        <a class="idx-a idx-a--sub" href={`#${s.id}`} data-idx={s.id}>
          <span class="idx-k">{s.chave}</span><span>{s.titulo}</span>
        </a>
      ))}
    </div>
    {depoisDaJornada.map((s) => (
      <a class="idx-a" href={`#${s.id}`} data-idx={s.id}>
        <span class="idx-k">{s.chave}</span><span>{s.titulo}</span>
      </a>
    ))}
  </nav>

  <div class="doc">


<header class="top" id="inicio">
  <div class="wrap">
    <div class="eyebrow">Coach Ruiz · Elite 90 Pro</div>
    <h1>Guia de<br><em>Referência Rápida</em></h1>
    <p class="lead">Do convite que chega por e-mail ao plano que o Coach publica para o atleta:
      o que é seu, o que é do Coach, e o que o sistema faz sozinho enquanto você trabalha.</p>
    <div class="stamp">Área do profissional · Planos de treino e nutricional</div>
  </div>
</header>

<section>
  <div class="wrap">
    <h3>Comece por aqui</h3>
    <h2 id="papeis">Três papéis, sem sobreposição</h2>
    <p class="lead" style="margin-bottom:var(--space-5)">Este código de cores acompanha o guia
      inteiro. Em cada etapa, a etiqueta indica quem age — e a separação não é uma promessa de
      conduta, é a forma como o sistema foi construído.</p>

    <div class="atores">
      <div class="ator" style="--cor:var(--ator-voce)">
        <div class="n">Você</div>
        <div class="verbo">Monta e envia</div>
        <p>Constrói o plano de treino ou nutricional de cada atleta da sua carteira e o envia ao
          Coach. É trabalho técnico seu, com seu nome — mas nada do que você escreve chega ao
          atleta pela sua mão.</p>
      </div>
      <div class="ator" style="--cor:var(--ator-coach)">
        <div class="n">O Coach</div>
        <div class="verbo">Revisa e publica</div>
        <p>Lê o que você enviou e decide entre três desfechos: publicar, devolver para ajuste ou
          recusar. É o único que publica, e é ele quem define quem está na sua carteira.</p>
      </div>
      <div class="ator" style="--cor:var(--ator-sistema)">
        <div class="n">O sistema</div>
        <div class="verbo">Guarda e protege</div>
        <p>Salva seu rascunho enquanto você digita, mostra do atleta só o que você precisa para
          trabalhar, e registra cada ato que muda alguma coisa.</p>
      </div>
    </div>
  </div>
</section>

<section>
  <div class="wrap">
    <h3>A jornada, passo a passo</h3>
    <h2>Do convite ao plano publicado</h2>

    <!-- 1 -->
    <div class="etapa" id="acesso">
      <div class="num">01</div>
      <div class="etapa-hd">
        <h2 style="font-size:clamp(1.4rem,3vw,2rem)">Seu primeiro acesso</h2>
        <span class="chip c-coach">Cadastro pelo Coach</span>
        <span class="chip c-sis">Automático</span>
      </div>
      <div class="etapa-body">
        <p class="lead">Você não se cadastra sozinho, e não existe tela pública de inscrição. O
          Coach cadastra você e concede o acesso; o resto chega por e-mail.</p>

        <div class="grid-2">
          <div class="card">
            <h3>O que chega até você</h3>
            <ul class="clean">
              <li>Um e-mail com um link para <strong>definir sua senha</strong>. Ele sai
                automaticamente quando o Coach concede o acesso — não é opcional, nem depende de
                alguém lembrar de avisar.</li>
              <li>A página pede a senha e a confirmação. São necessários <strong>ao menos seis
                caracteres</strong>, e as duas precisam coincidir.</li>
              <li>Definida a senha, você é levado à tela de entrada. Entre com o mesmo e-mail e o
                sistema abre direto a sua área.</li>
            </ul>
          </div>
          <div class="card">
            <h3>Onde você trabalha</h3>
            <ul class="clean">
              <li>O endereço da sua área é <strong>/profissional</strong>. Guarde-o nos
                favoritos: enquanto a sessão durar, ele abre direto, sem passar por login.</li>
              <li>É a única tela do sistema destinada a você. O painel completo do Coach é outro
                endereço, e sua conta não entra nele.</li>
            </ul>
          </div>
        </div>

        <div class="aviso a-laranja" style="margin-top:var(--space-3)">
          <div class="t">Guarde o endereço de entrada que veio no e-mail</div>
          <p>O mesmo e-mail que trouxe o link da senha traz também, logo abaixo, o endereço da
