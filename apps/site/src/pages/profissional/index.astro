      if (chart2) { try { chart2.destroy(); } catch(e){} chart2 = null; }
      if (chart3) { try { chart3.destroy(); } catch(e){} chart3 = null; }
      container.innerHTML = '';

      var periodRow =
        '<div style="display:flex;gap:8px;margin-bottom:24px;">' +
