---
export const prerender = false;
import '@fontsource/bebas-neue';
import '@fontsource/raleway/400.css';
import '@fontsource/raleway/700.css';
import '@fontsource/montserrat/400.css';
import '@fontsource/montserrat/700.css';
import '../../styles/tokens.css';
import '../../styles/global.css';
import '../../styles/editor-plano.css';
import AdminHeader from '../../components/AdminHeader.astro';

// CA-42 · Os MESMOS componentes que a gaveta do Coach importa. Não existe cópia:
// alterar qualquer um deles altera as duas telas.
import EditorTreino from '../../components/admin/EditorTreino.astro';
import PreviaTreino from '../../components/admin/PreviaTreino.astro';
import SobreposicoesTreino from '../../components/admin/SobreposicoesTreino.astro';
import EditorNutricional from '../../components/admin/EditorNutricional.astro';
import PreviaNutricional from '../../components/admin/PreviaNutricional.astro';
import SobreposicoesNutricional from '../../components/admin/SobreposicoesNutricional.astro';

// Os três núcleos, no padrão de injeção por `?raw` (F-16).
import buscaNucleo from '@elite90/busca/nucleo.js?raw';
import editorComunsNucleo from '@elite90/editor-comuns/nucleo.js?raw';
import editorPlanoNucleo from '@elite90/editor-plano/nucleo.js?raw';
---
{/*
  ELITE90 PRO · rota restrita do profissional — passo 2 da AC-16, a ligação.

  O QUE ESTE ARQUIVO NÃO CONTÉM, E POR QUE ISSO É O PONTO
  Nenhuma marcação de Publicar, de Compartilhar, do painel de configuração da
  fórmula de macros, nem de exclusão de atleta. A CA-33 e a CA-51 são
  verificáveis por AUSÊNCIA neste arquivo — não por condição em tempo de
  execução. Foi para isso que a AC-10 recusou renderização condicional dentro de
  `atletas.astro`, e para isso que a AC-15 declarou a fronteira do núcleo.

  AS TRÊS COSTURAS, TODAS RESOLVIDAS AQUI PELA HOSPEDEIRA RESTRITA
    onde persiste   → o gancho, no primeiro script (AC-19)
    de onde abre    → `abrir-plano-profissional` (AC-18, AC-23)
    identificação   → `displayLabel`, montado com o que a projeção devolveu (AC-21)
*/}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ELITE90 PRO — Área do Profissional</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="icon" href="/favicon.ico" />

  <meta name="fb-api"    content={import.meta.env.PUBLIC_FIREBASE_API_KEY} />
  <meta name="fb-auth"   content={import.meta.env.PUBLIC_FIREBASE_AUTH_DOMAIN} />
  <meta name="fb-proj"   content={import.meta.env.PUBLIC_FIREBASE_PROJECT_ID} />
  <meta name="fb-bucket" content={import.meta.env.PUBLIC_FIREBASE_STORAGE_BUCKET} />
  <meta name="fb-sender" content={import.meta.env.PUBLIC_FIREBASE_MESSAGING_SENDER_ID} />
  <meta name="fb-appid"  content={import.meta.env.PUBLIC_FIREBASE_APP_ID} />

  <!-- Gráficos da aba Visão Geral — mesma versão que /admin/atletas usa. -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>

  <style is:global>
    .prof-main { max-width: 1040px; margin: 0 auto; padding: 32px 24px 64px; }
    .prof-title { font-family: 'Bebas Neue', sans-serif; font-size: 2rem;
                  letter-spacing: .04em; margin: 0 0 8px; }
    .prof-sub { font-family: Montserrat, sans-serif; font-size: .9rem;
                opacity: .75; margin: 0 0 32px; }
    .prof-msg { font-family: Montserrat, sans-serif; padding: 24px;
                border: 1px solid rgba(255,255,255,.12); border-radius: 8px; }
    .prof-grid { display: grid; gap: 16px;
                 grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); }
    .prof-card { border: 1px solid rgba(255,255,255,.12); border-radius: 8px;
                 padding: 20px; background: #1A1A1A; }
    .prof-card__nome { font-family: Raleway, sans-serif; font-weight: 700;
                       font-size: 1.05rem; margin: 0 0 4px; }
    .prof-card__meta { font-family: Montserrat, sans-serif; font-size: .8rem;
                       opacity: .7; margin: 0 0 14px; }
    .prof-abas { display: flex; gap: 8px; flex-wrap: wrap; }
    .prof-aba { font-family: Raleway, sans-serif; font-size: .72rem;
                text-transform: uppercase; letter-spacing: .06em;
                padding: 5px 10px; border-radius: 4px; cursor: pointer;
                background: none;
                border: 1px solid var(--lima, #A6C300); color: var(--lima, #A6C300); }
    .prof-editor__topo { display: flex; align-items: center; gap: 16px;
                         flex-wrap: wrap; margin-bottom: 20px; }
    .prof-voltar { font-family: Raleway, sans-serif; font-size: .78rem;
                   background: none; cursor: pointer; padding: 6px 12px;
                   border-radius: 4px; border: 1px solid rgba(255,255,255,.2);
                   color: #CCCCCC; }
    .prof-estado { font-family: Montserrat, sans-serif; font-size: .82rem;
                   line-height: 1.5; padding: 12px 16px; border-radius: 6px;
                   margin-bottom: 20px; border: 1px solid #E67E22; color: #E67E22; }
    .prof-enviar { font-family: Raleway, sans-serif; font-weight: 700;
                   text-transform: uppercase; letter-spacing: .06em;
                   font-size: .8rem; padding: 10px 20px; border-radius: 4px;
                   cursor: pointer; border: none; margin-left: auto;
                   background: var(--lima, #A6C300); color: #0D0D0D; }
    .prof-enviar[disabled] { opacity: .35; cursor: not-allowed; }
    /* Modo de leitura (AC-24). A opacidade apenas ACOMPANHA o modo; a garantia
       é o `disabled` controle a controle, no roteiro — CSS não impede teclado. */
    .prof-leitura .drawer-section { opacity: .72; }
  </style>
</head>
<body>
  <AdminHeader badge="Profissional" />

  <main class="prof-main">
    <h1 class="prof-title" id="prof-title">Sua carteira</h1>
    <p class="prof-sub" id="prof-sub">Carregando…</p>

    <div id="prof-msg" class="prof-msg" hidden></div>
    <div id="prof-grid" class="prof-grid" hidden></div>

    <section id="prof-editor" hidden></section>

    <!-- GAVETA — mesmo padrão de /admin/atletas (CSS compartilhado,
         editor-plano.css), com uma diferença: só três abas, não seis.
         Check-in, Avaliação e Evolução continuam exclusivas do Coach —
         Visão Geral entra aqui porque sem contexto do atleta (idade,
         objetivo, frequência) o profissional não tem como montar plano
         nenhum com critério. -->
    <div id="prof-drawer" style="display: none;">
      <div class="drawer-panel">
        <span class="drawer-handle"></span>
        <div class="drawer-header">
          <span class="drawer-title">Atleta <span id="prof-drawer-nome"></span></span>
          <button class="drawer-close" id="prof-drawer-close" aria-label="Fechar gaveta" type="button">✕</button>
        </div>
        <div class="drawer-body">
          <nav class="drawer-sidenav" id="prof-drawer-sidenav">
            <button class="sidenav-item active" data-tab="overview" type="button">
              <span class="sidenav-abbr">VG</span><span class="sidenav-label">Visão Geral</span>
            </button>
            <!-- Treino/Nutricional começam ocultos: só a(s) especialidade(s)
                 desta atribuição aparecem (CA-44) — mostradas por
                 abrirGaveta(), nunca as duas por padrão. -->
            <button class="sidenav-item" data-tab="training" type="button" id="prof-sidenav-training" hidden>
              <span class="sidenav-abbr">TR</span><span class="sidenav-label">Treino</span>
            </button>
            <button class="sidenav-item" data-tab="nutrition" type="button" id="prof-sidenav-nutrition" hidden>
              <span class="sidenav-abbr">NU</span><span class="sidenav-label">Nutricional</span>
            </button>
          </nav>

          <div class="drawer-content-wrap">

            <!-- ABA: VISÃO GERAL -->
            <div class="tab-content active" id="prof-tab-overview">
              <div class="drawer-section">
                <div class="drawer-section-title">Perfil do Atleta</div>
                <div class="drawer-row"><span class="drawer-label">Início do Programa</span><span class="drawer-value" id="prof-profile-start">—</span></div>
                <div class="drawer-row"><span class="drawer-label">Fase</span><span class="drawer-value" id="prof-profile-fase">—</span></div>
                <div class="drawer-row"><span class="drawer-label">Idade</span><span class="drawer-value" id="prof-profile-age">—</span></div>
                <div class="drawer-row"><span class="drawer-label">Gênero</span><span class="drawer-value" id="prof-profile-genero">—</span></div>
                <div class="drawer-row"><span class="drawer-label">Altura</span><span class="drawer-value" id="prof-profile-height">—</span></div>
                <div class="drawer-row"><span class="drawer-label">Tempo de Atividade</span><span class="drawer-value" id="prof-profile-years">—</span></div>
                <div class="drawer-row"><span class="drawer-label">Frequência Semanal</span><span class="drawer-value" id="prof-profile-freq">—</span></div>
                <div class="drawer-row"><span class="drawer-label">Tempo Médio Treino/Dia</span><span class="drawer-value" id="prof-profile-duration">—</span></div>
                <div class="drawer-row" style="border-bottom:none;"><span class="drawer-label">Objetivo</span><span class="drawer-value" id="prof-profile-goal">—</span></div>
              </div>

              <div class="drawer-section" style="margin-top:24px;padding-top:24px;border-top:1px solid rgba(255,255,255,.08);">
                <div class="drawer-section-title">Progressão de Ciclo</div>
                <div style="display:flex;flex-direction:column;padding:12px 0 0;">
                  <span id="prof-overview-cycle-label" class="drawer-label" style="margin-bottom:12px;text-align:left;">Progresso</span>
                  <div class="progress-bar"><div class="progress-fill" id="prof-overview-progress" style="width:0%;"></div></div>
                </div>
              </div>

              <!-- Gráficos SIMULADOS — mesmo mecanismo de /admin/atletas
                   (generateMock*), não histórico real. A subcoleção que
                   traria o dado de verdade (weights/checkins/evaluations)
                   está deliberadamente fora desta fase (_projecao-atleta.ts).
                   Achado levado à governança em separado; ver
                   ACHADO-graficos-simulados-producao.md. -->
              <div style="margin-top:24px;padding-top:24px;border-top:1px solid rgba(255,255,255,.08);">
                <div class="drawer-section-title">Progressão Física</div>
                <p style="font-family:var(--font-body,inherit);font-size:12px;color:var(--c-textsub,#999);margin:0 0 16px;">
                  Peso, proporção e simetria ao longo do ciclo (Programa ELITE90 PRO)
                </p>
                <div id="prof-charts"></div>
              </div>
            </div>

            <!-- ABA: TREINO -->
            <div class="tab-content" id="prof-tab-training">
              <div class="prof-editor__topo">
                <button type="button" class="prof-enviar" id="prof-enviar-training">Enviar ao Coach</button>
              </div>
              <div id="prof-estado-training" class="prof-estado" hidden></div>
              <div class="drawer-section">
                <EditorTreino />
              </div>
              <PreviaTreino />
            </div>

            <!-- ABA: NUTRICIONAL -->
            <div class="tab-content" id="prof-tab-nutrition">
              <div class="prof-editor__topo">
                <button type="button" class="prof-enviar" id="prof-enviar-nutrition">Enviar ao Coach</button>
              </div>
              <div id="prof-estado-nutrition" class="prof-estado" hidden></div>
              <div class="drawer-section">
                <EditorNutricional />
              </div>
              <PreviaNutricional />
            </div>

          </div>
        </div>
      </div>
    </div>
  </main>

  <SobreposicoesTreino />
  <SobreposicoesNutricional />

  <script is:inline>
    // ---------- CONTRATO DE GANCHO NA ROTA RESTRITA (AC-19) ----------
    //
    // AS TRÊS ENTRADAS ESTÃO LIGADAS. Nenhuma fica ausente, e o núcleo NÃO foi
    // alterado para tolerar ausência — tolerância no núcleo devolveria a
    // garantia condicional que a AC-10 recusou.
    //
    // As três são chamadas pelo AUTOSSALVO, que dispara a cada tecla (F-21), e
    // NENHUMA por botão. Por isso "não existe botão neste arquivo" não bastaria:
    // ausência de ligação não é ausência de botão.
    //
    // `getPlanRef` devolve nulo e `renderPubHeader` não faz nada — INERTES
    // DECLARADAS aqui, por escrito. Quem lê este arquivo vê que aqui não se
    // publica, e o ramo condicional do autossalvo nunca executa porque a
    // referência vem nula.
    //
    // Script clássico, e não módulo, de propósito: o núcleo é injetado como
    // script clássico e alcança `EditorPlanoHost` pelo escopo global. Declarado
    // com `var` pela mesma razão — `const` no topo de script clássico é de
    // escopo de script, e o núcleo não o enxergaria.
    var E90 = {
      token: null,
      athleteUid: null,
      planType: null,
      suggestionId: null,
      status: null,
      somenteLeitura: false,
    };

    var EditorPlanoHost = {
      // Persistência: implementação PRÓPRIA, gravando rascunho em `suggestions/`
      // e nunca no campo `draft` do plano (CA-55).
      m2SalvarRascunho: function (planType, plano) {
        // CA-61 · No modo de leitura NÃO SE PRODUZ REQUISIÇÃO ALGUMA. Não é erro
        // tolerado nem resposta ignorada: a chamada termina aqui, antes do
        // `fetch`. Um laço de 409 silenciado reprovaria este critério tanto
        // quanto um laço não silenciado.
        if (E90.somenteLeitura) return;
        if (!E90.token || !E90.athleteUid) return;
        fetch('/.netlify/functions/rascunhar-sugestao', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': 'Bearer ' + E90.token,
          },
          body: JSON.stringify({
            athleteUid: E90.athleteUid,
            planType: planType,
            content: plano,
          }),
        }).then(function (r) {
          return r.ok ? r.json() : null;
        }).then(function (d) {
          // O identificador só nasce na primeira gravação; guardá-lo evita que a
          // submissão adiante crie um segundo documento para o mesmo par.
          if (d && d.suggestionId) E90.suggestionId = d.suggestionId;
        }).catch(function () {
          // O rascunho é oportunista — o ato que conta é a submissão, e ela
          // informa o resultado ao profissional. Falhar em silêncio aqui é
          // preferível a interromper a digitação.
        });
      },

      // Inerte declarada: aqui não há plano publicável a referenciar.
      getPlanRef: function () { return null; },

      // Inerte declarada: aqui não há cabeçalho de publicação a desenhar.
      renderPubHeader: function () { return; },
    };
  </script>

  <script is:inline set:html={buscaNucleo}></script>
  <script is:inline set:html={editorComunsNucleo}></script>
  <script is:inline set:html={editorPlanoNucleo}></script>

  <script type="module">
    import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-app.js";
    import { getAuth, onAuthStateChanged, signOut } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-auth.js";

    const cfg = {
      apiKey:            document.querySelector('meta[name="fb-api"]')?.content,
      authDomain:        document.querySelector('meta[name="fb-auth"]')?.content,
      projectId:         document.querySelector('meta[name="fb-proj"]')?.content,
      storageBucket:     document.querySelector('meta[name="fb-bucket"]')?.content,
      messagingSenderId: document.querySelector('meta[name="fb-sender"]')?.content,
      appId:             document.querySelector('meta[name="fb-appid"]')?.content,
    };
    const auth = getAuth(initializeApp(cfg));

    // AdminHeader renderiza o botão de logout por padrão (showLogout=true),
    // mas nada nesta página o ligava a signOut() — o mesmo defeito já
    // catalogado em aprovacoes.astro, exercicios.astro e alimentos.astro:
    // o botão existe e não faz nada. Mesmo padrão de atletas.astro.
    document.getElementById("btn-logout")?.addEventListener("click", async () => {
      await signOut(auth);
      window.location.href = "/admin/login";
    });

    const $ = (id) => document.getElementById(id);
    const titulo = $("prof-title"), sub = $("prof-sub"), msg = $("prof-msg");
    const grid = $("prof-grid");

    // A gaveta substitui a antiga <section id="prof-editor"> mostrada inline.
    // #prof-editor continua no HTML, sempre hidden — nada a mostrar nela.
    const drawer = $("prof-drawer");
    const drawerNome = $("prof-drawer-nome");
    const sidenav = $("prof-drawer-sidenav");

    const ROTULO_ABA = { training: "Treino", nutrition: "Nutricional" };
    const ROTULO_ESTADO = {
      draft: "Rascunho — ainda não enviado ao Coach.",
      returned: "Devolvida pelo Coach para ajuste.",
      pending: "Enviada ao Coach e em revisão.",
    };
    const GENERO_LABEL = { masculino: "Masculino", feminino: "Feminino", outro: "Outro" };

    // uid -> objeto atleta projetado (_projecao-atleta.ts), preenchido por
    // renderCarteira(). abrirGaveta() consulta este mapa para a Visão Geral —
    // dado que a carteira já trouxe, sem chamada nova ao servidor.
    let atletasPorUid = new Map();
    let drawerCloseTimer = null;

    function mostrarMensagem(texto) {
      sub.textContent = ""; grid.hidden = true;
      fecharGaveta();
      msg.textContent = texto; msg.hidden = false;
    }

    function chamar(fn, corpo) {
      return fetch("/.netlify/functions/" + fn, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "Authorization": `Bearer ${window.E90.token}`,
        },
        body: JSON.stringify(corpo ?? {}),
      });
    }

    // Achado ao reescrever este arquivo para a gaveta: esta chamada tinha
    // sido cortada por engano na primeira versão do patch — a página nunca
    // carregaria atleta nenhum sem ela. Pego pelo `tsc` ("onAuthStateChanged
    // declarado e nunca lido"), não por leitura.
    onAuthStateChanged(auth, async user => {
      if (!user) { window.location.href = "/admin/login"; return; }
      try {
        // Token novo: quem acabou de receber o acesso não deveria precisar sair
        // e entrar de novo para que a reivindicação chegue.
        window.E90.token = await user.getIdToken(true);
        const resp = await chamar("listar-atletas-do-profissional");
        // 403 cobre as três recusas do servidor. A tela NÃO distingue qual:
        // quem porta token revogado não precisa saber em que estado está o
        // cadastro dele.
        if (resp.status === 403) {
          mostrarMensagem("Esta conta não tem acesso à área do profissional. Procure o Coach.");
          return;
        }
        if (!resp.ok) throw new Error(String(resp.status));
        const { atletas } = await resp.json();
        renderCarteira(atletas ?? []);
      } catch {
        // Falha de rede não é falha de autorização, e dizer "sem acesso" aqui
        // mandaria a pessoa procurar o Coach por um problema que não é dela.
        mostrarMensagem("Não foi possível carregar a carteira agora. Tente novamente em instantes.");
      }
    });

    function renderCarteira(atletas) {
      msg.hidden = true; sub.hidden = false;
      titulo.textContent = "Sua carteira";
      if (atletas.length === 0) {
        mostrarMensagem("Nenhum atleta atribuído a você no momento.");
        return;
      }
      sub.textContent = atletas.length === 1
        ? "1 atleta sob sua responsabilidade."
        : `${atletas.length} atletas sob sua responsabilidade.`;

      atletasPorUid = new Map();
      grid.innerHTML = "";
      for (const item of atletas) {
        const a = item.atleta ?? {};
        // Nome OU rótulo, nunca os dois: o servidor projeta um só, conforme a
        // classificação do cadastro (D-14). A tela exibe o que veio, e o `??`
        // é recurso de renderização, não regra.
        const identidade = a.name ?? a.externalLabel ?? "—";
        atletasPorUid.set(a.uid, { atleta: a, identidade, specialties: item.specialties ?? [] });

        const card = document.createElement("div");
        card.className = "prof-card";

        const h = document.createElement("p");
        h.className = "prof-card__nome";
        h.textContent = identidade;

        const meta = document.createElement("p");
        meta.className = "prof-card__meta";
        meta.textContent = a.phase ? `Fase: ${a.phase}` : "Fase não definida";

        const abas = document.createElement("div");
        abas.className = "prof-abas";
        // CA-44 · uma aba por ATRIBUIÇÃO ATIVA NAQUELE ATLETA, e não pelas
        // especialidades do cadastro do profissional.
        for (const s of (item.specialties ?? [])) {
          const b = document.createElement("button");
          b.type = "button";
          b.className = "prof-aba";
          b.textContent = ROTULO_ABA[s] ?? s;
          b.addEventListener("click", () => abrirGaveta(a.uid, s));
          abas.appendChild(b);
        }

        card.append(h, meta, abas);
        grid.appendChild(card);
      }
      grid.hidden = false;
    }

    // ── ABERTURA DA GAVETA ──────────────────────────────────────────────────
    // Substitui o antigo abrir(): em vez de trocar #prof-grid por
    // #prof-editor na mesma página, abre #prof-drawer — mesmo padrão visual
    // de /admin/atletas, com CSS compartilhado (editor-plano.css).
    function abrirGaveta(athleteUid, planTypeInicial) {
      const entrada = atletasPorUid.get(athleteUid);
      if (!entrada) return;
      const { atleta, identidade, specialties } = entrada;

      drawerNome.textContent = identidade;

      // Sidenav: Visão Geral sempre; Treino/Nutricional só se esta atribuição
      // os autoriza (CA-44) — nunca os dois por padrão, nunca por suposição.
      $("prof-sidenav-training").hidden = !specialties.includes("training");
      $("prof-sidenav-nutrition").hidden = !specialties.includes("nutrition");

      // A gaveta fica visível ANTES de popularVisaoGeral (que inicializa os
      // gráficos) — mesma ordem de /admin/atletas. Gráfico é o Chart.js vindo
      // de CDN; se falhar ao carregar (rede, bloqueador), o erro não pode
      // impedir a gaveta de abrir — só os gráficos ficam ausentes.
      if (drawerCloseTimer) { clearTimeout(drawerCloseTimer); drawerCloseTimer = null; }
      drawer.style.display = "flex";
      requestAnimationFrame(() => drawer.classList.add("open"));

      popularVisaoGeral(atleta);

      selecionarAbaGaveta(planTypeInicial ?? "overview", athleteUid);
    }

    function fecharGaveta() {
      if (!drawer || !drawer.classList.contains("open")) return;
      drawer.classList.remove("open");
      drawerCloseTimer = setTimeout(() => {
        drawer.style.display = "none";
        drawerCloseTimer = null;
      }, 350);
    }

    $("prof-drawer-close").addEventListener("click", fecharGaveta);

    // ── VISÃO GERAL ──────────────────────────────────────────────────────────
    // Todo campo aqui já vem de listar-atletas-do-profissional (CAMPOS_NIVEL_1
    // em _projecao-atleta.ts) — nenhuma chamada nova ao servidor.
    function calcularIdade(birthDate) {
      if (!birthDate) return null;
      const nasc = new Date(birthDate);
      if (Number.isNaN(nasc.getTime())) return null;
      const hoje = new Date();
      let idade = hoje.getFullYear() - nasc.getFullYear();
      const aindaNaoFezAniversario =
        hoje.getMonth() < nasc.getMonth() ||
        (hoje.getMonth() === nasc.getMonth() && hoje.getDate() < nasc.getDate());
      if (aindaNaoFezAniversario) idade--;
      return idade;
    }

    function popularVisaoGeral(atleta) {
      const idade = calcularIdade(atleta.birthDate);
      $("prof-profile-start").textContent = atleta.startDate
        ? new Date(atleta.startDate).toLocaleDateString("pt-BR") : "—";
      $("prof-profile-fase").textContent = typeof rotuloFase === "function"
        ? rotuloFase(atleta.phase) : (atleta.phase ?? "—");
      $("prof-profile-age").textContent = idade != null ? `${idade} anos` : "—";
      $("prof-profile-genero").textContent = GENERO_LABEL[atleta.genero] ?? "—";
      $("prof-profile-height").textContent = atleta.heightCm ? `${atleta.heightCm} cm` : "—";
      $("prof-profile-years").textContent = atleta.trainingYears != null ? `${atleta.trainingYears} ano(s)` : "—";
      $("prof-profile-freq").textContent = atleta.weeklyFrequency != null ? `${atleta.weeklyFrequency}x/semana` : "—";
      $("prof-profile-duration").textContent = atleta.dailyMinutes != null ? `${atleta.dailyMinutes} min` : "—";
      $("prof-profile-goal").textContent = atleta.goal ?? "—";

      // Semana do ciclo: mesma conta que /admin/atletas usa (dia corrido / 90
      // dias totais do programa) — sem campo "week" nem "day" na projeção do
      // profissional (não estão em CAMPOS_NIVEL_1), calcula-se por startDate.
      let semana = null, diaCorrido = null;
      if (atleta.startDate) {
        const inicio = new Date(atleta.startDate);
        if (!Number.isNaN(inicio.getTime())) {
          diaCorrido = Math.max(0, Math.floor((Date.now() - inicio.getTime()) / 86400000));
          semana = Math.min(13, Math.floor(diaCorrido / 7) + 1);
        }
      }
      $("prof-overview-cycle-label").innerHTML = semana != null
        ? `Progresso: <span style="color:#EDEDE0;font-weight:700;">Semana ${semana} de 13</span>.`
          + ` Em fase de <span style="color:#EDEDE0;font-weight:700;">${(typeof rotuloFase === "function" ? rotuloFase(atleta.phase) : atleta.phase) ?? "—"}</span>.`
          + ` Iniciado em <span style="color:#EDEDE0;font-weight:700;">${new Date(atleta.startDate).toLocaleDateString("pt-BR")}</span>.`
        : "Progresso: início do programa não registrado.";
      $("prof-overview-progress").style.width = diaCorrido != null ? `${Math.min(100, (diaCorrido / 90) * 100)}%` : "0%";

      // Gráficos SIMULADOS — ver aviso no cabeçalho do HTML e
      // ACHADO-graficos-simulados-producao.md.
      // try/catch mesmo padrão de /admin/atletas: falha ao inicializar (ex.:
      // Chart.js não carregou do CDN) não pode derrubar o resto da gaveta.
      try { initCharts({ ...atleta, id: atleta.uid }); } catch (e) { console.error("Erro ao inicializar gráficos:", e); }
    }

    // ── TROCA DE ABA ─────────────────────────────────────────────────────────
    // Cada troca recarrega o plano do zero, em vez de manter dois planos
    // aplicados ao motor ao mesmo tempo. `window.E90` é um contrato ÚNICO e
    // compartilhado (AC-19) — se Treino e Nutrição ficassem ambos "aplicados"
    // simultaneamente, o autossalvo da aba que NÃO está em foco arriscaria
    // gravar contra o planType errado, porque E90.planType é um valor só.
    // O custo é uma chamada de rede extra ao voltar a uma aba já vista; o
    // ganho é nunca ter dois planos disputando o mesmo contrato.
    function selecionarAbaGaveta(tab, athleteUidForcado) {
      const athleteUid = athleteUidForcado ?? window.E90.athleteUid;

      document.querySelectorAll("#prof-drawer .tab-content").forEach(c => c.classList.remove("active"));
      document.querySelectorAll("#prof-drawer .sidenav-item").forEach(b => b.classList.toggle("active", b.dataset.tab === tab));
      const conteudo = $(`prof-tab-${tab}`);
      if (conteudo) conteudo.classList.add("active");

      const wrap = document.querySelector("#prof-drawer .drawer-content-wrap");
      if (wrap) wrap.scrollTop = 0;

      if (tab === "training" || tab === "nutrition") {
        carregarPlano(athleteUid, tab);
      }
    }

    // ── CARREGAMENTO DE PLANO (antigo abrir()) ─────────────────────────────
    async function carregarPlano(athleteUid, planType) {
      const resp = await chamar("abrir-plano-profissional", { athleteUid, planType });
      if (resp.status === 403) {
        mostrarMensagem("Este atleta não está mais na sua carteira.");
        return;
      }
      if (!resp.ok) {
        declararEstado({ status: null }, planType);
        $(`prof-estado-${planType}`).textContent = "Não foi possível abrir este plano agora.";
        $(`prof-estado-${planType}`).hidden = false;
        return;
      }
      const dados = await resp.json();

      Object.assign(window.E90, {
        athleteUid, planType,
        suggestionId: dados.suggestionId,
        status: dados.status,
        // AC-24 · a precedência escolheu O QUÊ; o estado determina COMO.
        somenteLeitura: dados.status === "pending",
      });

      // AC-21 · terceira costura. `displayLabel` é montado AQUI, com o que a
      // projeção devolveu — nome no Nível 2, rótulo externo no Nível 1 —, e o
      // núcleo não sabe qual dos dois recebeu. A escolha entre eles ficou no
      // servidor, onde a D-14 a pôs.
      const atleta = dados.atleta ?? {};
      atleta.displayLabel = atleta.name ?? atleta.externalLabel ?? "O atleta";

      // Estado de primeira vez, quando não há sugestão. `isNew` é o que o núcleo
      // já reconhece como "nenhum plano definido ainda". NUNCA o plano-base:
      // ele é artefato de homologação da gaveta do Coach (AC-18).
      const vazio = planType === "training"
        ? { order: [], days: {}, isNew: true }
        : { days: {}, isNew: true };
      const plano = dados.content ?? vazio;

      // A aplicação ao estado e a renderização são do núcleo (AC-18).
      if (planType === "training") window.wkeAplicarPlano(atleta, plano);
      else window.nteAplicarPlano(atleta, plano);

      declararEstado(dados, planType);
      aplicarModo(planType);
    }

    // CA-62 · o estado é DECLARADO, e com a via de retomada junto. Declarar o
    // estado sem dizer a saída deixaria o profissional sem ação — e a via
    // existe: pending → o Coach devolve → returned → editável (AD-08).
    function declararEstado(dados, planType) {
      const estado = $(`prof-estado-${planType}`);
      if (!estado) return;
      if (!dados.status) { estado.hidden = true; return; }
      let texto = ROTULO_ESTADO[dados.status] ?? "";
      if (dados.status === "pending") {
        texto += " Enquanto estiver em revisão o conteúdo fica em somente leitura;"
              +  " para voltar a editar, peça ao Coach que devolva a sugestão.";
      }
      if (dados.status === "returned" && dados.reviewNote) {
        texto += " Observação do Coach: " + dados.reviewNote;
      }
      estado.textContent = texto;
      estado.hidden = false;
    }

    // CA-62 · os campos ficam DESABILITADOS, controle a controle. Não por camada
    // visual: `pointer-events` não impede teclado, e opacidade não impede nada.
    function aplicarModo(planType) {
      const ro = window.E90.somenteLeitura;
      const aba = $(`prof-tab-${planType}`);
      const enviar = $(`prof-enviar-${planType}`);
      if (!aba || !enviar) return;
      aba.classList.toggle("prof-leitura", ro);
      enviar.disabled = ro;
      const alvos = aba.querySelectorAll("input, select, textarea, button");
      for (const el of alvos) {
        if (el === enviar) continue;
        el.disabled = ro;
      }
    }

    for (const planType of ["training", "nutrition"]) {
      $(`prof-enviar-${planType}`).addEventListener("click", async () => {
        if (window.E90.somenteLeitura || window.E90.planType !== planType) return;
        const plano = planType === "training" ? window.wkeState.plan : window.nteState.plan;
        const enviar = $(`prof-enviar-${planType}`);
        enviar.disabled = true;
        const resp = await chamar("submeter-sugestao", {
          athleteUid: window.E90.athleteUid,
          planType,
          content: plano,
          suggestionId: window.E90.suggestionId ?? undefined,
        });
        if (resp.ok) {
          const d = await resp.json();
          // Submeter põe a sugestão sob revisão — e o modo de leitura entra na
          // mesma hora, sem exigir recarregar a tela.
          Object.assign(window.E90, {
            suggestionId: d.suggestionId, status: "pending", somenteLeitura: true,
          });
          declararEstado({ status: "pending" }, planType);
          aplicarModo(planType);
        } else {
          enviar.disabled = false;
          const estado = $(`prof-estado-${planType}`);
          estado.textContent = "Não foi possível enviar agora. Tente novamente em instantes.";
          estado.hidden = false;
        }
      });
    }

    // ── SIDENAV: clique troca de aba ──────────────────────────────────────
    sidenav.addEventListener("click", (e) => {
      const btn = e.target.closest(".sidenav-item");
      if (!btn || btn.hidden) return;
      selecionarAbaGaveta(btn.dataset.tab);
    });

    // ── DRAG TO DISMISS (mobile bottom sheet) — mesmo mecanismo de
    //    /admin/atletas, adaptado para #prof-drawer. ──────────────────────
    (function() {
      let startY = 0, currentY = 0, isDragging = false, startTime = 0;
      const DISMISS_THRESHOLD = 0.3;
      const VELOCITY_THRESHOLD = 0.4;

      function getPanel() { return document.querySelector('#prof-drawer .drawer-panel'); }

      let origemConteudo = false;

      function onTouchStart(e, doConteudo) {
        const panel = getPanel();
        if (!panel) return;
        startY = e.touches[0].clientY;
        currentY = 0;
        isDragging = true;
        origemConteudo = !!doConteudo;
        startTime = Date.now();
        panel.style.transition = 'none';
      }

      function cancelarArrasto() {
        isDragging = false;
        origemConteudo = false;
        currentY = 0;
        const panel = getPanel();
        if (panel) { panel.style.transition = ''; panel.style.transform = ''; }
      }

      function onTouchMove(e) {
        if (!isDragging) return false;
        const panel = getPanel();
        if (!panel) return false;
        const dy = e.touches[0].clientY - startY;
        if (dy < 0) {
          if (origemConteudo) cancelarArrasto();
          return false;
        }
        currentY = dy;
        panel.style.transform = 'translateY(' + dy + 'px)';
        return true;
      }

      function onTouchEnd() {
        if (!isDragging) return;
        isDragging = false;
        const panel = getPanel();
        if (!panel) return;

        const elapsed = Date.now() - startTime;
        const velocity = currentY / Math.max(elapsed, 1);
        const panelHeight = panel.offsetHeight;
        const shouldDismiss = currentY > panelHeight * DISMISS_THRESHOLD || velocity > VELOCITY_THRESHOLD;

        panel.style.transition = 'transform 0.35s cubic-bezier(0.16, 1, 0.3, 1)';

        if (shouldDismiss) {
          panel.style.transform = 'translateY(100%)';
          drawerCloseTimer = setTimeout(function() {
            drawer.style.display = 'none';
            drawer.classList.remove('open');
            panel.style.transform = '';
            drawerCloseTimer = null;
          }, 350);
        } else {
          panel.style.transform = 'translateY(0)';
        }
        currentY = 0;
      }

      document.addEventListener('touchstart', function(e) {
        if (!drawer || !drawer.classList.contains('open')) return;

        // Overlays de tela cheia (PreviaTreino/PreviaNutricional usam
        // .evo-overlay) têm cabeçalho próprio que reaproveita .drawer-header
        // por estilo, não por participar deste arrasto. Mesma exclusão que
        // /admin/atletas já precisou (ver comentário lá, sobre o "preso na
        // parte inferior, não fecha").
        if (e.target.closest('.evo-overlay')) return;

        if (e.target.closest('.drawer-handle, .drawer-header')) { onTouchStart(e, false); return; }

        const wrap = e.target.closest('.drawer-content-wrap');
        if (wrap && wrap.scrollTop <= 0) onTouchStart(e, true);
      }, { passive: true });

      document.addEventListener('touchmove', function(e) {
        if (isDragging && onTouchMove(e)) e.preventDefault();
      }, { passive: false });

      document.addEventListener('touchend', function() {
        if (isDragging) onTouchEnd();
      });
    })();
    function idSeed(id) {
      if (typeof id === 'number') return id;
      var s = String(id), h = 0;
      for (var i = 0; i < s.length; i++) { h = (h * 31 + s.charCodeAt(i)) | 0; }
      return Math.abs(h) || 1;
    }
    function seededRand(seed, i) {
      var x = Math.sin(seed * 9301 + i * 49297 + 233) * 44208.63;
      return x - Math.floor(x);
    }

    // ── GERADOR PESO — usa dados reais do atleta ──
    function generateMockWeightData(days, athlete) {
      var data = [];
      var today = new Date();
      var seed = athlete ? idSeed(athlete.id) : 1;
      var pesoBase = athlete ? (athlete.weightInitialKg || 82) : 82;
      var pesoFinal = athlete ? (athlete.weightCurrentKg || pesoBase) : pesoBase;
      var totalDays = athlete ? (athlete.day || days) : days;
      var dailyTrend = (pesoFinal - pesoBase) / Math.max(totalDays, 1);
      for (var i = days - 1; i >= 0; i--) {
        var date = new Date(today);
        date.setDate(date.getDate() - i);
        var dayOffset = Math.max(0, totalDays - i);
        var trendW = pesoBase + dailyTrend * dayOffset;
        var noise = (seededRand(seed, i) - 0.5) * 1.0 + Math.sin(i / 7) * 0.3;
        data.push({ date: date.toLocaleDateString('pt-BR').substring(0, 5), peso_bruto: parseFloat((trendW + noise).toFixed(2)), mma7: 0 });
      }
      for (var j = 0; j < data.length; j++) {
        if (j < 6) { data[j].mma7 = data[j].peso_bruto; }
        else {
          var sl7 = data.slice(j - 6, j + 1).map(function(d){ return d.peso_bruto; });
          data[j].mma7 = parseFloat((sl7.reduce(function(a,b){ return a+b; }) / 7).toFixed(2));
        }
      }
      return data;
    }

    // ── GERADOR V-TAPER — usa dados reais do atleta ──
    function generateMockVTaperData(days, athlete) {
      var semanas = Math.ceil(days / 7);
      var data = [];
      var seed = athlete ? idSeed(athlete.id) : 1;
      var ombrosNow = (athlete && athlete.checkin && athlete.checkin.chest) ? (athlete.checkin.chest + 17) : 116;
      var cinturaNow = (athlete && athlete.checkin) ? athlete.checkin.waist : 88;
      var phase = athlete ? (athlete.phase || 'Bulking') : 'Bulking';
      var og = phase === 'Bulking' ? 0.12 : (phase === 'Cutting' ? -0.06 : 0.02);
      var cg = phase === 'Cutting' ? -0.20 : (phase === 'Bulking' ? 0.09 : -0.02);
      for (var s = 1; s <= semanas; s++) {
        var wo = s - semanas;
        var noise = (seededRand(seed, s) - 0.5) * 0.4;
        data.push({
          semana: s,
          perimetro_ombros: parseFloat(Math.max(90, ombrosNow + og * wo + noise).toFixed(1)),
          perimetro_cintura: parseFloat(Math.max(60, cinturaNow + cg * wo + noise * 0.5).toFixed(1))
        });
      }
      return data;
    }

    // ── GERADOR SIMETRIA — usa dados reais do atleta ──
    function generateMockSymmetryData(days, athlete) {
      var quinzenas = Math.max(2, Math.ceil(days / 15));
      var data = [];
      var seed = athlete ? idSeed(athlete.id) : 1;
      var bracoNow = (athlete && athlete.checkin && athlete.checkin.arm) ? athlete.checkin.arm : 41;
      var coxaNow  = (athlete && athlete.checkin && athlete.checkin.hip) ? (athlete.checkin.hip * 0.65) : 62;
      for (var q = 1; q <= quinzenas; q++) {
        var qo = q - quinzenas;
        data.push({
          quinzena: q,
          braco_esq: parseFloat((bracoNow      + qo*0.12 + seededRand(seed, q*4)   * 0.6).toFixed(1)),
          braco_dir: parseFloat((bracoNow+0.2  + qo*0.12 + seededRand(seed, q*4+1) * 0.6).toFixed(1)),
          coxa_esq:  parseFloat((coxaNow       + qo*0.18 + seededRand(seed, q*4+2) * 1.0).toFixed(1)),
          coxa_dir:  parseFloat((coxaNow-0.15  + qo*0.18 + seededRand(seed, q*4+3) * 1.0).toFixed(1))
        });
      }
      return data;
    }

    // ── GLOBAIS ──
    var chart1, chart2, chart3;
    var currentPeriod = 30;
    var currentAthlete = null;

