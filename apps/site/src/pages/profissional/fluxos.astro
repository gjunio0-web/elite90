---
export const prerender = false;
import '@fontsource/bebas-neue';
import '@fontsource/raleway/400.css';
import '@fontsource/raleway/700.css';
import '@fontsource/montserrat/400.css';
import '@fontsource/montserrat/700.css';
import '../../styles/tokens.css';
import '../../styles/global.css';
import AdminHeader from '../../components/AdminHeader.astro';
import Fluxogramas from '../../components/Fluxogramas.astro';

// Moldura da versão do profissional. O conteúdo vive em components/Fluxogramas.astro, gerado por scripts/gerar-fluxogramas.mjs e compartilhado com /admin/fluxos.
//
// DUAS ROTAS FINAS, E NÃO UMA COMPARTILHADA (decisão de sessão). Os dois guias
// mandam o não autenticado para telas de entrada diferentes — /admin/login de um
// lado, /acesso-equipe do outro —, e uma rota única teria de escolher o destino
// pela reivindicação do usuário, replicando aqui a lógica que a tela de entrada
// já tem. Duas páginas de moldura, importando o MESMO componente, mantêm a
// fronteira entre as áreas intacta e não duplicam conteúdo nenhum.
const backHref = '/profissional/guia';
---
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ELITE90 PRO — Fluxos da delegação</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="icon" href="/favicon.ico" />
  <style is:global>
  :root{ --line: 1px solid rgba(255,255,255,0.08); }
  *{box-sizing:border-box}
  :focus-visible{outline:2px solid var(--c-lime); outline-offset:3px}
  .wrap{max-width:1240px; margin:0 auto; padding:0 var(--space-4)}
  .top{
    border-bottom:4px solid var(--c-lime);
    background:linear-gradient(180deg,#0D0D0D 0%,#141414 100%);
    padding:var(--space-7) 0 var(--space-6);
  }
  .eyebrow{
    font-family:var(--font-label); font-size:.7rem; font-weight:700;
    letter-spacing:var(--tracking-label); text-transform:uppercase; color:var(--c-lime);
  }
  h1{
    font-family:var(--font-display); font-weight:400;
    font-size:clamp(2.2rem,7vw,4.2rem); line-height:.95; letter-spacing:var(--tracking-display);
    text-transform:uppercase; color:var(--c-white); margin:var(--space-3) 0 var(--space-3);
  }
  .top p{max-width:64ch; color:var(--c-textsub); margin:0}
  .legenda{display:flex; flex-wrap:wrap; gap:var(--space-3) var(--space-5); padding:var(--space-4) 0; border-bottom:var(--line)}
  .lg{
    display:flex; align-items:center; gap:var(--space-2);
    font-family:var(--font-label); font-size:.64rem; font-weight:700;
    letter-spacing:var(--tracking-label); text-transform:uppercase; color:var(--c-textsub);
  }
  .lg svg{flex:none}
  section.fl{padding:var(--space-7) 0 var(--space-3); border-top:var(--line)}
  section.fl:first-of-type{border-top:none}
  .fl-n{font-family:var(--font-display); font-size:2.4rem; line-height:1; color:var(--c-lime); letter-spacing:.06em}
  h2{
    font-family:var(--font-display); font-weight:400;
    font-size:clamp(1.5rem,4vw,2.2rem); line-height:1.05; letter-spacing:var(--tracking-display);
    text-transform:uppercase; color:var(--c-white); margin:var(--space-1) 0 var(--space-2);
  }
  section.fl > p{max-width:66ch; color:var(--c-textsub); font-size:.9rem; margin:0 0 var(--space-5)}
  .notas{padding:var(--space-6) 0 var(--space-7); border-top:var(--line)}
  .notas h3{
    font-family:var(--font-display); font-weight:400; font-size:1.5rem;
    letter-spacing:var(--tracking-display); text-transform:uppercase; color:var(--c-white);
    margin:0 0 var(--space-2);
  }
  .notas p{max-width:68ch; font-size:.875rem; color:var(--c-textsub)}
  .notas strong{color:var(--c-white); font-weight:600}
  @media (prefers-reduced-motion:reduce){*{transition:none !important}}
  </style>
</head>
<body>
  <AdminHeader badge="Fluxos" backHref={backHref} guideHref="/profissional/guia" logoHref="/profissional" />

  <header class="top">
    <div class="wrap">
      <div class="eyebrow">Coach Ruiz · Elite 90 Pro</div>
      <h1>Fluxos da<br>delegação</h1>
      <p>São dois, e não um. O primeiro acontece uma vez por profissional. O segundo acontece
        muitas vezes, para cada atleta e cada plano, enquanto o vínculo durar.</p>
    </div>
  </header>

  <div class="wrap">
    <div class="legenda">
      <span class="lg"><svg width="44" height="22" aria-hidden="true"><rect x="1" y="3" width="42" height="16" rx="8" fill="#A6C300"/></svg>Início ou fim</span>
      <span class="lg"><svg width="44" height="22" aria-hidden="true"><rect x="1" y="3" width="42" height="16" rx="2" fill="#1A1A1A" stroke="#8A8A82" stroke-width="1.5"/></svg>Processo</span>
      <span class="lg"><svg width="44" height="22" aria-hidden="true"><polygon points="22,2 43,11 22,20 1,11" fill="#1A1A1A" stroke="#8A8A82" stroke-width="1.5"/></svg>Decisão</span>
      <span class="lg"><svg width="44" height="22" aria-hidden="true"><circle cx="22" cy="11" r="9" fill="#0D0D0D" stroke="#A6C300" stroke-width="1.5"/></svg>Conector</span>
      <span class="lg"><svg width="44" height="22" aria-hidden="true"><line x1="2" y1="11" x2="34" y2="11" stroke="#8A8A82" stroke-width="1.5"/><path d="M34 6L41 11L34 16" fill="none" stroke="#8A8A82" stroke-width="1.5"/></svg>Fluxo</span>
    </div>
  </div>

  <main class="wrap">
    <section class="fl" id="fluxo-i">
      <div class="fl-n">I</div>
      <h2>Ciclo de vida do profissional</h2>
      <p>Acontece uma vez. Vai da decisão do Coach de trazer alguém para o programa até a saída
        dessa pessoa. Entre uma ponta e outra existe um estado — profissional ativo — que dura o
        tempo que durar, e é dentro dele que o fluxo II roda, quantas vezes for preciso.</p>
      <Fluxogramas qual="i" />
    </section>

    <section class="fl" id="fluxo-ii">
      <div class="fl-n">II</div>
      <h2>Ciclo de um plano</h2>
      <p>Acontece muitas vezes: uma por atleta, por especialidade e por rodada de plano. Começa
        quando o Coach atribui um atleta e termina quando o plano publicado chega às mãos dele.
        Rodar de novo é voltar ao começo deste fluxo, não do primeiro.</p>
      <Fluxogramas qual="ii" />
    </section>

    <section class="notas">
      <h3>Como ler</h3>
      <p>A coluna em que um símbolo está diz de quem é o ato, e toda seta que muda de coluna é uma
        passagem de responsabilidade. Em tela estreita, a mesma sequência aparece em coluna única,
        com o nome do ator dentro de cada símbolo.</p>
      <p>Os círculos são conectores. As <strong>letras</strong> marcam retorno a um ponto já
        desenhado acima. Os <strong>números</strong> marcam salto adiante e só aparecem na versão
        em coluna, onde um ramo não tem por onde contornar. Círculo tracejado é saída, contínuo é
        entrada.</p>
      <p>Duas coisas que o desenho deixa explícitas de propósito. A saída do profissional exige
        <strong>dois atos separados</strong>: encerrar cada atribuição, uma a uma, e revogar o
        acesso — um não implica o outro. E o cadastro nunca é apagado, porque a autoria das
        versões publicadas aponta para ele.</p>
    </section>
  </main>

  <script type="module">
    import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-app.js";
    import { getAuth, signOut, onAuthStateChanged } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-auth.js";

    const cfg = {
      apiKey:            document.querySelector('meta[name="fb-api"]')?.content,
      authDomain:        document.querySelector('meta[name="fb-auth"]')?.content,
      projectId:         document.querySelector('meta[name="fb-proj"]')?.content,
      storageBucket:     document.querySelector('meta[name="fb-bucket"]')?.content,
      messagingSenderId: document.querySelector('meta[name="fb-sender"]')?.content,
      appId:             document.querySelector('meta[name="fb-appid"]')?.content,
    };
    const app  = initializeApp(cfg);
    const auth = getAuth(app);

    // Destino /acesso-equipe, NÃO /admin/login: esta rota serve o profissional, e /admin/login tem o portão de gateway_unlocked (AC-35).
    onAuthStateChanged(auth, user => {
      if (!user) { window.location.href = "/acesso-equipe"; return; }
    });

    document.getElementById("btn-logout")?.addEventListener("click", async () => {
      await signOut(auth);
      window.location.href = "/acesso-equipe";
    });
  </script>

  <meta name="fb-api"    content={import.meta.env.PUBLIC_FIREBASE_API_KEY} />
  <meta name="fb-auth"   content={import.meta.env.PUBLIC_FIREBASE_AUTH_DOMAIN} />
  <meta name="fb-proj"   content={import.meta.env.PUBLIC_FIREBASE_PROJECT_ID} />
  <meta name="fb-bucket" content={import.meta.env.PUBLIC_FIREBASE_STORAGE_BUCKET} />
  <meta name="fb-sender" content={import.meta.env.PUBLIC_FIREBASE_MESSAGING_SENDER_ID} />
  <meta name="fb-appid"  content={import.meta.env.PUBLIC_FIREBASE_APP_ID} />
</body>
</html>
