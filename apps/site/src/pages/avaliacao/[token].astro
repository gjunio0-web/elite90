---
// --- ELITE 90 · Página de Avaliação
// Rota dinâmica /avaliacao/[token] - renderiza o documento de avaliação
// do atleta com a identidade visual do avaliacao_elite90.html.
export const prerender = false;

import { initializeApp, getApps, cert } from "firebase-admin/app";
import { getFirestore } from "firebase-admin/firestore";

function getDb() {
  if (!getApps().length) {
    const sa = JSON.parse(import.meta.env.FIREBASE_SERVICE_ACCOUNT_JSON ?? "{}");
    initializeApp({ credential: cert(sa) });
  }
  return getFirestore();
}

const { token } = Astro.params;

let avaliacao = null;
let notFound  = false;

try {
  const db = getDb();
  const snap = await db.collection("avaliacoes")
    .where("token", "==", token)
    .limit(1)
    .get();

  if (snap.empty) {
    notFound = true;
  } else {
    avaliacao = snap.docs[0].data();
  }
} catch (e) {
  notFound = true;
}

const sections = [
  { num: "01", title: "Diagnóstico Estético e Análise de Proporções", key: "s1" },
  { num: "02", title: "Planejamento de Treinamento e Cardio",          key: "s2" },
  { num: "03", title: "Protocolo de Saúde Cardiovascular",             key: "s3" },
  { num: "04", title: "Estratégia de Competição",                      key: "s4" },
  { num: "05", title: "Alinhamento Operacional",                        key: "s5" },
];
---

<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Elite 90 - {notFound ? "Avaliação não encontrada" : `Avaliação - ${avaliacao?.nome}`}</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="icon" href="/favicon.ico" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@300;400;500;600;700&family=Montserrat:wght@600;700;800;900&display=swap" rel="stylesheet" />

  <style>
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
    body{
      background-color:#080808;
      color:#EDEDED;
      font-family:'Inter',sans-serif;
      min-height:100vh;
      padding-bottom:80px;
      background-image:
        radial-gradient(circle at 10% 15%, rgba(85,102,0,.12) 0%, transparent 50%),
        radial-gradient(circle at 90% 85%, rgba(166,195,0,.06) 0%, transparent 60%);
    }
    .premium-border{position:relative;}
    .premium-border::after{
      content:'';position:absolute;inset:0;border-radius:inherit;padding:1px;
      background:linear-gradient(to bottom right,rgba(166,195,0,.35),rgba(85,102,0,.05));
      -webkit-mask:linear-gradient(#fff 0 0) content-box,linear-gradient(#fff 0 0);
      -webkit-mask-composite:xor;mask-composite:exclude;pointer-events:none;
    }
    header{
      border-bottom:1px solid rgba(166,195,0,.2);
      background:rgba(0,0,0,.8);
      backdrop-filter:blur(12px);
      position:sticky;top:0;z-index:50;
    }
    .header-inner{
      max-width:900px;margin:0 auto;padding:0 16px;
      height:80px;display:flex;align-items:center;justify-content:space-between;
    }
    .logo-mark{display:flex;align-items:center;gap:16px;}
    .logo-text h1{font-family:'Bebas Neue',sans-serif;font-size:28px;letter-spacing:.1em;color:#A6C300;line-height:1;}
    .logo-text p{font-size:10px;letter-spacing:.2em;text-transform:uppercase;color:#666;margin-top:2px;}
    .badge{
      padding:6px 16px;border-radius:999px;font-size:11px;font-family:'Montserrat',sans-serif;
      font-weight:700;letter-spacing:.12em;text-transform:uppercase;
      background:rgba(85,102,0,.3);color:#A6C300;border:1px solid rgba(166,195,0,.2);
    }
    main{max-width:900px;margin:0 auto;padding:48px 16px;}
    .card{
      background:#121212;border-radius:24px;
      padding:48px;border:1px solid rgba(255,255,255,.05);
    }
    .doc-title{
      font-family:'Bebas Neue',sans-serif;
      font-size:clamp(2rem,5vw,3.5rem);
      letter-spacing:.04em;color:#fff;line-height:1.1;margin-bottom:32px;
    }
    .summary{
      padding:24px;background:rgba(0,0,0,.4);
      border-left:4px solid #A6C300;border-radius:0 12px 12px 0;
      font-size:14px;color:#bbb;line-height:1.8;margin-bottom:48px;
    }
    .section{margin-bottom:48px;}
    .section-header{display:flex;align-items:center;gap:12px;margin-bottom:20px;}
    .section-num{font-family:'Bebas Neue',sans-serif;font-size:2rem;color:#A6C300;}
    .section-title{font-family:'Bebas Neue',sans-serif;font-size:clamp(1.2rem,3vw,1.75rem);letter-spacing:.06em;color:#fff;text-transform:uppercase;}
    .section-body{font-size:14px;line-height:1.9;color:#bbb;white-space:pre-wrap;}
    .divider{height:1px;background:rgba(255,255,255,.06);margin:40px 0;}
    .not-found{text-align:center;padding:80px 24px;}
    .not-found h2{font-family:'Bebas Neue',sans-serif;font-size:3rem;color:#A6C300;margin-bottom:16px;}
    footer{margin-top:48px;text-align:center;}
    footer p{font-size:10px;letter-spacing:.15em;text-transform:uppercase;color:#444;}
    @media(max-width:600px){.card{padding:24px;border-radius:12px;}}
  </style>
</head>
<body>

  {notFound ? (
    <main>
      <div class="not-found">
        <h2>Avaliação não encontrada</h2>
        <p>O link pode ter expirado ou estar incorreto.</p>
      </div>
    </main>
  ) : (
    <>
      <header>
        <div class="header-inner">
          <div class="logo-mark">
            <svg width="40" height="40" viewBox="0 0 100 100" fill="#A6C300" aria-hidden="true">
              <path d="M50,15 C45,15 36,18 33,28 C30.5,36.3 32,46 36,52 L38,42 C38,42 42,43 50,43 C58,43 62,42 62,42 L64,52 C68,46 69.5,36.3 67,28 C64,18 55,15 50,15 Z M42,46 L40,78 L50,88 L60,78 L58,46 C54,49 46,49 42,46 Z"/>
            </svg>
            <div class="logo-text">
              <h1>COACH RUIZ</h1>
              <p>Estrategista em Alta Performance</p>
            </div>
          </div>
          <span class="badge">Classic Physique</span>
        </div>
      </header>

      <main>
        <article class="card premium-border">

          <p class="doc-title">
            DIRETRIZES DE PREPARAÇÃO<br/>E PLANEJAMENTO ESTRATÉGICO DO FÍSICO
          </p>

          <div class="summary">
            Documento de planejamento estratégico individual preparado pelo Coach Ruiz
            para <strong style="color:#fff;">{avaliacao.nome}</strong> com base na
            ficha de triagem submetida. Este plano é confidencial e foi elaborado
            exclusivamente para este atleta.
          </div>

          {sections.map((s, i) => (
            avaliacao.sections?.[s.key] ? (
              <>
                <section class="section">
                  <div class="section-header">
                    <span class="section-num">{s.num}</span>
                    <h2 class="section-title">{s.title}</h2>
                  </div>
                  <div class="section-body">{avaliacao.sections[s.key]}</div>
                </section>
                {i < sections.length - 1 && <div class="divider"></div>}
              </>
            ) : null
          ))}

        </article>
      </main>

      <footer>
        <p>Elite 90 - Documento Oficial de Preparação</p>
      </footer>
    </>
  )}

</body>
</html>
