---
// --- ELITE90 PRO · Página de Avaliação
// Rota dinâmica /avaliacao/[token] - renderiza o documento de avaliação
// do atleta com a identidade visual do avaliacao_elite90.html.
export const prerender = false;

import { initializeApp, getApps, cert } from "firebase-admin/app";
import { getFirestore } from "firebase-admin/firestore";
import '@fontsource/bebas-neue';
import '@fontsource/raleway/400.css';
import '@fontsource/raleway/700.css';
import '@fontsource/raleway/800.css';
import '@fontsource/montserrat/400.css';
import '@fontsource/montserrat/700.css';
import '../../styles/tokens.css';
import '../../styles/global.css';

function getDb() {
  if (!getApps().length) {
    const sa = JSON.parse(import.meta.env.FIREBASE_SERVICE_ACCOUNT_JSON ?? "{}");
    initializeApp({ credential: cert(sa) });
  }
  return getFirestore();
}

const { token } = Astro.params;

let avaliacao = null;
let notFound  = false;
let isExpired = false;
let idioma    = "pt-br";

try {
  const db = getDb();
  const snap = await db.collection("avaliacoes")
    .where("token", "==", token)
    .limit(1)
    .get();

  if (snap.empty) {
    notFound = true;
  } else {
    avaliacao = snap.docs[0].data();
    if (avaliacao.expiresAt) {
      const exp: Date = avaliacao.expiresAt.toDate
        ? avaliacao.expiresAt.toDate()
        : new Date(avaliacao.expiresAt._seconds * 1000);
      if (exp < new Date()) isExpired = true;
    }

    // Idioma do documento. Gravado na avaliação desde a introdução do envio
    // bilíngue; avaliações anteriores não o têm, e nesse caso relemos a ficha
    // de origem — a página precisa sair no MESMO idioma do e-mail que a
    // anunciou, senão o atleta clica num link em inglês e cai em português.
    if (avaliacao.idioma === "en" || avaliacao.idioma === "pt-br") {
      idioma = avaliacao.idioma;
    } else if (avaliacao.leadId) {
      try {
        const leadSnap = await db.collection("leads").doc(avaliacao.leadId).get();
        if (leadSnap.exists && (leadSnap.data() as any)?.idioma === "en") idioma = "en";
      } catch {
        // Mantém o português — reserva segura.
      }
    }
  }
} catch (e) {
  notFound = true;
}

const en = idioma === "en";

// Títulos das seções — devem espelhar a estrutura que o modelo de linguagem
// recebe em generate-evaluation.ts, para que a moldura da página e o conteúdo
// gerado falem do mesmo documento.
const sections = en ? [
  { num: "01", title: "Aesthetic Assessment and Proportion Analysis", key: "s1" },
  { num: "02", title: "Training and Cardio Planning",                 key: "s2" },
  { num: "03", title: "Cardiovascular Health Protocol",               key: "s3" },
  { num: "04", title: "Competition Strategy",                         key: "s4" },
  { num: "05", title: "Operational Alignment",                        key: "s5" },
] : [
  { num: "01", title: "Diagnóstico Estético e Análise de Proporções", key: "s1" },
  { num: "02", title: "Planejamento de Treinamento e Cardio",          key: "s2" },
  { num: "03", title: "Protocolo de Saúde Cardiovascular",             key: "s3" },
  { num: "04", title: "Estratégia de Competição",                      key: "s4" },
  { num: "05", title: "Alinhamento Operacional",                        key: "s5" },
];

// Moldura da página. O conteúdo das seções vem do documento gerado; tudo o que
// está aqui é o que a plataforma escreve em volta dele.
const t = en ? {
  lang: "en",
  titleNotFound: "Assessment not found",
  titleDoc: "Assessment",
  tagline: "High Performance Strategist",
  expiredH: "Link expired",
  expiredP: "This access link expired after 90 days. Please contact Coach Ruiz to request new access.",
  notFoundH: "Assessment not found",
  notFoundP: "The link may be incorrect. Check the email you received or contact Coach Ruiz.",
  eyebrow: "Official preparation document",
  docTitle: "Physique preparation and strategic planning guidelines",
  summaryA: "Individual strategic planning document prepared by Coach Ruiz for",
  summaryB: "based on the submitted screening form. Confidential and prepared exclusively for this athlete.",
  rights: "Coach Ruiz 2026 © All rights reserved",
  credit: "Created by GM Digital Bunker ©, 2026",
} : {
  lang: "pt-BR",
  titleNotFound: "Avaliação não encontrada",
  titleDoc: "Avaliação",
  tagline: "Estrategista em Alta Performance",
  expiredH: "Link expirado",
  expiredP: "Este link de acesso expirou após 90 dias. Entre em contato com o Coach Ruiz para solicitar um novo acesso.",
  notFoundH: "Avaliação não encontrada",
  notFoundP: "O link pode estar incorreto. Verifique o e-mail recebido ou entre em contato com o Coach Ruiz.",
  eyebrow: "Documento oficial de preparação",
  docTitle: "Diretrizes de preparação e planejamento estratégico do físico",
  summaryA: "Documento de planejamento estratégico individual preparado pelo Coach Ruiz para",
  summaryB: "com base na ficha de triagem submetida. Confidencial e elaborado exclusivamente para este atleta.",
  rights: "Coach Ruiz 2026 © Todos os direitos reservados",
  credit: "Criado por GM Digital Bunker ©, 2026",
};
---

<!DOCTYPE html>
<html lang={t.lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ELITE90 PRO - {notFound ? t.titleNotFound : `${t.titleDoc} - ${avaliacao?.nome}`}</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="icon" href="/favicon.ico" />

  <style>
    body { padding-bottom: 64px; }
    header {
      position: sticky; top: 0; z-index: 5;
      background: rgba(13,13,13,0.86);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid rgba(166,195,0,0.2);
    }
    .header-inner {
      max-width: 880px; margin: 0 auto; height: 78px; padding: 0 20px;
      display: flex; align-items: center; justify-content: space-between;
    }
    .logo-group { display: flex; align-items: center; gap: 14px; }
    .logo-name {
      font-family: var(--font-display); font-size: 26px; letter-spacing: 0.08em;
      color: var(--c-lime); line-height: 1; text-transform: uppercase;
    }
    .logo-sub {
      font-family: var(--font-label); font-weight: 700; font-size: 9px;
      letter-spacing: 0.2em; text-transform: uppercase; color: var(--c-textsub); margin-top: 3px;
    }
    .badge {
      font-family: var(--font-label); font-weight: 700; font-size: 11px;
      letter-spacing: 0.12em; text-transform: uppercase; padding: 6px 14px;
      border-radius: var(--radius-pill); background: rgba(166,195,0,0.12);
      color: var(--c-lime); border: 1px solid rgba(166,195,0,0.2); white-space: nowrap;
    }
    main { max-width: 880px; margin: 0 auto; padding: 48px 20px 0; }
    .card {
      position: relative; background: var(--c-darkbg); border-radius: var(--radius-card);
      border: 1px solid rgba(166,195,0,0.2); padding: clamp(28px, 5vw, 52px); overflow: hidden;
      margin-bottom: 32px;
    }
    .card-eyebrow {
      font-family: var(--font-label); font-weight: 700; font-size: 11px;
      letter-spacing: 0.18em; text-transform: uppercase; color: var(--c-lime); margin-bottom: 14px;
    }
    .card-title {
      font-family: var(--font-display); font-size: clamp(2rem, 5vw, 3.25rem);
      letter-spacing: 0.02em; color: var(--c-white); line-height: 1.04; text-transform: uppercase; margin: 0;
    }
    .summary {
      border-left: 3px solid var(--c-lime); background: var(--c-black);
      padding: 18px 22px; margin: 30px 0 44px;
      font-family: var(--font-body); font-size: 14px; line-height: 1.8; color: var(--c-textbody);
    }
    .section { margin-bottom: 40px; }
    .section-header { display: flex; align-items: baseline; gap: 14px; margin-bottom: 14px; }
    .section-num { font-family: var(--font-display); font-size: 30px; color: var(--c-lime); line-height: 1; }
    .section-title {
      font-family: var(--font-label); font-weight: 800; font-size: clamp(1rem, 2.4vw, 1.3rem);
      letter-spacing: 0.04em; color: var(--c-white); text-transform: uppercase; margin: 0;
    }
    .section-body {
      font-family: var(--font-body); font-size: 14px; line-height: 1.9;
      color: var(--c-textbody); margin: 0 0 0 2px; white-space: pre-wrap;
    }
    .divider { height: 1px; background: rgba(255,255,255,0.08); margin-top: 40px; }
    .not-found { text-align: center; padding: 80px 24px; }
    .not-found h2 {
      font-family: var(--font-display); font-size: 3rem; color: var(--c-lime);
      text-transform: uppercase; margin-bottom: 16px;
    }
    .not-found p { font-family: var(--font-body); font-size: 14px; color: var(--c-textbody); line-height: 1.7; }
    .eval-footer { padding-bottom: 40px; margin-top: 16px; }
    .eval-footer__divider {
      width: 100%; height: 1px; margin-bottom: 24px; opacity: 0.25;
      background: linear-gradient(to right, transparent, var(--c-lime) 20%, var(--c-lime) 80%, transparent);
    }
    .eval-footer__inner { display: flex; flex-direction: column; align-items: center; gap: 8px; text-align: center; }
    .eval-footer__copy {
      font-family: var(--font-label); font-size: 11px; font-weight: 700;
      text-transform: uppercase; letter-spacing: 0.1em; color: var(--c-textsub);
    }
    .eval-footer__credit {
      font-family: var(--font-label); font-size: 10px; font-weight: 700;
      text-transform: uppercase; letter-spacing: 0.08em; color: rgba(153,153,153,0.5);
    }
    @media (max-width: 600px) {
      .card { padding: 24px; }
      .header-inner { padding: 0 16px; }
    }
  </style>
</head>
<body>

  {(notFound || isExpired) ? (
    <main>
      <div class="not-found">
        {isExpired ? (
          <>
            <h2>{t.expiredH}</h2>
            <p>{t.expiredP}</p>
          </>
        ) : (
          <>
            <h2>{t.notFoundH}</h2>
            <p>{t.notFoundP}</p>
          </>
        )}
      </div>
    </main>
  ) : (
    <>
      <header>
        <div class="header-inner">
          <div class="logo-group">
            <svg width="38" height="38" viewBox="0 0 100 100" fill="currentColor" style="color:var(--c-lime)" aria-hidden="true">
              <path d="M50,15 C45,15 36,18 33,28 C30.5,36.3 32,46 36,52 L38,42 C38,42 42,43 50,43 C58,43 62,42 62,42 L64,52 C68,46 69.5,36.3 67,28 C64,18 55,15 50,15 Z M42,46 L40,78 L50,88 L60,78 L58,46 C54,49 46,49 42,46 Z"/>
            </svg>
            <div>
              <div class="logo-name">Coach Ruiz</div>
              <div class="logo-sub">{t.tagline}</div>
            </div>
          </div>
          <span class="badge">Classic Physique</span>
        </div>
      </header>

      <main>
        <article class="card">
          <div class="card-eyebrow">{t.eyebrow}</div>
          <h1 class="card-title">{t.docTitle}</h1>

          <div class="summary">
            {t.summaryA} <strong style="color:var(--c-white)">{avaliacao?.nome}</strong> {t.summaryB}
          </div>

          {sections.map((s, i) => (
            avaliacao?.sections?.[s.key] ? (
              <>
                <section class="section">
                  <div class="section-header">
                    <span class="section-num">{s.num}</span>
                    <h2 class="section-title">{s.title}</h2>
                  </div>
                  <p class="section-body">{avaliacao!.sections[s.key]}</p>
                </section>
                {i < sections.length - 1 && <div class="divider"></div>}
              </>
            ) : null
          ))}
        </article>
      </main>

      <footer class="eval-footer">
        <div class="eval-footer__divider" role="presentation"></div>
        <div class="eval-footer__inner">
          <p class="eval-footer__copy">{t.rights}</p>
          <p class="eval-footer__credit">{t.credit}</p>
        </div>
      </footer>
    </>
  )}

</body>
</html>
