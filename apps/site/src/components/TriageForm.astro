---
// --- ELITE 90 PRO · Formulário de Triagem
// Dispara evento Lead no Meta Pixel ao enviar.
// O envio é tratado via Netlify Forms - sem backend necessário no Sprint 1.

import type { Translations } from "../i18n/pt";

interface Props {
  t: Translations;
  id?: string;
}

const { t, id = "triagem" } = Astro.props;
const f = t.form;
---

<div class="triage-form-wrap" id={id}>
  <h3 class="triage-form__title">{f.title}</h3>

  <form
    class="triage-form"
    name="triagem-elite90"
    method="POST"
    data-netlify="true"
    netlify-honeypot="bot-field"
    novalidate
  >
    <!-- Honeypot anti-spam (oculto) -->
    <input type="hidden" name="form-name" value="triagem-elite90" />
    <p style="display:none">
      <label>
        Não preencher:
        <input name="bot-field" />
      </label>
    </p>

    <!-- Nome -->
    <div class="triage-form__field">
      <label class="triage-form__label" for="tf-name">
        {f.fields.name}
      </label>
      <input
        class="triage-form__input"
        type="text"
        id="tf-name"
        name="nome"
        required
        autocomplete="name"
        placeholder="Fernando Ruiz"
      />
    </div>

    <!-- E-mail -->
    <div class="triage-form__field">
      <label class="triage-form__label" for="tf-email">
        {f.fields.email}
      </label>
      <input
        class="triage-form__input"
        type="email"
        id="tf-email"
        name="email"
        required
        autocomplete="email"
        placeholder="seu@email.com"
      />
    </div>

    <!-- Idade -->
    <div class="triage-form__field">
      <label class="triage-form__label" for="tf-age">
        {f.fields.age}
      </label>
      <input
        class="triage-form__input"
        type="number"
        id="tf-age"
        name="idade"
        required
        min="18"
        max="75"
        placeholder="42"
      />
    </div>

    <!-- Objetivo -->
    <div class="triage-form__field">
      <label class="triage-form__label" for="tf-goal">
        {f.fields.goal}
      </label>
      <select
        class="triage-form__select"
        id="tf-goal"
        name="objetivo"
        required
      >
        <option value="" disabled selected>-</option>
        {f.fields.goalOptions.map((opt) => (
          <option value={opt}>{opt}</option>
        ))}
      </select>
    </div>

    <!-- Experiência -->
    <div class="triage-form__field">
      <label class="triage-form__label" for="tf-exp">
        {f.fields.experience}
      </label>
      <select
        class="triage-form__select"
        id="tf-exp"
        name="experiencia"
        required
      >
        <option value="" disabled selected>-</option>
        {f.fields.experienceOptions.map((opt) => (
          <option value={opt}>{opt}</option>
        ))}
      </select>
    </div>

    <p class="triage-form__privacy">{f.privacy}</p>

    <button class="btn-cta triage-form__submit" type="submit">
      {f.submit}
    </button>

    <p class="triage-form__success" aria-live="polite" hidden>
      {f.success}
    </p>
    <p class="triage-form__error" aria-live="assertive" hidden>
      {f.error}
    </p>
  </form>
</div>

<script>
  const form = document.querySelector<HTMLFormElement>(".triage-form");
  const success = document.querySelector<HTMLElement>(".triage-form__success");
  const error = document.querySelector<HTMLElement>(".triage-form__error");
  const btn = document.querySelector<HTMLButtonElement>(".triage-form__submit");

  if (form && success && error && btn) {
    const submitText = btn.textContent ?? "";

    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      btn.disabled = true;
      btn.textContent = btn.dataset.submitting ?? "...";

      try {
        const data = new FormData(form);
        const res = await fetch("/", {
          method: "POST",
          headers: { "Content-Type": "application/x-www-form-urlencoded" },
          body: new URLSearchParams(data as any).toString(),
        });

        if (res.ok) {
          // Disparar evento Lead no Meta Pixel
          if (typeof window !== "undefined" && (window as any).fbq) {
            (window as any).fbq("track", "Lead");
          }

          form.style.display = "none";
          success.hidden = false;
          success.focus();
        } else {
          throw new Error("Submission failed");
        }
      } catch {
        error.hidden = false;
        btn.disabled = false;
        btn.textContent = submitText;
      }
    });
  }
</script>

<style>
  .triage-form-wrap {
    background-color: var(--c-darkbg);
    border: var(--border-card);
    border-radius: var(--radius-card);
    padding: var(--space-6);
    max-width: 480px;
    width: 100%;
  }

  .triage-form__title {
    font-family: var(--font-display);
    font-size: var(--fs-display-sm);
    color: var(--c-lime);
    text-transform: uppercase;
    margin-bottom: var(--space-5);
  }

  .triage-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .triage-form__field {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .triage-form__label {
    font-family: var(--font-label);
    font-size: var(--fs-label);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--c-textsub);
  }

  .triage-form__input,
  .triage-form__select {
    background-color: var(--c-black);
    border: 1px solid #333;
    border-radius: 4px;
    color: var(--c-white);
    font-family: var(--font-body);
    font-size: var(--fs-body-md);
    padding: 0.75rem 1rem;
    transition: border-color var(--transition-base);
    width: 100%;
    appearance: none;
    -webkit-appearance: none;
  }

  .triage-form__input:focus,
  .triage-form__select:focus {
    outline: none;
    border-color: var(--c-lime);
  }

  .triage-form__input::placeholder {
    color: var(--c-textsub);
  }

  .triage-form__select option {
    background-color: var(--c-darkbg);
  }

  .triage-form__privacy {
    font-size: var(--fs-body-sm);
    color: var(--c-textsub);
    line-height: 1.5;
  }

  .triage-form__submit {
    width: 100%;
    margin-top: var(--space-2);
  }

  .triage-form__success {
    color: #27AE60;
    font-size: var(--fs-body-md);
    font-weight: 700;
    text-align: center;
    padding: var(--space-4);
  }

  .triage-form__error {
    color: #E74C3C;
    font-size: var(--fs-body-sm);
    text-align: center;
  }
</style>
