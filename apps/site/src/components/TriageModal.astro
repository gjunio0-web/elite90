// ============================================================
// HELPERS
// ============================================================
const isEnPage = document.documentElement.lang === "en";
let compressedFiles: File[] = [];

function parseDecimal(v: string): number {
  return parseFloat(v.replace(",", "."));
}

function getMsg(rule: typeof FIELD_RULES[0], val = ""): string {
  const msg = isEnPage ? rule.msgEn : rule.msgPt;
  return typeof msg === "function" ? msg(val) : msg;
}

function validaCPF(cpf: string): boolean {
  const c = cpf.replace(/\D/g, "");
  if (c.length !== 11 || /^(\d)\1{10}$/.test(c)) return false;
  let soma = 0;
  for (let i = 1; i <= 9; i++) soma += +c[i-1] * (11 - i);
  let r = (soma * 10) % 11;
  if (r === 10 || r === 11) r = 0;
  if (r !== +c[9]) return false;
  soma = 0;
  for (let i = 1; i <= 10; i++) soma += +c[i-1] * (12 - i);
  r = (soma * 10) % 11;
  if (r === 10 || r === 11) r = 0;
  return r === +c[10];
}

function showValidationToast(msg: string) {
  if ((window as any).toast) {
    (window as any).toast.show(msg, "error");
  }
}

function showSuccessToast(msg: string) {
  if ((window as any).toast) {
    (window as any).toast.show(msg, "success");
  }
}

// ============================================================
// CAMPOS CONDICIONAIS - gerenciamento centralizado
// ============================================================
function updateConditionals() {
  // 1. Condicionais por radio (data-cond-name / data-cond-value)
  document.querySelectorAll<HTMLElement>("fieldset[data-cond-name]").forEach(fs => {
    const name = fs.dataset.condName!;
    const value = fs.dataset.condValue!;
    const optional = fs.dataset.condOptional === "true";

    // Casos especiais tratados separadamente
    if (name.startsWith("__")) return;

    const checked = document.querySelector<HTMLInputElement>(
      `input[name="${name}"][value="${value}"]:checked`
    );
    const show = !!checked;
    fs.hidden = !show;
    fs.setAttribute("aria-hidden", String(!show));
    fs.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>("input:not([type=hidden]), textarea").forEach(inp => {
      if (!optional) inp.required = show;
    });
  });

  // 2. Condicional "Outra atividade" - checkbox especifico
  const actOther = document.getElementById("r-act-other") as HTMLInputElement | null;
  const condActOther = document.getElementById("cond-act-other") as HTMLElement | null;
  if (actOther && condActOther) {
    const show = actOther.checked;
    condActOther.hidden = !show;
    condActOther.setAttribute("aria-hidden", String(!show));
    const inp = condActOther.querySelector<HTMLInputElement>("input");
    if (inp) inp.required = show;
  }

  // 3. Condicional "Ha quanto tempo" - aparece se qualquer checkbox de atividade
  //    marcado, EXCETO "Nenhuma/None"
  const condDuration = document.getElementById("cond-act-duration") as HTMLElement | null;
  if (condDuration) {
    const anyActivity = Array.from(
      document.querySelectorAll<HTMLInputElement>('input[name="atividade_fisica"]:checked')
    ).some(cb => cb.value !== "Nenhuma" && cb.value !== "None");
    condDuration.hidden = !anyActivity;
    condDuration.setAttribute("aria-hidden", String(!anyActivity));
    const inp = condDuration.querySelector<HTMLInputElement>("input[type=text]");
    if (inp) inp.required = anyActivity;
  }
}

// ============================================================
// VALIDACAO UNIFICADA - unica fonte de verdade
// ============================================================
function validateAll(): boolean {
  const errors: Array<{ rule: typeof FIELD_RULES[0]; val: string }> = [];

  for (const rule of FIELD_RULES) {
    // Pular se dentro de fieldset condicional oculto
    if (rule.skipIfCondHidden) {
      const inp = document.getElementById(rule.inputId);
      if (inp?.closest("fieldset[data-cond-name]")?.hasAttribute("hidden")) {
        const errEl = document.getElementById(rule.errorId);
        if (errEl) errEl.hidden = true;
        continue;
      }
    }

    const inp = document.getElementById(rule.inputId) as HTMLInputElement | null;
    const val = rule.isGroup ? "" : (inp?.value ?? "");
    const valid = rule.validate(val);
    const errEl = document.getElementById(rule.errorId);

    if (!valid) {
      const msg = getMsg(rule, val);
      errors.push({ rule, val });
      if (errEl) {
        errEl.textContent = msg;
        errEl.hidden = false;
      }
    } else {
      if (errEl) errEl.hidden = true;
    }
  }

  if (errors.length > 0) {
    // Toast 1: primeiro erro
    showValidationToast(getMsg(errors[0].rule, errors[0].val));
    // Toast 2: resumo se multiplos
    if (errors.length > 1) {
      setTimeout(() => {
        showValidationToast(
          isEnPage
            ? `${errors.length} fields require attention.`
            : `${errors.length} campos precisam de atencao.`
        );
      }, 1400);
    }
    // Scroll ate o primeiro erro dentro do modal-body
    const firstEl = document.getElementById(errors[0].rule.inputId);
    const container = firstEl?.closest(".field") ?? firstEl;
    if (container) {
      const modalBody = document.getElementById("modal-body");
      if (modalBody) {
        const offset = (container as HTMLElement).offsetTop - 80;
        modalBody.scrollTo({ top: offset, behavior: "smooth" });
      }
    }
    return false;
  }
  return true;
}

// ============================================================
// VALIDACAO ON-BLUR (usa o mesmo FIELD_RULES)
// ============================================================
function attachBlurValidation(rule: typeof FIELD_RULES[0]) {
  if (rule.isGroup) return; // radio/checkbox nao tem blur individual
  const inp = document.getElementById(rule.inputId) as HTMLInputElement | null;
  const errEl = document.getElementById(rule.errorId);
  if (!inp || !errEl) return;

  inp.addEventListener("blur", () => {
    if (!inp.value.trim()) return; // nao mostrar erro em campo vazio nao tocado
    const valid = rule.validate(inp.value);
    errEl.textContent = valid ? "" : getMsg(rule, inp.value);
    errEl.hidden = valid;
  });

  inp.addEventListener("input", () => {
    if (!errEl.hidden) {
      const valid = rule.validate(inp.value);
      if (valid) errEl.hidden = true;
      else errEl.textContent = getMsg(rule, inp.value);
    }
  });
}

// Inicializa blur para todos os campos de texto
FIELD_RULES.forEach(rule => attachBlurValidation(rule));

