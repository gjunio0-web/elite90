// Decimais com virgula: sanitizacao + espelhamento em hidden field (ponto)
// autocomplete="off" ja definido no HTML - este bloco nao re-seta para preservar
// campos que usam autocomplete legitimamente (nome, email, bday)
const DECIMAL_IDS = ["f-height","f-weight","f-avail","f-water","f-act-duration"];
DECIMAL_IDS.forEach(id => {
  const inp = document.getElementById(id) as HTMLInputElement | null;
  if (!inp) return;

  const syncHidden = (value: string) => {
    const targetKey = inp.dataset.fieldTarget;
    if (!targetKey) return;
    const hidden = document.getElementById(`real-${targetKey}`) as HTMLInputElement | null;
    if (hidden) {
      const float = parseFloat(value.replace(",", "."));
      hidden.value = isNaN(float) ? "" : float.toString();
    }
  };

  inp.addEventListener("input", () => {
    // Permite apenas digitos e uma unica virgula
    let v = inp.value.replace(/[^0-9,]/g, "");
    const parts = v.split(",");
    if (parts.length > 2) v = parts[0] + "," + parts.slice(1).join("");
    inp.value = v;
    syncHidden(v);
  });

  // Previne autocomplete de sobrescrever a formatacao com ponto
  // (autocomplete="off" no HTML e o principal mecanismo;
  //  este listener e fallback para browsers que ignoram o atributo)
  inp.addEventListener("change", () => {
    // Normaliza: se o browser inseriu ponto (ex: via autofill), converte para virgula
    if (!isEnPage && inp.value.includes(".") && !inp.value.includes(",")) {
      inp.value = inp.value.replace(".", ",");
    }
    syncHidden(inp.value);
  });
});

