---
import type { Translations } from "../i18n/pt";
interface Props { t: Translations; }
const { t } = Astro.props;
const f = t.form;
const isEn = f.submit === "Request evaluation";
---

<div class="modal-overlay" id="triage-modal" role="dialog" aria-modal="true"
  aria-labelledby="modal-title" hidden>
  <div class="modal-container">

    <div class="modal-header">
      <div>
        <p class="modal-eyebrow">{t.ctaFinal.eyebrow}</p>
        <h2 class="modal-title" id="modal-title">{f.title}</h2>
      </div>
      <button class="modal-close" id="modal-close" type="button" aria-label="Fechar">x</button>
    </div>

    <div class="modal-body">
      <form class="triage-form" id="triage-form" novalidate>

        <!-- DADOS PESSOAIS -->
        <div class="form-section">
          <h3 class="form-section__title">{isEn ? "Personal Data" : "Dados Pessoais"}</h3>
          <div class="form-grid form-grid--2">
            <div class="field">
              <label class="field__label" for="f-name">
                {isEn ? "Full name" : "Nome completo"} <span class="field__req" aria-hidden="true">*</span>
              </label>
              <input class="field__input" type="text" id="f-name" name="nome" required autocomplete="name" />
            </div>
            <div class="field">
              <label class="field__label" for="f-cpf">CPF <span class="field__req" aria-hidden="true">*</span></label>
              <input class="field__input" type="text" id="f-cpf" name="cpf" required
                placeholder="000.000.000-00" maxlength="14" inputmode="numeric" />
            </div>
            <div class="field">
              <label class="field__label" for="f-dob">
                {isEn ? "Date of birth (DD/MM/YYYY)" : "Data de nascimento (DD/MM/AAAA)"}
                <span class="field__req" aria-hidden="true">*</span>
              </label>
              <input class="field__input" type="date" id="f-dob" name="data_nascimento" required
                placeholder="DD/MM/AAAA" />
            </div>
            <div class="field">
              <label class="field__label" for="f-email">
                E-mail <span class="field__req" aria-hidden="true">*</span>
              </label>
              <input class="field__input" type="email" id="f-email" name="email" required
                autocomplete="email" placeholder={isEn ? "your@email.com" : "seu@email.com"} />
              <p class="field__error" id="f-email-error" hidden>
                {isEn ? "Enter a valid e-mail address." : "Informe um e-mail valido."}
              </p>
            </div>
            <div class="field">
              <label class="field__label" for="f-height">
                {isEn ? "Height (in metres, e.g. 1.75)" : "Altura (em metros, ex: 1,75)"}
                <span class="field__req" aria-hidden="true">*</span>
              </label>
              <input class="field__input" type="number" id="f-height" name="altura" required
                min="1.00" max="2.50" step="0.01"
                placeholder={isEn ? "1.75" : "1,75"} />
              <p class="field__error" id="f-height-error" hidden>
                {isEn ? "Enter a value between 1.00 and 2.50 m." : "Informe um valor entre 1,00 e 2,50 m."}
              </p>
            </div>
            <div class="field">
              <label class="field__label" for="f-weight">
                {isEn ? "Weight (in kg, e.g. 85.5)" : "Peso (em kg, ex: 85,5)"}
                <span class="field__req" aria-hidden="true">*</span>
              </label>
              <input class="field__input" type="number" id="f-weight" name="peso" required
                min="30" max="300" step="0.1"
                placeholder={isEn ? "85.5" : "85,5"} />
              <p class="field__error" id="f-weight-error" hidden>
                {isEn ? "Enter a value between 30 and 300 kg." : "Informe um valor entre 30 e 300 kg."}
              </p>
            </div>
          </div>
        </div>

        <!-- IMERSAO DO ATLETA -->
        <div class="form-section">
          <h3 class="form-section__title">{isEn ? "Athlete Immersion" : "Imersao do Atleta"}</h3>
          <p class="form-section__intro">
            {isEn
              ? "Honest answers here shape your entire protocol."
              : "Bora mergulhar de cabeca no processo? Seja honesto - e o seu corpo, sua evolucao."}
          </p>

          <div class="form-stack">

            <!-- Q1: objetivo -->
            <div class="field">
              <span class="field__label">
                1. {isEn ? "What is your main goal with this coaching?" : "Qual o seu objetivo principal com esse acompanhamento?"}
                <span class="field__req" aria-hidden="true">*</span>
              </span>
              <div class="radio-group radio-group--vertical">
                {(isEn
                  ? ["Muscle gain","Fat loss","Body recomposition","Competition preparation","Improve general fitness","Other"]
                  : ["Ganho de massa muscular","Perda de gordura","Recomposicao corporal","Preparacao para competicao","Melhorar condicionamento geral","Outro"]
                ).map((opt, i, arr) => (
                  <label class="radio-label">
                    <input type="radio" name="objetivo" value={opt}
                      id={i === arr.length - 1 ? "r-goal-other" : undefined}
                      required />
                    {opt}
                  </label>
                ))}
              </div>
              <div class="field field--conditional" id="cond-goal-other" hidden>
                <label class="field__label" for="f-goal-other">
                  {isEn ? "Describe your goal:" : "Descreva seu objetivo:"} <span class="field__req">*</span>
                </label>
                <textarea class="field__input field__textarea" id="f-goal-other"
                  name="objetivo_outro" rows="2"></textarea>
              </div>
            </div>

            <!-- Q2a: qual atividade -->
            <div class="field">
              <span class="field__label">
                2. {isEn ? "Do you currently practice any physical activity? If so, which?" : "Atualmente pratica alguma atividade fisica? Se sim, qual?"}
                <span class="field__req" aria-hidden="true">*</span>
              </span>
              <div class="radio-group radio-group--vertical">
                {(isEn
                  ? ["Weight training","CrossFit","Running","Swimming","Martial arts","Cycling","Other","None"]
                  : ["Musculacao","CrossFit","Corrida","Natacao","Artes marciais","Ciclismo","Outra","Nenhuma"]
                ).map((opt, i, arr) => (
                  <label class="radio-label">
                    <input type="radio" name="atividade_fisica" value={opt}
                      id={i === arr.length - 2 ? "r-act-other" : undefined}
                      required />
                    {opt}
                  </label>
                ))}
              </div>
              <div class="field field--conditional" id="cond-act-other" hidden>
                <label class="field__label" for="f-act-other">
                  {isEn ? "Which activity?" : "Qual atividade?"}
                </label>
                <input class="field__input" type="text" id="f-act-other" name="atividade_outra" />
              </div>
            </div>

            <!-- Q2b: ha quanto tempo -->
            <div class="field">
              <label class="field__label" for="f-act-duration">
                {isEn ? "How long? (in years, e.g. 2.5)" : "Ha quanto tempo? (em anos, ex: 2,5)"}
              </label>
              <input class="field__input" type="number" id="f-act-duration"
                name="tempo_atividade" min="0" max="50" step="0.5"
                placeholder={isEn ? "2.5" : "2,5"} />
            </div>

            <div class="form-grid form-grid--2">
              <div class="field">
                <label class="field__label" for="f-freq">
                  3. {isEn ? "How many times per week do you plan to train?" : "Pretende treinar quantas vezes por semana?"}
                  <span class="field__req" aria-hidden="true">*</span>
                </label>
                <input class="field__input" type="number" id="f-freq"
                  name="frequencia_semanal" required min="1" max="7" />
              </div>
              <div class="field">
                <label class="field__label" for="f-avail">
                  4. {isEn ? "Daily time available for training?" : "Disponibilidade diaria de tempo para treinos?"}
                  <span class="field__req" aria-hidden="true">*</span>
                </label>
                <input class="field__input" type="text" id="f-avail"
                  name="disponibilidade_diaria" required
                  placeholder={isEn ? "e.g. 1h30" : "ex: 1h30"} />
              </div>
            </div>

            <div class="field">
              <span class="field__label">
                5. {isEn ? "Do you train with a personal trainer?" : "Treina com personal trainer?"}
                <span class="field__req" aria-hidden="true">*</span>
              </span>
              <div class="radio-group">
                <label class="radio-label"><input type="radio" name="personal_trainer" value="SIM" required /> {isEn ? "YES" : "SIM"}</label>
                <label class="radio-label"><input type="radio" name="personal_trainer" value="NAO" /> {isEn ? "NO" : "NAO"}</label>
              </div>
            </div>

            <div class="field">
              <span class="field__label">
                6. {isEn ? "Have you competed before?" : "Ja participou de alguma competicao?"}
              </span>
              <div class="radio-group">
                <label class="radio-label"><input type="radio" name="competicao" value="SIM" id="r-comp-sim" /> {isEn ? "YES" : "SIM"}</label>
                <label class="radio-label"><input type="radio" name="competicao" value="NAO" /> {isEn ? "NO" : "NAO"}</label>
              </div>
            </div>
            <div class="field field--conditional" id="cond-comp" hidden>
              <label class="field__label" for="f-comp-detail">
                {isEn ? "If yes, which category and year?" : "Se sim, qual modalidade e ano?"}
              </label>
              <input class="field__input" type="text" id="f-comp-detail" name="competicao_detalhe" />
            </div>

            <div class="field">
              <span class="field__label">
                7. {isEn ? "Do you know or follow a bodybuilding coach's work?" : "Ja conhece ou acompanha o trabalho de um coach bodybuilding?"}
                <span class="field__req" aria-hidden="true">*</span>
              </span>
              <div class="radio-group">
                <label class="radio-label"><input type="radio" name="conhece_coach" value="SIM" required /> {isEn ? "YES" : "SIM"}</label>
                <label class="radio-label"><input type="radio" name="conhece_coach" value="NAO" /> {isEn ? "NO" : "NAO"}</label>
              </div>
            </div>

            <div class="field">
              <span class="field__label">
                8. {isEn ? "Do you see a sports medicine doctor?" : "Faz acompanhamento com medico do esporte?"}
                <span class="field__req" aria-hidden="true">*</span>
              </span>
              <div class="radio-group">
                <label class="radio-label"><input type="radio" name="medico_esporte" value="SIM" required /> {isEn ? "YES" : "SIM"}</label>
                <label class="radio-label"><input type="radio" name="medico_esporte" value="NAO" /> {isEn ? "NO" : "NAO"}</label>
              </div>
            </div>

            <div class="field">
              <span class="field__label">
                9. {isEn ? "Have you done or are you doing TRT?" : "Ja fez ou esta fazendo reposicao hormonal (TRT)?"}
                <span class="field__req" aria-hidden="true">*</span>
              </span>
              <div class="radio-group">
                <label class="radio-label"><input type="radio" name="trt" value="SIM" id="r-trt-sim" required /> {isEn ? "YES" : "SIM"}</label>
                <label class="radio-label"><input type="radio" name="trt" value="NAO" /> {isEn ? "NO" : "NAO"}</label>
              </div>
            </div>
            <div class="field field--conditional" id="cond-trt" hidden>
              <label class="field__label" for="f-trt-detail">
                10. {isEn ? "Which hormones and at what frequency?" : "Quais hormonios e em qual frequencia?"}
              </label>
              <textarea class="field__input field__textarea" id="f-trt-detail"
                name="trt_detalhe" rows="2"></textarea>
            </div>
          </div>
        </div>

        <!-- HISTORICO DE SAUDE -->
        <div class="form-section">
          <h3 class="form-section__title">{isEn ? "Health History" : "Historico de Saude"}</h3>
          <div class="form-stack">

            <div class="field">
              <label class="field__label" for="f-cardiac">
                11. {isEn
                  ? "Do you have any cardiac condition? (hypertension, arrhythmia, pacemaker, angina, etc.)"
                  : "Possui alguma condicao cardiaca? (hipertensao, arritmia, uso de marcapasso, angina, etc.)"}
                <span class="field__req" aria-hidden="true">*</span>
              </label>
              <textarea class="field__input field__textarea" id="f-cardiac"
                name="condicao_cardiaca" required rows="2"
                placeholder={isEn ? "None / describe if applicable" : "Nenhuma / descreva se houver"}></textarea>
            </div>

            <div class="field">
              <span class="field__label">
                12. {isEn ? "Do you have diabetes?" : "Possui diabetes?"}
                <span class="field__req" aria-hidden="true">*</span>
              </span>
              <div class="radio-group">
                <label class="radio-label"><input type="radio" name="diabetes" value="SIM" required /> {isEn ? "YES" : "SIM"}</label>
                <label class="radio-label"><input type="radio" name="diabetes" value="NAO" /> {isEn ? "NO" : "NAO"}</label>
              </div>
            </div>

            <div class="field">
              <label class="field__label" for="f-chronic">
                13. {isEn ? "Do you have any pre-existing or chronic disease?" : "Tem alguma doenca pre-existente ou cronica?"}
                <span class="field__req" aria-hidden="true">*</span>
              </label>
              <textarea class="field__input field__textarea" id="f-chronic"
                name="doenca_cronica" required rows="2"
                placeholder={isEn ? "None / describe if applicable" : "Nenhuma / descreva se houver"}></textarea>
            </div>

            <div class="field">
              <span class="field__label">
                14. {isEn ? "Have you had a muscle or joint injury?" : "Ja teve lesao muscular ou articular?"}
                <span class="field__req" aria-hidden="true">*</span>
              </span>
              <div class="radio-group">
                <label class="radio-label"><input type="radio" name="lesao" value="SIM" id="r-lesao-sim" required /> {isEn ? "YES" : "SIM"}</label>
                <label class="radio-label"><input type="radio" name="lesao" value="NAO" /> {isEn ? "NO" : "NAO"}</label>
              </div>
            </div>
            <div class="field field--conditional" id="cond-lesao" hidden>
              <label class="field__label" for="f-lesao-detail">
                {isEn ? "Which injury? Was surgery needed?" : "Qual lesao? Houve necessidade cirurgica?"}
              </label>
              <textarea class="field__input field__textarea" id="f-lesao-detail"
                name="lesao_detalhe" rows="2"></textarea>
            </div>
          </div>
        </div>

        <!-- ROTINA ALIMENTAR -->
        <div class="form-section">
          <h3 class="form-section__title">{isEn ? "Diet and Supplementation" : "Rotina Alimentar e Suplementacao"}</h3>
          <div class="form-stack">

            <div class="field">
              <span class="field__label">
                15. {isEn ? "Do you currently follow a diet?" : "Atualmente segue alguma dieta?"}
                <span class="field__req" aria-hidden="true">*</span>
              </span>
              <div class="radio-group radio-group--vertical">
                {(isEn
                  ? ["Yes, with professional guidance","Yes, on my own","No diet"]
                  : ["Sim, com acompanhamento profissional","Sim, por conta propria","Nao sigo dieta"]
                ).map(opt => (
                  <label class="radio-label">
                    <input type="radio" name="dieta" value={opt} required />
                    {opt}
                  </label>
                ))}
              </div>
            </div>

            <div class="form-grid form-grid--2">
              <div class="field">
                <label class="field__label" for="f-meals">
                  16. {isEn ? "How many meals per day on average?" : "Em media, quantas refeicoes por dia?"}
                  <span class="field__req" aria-hidden="true">*</span>
                </label>
                <input class="field__input" type="number" id="f-meals"
                  name="refeicoes_dia" required min="1" max="12" />
              </div>
              <div class="field">
                <label class="field__label" for="f-water">
                  18. {isEn ? "Litres of water per day on average?" : "Em media, quantos litros de agua por dia?"}
                  <span class="field__req" aria-hidden="true">*</span>
                </label>
                <input class="field__input" type="number" id="f-water"
                  name="agua_litros" required min="0" max="20" step="0.5"
                  placeholder={isEn ? "2.5" : "2,5"} />
              </div>
            </div>

            <div class="field">
              <span class="field__label">
                17. {isEn ? "Do you use supplements?" : "Usa suplementos?"}
                <span class="field__req" aria-hidden="true">*</span>
              </span>
              <div class="radio-group">
                <label class="radio-label"><input type="radio" name="suplementos" value="SIM" id="r-supl-sim" required /> {isEn ? "YES" : "SIM"}</label>
                <label class="radio-label"><input type="radio" name="suplementos" value="NAO" /> {isEn ? "NO" : "NAO"}</label>
              </div>
            </div>
            <div class="field field--conditional" id="cond-supl" hidden>
              <label class="field__label" for="f-supl-detail">
                {isEn ? "Which supplements?" : "Se sim, quais:"}
              </label>
              <textarea class="field__input field__textarea" id="f-supl-detail"
                name="suplementos_detalhe" rows="2"></textarea>
            </div>
          </div>
        </div>

        <!-- AVALIACAO FISICA VISUAL -->
        <div class="form-section">
          <h3 class="form-section__title">{isEn ? "Visual Physical Assessment" : "Avaliacao Fisica Visual"}</h3>
          <p class="form-section__intro">
            {isEn ? "Upload up to 5 photos (max 10 MB each). They will be compressed automatically." : "Envie ate 5 fotos (max 10 MB cada). Elas serao comprimidas automaticamente."}
          </p>
          <div class="field">
            <label class="field__label field__label--file" for="f-photos">
              + {isEn ? "Add photos" : "Adicionar fotos"}
            </label>
            <input class="field__file" type="file" id="f-photos" name="fotos"
              accept="image/*" multiple />
            <div class="file-preview" id="file-preview" hidden></div>
            <div class="toast-area" id="toast-area"></div>
          </div>
        </div>

        <div class="form-footer">
          <p class="form-privacy">{f.privacy}</p>
          <button class="btn-cta form-submit" type="submit" id="form-submit-btn">
            {f.submit}
          </button>
          <p class="form-error" id="form-error" hidden role="alert"></p>
        </div>
      </form>

      <div class="form-success" id="form-success" hidden tabindex="-1">
        <div class="form-success__icon" aria-hidden="true">OK</div>
        <h3 class="form-success__title">
          {isEn ? "Application received." : "Ficha recebida."}
        </h3>
        <p class="form-success__message">
          {isEn
            ? "Your application is under review. You will be contacted within 48 hours."
            : "Sua solicitacao esta em analise. Em ate 48 horas voce recebera um contato."}
        </p>
        <p class="form-success__sub">
          {isEn ? "Limited spots per cycle. Your application is in the queue." : "Vagas limitadas por ciclo. Sua ficha esta na fila de analise."}
        </p>
        <button class="btn-cta" type="button" id="success-close">
          {isEn ? "Close" : "Fechar"}
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  // -- Modal open/close --
  const modal   = document.getElementById("triage-modal") as HTMLElement;
  const success = document.getElementById("form-success") as HTMLElement;
  const errorEl = document.getElementById("form-error") as HTMLElement;
  const submitBtn = document.getElementById("form-submit-btn") as HTMLButtonElement;
  const form    = document.getElementById("triage-form") as HTMLFormElement;

  function openModal() {
    if (!modal) return;
    modal.hidden = false;
    document.body.style.overflow = "hidden";
    (modal.querySelector(".modal-close") as HTMLElement)?.focus();
  }

  function closeModal() {
    if (!modal) return;
    modal.hidden = true;
    document.body.style.overflow = "";
  }

  document.addEventListener("open-triage-modal", openModal);
  document.getElementById("modal-close")?.addEventListener("click", closeModal);
  document.getElementById("success-close")?.addEventListener("click", closeModal);
  modal?.addEventListener("click", e => { if (e.target === modal) closeModal(); });
  document.addEventListener("keydown", e => { if (e.key === "Escape" && modal && !modal.hidden) closeModal(); });

  // -- CTAs -> open modal --
  document.querySelectorAll<HTMLElement>(
    "#header-cta-btn, #drawer-cta-btn, .hero__cta, .motivational__cta, .cta-final__btn"
  ).forEach(btn => {
    btn.addEventListener("click", e => {
      e.preventDefault();
      document.dispatchEvent(new CustomEvent("open-triage-modal"));
    });
  });

  // -- Conditional fields --
  function conditional(radioName: string, condId: string, inputSel: string, optional = false) {
    const radios = document.querySelectorAll<HTMLInputElement>(`input[name="${radioName}"]`);
    const cond = document.getElementById(condId) as HTMLElement | null;
    const input = cond?.querySelector<HTMLInputElement | HTMLTextAreaElement>(inputSel);
    radios.forEach(r => r.addEventListener("change", () => {
      const show = r.value === "SIM" && r.checked;
      if (cond) cond.hidden = !show;
      if (input && !optional) input.required = show;
    }));
  }

  conditional("competicao",  "cond-comp",       "input", true);  // optional
  conditional("trt",         "cond-trt",         "textarea");
  conditional("lesao",       "cond-lesao",       "textarea", true);
  conditional("suplementos", "cond-supl",        "textarea", true);

  // Goal "other" conditional
  document.getElementById("r-goal-other")?.addEventListener("change", function() {
    const cond = document.getElementById("cond-goal-other") as HTMLElement;
    const inp = document.getElementById("f-goal-other") as HTMLTextAreaElement;
    const show = (this as HTMLInputElement).checked;
    cond.hidden = !show;
    inp.required = show;
  });
  document.querySelectorAll<HTMLInputElement>('input[name="objetivo"]').forEach(r => {
    if (r.id !== "r-goal-other") {
      r.addEventListener("change", () => {
        const cond = document.getElementById("cond-goal-other") as HTMLElement;
        const inp = document.getElementById("f-goal-other") as HTMLTextAreaElement;
        cond.hidden = true;
        inp.required = false;
      });
    }
  });

  // Activity "other" conditional
  document.getElementById("r-act-other")?.addEventListener("change", function() {
    const cond = document.getElementById("cond-act-other") as HTMLElement;
    const show = (this as HTMLInputElement).checked;
    cond.hidden = !show;
  });
  document.querySelectorAll<HTMLInputElement>('input[name="atividade_fisica"]').forEach(r => {
    if (r.id !== "r-act-other") {
      r.addEventListener("change", () => {
        const cond = document.getElementById("cond-act-other") as HTMLElement;
        cond.hidden = true;
      });
    }
  });

  // -- CPF mask --
  const cpfInput = document.getElementById("f-cpf") as HTMLInputElement;
  cpfInput?.addEventListener("input", () => {
    let v = cpfInput.value.replace(/\D/g, "").slice(0, 11);
    if (v.length > 9) v = v.replace(/(\d{3})(\d{3})(\d{3})(\d{1,2})/, "$1.$2.$3-$4");
    else if (v.length > 6) v = v.replace(/(\d{3})(\d{3})(\d{1,3})/, "$1.$2.$3");
    else if (v.length > 3) v = v.replace(/(\d{3})(\d{1,3})/, "$1.$2");
    cpfInput.value = v;
  });

  // -- Email validation --
  const emailInput = document.getElementById("f-email") as HTMLInputElement;
  const emailError = document.getElementById("f-email-error") as HTMLElement;
  emailInput?.addEventListener("blur", () => {
    const valid = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(emailInput.value);
    if (emailError) emailError.hidden = valid || !emailInput.value;
  });

  // -- Height/weight validation feedback --
  ["f-height", "f-weight"].forEach(id => {
    const inp = document.getElementById(id) as HTMLInputElement;
    const err = document.getElementById(`${id}-error`) as HTMLElement;
    inp?.addEventListener("blur", () => {
      if (!err) return;
      err.hidden = inp.validity.valid || !inp.value;
    });
  });

  // -- Image compression + toast --
  const fileInput = document.getElementById("f-photos") as HTMLInputElement;
  const filePreview = document.getElementById("file-preview") as HTMLElement;
  const toastArea = document.getElementById("toast-area") as HTMLElement;
  let compressedFiles: File[] = [];

  function showToast(msg: string) {
    const toast = document.createElement("div");
    toast.className = "compress-toast";
    toast.textContent = msg;
    toastArea.appendChild(toast);
    setTimeout(() => { toast.classList.add("compress-toast--out"); }, 3200);
    setTimeout(() => toast.remove(), 3800);
  }

  async function compressImage(file: File): Promise<File> {
    return new Promise((resolve) => {
      const img = new Image();
      const url = URL.createObjectURL(file);
      img.onload = () => {
        URL.revokeObjectURL(url);
        const MAX = 1200;
        let { width, height } = img;
        if (width > MAX || height > MAX) {
          if (width > height) { height = Math.round(height * MAX / width); width = MAX; }
          else { width = Math.round(width * MAX / height); height = MAX; }
        }
        const canvas = document.createElement("canvas");
        canvas.width = width; canvas.height = height;
        const ctx = canvas.getContext("2d")!;
        ctx.drawImage(img, 0, 0, width, height);
        canvas.toBlob(blob => {
          if (!blob) { resolve(file); return; }
          const compressed = new File([blob], file.name.replace(/\.[^.]+$/, ".webp"), { type: "image/webp" });
          const pct = Math.round((1 - blob.size / file.size) * 100);
          const origKB = (file.size / 1024).toFixed(0);
          const newKB  = (blob.size / 1024).toFixed(0);
          showToast(`${file.name}: ${origKB} KB -> ${newKB} KB (${pct}% menor)`);
          resolve(compressed);
        }, "image/webp", 0.82);
      };
      img.src = url;
    });
  }

  fileInput?.addEventListener("change", async () => {
    const files = Array.from(fileInput.files ?? []);
    if (!files.length) return;
    compressedFiles = [];
    filePreview.innerHTML = "";
    filePreview.hidden = false;

    for (const file of files.slice(0, 5)) {
      const compressed = await compressImage(file);
      compressedFiles.push(compressed);
      const url = URL.createObjectURL(compressed);
      const img = document.createElement("img");
      img.src = url; img.className = "file-preview__img";
      img.alt = compressed.name;
      filePreview.appendChild(img);
    }
  });

  // -- Submit --
  form?.addEventListener("submit", async e => {
    e.preventDefault();
    if (!form.checkValidity()) { form.reportValidity(); return; }

    submitBtn.disabled = true;
    submitBtn.textContent = "...";
    if (errorEl) errorEl.hidden = true;

    try {
      const data = new FormData(form);
      // Replace file input with compressed files
      data.delete("fotos");
      compressedFiles.forEach(f => data.append("fotos", f));

      const res = await fetch("/.netlify/functions/submit-lead", {
        method: "POST",
        body: data,
      });

      if (!res.ok) throw new Error(await res.text());

      form.hidden = true;
      if (success) { success.hidden = false; success.focus(); }

      if (typeof window !== "undefined" && (window as any).fbq) {
        (window as any).fbq("track", "Lead");
      }
    } catch {
      if (errorEl) {
        errorEl.textContent = "Erro ao enviar. Tente novamente.";
        errorEl.hidden = false;
      }
      submitBtn.disabled = false;
      submitBtn.textContent = submitBtn.dataset.label ?? "Solicitar avaliacao";
    }
  });

  // -- Sticky CTA: hide when #triagem visible --
  const stickyCta = document.getElementById("sticky-cta");
  const triagemSection = document.getElementById("triagem");
  if (stickyCta && triagemSection) {
    const obs = new IntersectionObserver(entries => {
      entries.forEach(entry => {
        stickyCta.style.opacity = entry.isIntersecting ? "0" : "";
        stickyCta.style.pointerEvents = entry.isIntersecting ? "none" : "";
      });
    }, { threshold: 0.1 });
    obs.observe(triagemSection);
  }
</script>

