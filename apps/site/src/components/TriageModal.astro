---
import type { Translations } from "../i18n/pt";
import type { Locale } from "../i18n/utils";

interface Props { t: Translations; locale?: Locale; }
const { t, locale = "pt-br" } = Astro.props;
const f = t.form;
const isEn = locale === "en";
---

<div class="modal-overlay" id="triage-modal" role="dialog" aria-modal="true"
  aria-labelledby="modal-title" hidden>
  <div class="modal-container">

    <div class="modal-header">
      <div>
        <p class="modal-eyebrow">{t.ctaFinal.eyebrow}</p>
        <h2 class="modal-title" id="modal-title">{f.title}</h2>
      </div>
      <button class="modal-close" id="modal-close" type="button" aria-label="Fechar">&#x2715;</button>
    </div>

    <div class="modal-body" id="modal-body">

      <!-- SUCESSO: oculto por padrao, exibido apenas apos envio bem-sucedido -->
      <div class="form-success" id="form-success" hidden tabindex="-1">
        <div class="form-success__icon" aria-hidden="true">&#x2713;</div>
        <h3 class="form-success__title">
          {isEn ? "Application received." : "Ficha recebida."}
        </h3>
        <p class="form-success__message">
          {isEn
            ? "Your application is under review. You will be contacted within 48 hours."
            : "Sua solicitacao esta em analise. Em ate 48 horas voce recebera um contato."}
        </p>
        <p class="form-success__sub">
          {isEn
            ? "Limited spots per cycle. Your application is in the queue."
            : "Vagas limitadas por ciclo. Sua ficha esta na fila de analise."}
        </p>
        <button class="btn-cta" type="button" id="success-close">
          {isEn ? "Close" : "Fechar"}
        </button>
      </div>

      <!-- FORMULARIO -->
      <form class="triage-form" id="triage-form" novalidate>

        <!-- DADOS PESSOAIS -->
        <div class="form-section">
          <h3 class="form-section__title">{isEn ? "Personal Data" : "Dados Pessoais"}</h3>
          <div class="form-grid form-grid--2">

            <div class="field">
              <label class="field__label" for="f-name">
                {isEn ? "Full name" : "Nome completo"} <span class="field__req">*</span>
              </label>
              <input class="field__input" type="text" id="f-name" name="nome"
                autocomplete="name" />
              <p class="field__error" id="f-name-error" hidden></p>
            </div>

            <div class="field">
              <label class="field__label" for="f-cpf">
                CPF <span class="field__req">*</span>
              </label>
              <input class="field__input" type="text" id="f-cpf" name="cpf"
                placeholder="000.000.000-00" maxlength="14" inputmode="numeric"
                autocomplete="off" />
              <p class="field__error" id="f-cpf-error" hidden></p>
            </div>

            <div class="field">
              <label class="field__label" for="f-dob">
                {isEn ? "Date of birth (DD/MM/YYYY)" : "Data de nascimento (DD/MM/AAAA)"}
                <span class="field__req">*</span>
              </label>
              {isEn
                ? <input class="field__input" type="date" id="f-dob"
                    name="data_nascimento" autocomplete="bday" />
                : <input class="field__input" type="text" id="f-dob"
                    name="data_nascimento" placeholder="DD/MM/AAAA"
                    maxlength="10" inputmode="numeric" autocomplete="off" />
              }
              <p class="field__error" id="f-dob-error" hidden></p>
            </div>

            <div class="field">
              <label class="field__label" for="f-email">
                E-mail <span class="field__req">*</span>
              </label>
              <input class="field__input" type="email" id="f-email" name="email"
                autocomplete="email"
                placeholder={isEn ? "your@email.com" : "seu@email.com"} />
              <p class="field__error" id="f-email-error" hidden></p>
            </div>

            <div class="field">
              <label class="field__label" for="f-height">
                {isEn ? "Height (metres, e.g. 1.75)" : "Altura (metros, ex: 1,75)"}
                <span class="field__req">*</span>
              </label>
              <input class="field__input" type="text" id="f-height"
                name="altura_visual" inputmode="decimal"
                placeholder={isEn ? "1.75" : "1,75"}
                autocomplete="off"
                data-field-target="altura" />
              <input type="hidden" id="real-altura" name="altura" />
              <p class="field__error" id="f-height-error" hidden></p>
            </div>

            <div class="field">
              <label class="field__label" for="f-weight">
                {isEn ? "Weight (kg, e.g. 85.5)" : "Peso (kg, ex: 85,5)"}
                <span class="field__req">*</span>
              </label>
              <input class="field__input" type="text" id="f-weight"
                name="peso_visual" inputmode="decimal"
                placeholder={isEn ? "85.5" : "85,5"}
                autocomplete="off"
                data-field-target="peso" />
              <input type="hidden" id="real-peso" name="peso" />
              <p class="field__error" id="f-weight-error" hidden></p>
            </div>

          </div>
        </div>

        <!-- IMERSAO DO ATLETA -->
        <div class="form-section">
          <h3 class="form-section__title">{isEn ? "Athlete Immersion" : "Imersao do Atleta"}</h3>
          <p class="form-section__intro">
            {isEn
              ? "Honest answers shape your entire protocol."
              : "Bora mergulhar de cabeca no processo? Seja honesto - e o seu corpo, sua evolucao."}
          </p>

          <div class="form-stack">

            <!-- Q1: objetivo -->
            <div class="field">
              <span class="field__label">
                1. {isEn
                  ? "What is your main goal with this coaching?"
                  : "Qual o seu objetivo principal com esse acompanhamento?"}
                <span class="field__req">*</span>
              </span>
              <div class="radio-group radio-group--vertical" id="group-objetivo">
                {(isEn
                  ? ["Muscle gain","Fat loss","Body recomposition","Competition preparation","Improve general fitness","Other"]
                  : ["Ganho de massa muscular","Perda de gordura","Recomposicao corporal","Preparacao para competicao","Melhorar condicionamento geral","Outro"]
                ).map((opt, i, arr) => (
                  <label class="radio-label">
                    <input type="radio" name="objetivo" value={opt}
                      id={i === arr.length - 1 ? "r-goal-other" : undefined} />
                    {opt}
                  </label>
                ))}
              </div>
              <p class="field__error" id="f-objetivo-error" hidden></p>
              <!-- Condicional: aparece se "Outro/Other" selecionado -->
              <fieldset class="field field--cond" id="cond-goal-other"
                data-cond-name="objetivo"
                data-cond-value={isEn ? "Other" : "Outro"}
                hidden aria-hidden="true">
                <label class="field__label" for="f-goal-other">
                  {isEn ? "Describe your goal:" : "Descreva seu objetivo:"}
                </label>
                <textarea class="field__input field__textarea" id="f-goal-other"
                  name="objetivo_outro" rows="2" autocomplete="off"></textarea>
                <p class="field__error" id="f-goal-other-error" hidden></p>
              </fieldset>
            </div>

            <!-- Q2: atividade fisica -->
            <div class="field">
              <span class="field__label">
                2. {isEn
                  ? "Do you currently practice any physical activity? If so, which?"
                  : "Atualmente pratica alguma atividade fisica? Se sim, qual?"}
                <span class="field__req">*</span>
              </span>
              <div class="radio-group radio-group--vertical" id="activity-group">
                {(isEn
                  ? ["Weight training","CrossFit","Running","Swimming","Martial arts","Cycling","None"]
                  : ["Musculacao","CrossFit","Corrida","Natacao","Artes marciais","Ciclismo","Nenhuma"]
                ).map((opt) => (
                  <label class="radio-label">
                    <input type="checkbox" name="atividade_fisica" value={opt}
                      class="activity-check" />
                    {opt}
                  </label>
                ))}
                <label class="radio-label">
                  <input type="checkbox" name="atividade_fisica"
                    value={isEn ? "Other" : "Outra"}
                    id="r-act-other" class="activity-check" />
                  {isEn ? "Other" : "Outra"}
                </label>
              </div>
              <p class="field__error" id="f-activity-error" hidden></p>
              <!-- Condicional "Outra": aparece se checkbox "Outra" marcado -->
              <fieldset class="field field--cond" id="cond-act-other"
                data-cond-name="__act-other-checkbox"
                data-cond-value="checked"
                hidden aria-hidden="true">
                <label class="field__label" for="f-act-other">
                  {isEn ? "Which activity?" : "Qual atividade?"}
                  <span class="field__req">*</span>
                </label>
                <input class="field__input" type="text" id="f-act-other"
                  name="atividade_outra" autocomplete="off" />
                <p class="field__error" id="f-act-other-error" hidden></p>
              </fieldset>
            </div>

            <!-- Q3: há quanto tempo (condicional: so se alguma atividade marcada, exceto Nenhuma) -->
            <fieldset class="field field--cond" id="cond-act-duration"
              data-cond-name="__activity-any"
              data-cond-value="yes"
              hidden aria-hidden="true">
              <label class="field__label" for="f-act-duration">
                3. {isEn ? "How long? (years, e.g. 2.5)" : "Ha quanto tempo? (anos, ex: 2,5)"}
                <span class="field__req">*</span>
              </label>
              <input class="field__input" type="text" id="f-act-duration"
                name="tempo_atividade" inputmode="decimal"
                placeholder={isEn ? "2.5" : "2,5"}
                autocomplete="off"
                data-field-target="tempo_atividade" />
              <input type="hidden" id="real-tempo_atividade" name="tempo_atividade_float" />
              <p class="field__error" id="f-act-duration-error" hidden></p>
            </fieldset>

            <div class="form-grid form-grid--2">
              <div class="field">
                <label class="field__label" for="f-freq">
                  4. {isEn
                    ? "How many times per week do you plan to train?"
                    : "Pretende treinar quantas vezes por semana?"}
                  <span class="field__req">*</span>
                </label>
                <input class="field__input" type="text" id="f-freq"
                  name="frequencia_semanal"
                  inputmode="numeric" placeholder="4"
                  autocomplete="off" />
                <p class="field__error" id="f-freq-error" hidden></p>
              </div>
              <div class="field">
                <label class="field__label" for="f-avail">
                  5. {isEn
                    ? "Daily hours available for training?"
                    : "Disponibilidade diária de horas para treinos?"}
                  <span class="field__req">*</span>
                </label>
                <input class="field__input" type="text" id="f-avail"
                  name="disponibilidade_diaria" inputmode="decimal"
                  placeholder={isEn ? "1.5" : "1,5"}
                  autocomplete="off"
                  data-field-target="disponibilidade_diaria" />
                <input type="hidden" id="real-disponibilidade_diaria" name="disponibilidade_diaria_float" />
                <p class="field__error" id="f-avail-error" hidden></p>
              </div>
            </div>

            <div class="field">
              <span class="field__label">
                6. {isEn ? "Do you train with a personal trainer?" : "Treina com personal trainer?"}
                <span class="field__req">*</span>
              </span>
              <div class="radio-group">
                <label class="radio-label"><input type="radio" name="personal_trainer" value="SIM" /> {isEn ? "YES" : "SIM"}</label>
                <label class="radio-label"><input type="radio" name="personal_trainer" value="NAO" /> {isEn ? "NO" : "NAO"}</label>
              </div>
              <p class="field__error" id="f-personal-error" hidden></p>
            </div>

            <div class="field">
              <span class="field__label">
                7. {isEn ? "Have you competed before?" : "Ja participou de alguma competicao?"}
              </span>
              <div class="radio-group">
                <label class="radio-label"><input type="radio" name="competicao" value="SIM" /> {isEn ? "YES" : "SIM"}</label>
                <label class="radio-label"><input type="radio" name="competicao" value="NAO" /> {isEn ? "NO" : "NAO"}</label>
              </div>
              <!-- Condicional: aparece se SIM, mas NAO é obrigatório -->
              <fieldset class="field field--cond" id="cond-comp"
                data-cond-name="competicao"
                data-cond-value="SIM"
                data-cond-optional="true"
                hidden aria-hidden="true">
                <label class="field__label" for="f-comp-detail">
                  {isEn ? "Which category and year?" : "Qual modalidade e ano?"}
                </label>
                <input class="field__input" type="text" id="f-comp-detail"
                  name="competicao_detalhe" autocomplete="off" />
              </fieldset>
            </div>

            <div class="field">
              <span class="field__label">
                8. {isEn
                  ? "Do you know or follow a bodybuilding coach?"
                  : "Ja conhece ou acompanha o trabalho de um coach bodybuilding?"}
                <span class="field__req">*</span>
              </span>
              <div class="radio-group">
                <label class="radio-label"><input type="radio" name="conhece_coach" value="SIM" /> {isEn ? "YES" : "SIM"}</label>
                <label class="radio-label"><input type="radio" name="conhece_coach" value="NAO" /> {isEn ? "NO" : "NAO"}</label>
              </div>
              <p class="field__error" id="f-coach-error" hidden></p>
            </div>

            <div class="field">
              <span class="field__label">
                9. {isEn ? "Do you see a sports medicine doctor?" : "Faz acompanhamento com medico do esporte?"}
                <span class="field__req">*</span>
              </span>
              <div class="radio-group">
                <label class="radio-label"><input type="radio" name="medico_esporte" value="SIM" /> {isEn ? "YES" : "SIM"}</label>
                <label class="radio-label"><input type="radio" name="medico_esporte" value="NAO" /> {isEn ? "NO" : "NAO"}</label>
              </div>
              <p class="field__error" id="f-medico-error" hidden></p>
            </div>

            <div class="field">
              <span class="field__label">
                10. {isEn ? "Have you done or are you doing TRT?" : "Ja fez ou esta fazendo reposicao hormonal (TRT)?"}
                <span class="field__req">*</span>
              </span>
              <div class="radio-group">
                <label class="radio-label"><input type="radio" name="trt" value="SIM" /> {isEn ? "YES" : "SIM"}</label>
                <label class="radio-label"><input type="radio" name="trt" value="NAO" /> {isEn ? "NO" : "NAO"}</label>
              </div>
              <p class="field__error" id="f-trt-error" hidden></p>
              <!-- Condicional: aparece se SIM, obrigatorio -->
              <fieldset class="field field--cond" id="cond-trt"
                data-cond-name="trt"
                data-cond-value="SIM"
                hidden aria-hidden="true">
                <label class="field__label" for="f-trt-detail">
                  {isEn ? "Which hormones and at what frequency?" : "Quais hormonios e em qual frequencia?"}
                  <span class="field__req">*</span>
                </label>
                <textarea class="field__input field__textarea" id="f-trt-detail"
                  name="trt_detalhe" rows="2" autocomplete="off"></textarea>
                <p class="field__error" id="f-trt-detail-error" hidden></p>
              </fieldset>
            </div>

          </div>
        </div>

        <!-- HISTORICO DE SAUDE -->
        <div class="form-section">
          <h3 class="form-section__title">{isEn ? "Health History" : "Historico de Saude"}</h3>
          <div class="form-stack">

            <div class="field">
              <label class="field__label" for="f-cardiac">
                11. {isEn
                  ? "Do you have any cardiac condition? (hypertension, arrhythmia, pacemaker, angina, etc.)"
                  : "Possui alguma condicao cardiaca? (hipertensao, arritmia, uso de marcapasso, angina, etc.)"}
                <span class="field__req">*</span>
              </label>
              <textarea class="field__input field__textarea" id="f-cardiac"
                name="condicao_cardiaca" rows="2" autocomplete="off"
                placeholder={isEn ? "None / describe if applicable" : "Nenhuma / descreva se houver"}></textarea>
              <p class="field__error" id="f-cardiac-error" hidden></p>
            </div>

            <div class="field">
              <span class="field__label">
                12. {isEn ? "Do you have diabetes?" : "Possui diabetes?"}
                <span class="field__req">*</span>
              </span>
              <div class="radio-group">
                <label class="radio-label"><input type="radio" name="diabetes" value="SIM" /> {isEn ? "YES" : "SIM"}</label>
                <label class="radio-label"><input type="radio" name="diabetes" value="NAO" /> {isEn ? "NO" : "NAO"}</label>
              </div>
              <p class="field__error" id="f-diabetes-error" hidden></p>
            </div>

            <div class="field">
              <label class="field__label" for="f-chronic">
                13. {isEn
                  ? "Do you have any pre-existing or chronic disease?"
                  : "Tem alguma doenca pre-existente ou cronica?"}
                <span class="field__req">*</span>
              </label>
              <textarea class="field__input field__textarea" id="f-chronic"
                name="doenca_cronica" rows="2" autocomplete="off"
                placeholder={isEn ? "None / describe if applicable" : "Nenhuma / descreva se houver"}></textarea>
              <p class="field__error" id="f-chronic-error" hidden></p>
            </div>

            <div class="field">
              <span class="field__label">
                14. {isEn ? "Have you had a muscle or joint injury?" : "Ja teve lesao muscular ou articular?"}
                <span class="field__req">*</span>
              </span>
              <div class="radio-group">
                <label class="radio-label"><input type="radio" name="lesao" value="SIM" /> {isEn ? "YES" : "SIM"}</label>
                <label class="radio-label"><input type="radio" name="lesao" value="NAO" /> {isEn ? "NO" : "NAO"}</label>
              </div>
              <p class="field__error" id="f-lesao-error" hidden></p>
              <!-- Condicional: aparece se SIM, mas NAO é obrigatório -->
              <fieldset class="field field--cond" id="cond-lesao"
                data-cond-name="lesao"
                data-cond-value="SIM"
                data-cond-optional="true"
                hidden aria-hidden="true">
                <label class="field__label" for="f-lesao-detail">
                  {isEn ? "Which injury? Was surgery needed?" : "Qual lesao? Houve necessidade cirurgica?"}
                </label>
                <textarea class="field__input field__textarea" id="f-lesao-detail"
                  name="lesao_detalhe" rows="2" autocomplete="off"></textarea>
              </fieldset>
            </div>

          </div>
        </div>

        <!-- ROTINA ALIMENTAR E SUPLEMENTACAO -->
        <div class="form-section">
          <h3 class="form-section__title">{isEn ? "Diet and Supplementation" : "Rotina Alimentar e Suplementacao"}</h3>
          <div class="form-stack">

            <div class="field">
              <span class="field__label">
                15. {isEn ? "Do you currently follow a diet?" : "Atualmente segue alguma dieta?"}
                <span class="field__req">*</span>
              </span>
              <div class="radio-group radio-group--vertical">
                {(isEn
                  ? ["Yes, with professional guidance","Yes, on my own","No diet"]
                  : ["Sim, com acompanhamento profissional","Sim, por conta propria","Nao sigo dieta"]
                ).map(opt => (
                  <label class="radio-label">
                    <input type="radio" name="dieta" value={opt} />
                    {opt}
                  </label>
                ))}
              </div>
              <p class="field__error" id="f-dieta-error" hidden></p>
            </div>

            <div class="field">
              <label class="field__label" for="f-meals">
                16. {isEn ? "How many meals per day on average?" : "Em media, quantas refeicoes por dia?"}
                <span class="field__req">*</span>
              </label>
              <input class="field__input" type="text" id="f-meals"
                name="refeicoes_dia" inputmode="numeric"
                placeholder="5" autocomplete="off" />
              <p class="field__error" id="f-meals-error" hidden></p>
            </div>

            <div class="field">
              <span class="field__label">
                17. {isEn ? "Do you use supplements?" : "Usa suplementos?"}
                <span class="field__req">*</span>
              </span>
              <div class="radio-group">
                <label class="radio-label"><input type="radio" name="suplementos" value="SIM" /> {isEn ? "YES" : "SIM"}</label>
                <label class="radio-label"><input type="radio" name="suplementos" value="NAO" /> {isEn ? "NO" : "NAO"}</label>
              </div>
              <p class="field__error" id="f-suplementos-error" hidden></p>
              <!-- Condicional: aparece se SIM, mas NAO é obrigatório -->
              <fieldset class="field field--cond" id="cond-supl"
                data-cond-name="suplementos"
                data-cond-value="SIM"
                data-cond-optional="true"
                hidden aria-hidden="true">
                <label class="field__label" for="f-supl-detail">
                  {isEn ? "Which supplements?" : "Se sim, quais:"}
                </label>
                <textarea class="field__input field__textarea" id="f-supl-detail"
                  name="suplementos_detalhe" rows="2" autocomplete="off"></textarea>
              </fieldset>
            </div>

            <div class="field">
              <label class="field__label" for="f-water">
                18. {isEn ? "Litres of water per day on average?" : "Em media, quantos litros de agua por dia?"}
                <span class="field__req">*</span>
              </label>
              <input class="field__input" type="text" id="f-water"
                name="agua_litros_visual" inputmode="decimal"
                placeholder={isEn ? "2.5" : "2,5"}
                autocomplete="off"
                data-field-target="agua_litros" />
              <input type="hidden" id="real-agua_litros" name="agua_litros" />
              <p class="field__error" id="f-water-error" hidden></p>
            </div>

          </div>
        </div>

        <!-- AVALIACAO FISICA VISUAL -->
        <div class="form-section">
          <h3 class="form-section__title">{isEn ? "Visual Physical Assessment" : "Avaliacao Fisica Visual"}</h3>
          <p class="form-section__intro">
            {isEn
              ? "Upload up to 5 photos (max 10 MB each). Compressed automatically."
              : "Envie ate 5 fotos (max. 10 MB cada). Compressao automatica."}
          </p>
          <div class="field">
            <label class="field__label field__label--file" for="f-photos">
              + {isEn ? "Add photos" : "Adicionar fotos"}
            </label>
            <input class="field__file" type="file" id="f-photos" name="fotos"
              accept="image/*" multiple />
            <div class="file-preview" id="file-preview"></div>
            <p class="field__error" id="f-photos-error" hidden></p>
          </div>
        </div>

        <div class="form-footer">
          <p class="form-privacy">{f.privacy}</p>
          <button class="btn-cta form-submit" type="submit" id="form-submit-btn">
            {f.submit}
          </button>
          <p class="form-error" id="form-error" hidden role="alert"></p>
        </div>

      </form>
    </div>
  </div>
</div>

<script>
// ============================================================
// FONTE UNICA DE VERDADE: FIELD_RULES
// Cada entrada define: inputId, errorId, mensagens PT/EN,
// funcao de validacao, e se e campo de radio/checkbox.
// ============================================================
const FIELD_RULES: Array<{
  key:       string;
  inputId:   string;
  errorId:   string;
  msgPt:     string | ((v: string) => string);
  msgEn:     string | ((v: string) => string);
  validate:  (v: string) => boolean;
  isGroup?:  boolean; // true para radio/checkbox - le via querySelector
  groupSel?: string;  // selector para radio/checkbox :checked
  skipIfCondHidden?: boolean; // pular se dentro de fieldset[hidden]
}> = [
  {
    key: "nome", inputId: "f-name", errorId: "f-name-error",
    msgPt: "Nome completo é obrigatório.",
    msgEn: "Full name is required.",
    validate: v => v.trim().length >= 2,
  },
  {
    key: "cpf", inputId: "f-cpf", errorId: "f-cpf-error",
