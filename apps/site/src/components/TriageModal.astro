function openModal() {
  if (!modal) return;
  // Resetar estado
  formEl?.style && (formEl.style.display = "");
  formEl?.reset();
  if (successEl) successEl.hidden = true;
  if (errorEl) errorEl.hidden = true;
  compressedFiles = [];
  const preview = document.getElementById("file-preview");
  if (preview) preview.innerHTML = "";
  // Limpar todos os erros inline
  modal.querySelectorAll<HTMLElement>(".field__error").forEach(el => {
    el.hidden = true;
    el.textContent = "";
  });
  // Resetar condicionais
  updateConditionals();
  modal.hidden = false;
  document.body.style.overflow = "hidden";
  (modal.querySelector(".modal-close") as HTMLElement)?.focus();
}

function closeModal() {
  if (!modal) return;
  modal.hidden = true;
  document.body.style.overflow = "";
}

