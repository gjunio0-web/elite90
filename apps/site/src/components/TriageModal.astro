---
import type { Translations } from "../i18n/pt";
import type { Locale } from "../i18n/utils";

interface Props { t: Translations; locale?: Locale; }
const { t, locale = "pt-br" } = Astro.props;
const f = t.form;
const isEn = locale === "en";
---

<div class="modal-overlay" id="triage-modal" role="dialog" aria-modal="true"
  aria-labelledby="modal-title" hidden>
  <div class="modal-container">

    <div class="modal-header">
      <div>
        <p class="modal-eyebrow">{t.ctaFinal.eyebrow}</p>
        <h2 class="modal-title" id="modal-title">{f.title}</h2>
      </div>
      <button class="modal-close" id="modal-close" type="button" aria-label="Fechar">&#x2715;</button>
    </div>

    <div class="modal-body">
      <!-- SUCCESS shown ONLY after submit, starts hidden -->
      <div class="form-success" id="form-success" hidden tabindex="-1">
        <div class="form-success__icon" aria-hidden="true">&#x2713;</div>
        <h3 class="form-success__title">
          {isEn ? "Application received." : "Ficha recebida."}
        </h3>
        <p class="form-success__message">
          {isEn
            ? "Your application is under review. You will be contacted within 48 hours."
            : "Sua solicitação está em análise. Em até 48 horas você receberá um contato."}
        </p>
        <p class="form-success__sub">
          {isEn
            ? "Limited spots per cycle. Your application is in the queue."
            : "Vagas limitadas por ciclo. Sua ficha está na fila de análise."}
        </p>
        <button class="btn-cta" type="button" id="success-close">
          {isEn ? "Close" : "Fechar"}
        </button>
      </div>

      <!-- FORM shown by default -->
      <form class="triage-form" id="triage-form" novalidate>

        <!-- DADOS PESSOAIS -->
        <div class="form-section">
          <h3 class="form-section__title">{isEn ? "Personal Data" : "Dados Pessoais"}</h3>
          <div class="form-grid form-grid--2">

            <div class="field">
              <label class="field__label" for="f-name">
                {isEn ? "Full name" : "Nome completo"} <span class="field__req">*</span>
              </label>
              <input class="field__input" type="text" id="f-name" name="nome" required
                autocomplete="name" />
              <p class="field__error" id="f-name-error" hidden>
                {isEn ? "Name is required." : "Nome é obrigatório."}
              </p>
            </div>

            <div class="field">
              <label class="field__label" for="f-cpf">
                CPF <span class="field__req">*</span>
              </label>
              <input class="field__input" type="text" id="f-cpf" name="cpf" required
                placeholder="000.000.000-00" maxlength="14" inputmode="numeric" />
              <p class="field__error" id="f-cpf-error" hidden>
                {isEn ? "Enter a valid CPF." : "Informe um CPF válido."}
              </p>
            </div>

            <div class="field">
              <label class="field__label" for="f-dob">
                {isEn ? "Date of birth (DD/MM/YYYY)" : "Data de nascimento (DD/MM/AAAA)"}
                <span class="field__req">*</span>
              </label>
              {isEn
                ? <input class="field__input" type="date" id="f-dob" name="data_nascimento" required />
                : <input class="field__input" type="text" id="f-dob" name="data_nascimento" required
                    placeholder="DD/MM/AAAA" maxlength="10" inputmode="numeric" />
              }
              <p class="field__error" id="f-dob-error" hidden>
                {isEn ? "Enter a valid date." : "Informe uma data válida (DD/MM/AAAA)."}
              </p>
            </div>

            <div class="field">
              <label class="field__label" for="f-email">
                E-mail <span class="field__req">*</span>
              </label>
              <input class="field__input" type="email" id="f-email" name="email" required
                autocomplete="email"
                placeholder={isEn ? "your@email.com" : "seu@email.com"} />
              <p class="field__error" id="f-email-error" hidden>
                {isEn ? "Enter a valid e-mail address." : "Informe um e-mail válido."}
              </p>
            </div>

            <div class="field">
              <label class="field__label" for="f-height">
                {isEn ? "Height (in metres, e.g. 1.75)" : "Altura (em metros, ex: 1,75)"}
                <span class="field__req">*</span>
              </label>
              <input class="field__input numeric-br-field" type="text" id="f-height" name="altura_visual" required
                inputmode="decimal"
                placeholder={isEn ? "1.75" : "1,75"} data-field-target="altura" />
              <input type="hidden" id="real-altura" name="altura" />
              <p class="field__error" id="f-height-error" hidden>
                {isEn ? "Enter a value between 1.00 and 2.50 m." : "Informe um valor entre 1,00 e 2,50 m."}
              </p>
            </div>

            <div class="field">
              <label class="field__label" for="f-weight">
                {isEn ? "Weight (in kg, e.g. 85.5)" : "Peso (em kg, ex: 85,5)"}
                <span class="field__req">*</span>
              </label>
              <input class="field__input numeric-br-field" type="text" id="f-weight" name="peso_visual" required
                inputmode="decimal"
                placeholder={isEn ? "85.5" : "85,5"} data-field-target="peso" />
              <input type="hidden" id="real-peso" name="peso" />
              <p class="field__error" id="f-weight-error" hidden>
                {isEn ? "Enter a value between 30 and 300 kg." : "Informe um valor entre 30 e 300 kg."}
              </p>
            </div>

          </div>
        </div>

        <!-- IMERSÃO DO ATLETA -->
        <div class="form-section">
          <h3 class="form-section__title">{isEn ? "Athlete Immersion" : "Imersão do Atleta"}</h3>
          <p class="form-section__intro">
            {isEn
              ? "Honest answers here shape your entire protocol."
              : "Bora mergulhar de cabeça no processo? Seja honesto - é o seu corpo, sua evolução."}
          </p>

          <div class="form-stack">

            <!-- Q1: objetivo -->
            <div class="field">
              <span class="field__label">
                1. {isEn
                  ? "What is your main goal with this coaching?"
                  : "Qual o seu objetivo principal com esse acompanhamento?"}
                <span class="field__req">*</span>
              </span>
              <div class="radio-group radio-group--vertical">
                {(isEn
                  ? ["Muscle gain","Fat loss","Body recomposition","Competition preparation","Improve general fitness","Other"]
                  : ["Ganho de massa muscular","Perda de gordura","Recomposição corporal","Preparação para competição","Melhorar condicionamento geral","Outro"]
                ).map((opt, i, arr) => (
                  <label class="radio-label">
                    <input type="radio" name="objetivo" value={opt}
                      id={i === arr.length - 1 ? "r-goal-other" : undefined}
                      required />
                    {opt}
                  </label>
                ))}
              </div>
              <div class="field field--conditional" id="cond-goal-other" hidden>
                <label class="field__label" for="f-goal-other">
                  {isEn ? "Describe your goal:" : "Descreva seu objetivo:"}
                </label>
                <textarea class="field__input field__textarea" id="f-goal-other"
                  name="objetivo_outro" rows="2"></textarea>
              </div>
            </div>

            <!-- Q2a: qual atividade (multiple checkboxes) -->
            <div class="field">
              <span class="field__label">
                2. {isEn
                  ? "Do you currently practice any physical activity? If so, which?"
                  : "Atualmente pratica alguma atividade física? Se sim, qual?"}
                <span class="field__req">*</span>
              </span>
              <div class="radio-group radio-group--vertical" id="activity-group">
                {(isEn
                  ? ["Weight training","CrossFit","Running","Swimming","Martial arts","Cycling","None"]
                  : ["Musculação","CrossFit","Corrida","Natação","Artes marciais","Ciclismo","Nenhuma"]
                ).map((opt) => (
                  <label class="radio-label">
                    <input type="checkbox" name="atividade_fisica" value={opt}
                      class="activity-check" />
                    {opt}
                  </label>
                ))}
                <label class="radio-label">
                  <input type="checkbox" name="atividade_fisica" value={isEn ? "Other" : "Outra"}
                    id="r-act-other" class="activity-check" />
                  {isEn ? "Other" : "Outra"}
                </label>
              </div>
              <p class="field__error" id="f-activity-error" hidden>
                {isEn ? "Select at least one option." : "Selecione ao menos uma opção."}
              </p>
              <div class="field field--conditional" id="cond-act-other" hidden>
                <label class="field__label" for="f-act-other">
                  {isEn ? "Which activity?" : "Qual atividade?"}
                </label>
                <input class="field__input" type="text" id="f-act-other" name="atividade_outra" />
              </div>
            </div>

            <!-- Q2b: há quanto tempo -->
            <div class="field">
              <label class="field__label" for="f-act-duration">
                {isEn ? "How long? (in years, e.g. 2.5)" : "Há quanto tempo? (em anos, ex: 2,5)"}
              </label>
              <input class="field__input" type="text" id="f-act-duration"
                name="tempo_atividade" inputmode="decimal"
                placeholder={isEn ? "2.5" : "2,5"} />
            </div>

            <div class="form-grid form-grid--2">
              <div class="field">
                <label class="field__label" for="f-freq">
                  3. {isEn
                    ? "How many times per week do you plan to train?"
                    : "Pretende treinar quantas vezes por semana?"}
                  <span class="field__req">*</span>
                </label>
                <input class="field__input" type="text" id="f-freq"
                  name="frequencia_semanal" required
                  inputmode="numeric"
                  placeholder="4" />
              </div>
              <div class="field">
                <label class="field__label" for="f-avail">
                  4. {isEn
                    ? "Daily hours available for training?"
                    : "Disponibilidade diária de horas para treinos?"}
                  <span class="field__req">*</span>
                </label>
                <input class="field__input" type="text" id="f-avail"
                  name="disponibilidade_diaria" required
                  inputmode="decimal"
                  placeholder={isEn ? "e.g. 1.5" : "ex: 1,5"} />
              </div>
            </div>

            <div class="field">
              <span class="field__label">
                5. {isEn ? "Do you train with a personal trainer?" : "Treina com personal trainer?"}
                <span class="field__req">*</span>
              </span>
              <div class="radio-group">
                <label class="radio-label"><input type="radio" name="personal_trainer" value="SIM" required /> {isEn ? "YES" : "SIM"}</label>
                <label class="radio-label"><input type="radio" name="personal_trainer" value="NAO" /> {isEn ? "NO" : "NÃO"}</label>
              </div>
            </div>

            <div class="field">
              <span class="field__label">
                6. {isEn ? "Have you competed before?" : "Já participou de alguma competição?"}
              </span>
              <div class="radio-group">
                <label class="radio-label"><input type="radio" name="competicao" value="SIM" id="r-comp-sim" /> {isEn ? "YES" : "SIM"}</label>
                <label class="radio-label"><input type="radio" name="competicao" value="NAO" /> {isEn ? "NO" : "NÃO"}</label>
              </div>
            </div>
            <div class="field field--conditional" id="cond-comp" hidden>
              <label class="field__label" for="f-comp-detail">
                {isEn ? "If yes, which category and year?" : "Se sim, qual modalidade e ano?"}
              </label>
              <input class="field__input" type="text" id="f-comp-detail" name="competicao_detalhe" />
            </div>

            <div class="field">
              <span class="field__label">
                7. {isEn
                  ? "Do you know or follow a bodybuilding coach?"
                  : "Já conhece ou acompanha o trabalho de um coach bodybuilding?"}
                <span class="field__req">*</span>
              </span>
              <div class="radio-group">
                <label class="radio-label"><input type="radio" name="conhece_coach" value="SIM" required /> {isEn ? "YES" : "SIM"}</label>
                <label class="radio-label"><input type="radio" name="conhece_coach" value="NAO" /> {isEn ? "NO" : "NÃO"}</label>
              </div>
            </div>

            <div class="field">
              <span class="field__label">
                8. {isEn ? "Do you see a sports medicine doctor?" : "Faz acompanhamento com médico do esporte?"}
                <span class="field__req">*</span>
              </span>
              <div class="radio-group">
                <label class="radio-label"><input type="radio" name="medico_esporte" value="SIM" required /> {isEn ? "YES" : "SIM"}</label>
                <label class="radio-label"><input type="radio" name="medico_esporte" value="NAO" /> {isEn ? "NO" : "NÃO"}</label>
              </div>
            </div>

            <div class="field">
              <span class="field__label">
                9. {isEn ? "Have you done or are you doing TRT?" : "Já fez ou está fazendo reposição hormonal (TRT)?"}
                <span class="field__req">*</span>
              </span>
              <div class="radio-group">
                <label class="radio-label"><input type="radio" name="trt" value="SIM" id="r-trt-sim" required /> {isEn ? "YES" : "SIM"}</label>
                <label class="radio-label"><input type="radio" name="trt" value="NAO" /> {isEn ? "NO" : "NÃO"}</label>
              </div>
            </div>
            <div class="field field--conditional" id="cond-trt" hidden>
              <label class="field__label" for="f-trt-detail">
                10. {isEn ? "Which hormones and at what frequency?" : "Quais hormônios e em qual frequência?"}
              </label>
              <textarea class="field__input field__textarea" id="f-trt-detail"
                name="trt_detalhe" rows="2"></textarea>
            </div>

          </div>
        </div>

        <!-- HISTÓRICO DE SAÚDE -->
        <div class="form-section">
          <h3 class="form-section__title">{isEn ? "Health History" : "Histórico de Saúde"}</h3>
          <div class="form-stack">

            <div class="field">
              <label class="field__label" for="f-cardiac">
                11. {isEn
                  ? "Do you have any cardiac condition? (hypertension, arrhythmia, pacemaker, angina, etc.)"
                  : "Possui alguma condição cardíaca? (hipertensão, arritmia, uso de marcapasso, angina, etc.)"}
                <span class="field__req">*</span>
              </label>
              <textarea class="field__input field__textarea" id="f-cardiac"
                name="condicao_cardiaca" required rows="2"
                placeholder={isEn ? "None / describe if applicable" : "Nenhuma / descreva se houver"}></textarea>
            </div>

            <div class="field">
              <span class="field__label">
                12. {isEn ? "Do you have diabetes?" : "Possui diabetes?"}
                <span class="field__req">*</span>
              </span>
              <div class="radio-group">
                <label class="radio-label"><input type="radio" name="diabetes" value="SIM" required /> {isEn ? "YES" : "SIM"}</label>
                <label class="radio-label"><input type="radio" name="diabetes" value="NAO" /> {isEn ? "NO" : "NÃO"}</label>
              </div>
            </div>

            <div class="field">
              <label class="field__label" for="f-chronic">
                13. {isEn
                  ? "Do you have any pre-existing or chronic disease?"
                  : "Tem alguma doença pré-existente ou crônica?"}
                <span class="field__req">*</span>
              </label>
              <textarea class="field__input field__textarea" id="f-chronic"
                name="doenca_cronica" required rows="2"
                placeholder={isEn ? "None / describe if applicable" : "Nenhuma / descreva se houver"}></textarea>
            </div>

            <div class="field">
              <span class="field__label">
                14. {isEn ? "Have you had a muscle or joint injury?" : "Já teve lesão muscular ou articular?"}
                <span class="field__req">*</span>
              </span>
              <div class="radio-group">
                <label class="radio-label"><input type="radio" name="lesao" value="SIM" id="r-lesao-sim" required /> {isEn ? "YES" : "SIM"}</label>
                <label class="radio-label"><input type="radio" name="lesao" value="NAO" /> {isEn ? "NO" : "NÃO"}</label>
              </div>
            </div>
            <div class="field field--conditional" id="cond-lesao" hidden>
              <label class="field__label" for="f-lesao-detail">
                {isEn ? "Which injury? Was surgery needed?" : "Qual lesão? Houve necessidade cirúrgica?"}
              </label>
              <textarea class="field__input field__textarea" id="f-lesao-detail"
                name="lesao_detalhe" rows="2"></textarea>
            </div>

          </div>
        </div>

        <!-- ROTINA ALIMENTAR E SUPLEMENTAÇÃO -->
        <div class="form-section">
          <h3 class="form-section__title">{isEn ? "Diet and Supplementation" : "Rotina Alimentar e Suplementação"}</h3>
          <div class="form-stack">

            <div class="field">
              <span class="field__label">
                15. {isEn ? "Do you currently follow a diet?" : "Atualmente segue alguma dieta?"}
                <span class="field__req">*</span>
              </span>
              <div class="radio-group radio-group--vertical">
                {(isEn
                  ? ["Yes, with professional guidance","Yes, on my own","No diet"]
                  : ["Sim, com acompanhamento profissional","Sim, por conta própria","Não sigo dieta"]
                ).map(opt => (
                  <label class="radio-label">
                    <input type="radio" name="dieta" value={opt} required />
                    {opt}
                  </label>
                ))}
              </div>
            </div>

            <div class="form-grid form-grid--2">
              <div class="field">
                <label class="field__label" for="f-meals">
                  16. {isEn ? "How many meals per day on average?" : "Em média, quantas refeições por dia?"}
                  <span class="field__req">*</span>
                </label>
                <input class="field__input" type="text" id="f-meals"
                  name="refeicoes_dia" required
                  inputmode="numeric"
                  placeholder="5" />
              </div>
              <div class="field">
                <label class="field__label" for="f-water">
                  18. {isEn ? "Litres of water per day on average?" : "Em média, quantos litros de água por dia?"}
                  <span class="field__req">*</span>
                </label>
                <input class="field__input numeric-br-field" type="text" id="f-water"
                  name="agua_litros_visual" required
                  inputmode="decimal"
                  placeholder={isEn ? "2.5" : "2,5"} data-field-target="agua_litros" />
                <input type="hidden" id="real-agua_litros" name="agua_litros" />
              </div>
            </div>

            <div class="field">
              <span class="field__label">
                17. {isEn ? "Do you use supplements?" : "Usa suplementos?"}
                <span class="field__req">*</span>
              </span>
              <div class="radio-group">
                <label class="radio-label"><input type="radio" name="suplementos" value="SIM" id="r-supl-sim" required /> {isEn ? "YES" : "SIM"}</label>
                <label class="radio-label"><input type="radio" name="suplementos" value="NAO" /> {isEn ? "NO" : "NÃO"}</label>
              </div>
            </div>
            <div class="field field--conditional" id="cond-supl" hidden>
              <label class="field__label" for="f-supl-detail">
                {isEn ? "Which supplements?" : "Se sim, quais:"}
              </label>
              <textarea class="field__input field__textarea" id="f-supl-detail"
                name="suplementos_detalhe" rows="2"></textarea>
            </div>

          </div>
        </div>

        <!-- AVALIAÇÃO FÍSICA VISUAL -->
        <div class="form-section">
          <h3 class="form-section__title">{isEn ? "Visual Physical Assessment" : "Avaliação Física Visual"}</h3>
          <p class="form-section__intro">
            {isEn
              ? "Upload up to 5 photos (max 10 MB each). They will be compressed automatically."
              : "Envie até 5 fotos (máx. 10 MB cada). Elas serão comprimidas automaticamente."}
          </p>
          <div class="field">
            <label class="field__label field__label--file" for="f-photos">
              + {isEn ? "Add photos" : "Adicionar fotos"}
            </label>
            <input class="field__file" type="file" id="f-photos" name="fotos"
              accept="image/*" multiple />
            <div class="file-preview" id="file-preview" hidden></div>
            <div id="toast-placeholder-spacer" style="display:none; height:0px;"></div>
          </div>
        </div>

        <div class="form-footer">
          <p class="form-privacy">{f.privacy}</p>
          <button class="btn-cta form-submit" type="submit" id="form-submit-btn">
            {f.submit}
          </button>
          <p class="form-error" id="form-error" hidden role="alert"></p>
        </div>

      </form>
    </div>
  </div>
</div>

<script>
  // -- Modal open/close --
  const modal     = document.getElementById("triage-modal") as HTMLElement;
  const formEl    = document.getElementById("triage-form") as HTMLFormElement;
  const successEl = document.getElementById("form-success") as HTMLElement;
  const errorEl   = document.getElementById("form-error") as HTMLElement;
  const submitBtn = document.getElementById("form-submit-btn") as HTMLButtonElement;

  function openModal() {
    if (!modal) return;
    // Reset form state every time modal opens
    if (formEl) {
      formEl.style.display = "";
      formEl.reset();
    }
    if (successEl) successEl.hidden = true;
    if (errorEl) errorEl.hidden = true;
    // Clear all field errors
    modal.querySelectorAll(".field__error").forEach(el => {
      (el as HTMLElement).hidden = true;
    });
    modal.hidden = false;
    document.body.style.overflow = "hidden";
    (modal.querySelector(".modal-close") as HTMLElement)?.focus();
  }
  function closeModal() {
    if (!modal) return;
    modal.hidden = true;
    document.body.style.overflow = "";
  }

  document.addEventListener("open-triage-modal", openModal);
  document.getElementById("modal-close")?.addEventListener("click", closeModal);
  document.getElementById("success-close")?.addEventListener("click", closeModal);
  modal?.addEventListener("click", e => { if (e.target === modal) closeModal(); });
  document.addEventListener("keydown", e => {
    if (e.key === "Escape" && modal && !modal.hidden) closeModal();
  });

  // -- Wire all CTAs to open modal --
  document.querySelectorAll<HTMLElement>(
    "#header-cta-btn, #drawer-cta-btn, .hero__cta, .motivational__cta, .cta-final__btn, .sticky-cta__btn"
  ).forEach(btn => {
    btn.addEventListener("click", e => {
      e.preventDefault();
      document.dispatchEvent(new CustomEvent("open-triage-modal"));
    });
  });

  // -- Conditional: radio SIM/NÃO --
  function conditionalRadio(
    radioName: string,
    condId: string,
    inputSel: string,
    optional = false
  ) {
    const radios = document.querySelectorAll<HTMLInputElement>(`input[name="${radioName}"]`);
    const cond   = document.getElementById(condId);
    const input  = cond?.querySelector<HTMLInputElement | HTMLTextAreaElement>(inputSel);
    radios.forEach(r => r.addEventListener("change", () => {
      const show = r.value === "SIM" && r.checked;
      if (cond) cond.hidden = !show;
      if (input && !optional) input.required = show;
    }));
  }

  conditionalRadio("competicao",  "cond-comp",  "input",    true);
  conditionalRadio("trt",         "cond-trt",   "textarea");
  conditionalRadio("lesao",       "cond-lesao", "textarea", true);
  conditionalRadio("suplementos", "cond-supl",  "textarea", true);

  // -- Conditional: goal "Outro/Other" --
  document.querySelectorAll<HTMLInputElement>('input[name="objetivo"]').forEach(r => {
    r.addEventListener("change", () => {
      const isOther = r.id === "r-goal-other" && r.checked;
      const cond    = document.getElementById("cond-goal-other");
      const inp     = document.getElementById("f-goal-other") as HTMLTextAreaElement;
      if (cond) cond.hidden = !isOther;
      // NOT required - user can leave blank
      if (inp) inp.required = false;
    });
  });

  // -- Conditional: activity "Outra/Other" (checkbox) --
  document.getElementById("r-act-other")?.addEventListener("change", function() {
    const checked = (this as HTMLInputElement).checked;
    const cond = document.getElementById("cond-act-other");
    if (cond) cond.hidden = !checked;
    // NOT required - field is optional
  });

  // -- CPF mask --
  const cpfInput = document.getElementById("f-cpf") as HTMLInputElement;
  cpfInput?.addEventListener("input", () => {
    let v = cpfInput.value.replace(/\D/g, "").slice(0, 11);
    if (v.length > 9)      v = v.replace(/(\d{3})(\d{3})(\d{3})(\d{1,2})/, "$1.$2.$3-$4");
    else if (v.length > 6) v = v.replace(/(\d{3})(\d{3})(\d{1,3})/, "$1.$2.$3");
    else if (v.length > 3) v = v.replace(/(\d{3})(\d{1,3})/, "$1.$2");
    cpfInput.value = v;
  });

  // -- PT-BR date mask DD/MM/AAAA --
  const dobInput = document.getElementById("f-dob") as HTMLInputElement;
  if (dobInput && dobInput.type === "text") {
    dobInput.addEventListener("input", () => {
      let v = dobInput.value.replace(/\D/g, "").slice(0, 8);
      if (v.length > 4)      v = v.replace(/(\d{2})(\d{2})(\d{1,4})/, "$1/$2/$3");
      else if (v.length > 2) v = v.replace(/(\d{2})(\d{1,2})/, "$1/$2");
      dobInput.value = v;
    });
  }

  // -- Redirecionamento unificado para o Barramento Global Brutalista Noir --
  function showValidationToast(msg: string) {
    if (typeof window !== "undefined" && (window as any).toast) {
      (window as any).toast.show(msg, 'error');
    }
  }

  // -- Validation helpers --
  function parseDecimal(v: string): number {
    return parseFloat(v.replace(",", "."));
  }

  function validaCPF(cpf: string): boolean {
    const limpo = cpf.replace(/\D/g, "");
    if (limpo.length !== 11 || /^(\d)\1{10}$/.test(limpo)) return false;
    let soma = 0;
    for (let i = 1; i <= 9; i++) soma += parseInt(limpo.substring(i - 1, i)) * (11 - i);
    let resto = (soma * 10) % 11;
    if (resto === 10 || resto === 11) resto = 0;
    if (resto !== parseInt(limpo.substring(9, 10))) return false;
    soma = 0;
    for (let i = 1; i <= 10; i++) soma += parseInt(limpo.substring(i - 1, i)) * (12 - i);
    resto = (soma * 10) % 11;
    if (resto === 10 || resto === 11) resto = 0;
    return resto === parseInt(limpo.substring(10, 11));
  }

  function validateField(id: string, errorId: string, fn: (v: string) => boolean): boolean {
    const inp = document.getElementById(id) as HTMLInputElement | null;
    const err = document.getElementById(errorId);
    if (!inp) return true;
    const valid = inp.value.trim() !== "" && fn(inp.value.trim());
    if (err) err.hidden = valid;
    return valid;
  }

  // -- Blur validation (show error only after user leaves field) --
  function attachBlurValidation(id: string, errorId: string, validateFn: (v: string) => boolean) {
    const inp = document.getElementById(id) as HTMLInputElement | null;
    const err = document.getElementById(errorId);
    if (!inp || !err) return;
    inp.addEventListener("blur", () => {
      if (!inp.value) return;
      err.hidden = validateFn(inp.value);
    });
    inp.addEventListener("input", () => {
      if (err && !err.hidden) err.hidden = validateFn(inp.value);
    });
  }

  attachBlurValidation("f-cpf",   "f-cpf-error",   v => validaCPF(v));
  attachBlurValidation("f-email",  "f-email-error", v => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v));
  attachBlurValidation("f-height", "f-height-error", v => { const n = parseDecimal(v); return n >= 1 && n <= 2.5; });
  attachBlurValidation("f-weight", "f-weight-error", v => { const n = parseDecimal(v); return n >= 30 && n <= 300; });
  attachBlurValidation("f-dob", "f-dob-error", v => {
    if (v.includes("-")) return true;
    const m = v.match(/^(\d{2})\/(\d{2})\/(\d{4})$/);
    if (!m) return false;
    const d = new Date(`${m[3]}-${m[2]}-${m[1]}`);
    return !isNaN(d.getTime());
  });

  // -- Decimal input: allow comma, prevent letters (Algoritmo BR Corrigido) --
  ["f-height","f-weight","f-act-duration","f-avail","f-water"].forEach(id => {
    const inp = document.getElementById(id) as HTMLInputElement;
    if (!inp) return;
    inp.addEventListener("input", () => {
      // Sanitização: permite apenas dígitos e uma única vírgula visual
      let value = inp.value.replace(/[^0-9,]/g, "");
      
      const parts = value.split(",");
      if (parts.length > 2) {
        value = parts[0] + "," + parts.slice(1).join("");
      }
      inp.value = value;

      // Captura o data-field-target associado e espelha no hidden input correspondente como Float (.)
      const targetKey = inp.dataset.fieldTarget;
      if (targetKey) {
        const hiddenInput = document.getElementById(`real-${targetKey}`) as HTMLInputElement;
        if (hiddenInput) {
          const rawFloatString = value.replace(",", ".");
          hiddenInput.value = rawFloatString ? parseFloat(rawFloatString).toString() : "";
        }
      }
    });
    // Prevent autocomplete from overwriting comma format
    inp.setAttribute("autocomplete", "off");
  });
  ["f-freq","f-meals"].forEach(id => {
    const inp = document.getElementById(id) as HTMLInputElement;
    if (!inp) return;
    inp.addEventListener("input", () => {
      inp.value = inp.value.replace(/[^0-9]/g, "");
    });
    inp.setAttribute("autocomplete", "off");
  });

  // -- Activity: at least one checkbox required --
  const activityGroup = document.getElementById("activity-group");
  const activityError = document.getElementById("f-activity-error");

  function validateActivity(): boolean {
    const checked = activityGroup?.querySelectorAll<HTMLInputElement>("input:checked") ?? [];
    return checked.length > 0;
  }

  // -- Compressão de Imagens integrada ao Barramento Global --
  const fileInput   = document.getElementById("f-photos") as HTMLInputElement;
  const filePreview = document.getElementById("file-preview") as HTMLElement;
  let compressedFiles: File[] = [];

  function showToast(msg: string) {
    if (typeof window !== "undefined" && (window as any).toast) {
      (window as any).toast.show(msg, 'success');
    }
  }

  async function compressImage(file: File): Promise<File> {
    return new Promise(resolve => {
      const img = new Image();
      const url = URL.createObjectURL(file);
      img.onload = () => {
        URL.revokeObjectURL(url);
        const MAX = 1200;
        let { width, height } = img;
        if (width > MAX || height > MAX) {
          if (width > height) { height = Math.round(height * MAX / width); width = MAX; }
          else { width = Math.round(width * MAX / height); height = MAX; }
        }
        const canvas = document.createElement("canvas");
        canvas.width = width; canvas.height = height;
        canvas.getContext("2d")!.drawImage(img, 0, 0, width, height);
        canvas.toBlob(blob => {
          if (!blob) { resolve(file); return; }
          const out = new File([blob], file.name.replace(/\.[^.]+$/, ".webp"), { type: "image/webp" });
          const pct = Math.round((1 - blob.size / file.size) * 100);
          showToast(`${file.name}: ${(file.size/1024).toFixed(0)} KB -> ${(blob.size/1024).toFixed(0)} KB (${pct}% menor)`);
          resolve(out);
        }, "image/webp", 0.82);
      };
      img.src = url;
    });
  }

  fileInput?.addEventListener("change", async () => {
    const files = Array.from(fileInput.files ?? []);
    if (!files.length) return;

    if (files.length > 5) {
      const isEnPage = document.documentElement.lang === "en";
      showToast(isEnPage ? "Maximum 5 photos. The rest will be discarded." : "Máximo de 5 fotos. O excesso foi descartado.");
    }

    compressedFiles = [];
    filePreview.innerHTML = "";
    filePreview.hidden = false;
    for (const file of files.slice(0, 5)) {
      const compressed = await compressImage(file);
      compressedFiles.push(compressed);
      const url = URL.createObjectURL(compressed);
      const img = document.createElement("img");
      img.src = url; img.className = "file-preview__img"; img.alt = compressed.name;
      filePreview.appendChild(img);
    }
  });

  // -- Submit --
  formEl?.addEventListener("submit", async e => {
    e.preventDefault();

    const isEnPage = document.documentElement.lang === "en";
    const toasts: string[] = [];
    let firstInvalidEl: HTMLElement | null = null;

    // Função utilitária interna para registrar falhas e capturar o primeiro elemento inválido do fluxo
    function markInvalid(elementIdOrQuery: string, message: string) {
      toasts.push(message);
      if (!firstInvalidEl) {
        if (elementIdOrQuery.startsWith('.') || elementIdOrQuery.includes('[')) {
          firstInvalidEl = modal.querySelector(elementIdOrQuery);
        } else {
          firstInvalidEl = document.getElementById(elementIdOrQuery);
        }
      }
    }

    // 1. Nome Completo
    const nameVal = (document.getElementById("f-name") as HTMLInputElement)?.value.trim();
    const nameErr = document.getElementById("f-name-error");
    if (!nameVal) {
      markInvalid("f-name", isEnPage ? "Full name is required." : "Nome completo é obrigatório.");
      if (nameErr) nameErr.hidden = false;
    } else { if (nameErr) nameErr.hidden = true; }

    // 2. CPF (Com validação Módulo 11 integrada)
    const cpfVal = (document.getElementById("f-cpf") as HTMLInputElement)?.value.trim();
    const cpfErr = document.getElementById("f-cpf-error");
    if (!cpfVal) {
      markInvalid("f-cpf", isEnPage ? "CPF is required." : "CPF é obrigatório.");
      if (cpfErr) cpfErr.hidden = false;
    } else if (!validaCPF(cpfVal)) {
      markInvalid("f-cpf", isEnPage ? "Invalid CPF matrix." : "CPF inválido.");
      if (cpfErr) cpfErr.hidden = false;
    } else { if (cpfErr) cpfErr.hidden = true; }

    // 3. Data de Nascimento
    const dobVal = (document.getElementById("f-dob") as HTMLInputElement)?.value.trim();
    const dobErr = document.getElementById("f-dob-error");
    let isDobValid = true;
    if (!dobVal) {
      isDobValid = false;
      markInvalid("f-dob", isEnPage ? "Date of birth is required." : "Data de nascimento é obrigatória.");
    } else if (dobInput?.type === "text") {
      const m = dobVal.match(/^(\d{2})\/(\d{2})\/(\d{4})$/);
      if (!m) {
        isDobValid = false;
        markInvalid("f-dob", isEnPage ? "Date must be DD/MM/YYYY." : "Data deve estar no formato DD/MM/AAAA.");
      } else {
        const d = new Date(`${m[3]}-${m[2]}-${m[1]}`);
        if (isNaN(d.getTime())) isDobValid = false;
      }
    }
    if (dobErr) dobErr.hidden = isDobValid;

    // 4. E-mail
    const emailVal = (document.getElementById("f-email") as HTMLInputElement)?.value.trim();
    const emailErr = document.getElementById("f-email-error");
    if (!emailVal || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(emailVal)) {
      markInvalid("f-email", isEnPage ? "Enter a valid e-mail address." : "Informe um e-mail válido.");
      if (emailErr) emailErr.hidden = false;
    } else { if (emailErr) emailErr.hidden = true; }

    // 5. Altura
    const heightVal = (document.getElementById("f-height") as HTMLInputElement)?.value.trim();
    const heightN = parseDecimal(heightVal);
    const heightErr = document.getElementById("f-height-error");
    if (!heightVal || heightN < 1 || heightN > 2.5) {
      markInvalid("f-height", isEnPage ? "Height must be between 1.00 and 2.50 m." : "Altura deve estar entre 1,00 e 2,50 m.");
      if (heightErr) heightErr.hidden = false;
    } else { if (heightErr) heightErr.hidden = true; }

    // 6. Peso
    const weightVal = (document.getElementById("f-weight") as HTMLInputElement)?.value.trim();
    const weightN = parseDecimal(weightVal);
    const weightErr = document.getElementById("f-weight-error");
    if (!weightVal || weightN < 30 || weightN > 300) {
      markInvalid("f-weight", isEnPage ? "Weight must be between 30 and 300 kg." : "Peso deve estar entre 30 e 300 kg.");
      if (weightErr) weightErr.hidden = false;
    } else { if (weightErr) weightErr.hidden = true; }

    // 7. Q1: Objetivo Principal
    const goalChecked = modal.querySelector<HTMLInputElement>('input[name="objetivo"]:checked');
    if (!goalChecked) {
      markInvalid('input[name="objetivo"]', isEnPage ? "Select your main goal (Question 1)." : "Selecione seu objetivo principal (Questão 1).");
    }

    // 8. Q2: Atividade Física (Checkboxes Coletivos)
    const activityGroup = document.getElementById("activity-group");
    const activityError = document.getElementById("f-activity-error");
    const actChecked = modal.querySelectorAll<HTMLInputElement>('input[name="atividade_fisica"]:checked');
    if (!actChecked.length) {
      markInvalid('#activity-group', isEnPage ? "Select at least one activity (Question 2)." : "Selecione ao menos uma atividade (Questão 2).");
      if (activityError) activityError.hidden = false;
    } else { if (activityError) activityError.hidden = true; }

    // 9. Q3: Frequência Semanal
    const freqVal = (document.getElementById("f-freq") as HTMLInputElement)?.value.trim();
    if (!freqVal) {
      markInvalid("f-freq", isEnPage ? "Training frequency is required (Question 3)." : "Frequência semanal é obrigatória (Questão 3).");
    }

    // 10. Q4: Disponibilidade Diária
    const availVal = (document.getElementById("f-avail") as HTMLInputElement)?.value.trim();
    if (!availVal) {
      markInvalid("f-avail", isEnPage ? "Daily availability is required (Question 4)." : "Disponibilidade diária é obrigatória (Questão 4).");
    }

    // 11. Q5: Personal Trainer
    const ptVal = modal.querySelector<HTMLInputElement>('input[name="personal_trainer"]:checked');
    if (!ptVal) {
      markInvalid('input[name="personal_trainer"]', isEnPage ? "Answer if you train with a Personal (Question 5)." : "Responda se treina com personal trainer (Questão 5).");
    }

    // 12. Q7: Conhece o Trabalho do Coach
    const coachVal = modal.querySelector<HTMLInputElement>('input[name="conhece_coach"]:checked');
    if (!coachVal) {
      markInvalid('input[name="conhece_coach"]', isEnPage ? "Answer if you know the coach's work (Question 7)." : "Responda se conhece o trabalho do coach (Questão 7).");
    }

    // 13. Q8: Médico do Esporte
    const medVal = modal.querySelector<HTMLInputElement>('input[name="medico_esporte"]:checked');
    if (!medVal) {
      markInvalid('input[name="medico_esporte"]', isEnPage ? "Answer regarding sports medicine (Question 8)." : "Faz acompanhamento com médico do esporte? (Questão 8).");
    }

    // 14. Q9: TRT
    const trtVal = modal.querySelector<HTMLInputElement>('input[name="trt"]:checked');
    if (!trtVal) {
      markInvalid('input[name="trt"]', isEnPage ? "Answer regarding TRT (Question 9)." : "Responda sobre reposição hormonal/TRT (Questão 9).");
    }

    // 15. Q11: Condição Cardíaca
    const cardiacVal = (document.getElementById("f-cardiac") as HTMLInputElement)?.value.trim();
    if (!cardiacVal) {
      markInvalid("f-cardiac", isEnPage ? "Cardiac history is required (Question 11)." : "Histórico de condição cardíaca é obrigatório (Questão 11).");
    }

    // 16. Q12: Diabetes
    const diabVal = modal.querySelector<HTMLInputElement>('input[name="diabetes"]:checked');
    if (!diabVal) {
      markInvalid('input[name="diabetes"]', isEnPage ? "Answer if you have diabetes (Question 12)." : "Responda se possui diabetes (Questão 12).");
    }

    // 17. Q13: Doença Crônica
    const chronicVal = (document.getElementById("f-chronic") as HTMLInputElement)?.value.trim();
    if (!chronicVal) {
      markInvalid("f-chronic", isEnPage ? "Chronic disease information is required (Question 13)." : "Informações sobre doenças crônicas são obrigatórias (Questão 13).");
    }

    // 18. Q14: Lesão Muscular
    const lesaoVal = modal.querySelector<HTMLInputElement>('input[name="lesao"]:checked');
    if (!lesaoVal) {
      markInvalid('input[name="lesao"]', isEnPage ? "Answer regarding muscle injuries (Question 14)." : "Responda sobre lesões musculares/articulares (Questão 14).");
    }

    // 19. Q15: Dieta
    const dietaVal = modal.querySelector<HTMLInputElement>('input[name="dieta"]:checked');
    if (!dietaVal) {
      markInvalid('input[name="dieta"]', isEnPage ? "Select your diet status (Question 15)." : "Selecione seu status de dieta (Questão 15).");
    }

    // 20. Q16: Refeições por Dia
    const mealsVal = (document.getElementById("f-meals") as HTMLInputElement)?.value.trim();
    if (!mealsVal) {
      markInvalid("f-meals", isEnPage ? "Number of meals is required (Question 16)." : "Número de refeições diárias é obrigatório (Questão 16).");
    }

    // 21. Q17: Suplementos
    const suplVal = modal.querySelector<HTMLInputElement>('input[name="suplementos"]:checked');
    if (!suplVal) {
      markInvalid('input[name="suplementos"]', isEnPage ? "Answer regarding supplement use (Question 17)." : "Responda se faz uso de suplementos (Questão 17).");
    }

    // 22. Q18: Consumo de Água
    const waterVal = (document.getElementById("f-water") as HTMLInputElement)?.value.trim();
    if (!waterVal) {
      markInvalid("f-water", isEnPage ? "Water intake volume is required (Question 18)." : "Volume de consumo de água é obrigatório (Questão 18).");
    }

    // Trava de Segurança Extra: Obrigatoriedade Física de Imagens (Fase 3)
    if (compressedFiles.length === 0) {
      markInvalid("f-photos", isEnPage ? "At least one assessment photo is required." : "É obrigatório enviar pelo menos uma foto para avaliação.");
    }

    // Orquestração e Desobstrução do Feedback Visual (Fase 2 UI/UX)
    if (toasts.length > 0) {
      // Despara as mensagens sequenciais em rajada organizada no topo
      toasts.slice(0, 4).forEach((msg, i) => {
        setTimeout(() => showValidationToast(msg), i * 220);
      });
      if (toasts.length > 4) {
        setTimeout(() => showValidationToast(
          isEnPage ? `...and ${toasts.length - 4} more required fields to complete.`
                   : `...e mais ${toasts.length - 4} item(ns) obrigatório(s) a preencher.`
        ), 880);
      }

      // Efetua o Scroll focado até o primeiro campo problemático, centralizando o elemento na tela (Segunda Imagem)
      if (firstInvalidEl) {
        (firstInvalidEl as HTMLElement).scrollIntoView({ behavior: "smooth", block: "center" });
        setTimeout(() => {
          try { (firstInvalidEl as HTMLElement).focus(); } catch(e){}
        }, 400);
      }
      return;
    }

    submitBtn.disabled = true;
    submitBtn.textContent = "...";
    if (errorEl) errorEl.hidden = true;

    try {
      // Collect all form fields as JSON (files handled separately)
      const formData = new FormData(formEl);
      const fields: Record<string, string> = {};
      formData.forEach((value, key) => {
        if (key === "fotos") return; // skip files
        if (key === "atividade_fisica") {
          // Aggregate checkboxes into comma-separated string
          const existing = fields[key];
          fields[key] = existing ? `${existing}, ${value}` : String(value);
        } else {
          fields[key] = String(value);
        }
      });

      const res = await fetch("/.netlify/functions/submit-lead", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(fields),
      });

      if (!res.ok) throw new Error(await res.text());

      // Show success, hide form
      formEl.style.display = "none";
      if (successEl) {
        successEl.hidden = false;
        successEl.focus();
      }

      if (typeof window !== "undefined" && (window as any).fbq) {
        (window as any).fbq("track", "Lead");
      }
    } catch {
      if (errorEl) {
        errorEl.textContent = "Erro ao enviar. Tente novamente.";
        errorEl.hidden = false;
      }
      submitBtn.disabled = false;
      submitBtn.textContent = submitBtn.dataset.label ?? "Solicitar avaliação";
    }
  });

  // -- Sticky CTA: hide when #triagem visible --
  const stickyCta      = document.getElementById("sticky-cta");
  const triagemSection = document.getElementById("triagem");
  if (stickyCta && triagemSection) {
    const obs = new IntersectionObserver(entries => {
      entries.forEach(entry => {
        stickyCta.style.opacity = entry.isIntersecting ? "0" : "";
        stickyCta.style.pointerEvents = entry.isIntersecting ? "none" : "";
      });
    }, { threshold: 0.1 });
    obs.observe(triagemSection);
  }
</script>

<style>
  /* Modal overlay */
  .modal-overlay{position:fixed;inset:0;z-index:200;background:rgba(0,0,0,0.88);backdrop-filter:blur(6px);display:flex;align-items:center;justify-content:center;padding:var(--space-4);overflow-y:auto;}
  .modal-overlay[hidden]{display:none;}

  /* Container */
  .modal-container{background:var(--c-darkbg);border:var(--border-card);border-radius:8px;width:100%;max-width:680px;max-height:90vh;display:flex;flex-direction:column;position:relative;animation:modal-in 200ms ease;}
  @keyframes modal-in{from{opacity:0;transform:translateY(16px);}to{opacity:1;transform:translateY(0);}}

  /* Header */
  .modal-header{display:flex;align-items:flex-start;justify-content:space-between;gap:var(--space-4);padding:var(--space-5) var(--space-6);border-bottom:1px solid rgba(255,255,255,0.06);flex-shrink:0;}
  .modal-eyebrow{font-family:var(--font-label);font-size:var(--fs-label);font-weight:700;text-transform:uppercase;letter-spacing:0.1em;color:var(--c-lime);margin-bottom:var(--space-1);}
  .modal-title{font-family:var(--font-display);font-size:var(--fs-display-sm);color:var(--c-white);text-transform:uppercase;}
  .modal-close{font-size:1.2rem;color:var(--c-textsub);background:none;border:none;cursor:pointer;padding:var(--space-1);transition:color var(--transition-base);line-height:1;flex-shrink:0;}
  .modal-close:hover{color:var(--c-lime);}

  /* Body scrollable */
  .modal-body{overflow-y:auto;padding:var(--space-5) var(--space-6);flex:1;scrollbar-width:thin;scrollbar-color:var(--c-lime) var(--c-darkbg);}
  .modal-body::-webkit-scrollbar{width:4px;}
  .modal-body::-webkit-scrollbar-track{background:var(--c-darkbg);}
  .modal-body::-webkit-scrollbar-thumb{background:var(--c-lime);border-radius:2px;}

  /* Form */
  .triage-form{display:flex;flex-direction:column;gap:var(--space-6);}
  .form-section{display:flex;flex-direction:column;gap:var(--space-4);}
  .form-section__title{font-family:var(--font-display);font-size:var(--fs-display-sm);color:var(--c-lime);text-transform:uppercase;padding-bottom:var(--space-3);border-bottom:1px solid rgba(166,195,0,0.2);}
  .form-section__intro{font-size:var(--fs-body-sm);color:var(--c-textsub);font-style:italic;line-height:1.6;margin-top:calc(-1 * var(--space-2));}
  .form-grid{display:grid;gap:var(--space-4);}
  .form-grid--2{grid-template-columns:1fr 1fr;}
  .form-stack{display:flex;flex-direction:column;gap:var(--space-4);}
  @media(max-width:520px){.form-grid--2{grid-template-columns:1fr;}}

  /* Fields */
  .field{display:flex;flex-direction:column;gap:var(--space-2);}
  .field__label{font-family:var(--font-label);font-size:var(--fs-label);font-weight:700;text-transform:uppercase;letter-spacing:0.08em;color:var(--c-textsub);line-height:1.5;}
  .field__req{color:var(--c-lime);margin-left:2px;}
  .field__input,.field__textarea{background:var(--c-black);border:1px solid #2a2a2a;border-radius:4px;color:var(--c-white);font-family:var(--font-body);font-size:var(--fs-body-md);padding:0.75rem 1rem;transition:border-color var(--transition-base);width:100%;scrollbar-width:thin;scrollbar-color:var(--c-lime) var(--c-black);}
  .field__input::-webkit-scrollbar,.field__textarea::-webkit-scrollbar{width:4px;}
