---
// AdminHeader.astro — Cabeçalho compartilhado das páginas do painel admin.
// Importado por: /admin/index.astro, /admin/fichas.astro, /admin/login.astro
//
// Props:
//   badge   — rótulo do contexto atual (ex: "Admin", "Fichas"). Obrigatório.
//   backHref — se fornecido, exibe botão de voltar apontando para este href.
//   showLogout — exibe botão de logout (padrão: true).
//   showGuide — exibe o atalho para o Guia de Referência Rápida (padrão: true).
//     Fica em todas as telas do painel de propósito: a dúvida sobre o que um
//     aviso significa nasce com a ficha aberta, não no Hub. Desligar apenas na
//     própria página do guia, onde o atalho apontaria para ela mesma.
//
// Slot "primeiro" — entra ANTES do atalho do guia, dentro do mesmo contêiner.
//   Existe porque a especificação do catálogo (seção 6.3) pede um item próprio
//   no topo deste menu, e proíbe substituir o gatilho "⋮": em telas estreitas
//   ele é quem agrupa guia, voltar e encerrar sessão, e trocá-lo esconderia os
//   três. Slot em vez de prop: o item é da tela que o usa — o cabeçalho não
//   precisa saber o que ele faz, só onde ele fica. Quem preencher deve usar as
//   classes .adm-btn-icon e .adm-btn-icon__label para herdar o comportamento
//   de ícone solto no desktop e linha rotulada dentro do menu no celular.
//
// Slot "navegacao" — entra no TOPO do menu "⋮", acima de tudo, e só existe
//   onde o gatilho "⋮" existe (≤760px em retrato). Contrato DIFERENTE do slot
//   "primeiro": aquele recebe uma AÇÃO, que no desktop vira ícone solto; este
//   recebe NAVEGAÇÃO da própria página, que no desktop não vem para o
//   cabeçalho — a página a exibe onde lhe convier (no guia, uma coluna
//   lateral). Por isso o conteúdo daqui fica oculto fora do corte, em vez de
//   herdar .adm-btn-icon. Preenchido hoje só por /admin/guia; com o slot
//   vazio, o wrapper nem é renderizado e as demais telas não mudam em nada.

interface Props {
  badge: string;
  backHref?: string;
  showLogout?: boolean;
  showGuide?: boolean;
}

const { badge, backHref, showLogout = true, showGuide = true } = Astro.props;

// O atalho do guia carrega a página atual em "from" para que, se o guia por
// sua vez for aberto com o link "voltar" apontando para /admin/guia (ver
// guia.astro), ele saiba devolver o Coach à tela de onde partiu — em vez de
// sempre cair no Hub, que era o comportamento anterior.
const guideHref = `/admin/guia?from=${encodeURIComponent(Astro.url.pathname + Astro.url.search)}`;
---

<header class="adm-header">
  <div class="adm-header__left">
    <a href="/admin" class="adm-logo">ELITE90 PRO</a>
    <span class="adm-badge">{badge}</span>
  </div>
  <div class="adm-header__right">
    <button class="adm-menu-toggle" id="adm-menu-toggle" aria-haspopup="true" aria-expanded="false" aria-controls="adm-actions" aria-label="Mais ações">
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
        <circle cx="12" cy="5" r="1.8"/><circle cx="12" cy="12" r="1.8"/><circle cx="12" cy="19" r="1.8"/>
      </svg>
    </button>
    <div class="adm-actions" id="adm-actions">
      {Astro.slots.has("navegacao") && (
        <div class="adm-nav"><slot name="navegacao" /></div>
      )}
      <slot name="primeiro" />
      {showGuide && (
        <a
          class="adm-btn-icon adm-btn-icon--guide"
          href={guideHref}
          aria-label="Abrir o guia de referência rápida"
          title="Como o painel funciona"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="9"/>
            <path d="M9.2 9.2a2.9 2.9 0 0 1 5.6 1c0 1.9-2.8 2.4-2.8 4"/>
            <line x1="12" y1="17.4" x2="12" y2="17.4"/>
          </svg>
          <span class="adm-btn-icon__label">Como o painel funciona</span>
        </a>
      )}
      {backHref && (
        <button
          class="adm-btn-icon"
          onclick={`window.location.href='${backHref}'`}
          aria-label="Voltar"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square" stroke-linejoin="miter">
            <line x1="19" y1="12" x2="5" y2="12"/>
            <polyline points="12 19 5 12 12 5"/>
          </svg>
          <span class="adm-btn-icon__label">Voltar</span>
        </button>
      )}
      {showLogout && (
        <button
          class="adm-btn-icon"
          id="btn-logout"
          aria-label="Encerrar sessão"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square" stroke-linejoin="miter">
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"/>
          </svg>
          <span class="adm-btn-icon__label">Encerrar sessão</span>
        </button>
      )}
    </div>
  </div>
</header>

<style is:global>
  /* Estilos globais do header admin — usados em todas as páginas admin */
  .adm-header {
    background: var(--c-darkbg);
    border-bottom: 1px solid rgba(166, 195, 0, 0.15);
    padding: 0 var(--space-5);
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    position: sticky;
    top: 0;
    z-index: 100;
  }
  .adm-header__left  { display: flex; align-items: center; gap: var(--space-3); }
  .adm-header__right { display: flex; align-items: center; gap: var(--space-2); position: relative; }
  .adm-actions { display: flex; align-items: center; gap: var(--space-2); }
  .adm-btn-icon__label { display: none; }
  /* Navegação da página: só aparece onde o gatilho "⋮" aparece. Fora do corte
     ela é responsabilidade da própria página, que a exibe do jeito dela. */
  .adm-nav { display: none; }

  /* Gatilho "⋮" — some no desktop, onde os três ícones cabem soltos.
     Some também em landscape: mesmo abaixo de 760px de largura, a altura
     do celular deitado sobra e a linha inteira cabe sem colidir. Só em
     retrato (o formato em que a colisão foi reportada) a largura some e
     os três ícones — mais logo e badge — deixam de caber numa linha. */
  .adm-menu-toggle {
    display: none;
    background: transparent;
    color: var(--c-textsub);
    border: 1px solid rgba(166, 195, 0, 0.25);
    border-radius: var(--radius-card);
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    cursor: pointer;
    transition: color var(--transition-base), border-color var(--transition-base), background var(--transition-base);
  }
  .adm-menu-toggle:hover,
  .adm-menu-toggle[aria-expanded="true"] {
    color: var(--c-lime);
    border-color: rgba(166, 195, 0, 0.6);
    background: rgba(166, 195, 0, 0.05);
  }

  @media (max-width: 760px) and (orientation: portrait) {
    .adm-menu-toggle { display: inline-flex; }
    .adm-actions {
      /* display:flex fica fixo (não é mais o que abre/fecha o painel) — quem
         faz isso agora é visibility/opacity/transform logo abaixo, porque um
         display:none->flex não anima: o navegador troca de estado no mesmo
         quadro, sem quadro intermediário para a transição percorrer. */
      display: flex;
      position: absolute;
      top: calc(100% + 8px);
      right: 0;
      z-index: 150;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      /* Piso, não largura fixa: o painel continua se ajustando ao conteúdo de
         cada tela. Subiu de 230px porque o índice do guia traz títulos de
         seção, não rótulos de ação — a 230px quatro deles quebravam em duas
         linhas e o painel crescia 100px em altura. Nas telas que só têm ações
         nada muda: os rótulos delas já cabiam. */
      min-width: 288px;
      /* Teto de altura + rolagem interna: sem isso, um menu alto demais
         esconderia justamente as últimas linhas — voltar e encerrar sessão.
         Só o eixo vertical rola; o horizontal segue recortado pelo raio. */
      max-height: calc(100vh - 96px);
      background: var(--c-darkbg);
      border: 1px solid rgba(166, 195, 0, 0.25);
      border-radius: var(--radius-card);
      box-shadow: 0 12px 32px rgba(0, 0, 0, 0.6);
      overflow: hidden auto;
      /* Fechado: invisível E fora da árvore de acessibilidade/tabulação —
         visibility:hidden faz isso, ao contrário de opacity/pointer-events
         sozinhos, que deixariam os itens focáveis via Tab mesmo escondidos.
         O delay na transição de visibility é o que faz a saída (fade-out)
         terminar de tocar antes do painel sumir de vez; na entrada o delay
         é zero, porque não há nada para esperar. */
      opacity: 0;
      visibility: hidden;
      transform: translateY(-8px) scale(0.97);
      transform-origin: top right;
      transition: opacity 160ms ease, transform 160ms ease, visibility 0s linear 160ms;
    }
    .adm-actions.is-open {
      opacity: 1;
      visibility: visible;
      transform: translateY(0) scale(1);
      transition: opacity 160ms ease, transform 160ms ease, visibility 0s linear 0s;
    }
    .adm-nav { display: block; }
    .adm-actions .adm-btn-icon {
      width: auto;
      height: auto;
      border: none;
      border-radius: 0;
      justify-content: flex-start;
      gap: var(--space-3);
      padding: 14px var(--space-4);
      border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    }
    .adm-actions .adm-btn-icon:last-child { border-bottom: none; }
    .adm-btn-icon__label {
      display: inline;
      font-family: var(--font-label);
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.06em;
    }
  }

  /* Inset lateral menor no mobile — mesmo valor (--space-3) já usado como
     padding horizontal em fichas.astro sob o mesmo corte de 760px. Só o
     lado esquerdo muda: o direito já fica justo por conta dos botões. */
  @media (max-width: 760px) {
    .adm-header { padding-left: var(--space-3); }
  }

  .adm-logo {
    font-family: var(--font-display);
    font-size: var(--fs-display-md);
    font-weight: 400;
    letter-spacing: 0.05em;
    color: var(--c-lime);
    text-transform: uppercase;
    text-decoration: none;
  }
  .adm-badge {
    font-family: var(--font-label);
    font-size: var(--fs-label);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    background: rgba(166, 195, 0, 0.1);
    color: var(--c-lime);
    border: 1px solid rgba(166, 195, 0, 0.25);
    border-radius: 3px;
    padding: 4px 10px;
  }
  .adm-btn-icon {
    background: transparent;
    color: var(--c-textsub);
    border: 1px solid rgba(166, 195, 0, 0.25);
    border-radius: var(--radius-card);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    cursor: pointer;
    transition: color var(--transition-base), border-color var(--transition-base), background var(--transition-base);
  }
  .adm-btn-icon:hover {
    color: var(--c-lime);
    border-color: rgba(166, 195, 0, 0.6);
    background: rgba(166, 195, 0, 0.05);
  }
  /* O atalho do guia é consulta, não ação: borda apagada em repouso, para não
     disputar atenção com voltar e encerrar sessão. Acende igual aos demais no
     hover, porque continua sendo um alvo clicável do mesmo peso. */
  .adm-btn-icon--guide {
    border-color: rgba(255, 255, 255, 0.1);
    text-decoration: none;
  }
</style>

<script>
  // Menu "⋮" do mobile (≤760px) — guia/voltar/sair colapsados numa lista.
  // No desktop o toggle fica oculto por CSS e os três ícones já aparecem
  // soltos, então este script só tem efeito visível abaixo do corte.
  const menuToggle = document.getElementById("adm-menu-toggle");
  const actions = document.getElementById("adm-actions");

  function closeMenu() {
    actions?.classList.remove("is-open");
    menuToggle?.setAttribute("aria-expanded", "false");
  }

  menuToggle?.addEventListener("click", (e) => {
    e.stopPropagation();
    const isOpen = actions?.classList.toggle("is-open");
    menuToggle.setAttribute("aria-expanded", String(!!isOpen));
  });

  document.addEventListener("click", (e) => {
    if (!actions?.classList.contains("is-open")) return;
    if (actions.contains(e.target as Node) || menuToggle?.contains(e.target as Node)) return;
    closeMenu();
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeMenu();
  });

  actions?.addEventListener("click", (e) => {
    if ((e.target as Element)?.closest("a, button")) closeMenu();
  });
</script>