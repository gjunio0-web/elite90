---
import LanguageSwitcher from "./LanguageSwitcher.astro";
import type { Locale } from "../i18n/utils";
import type { Translations } from "../i18n/pt";

interface Props { t: Translations; locale: Locale; }
const { t, locale } = Astro.props;
const n = t.nav;

// Nav links in page order
const navLinks = [
  { href: "#cronograma",  label: n.schedule },
  { href: "#coach",       label: n.coach },
  { href: "#pilares",     label: n.method },
  { href: "#resultados",  label: n.results },
  { href: "#processo",    label: n.process },
  { href: "#depoimentos", label: n.testimonials },
  { href: "#parceiros",   label: n.partners },
  { href: "#faq",         label: n.faq },
];
---

<header class="site-header" id="site-header" data-scrolled="false">
  <div class="site-header__inner container">

    <!-- Logo -->
    <a href="#" class="site-header__logo" id="logo-home-link" aria-label="Coach Ruiz - Topo da página">
      <img
        src="/images/brand/logo-header.webp"
        srcset="/images/brand/logo-header.webp 1x, /images/brand/logo-header@2x.webp 2x"
        alt="Coach Ruiz"
        class="site-header__logo-img"
        width="280" height="70"
        loading="eager"
      />
    </a>

    <!-- Desktop nav -->
    <nav class="site-header__nav" id="site-nav" aria-label="Navegacao principal" style="position: relative; display: flex; align-items: center; overflow: hidden; max-height: 100%;">
      
      <div class="nav-flex-wrapper" id="nav-flex-wrapper" style="display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-4); width: 100%; max-height: 35px; overflow: hidden;">
        {navLinks.map(link => (
          <a
            href={link.href}
            class="site-header__link"
            data-nav-link
            data-href={link.href}
          >
            {link.label}
          </a>
        ))}

        <div class="site-header__more" id="nav-more" style="display: none; position: relative; z-index: 10;">
          <button
            class="site-header__link site-header__more-btn"
            id="nav-more-btn"
            type="button"
            aria-expanded="false"
            aria-haspopup="true"
          >
            {n.more}
            <svg class="site-header__more-icon" width="10" height="10" viewBox="0 0 10 10" aria-hidden="true">
              <path d="M1 3l4 4 4-4" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round"/>
            </svg>
          </button>
          <div class="site-header__dropdown" id="nav-dropdown" hidden role="menu">
          </div>
        </div>
      </div>
    </nav>

    <!-- Right: lang + CTA + hamburger -->
    <div class="site-header__right">
      <LanguageSwitcher currentLocale={locale} />
      <button class="btn-cta site-header__cta" id="header-cta-btn" type="button" aria-haspopup="dialog">
        {n.applyCta}
      </button>
      <button
        class="site-header__hamburger"
        id="hamburger-btn"
        type="button"
        aria-label={n.menu}
        aria-expanded="false"
        aria-controls="mobile-drawer"
      >
        <span class="site-header__bar"></span>
        <span class="site-header__bar"></span>
        <span class="site-header__bar"></span>
      </button>
    </div>
  </div>
</header>

<!-- Mobile drawer (no CTA button inside) -->
<div class="mobile-drawer" id="mobile-drawer" role="dialog" aria-modal="true" aria-label={n.menu} hidden>
  <div class="mobile-drawer__overlay" id="drawer-overlay"></div>
  <nav class="mobile-drawer__panel" aria-label="Menu mobile">
    <button class="mobile-drawer__close" id="drawer-close" type="button" aria-label={n.close}>&#x2715;</button>
    {navLinks.map(link => (
      <a href={link.href} class="mobile-drawer__link" data-drawer-link>{link.label}</a>
    ))}
    <div class="mobile-drawer__lang">
      <LanguageSwitcher currentLocale={locale} />
    </div>
  </nav>
</div>

<script>
  // -- Transparent → solid on scroll -------------------------------------------
  const header = document.getElementById("site-header") as HTMLElement;
  function updateHeader() {
    if (!header) return;
    const scrollY = window.scrollY;
    const isScrolled = scrollY > 80;

    if (header.getAttribute("data-scrolled") !== String(isScrolled)) {
      header.setAttribute("data-scrolled", String(isScrolled));
      
      // EXECUTAR CORREÇÃO: Força o recálculo imediato da geometria dos links
      // assim que o CSS alterar a escala e a altura do cabeçalho.
      syncOverflowMenu();
    }
  }
  window.addEventListener("scroll", updateHeader, { passive: true });
  updateHeader();

  // Logo click -> smooth scroll to top
  document.getElementById("logo-home-link")?.addEventListener("click", e => {
    e.preventDefault();
    window.scrollTo({ top: 0, behavior: "smooth" });
  });

  // -- Active link highlight ----------------------------------------------------
  const navLinkEls = document.querySelectorAll<HTMLAnchorElement>("[data-nav-link]");
  const sectionIds = ["cronograma","coach","pilares","resultados",
                      "processo","depoimentos","parceiros","faq","triagem"];

  const sectionObserver = new IntersectionObserver(entries => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const id = entry.target.id;
        navLinkEls.forEach(link => {
          link.classList.toggle(
            "site-header__link--active",
            link.dataset.href === `#${id}`
          );
        });
      }
    });
  }, { rootMargin: "-40% 0px -55% 0px" });

  sectionIds.forEach(id => {
    const el = document.getElementById(id);
    if (el) sectionObserver.observe(el);
  });

  // -- Overflow "Mais" menu (Abordagem Absoluta por Geometria Pura em Memória) ----
  const navFlexWrapper = document.getElementById("nav-flex-wrapper") as HTMLElement;
  const moreWrap       = document.getElementById("nav-more") as HTMLElement;
  const moreBtn        = document.getElementById("nav-more-btn") as HTMLButtonElement;
  const dropdown       = document.getElementById("nav-dropdown") as HTMLElement;
  const moreIcon       = moreBtn?.querySelector(".site-header__more-icon") as SVGElement;

  // Constantes de Engenharia Geométrica (Cálculo Preditivo Blindado)
  const LARGURA_FIXA_MAIS = 85; // Espaço físico estendido para absorver "MAIS ⌄" / "MORE ⌄" sem vazamento

  // Teletransporta o dropdown para fora da jaula de overflow:hidden assim que o script inicializa
  if (dropdown && dropdown.parentElement !== document.body) {
    document.body.appendChild(dropdown);
  }

  // Função para calcular e alinhar dinamicamente a posição flutuante do dropdown na tela (Ação 2.2)
  function positionDropdown() {
    if (!moreBtn || !dropdown) return;
    const rect = moreBtn.getBoundingClientRect();
    
    dropdown.style.position = "absolute";
    dropdown.style.zIndex = "9999";
    dropdown.style.margin = "0";
    
    // Neutraliza o 'right: 0' do CSS estático para permitir o alinhamento via JS
    dropdown.style.right = "auto";

    // --- CORREÇÃO DE FORMATAÇÃO EM RUNTIME ---
    // Força o contêiner do dropdown a empilhar os links verticalmente e com espaçamento isolado
    dropdown.style.display = "flex";
    dropdown.style.flexDirection = "column";
    dropdown.style.padding = "8px 0"; // Equivalente a var(--space-2)
    
    // Aplica o espaçamento e quebra de linha individual em cada link clonado lá dentro
    const dropdownItems = dropdown.querySelectorAll<HTMLAnchorElement>(".site-header__dropdown-item");
    dropdownItems.forEach(item => {
      item.style.display = "block";
      item.style.padding = "12px 16px"; // Equivalente a var(--space-3) var(--space-4)
      item.style.whiteSpace = "nowrap";
    });
    // -----------------------------------------
    
    // Calcula a largura dinâmica real (absorve traduções i18n)
    const dropdownWidth = dropdown.offsetWidth || 180;
    
    // Injeta as coordenadas absolutas ancoradas ao botão [Mais]
    dropdown.style.top = `${rect.bottom + window.scrollY + 12}px`;
    dropdown.style.left = `${rect.right + window.scrollX - dropdownWidth}px`;
  }

  function syncOverflowMenu() {
    if (!navFlexWrapper || !moreWrap || !dropdown || !moreBtn) return;

    // --- FASE 1: LEITURA PURA (Tarefa B - Read) ---

    // Captura primeiro a largura física real e imutável que a barra possui na tela
    const larguraDisponivelTotal = navFlexWrapper.offsetWidth;

    // Forçamos temporariamente o reset para medir a largura nativa real dos links
    moreWrap.style.display = "none";
    const links = Array.from(navFlexWrapper.querySelectorAll<HTMLAnchorElement>("a[data-nav-link]"));
    links.forEach(link => { 
      link.style.display = ""; 
      link.setAttribute("tabindex", "0"); // Restaura o foco padrão
    });
    
    // Captura as larguras físicas que o HTML/CSS distribuiu previamente na tela
    const largurasLinks = links.map(link => link.offsetWidth);

    // Interroga o motor de renderização para obter o gap real computado pelo CSS (Ação 2)
    const estiloComputado = window.getComputedStyle(navFlexWrapper);
    const gapTexto = estiloComputado.gap || estiloComputado.columnGap;
    const GAP_PIXELS = gapTexto && gapTexto !== "normal" ? parseFloat(gapTexto) : 16;

    // --- FASE 2: CÁLCULO PREDITIVO EM MEMÓRIA POR SIMULAÇÃO VIRTUAL (Tarefa C - Compute) ---
    let somaLargurasFila = 0;
    let precisaDeMais = false;
    let indiceCorte = links.length; // Por padrão, assume que todos os links cabem

    // 1. Primeiro teste: a fila inteira de links cabe na barra sem o botão "Mais"?
    for (let i = 0; i < links.length; i++) {
      const espacamento = i > 0 ? GAP_PIXELS : 0;
      somaLargurasFila += largurasLinks[i] + espacamento;

      if (somaLargurasFila > larguraDisponivelTotal) {
        precisaDeMais = true;
        break;
      }
    }

    // 2. Se a fila estourou, simulamos o encaixe em lote inserindo o botão "Mais" de forma dinâmica
    if (precisaDeMais) {
      let somaAcumuladaComMais = 0;
      
      for (let i = 0; i < links.length; i++) {
        const espacamento = i > 0 ? GAP_PIXELS : 0;
        
        // Mede virtualmente quanto espaço este link + o espaçamento + o botão "Mais" ocupariam juntos
        const larguraDesteLinkComBotaoMais = largurasLinks[i] + espacamento + GAP_PIXELS + LARGURA_FIXA_MAIS;

        // Se essa projeção ultrapassar a largura física da barra, o corte ocorre retroativamente neste link
        if (somaAcumuladaComMais + larguraDesteLinkComBotaoMais > larguraDisponivelTotal) {
          indiceCorte = i;
          break;
        }

        // Se a simulação passou, acumula o espaço real do link para o próximo teste
        somaAcumuladaComMais += largurasLinks[i] + espacamento;
      }
    }

    // --- FASE 3: ESCRITA ÚNICA EM LOTE (Tarefa B - Write) ---
    dropdown.innerHTML = "";
    const fragmentoDropdown = document.createDocumentFragment();

    links.forEach((link, indice) => {
      if (indice >= indiceCorte) {
        // Elementos cortados matematicamente: somem da barra e vão para o Dropdown
        link.style.display = "none";
        link.setAttribute("tabindex", "-1"); // Bloqueia foco do teclado (WCAG 2.2)

        const a = document.createElement("a");
        a.href = link.getAttribute("href") ?? "#";
        a.className = "site-header__dropdown-item";
        a.textContent = link.textContent?.trim() ?? "";
        a.setAttribute("role", "menuitem");

        // --- CORREÇÃO DE ASSINATURA DE ESCOPO (Astro Scoping) ---
        // Descobre dinamicamente se o link original possui o atributo com o hash do Astro
        const astroAttr = Array.from(link.attributes).find(attr => attr.name.startsWith('data-astro-cid'));
        if (astroAttr) {
          // Aplica exatamente a mesma assinatura do Astro no novo link criado
          a.setAttribute(astroAttr.name, astroAttr.value);
        }
        // --------------------------------------------------------
        
        fragmentoDropdown.appendChild(a);
      }
    });

    // Despejo físico e controle de visibilidade baseado em dados estruturais consistentes
    if (indiceCorte < links.length) {
      dropdown.appendChild(fragmentoDropdown);
      moreWrap.style.display = "inline-block"; // Posiciona o botão colado ao último link visível
    } else {
      moreWrap.style.display = "none";
      dropdown.hidden = true;
      moreBtn.setAttribute("aria-expanded", "false");
      if (moreIcon) moreIcon.style.transform = "";
    }
  }


  // Mecânica do debounce para blindar o ResizeObserver contra o Layout Thrashing
  let timeoutId: number;
  const resizeObserver = new ResizeObserver(() => {
    clearTimeout(timeoutId);
    timeoutId = window.setTimeout(syncOverflowMenu, 40); // Aguarda a estabilização da janela
  });

  if (navFlexWrapper) {
    resizeObserver.observe(navFlexWrapper);
  }


  // Mecânica do gatilho de clique corrigida alternando a propriedade hidden nativa do DOM
  moreBtn?.addEventListener("click", (e) => {
    e.stopPropagation();
    const isHidden = dropdown.hidden;
    dropdown.hidden = !isHidden;
    moreBtn.setAttribute("aria-expanded", String(isHidden));
    
    // Ativa o cálculo de portal se o menu estiver abrindo
    if (isHidden) {
      positionDropdown();
    }
    
    if (moreIcon) {
      moreIcon.style.transform = isHidden ? "rotate(180deg)" : "";
    }
  });

  // Fechamento nativo ao clicar fora da área do menu dropdown
  document.addEventListener("click", (e) => {
    if (!moreWrap?.contains(e.target as Node)) {
      dropdown.hidden = true;
      moreBtn?.setAttribute("aria-expanded", "false");
      if (moreIcon) moreIcon.style.transform = "";
    }
  });

  if ('fonts' in document) {
    document.fonts.ready.then(() => {
      syncOverflowMenu();
    });
  } else {
    setTimeout(syncOverflowMenu, 100);
  }
  window.addEventListener("load", syncOverflowMenu);

  // Garante que o dropdown flutuante acompanhe a barra durante a rolagem ou redimensionamento
  window.addEventListener("scroll", () => {
    if (dropdown && !dropdown.hidden) positionDropdown();
  }, { passive: true });

  window.addEventListener("resize", () => {
    if (dropdown && !dropdown.hidden) positionDropdown();
  }, { passive: true });

  // -- Drawer --------------------------------------------------------------------
  const hamburger  = document.getElementById("hamburger-btn") as HTMLButtonElement;
  const drawer     = document.getElementById("mobile-drawer") as HTMLElement;
  const overlay    = document.getElementById("drawer-overlay") as HTMLElement;
  const closeBtn   = document.getElementById("drawer-close") as HTMLButtonElement;
  const drawerLinks = document.querySelectorAll("[data-drawer-link]");

  function openDrawer() {
    drawer.hidden = false;
    hamburger.setAttribute("aria-expanded", "true");
    document.body.style.overflow = "hidden";
    closeBtn.focus();
  }
  function closeDrawer() {
    drawer.hidden = true;
    hamburger.setAttribute("aria-expanded", "false");
    document.body.style.overflow = "";
    hamburger.focus();
  }

  hamburger.addEventListener("click", openDrawer);
  closeBtn.addEventListener("click", closeDrawer);
  overlay.addEventListener("click", closeDrawer);
  drawerLinks.forEach(l => l.addEventListener("click", closeDrawer));
  document.addEventListener("keydown", e => {
    if (e.key === "Escape" && !drawer.hidden) closeDrawer();
  });
</script>

<style>
  .site-header {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 50;
    height: 80px;
    background: transparent;
    border-bottom: 1px solid transparent;
    transition: background 300ms ease, height 300ms ease,
                border-color 300ms ease, backdrop-filter 300ms ease;
  }

  .site-header[data-scrolled="true"] {
    height: 64px;
    background: rgba(13,13,13,0.94);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom-color: rgba(166,195,0,0.12);
  }

  .site-header__inner {
    height: 100%;
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  /* Logo */
  .site-header__logo {
    display: flex;
    align-items: center;
    text-decoration: none;
    flex-shrink: 0;
  }

  .site-header__logo-img {
    height: 52px;
    width: auto;
    object-fit: contain;
    transition: height 300ms ease;
  }

  .site-header[data-scrolled="true"] .site-header__logo-img { height: 40px; }

  /* Nav */
  .site-header__nav {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex: 1;
    overflow: hidden;
    min-width: 0;
  }

  .site-header__link {
    font-family: var(--font-label);
    font-size: 0.66rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgba(204,204,204,0.75);
    text-decoration: none;
    white-space: nowrap;
    flex-shrink: 0;
    padding-bottom: 2px;
    border-bottom: 1px solid transparent;
    transition: color var(--transition-base), border-color var(--transition-base);
  }

  .site-header__link:hover,
  .site-header__link:focus-visible { color: var(--c-white); }

  .site-header__link--active {
    color: var(--c-lime);
    border-bottom-color: var(--c-lime);
  }

  /* More dropdown */
  .site-header__more {
    position: relative;
    flex-shrink: 0;
  }

  .site-header__more-btn {
    display: flex;
    align-items: center;
    gap: 4px;
    background: none;
    border: none;
    cursor: pointer;
    font-family: var(--font-label);
    font-size: 0.66rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgba(204,204,204,0.75);
    padding-bottom: 2px;
    white-space: nowrap;
    transition: color var(--transition-base);
  }

  .site-header__more-btn:hover { color: var(--c-white); }

  .site-header__more-icon {
    transition: transform 200ms ease;
    stroke: currentColor;
  }

  .site-header__dropdown {
    position: absolute;
    top: calc(100% + 12px);
    right: 0;
    background: rgba(13,13,13,0.97);
    border: 1px solid rgba(166,195,0,0.18);
    border-radius: 6px;
    backdrop-filter: blur(12px);
    min-width: 180px;
    padding: var(--space-2) 0;
    z-index: 60;
    box-shadow: 0 8px 32px rgba(0,0,0,0.5);
  }

  .site-header__dropdown-item {
    display: block;
    padding: var(--space-3) var(--space-4);
    font-family: var(--font-label);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--c-textsub);
    text-decoration: none;
    transition: color var(--transition-base), background var(--transition-base);
  }

  .site-header__dropdown-item:hover {
    color: var(--c-lime);
    background: rgba(166,195,0,0.05);
  }

  /* Right slot */
  .site-header__right {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-shrink: 0;
    margin-left: auto;
  }

  .site-header__cta {
    padding: 0.4rem 1rem;
    font-size: 0.65rem;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .site-header__hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 36px; height: 36px;
    background: none; border: none;
    cursor: pointer; padding: 4px;
    flex-shrink: 0;
  }

  .site-header__bar {
    display: block; width: 100%; height: 2px;
    background-color: var(--c-lime); border-radius: 2px;
  }

  /* Mobile drawer */
  .mobile-drawer {
    position: fixed; inset: 0; z-index: 100;
    display: flex;
  }
  .mobile-drawer[hidden] { display: none; }

  .mobile-drawer__overlay {
    position: absolute; inset: 0;
    background: rgba(0,0,0,0.75);
    backdrop-filter: blur(4px);
  }

  .mobile-drawer__panel {
    position: relative;
    margin-left: auto;
    width: min(300px, 85vw);
    height: 100%;
    background: var(--c-darkbg);
    border-left: 1px solid rgba(166,195,0,0.15);
    display: flex; flex-direction: column;
    padding: var(--space-6) var(--space-5);
    gap: var(--space-3);
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: var(--c-lime) var(--c-darkbg);
  }

  .mobile-drawer__close {
    align-self: flex-end;
    font-size: 1.2rem; color: var(--c-textsub);
    background: none; border: none; cursor: pointer;
    padding: var(--space-2); margin-bottom: var(--space-4);
    transition: color var(--transition-base);
  }
  .mobile-drawer__close:hover { color: var(--c-lime); }

  .mobile-drawer__link {
    font-family: var(--font-label);
    font-size: 0.875rem; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.1em;
    color: var(--c-textbody); text-decoration: none;
    padding-block: var(--space-3);
    border-bottom: 1px solid rgba(255,255,255,0.06);
    transition: color var(--transition-base);
  }
  .mobile-drawer__link:hover { color: var(--c-lime); }

  .mobile-drawer__lang { margin-top: auto; padding-top: var(--space-5); }

  /* Breakpoint Definitivo: Reorganização de Fluxo Mobile */
  @media (max-width: 1025px) {
    /* 1. Esconde a navegação inteira (links + botão mais) */
    .site-header__nav { 
      display: none !important; 
    }
    
    /* 2. Esconde o botão de CTA de desktop */
    .site-header__cta { 
      display: none !important; 
    }
    
    /* 3. Força o hambúrguer a aparecer */
    .site-header__hamburger { 
      display: flex !important; 
    }

    /* 4. CORREÇÃO SISTÊMICA: Força o contêiner pai a empurrar as duas extremidades */
    .site-header__inner {
      display: flex !important;
      justify-content: space-between !important;
      align-items: center !important;
    }

    /* 5. Garante que o bloco da direita não retenha larguras ou margens do desktop */
    .site-header__right {
      flex: none !important;
      display: flex !important;
      align-items: center !important;
      gap: var(--space-4) !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header,
    .site-header__logo-img,
    .site-header__more-icon { transition: none; }
  }
</style>
