---
interface Props {
  stage1: string;
  stage2: string;
  stage3: string;
  targetId?: string;
}
const { stage1, targetId = "triagem" } = Astro.props;
---

<div class="sticky-cta" id="sticky-cta" aria-hidden="true">
  <button
    class="btn-cta sticky-cta__btn"
    id="sticky-cta-btn"
    type="button"
    aria-haspopup="dialog"
  >
    {stage1}
  </button>
</div>

<script>
  const wrap = document.getElementById("sticky-cta");
  const btn  = document.getElementById("sticky-cta-btn");
  if (!wrap || !btn) throw new Error("sticky-cta missing");

  const heroEl        = document.querySelector(".hero");
  const motivSection  = document.querySelector(".motivational");
  const ctaSection    = document.getElementById("triagem");
  let visible = false;
  let suppressed = false;

  // Hide sticky when motivational CTA or final CTA section is on screen
  const suppressObserver = new IntersectionObserver(entries => {
    entries.forEach(entry => {
      if (entry.isIntersecting) suppressed = true;
    });
    // Check if ANY observed section is still intersecting
    const anyVisible = entries.some(e => e.isIntersecting);
    if (!anyVisible) {
      // Re-check all entries from observer
    }
    // Simple: hide if any target is visible
    suppressed = entries.some(e => e.isIntersecting);
    applyVisibility();
  }, { threshold: 0.1 });

  if (motivSection) suppressObserver.observe(motivSection);
  if (ctaSection)   suppressObserver.observe(ctaSection);

  function applyVisibility() {
    const show = visible && !suppressed;
    wrap.setAttribute("aria-hidden", String(!show));
    wrap.classList.toggle("sticky-cta--visible", show);
  }

  function update() {
    const heroBottom = (heroEl?.getBoundingClientRect().bottom ?? 0) + window.scrollY;
    const shouldShow = window.scrollY > heroBottom * 0.7;
    if (shouldShow !== visible) {
      visible = shouldShow;
      applyVisibility();
    }
  }

  window.addEventListener("scroll", update, { passive: true });
  update();

  btn.addEventListener("click", () => {
    document.dispatchEvent(new CustomEvent("open-triage-modal"));
  });
</script>

<style>
  .sticky-cta {
    position: fixed;
    bottom: 0; left: 0; right: 0;
    z-index: 90;
    padding: var(--space-3) var(--space-4);
    background: linear-gradient(to top, rgba(13,13,13,.98) 60%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    transform: translateY(100%);
    transition: transform var(--transition-slow), opacity var(--transition-slow);
    pointer-events: none;
    display: none;
    opacity: 1;
  }

  .sticky-cta--visible {
    transform: translateY(0);
    pointer-events: auto;
  }

  .sticky-cta__btn {
    width: 100%;
    min-height: 52px;
    font-size: var(--fs-body-sm);
    white-space: normal;
    text-align: center;
    line-height: 1.3;
    padding: 0.875rem 1.5rem;
  }

  @media (max-width: 767px) {
    .sticky-cta { display: block; }
  }

  @media (prefers-reduced-motion: reduce) {
    .sticky-cta { transition: none; }
  }
</style>
