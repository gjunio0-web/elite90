---
import Fluxogramas from './Fluxogramas.astro';

// GAVETA DOS FLUXOS — substitui as rotas /admin/fluxos e /profissional/fluxos,
// que existiram entre o patch D e este.
//
// POR QUE GAVETA DESLIZANTE, E NÃO PÁGINA
// A coluna de leitura dos guias tem ~1080px, e o índice lateral come 264 — sobra
// perto de 790 de área útil, contra 1200 de largura do fluxo II. Embutido no
// corpo, o desenho renderizaria a dois terços, com rótulo abaixo de 11px. A
// gaveta recupera a largura que o fluxo precisa SEM tirar o leitor do parágrafo
// em que estava — mesmo #athlete-drawer/.drawer-panel de admin/atletas.astro
// (fixed + flex justify-content:flex-end + transform:translateX), só que mais
// larga, porque o conteúdo que ela guarda é mais largo. O preço é a rolagem
// interna, que aqui não é defeito: é o que .drawer-content-wrap já faz lá.
//
// O QUE A GAVETA NÃO PODE PERDER EM RELAÇÃO À PÁGINA
// Eram duas coisas, e as duas estão resolvidas aqui:
//   · endereço que se manda a alguém → a gaveta abre sozinha quando a URL
//     termina em #fluxos, e escreve isso na barra ao abrir;
//   · impressão → a regra de @media print revela o conteúdo e esconde o guia.
//
// COMO SE USA
// Importe este componente uma vez na página e ponha, em qualquer lugar dela,
// um elemento com [data-gvf-abrir]. O script liga todos de uma vez — o gatilho
// não precisa ser vizinho da gaveta nem conhecer o id dela.
---
<div class="gvf" id="gvf" hidden role="dialog" aria-modal="true" aria-labelledby="gvf-titulo">
  <div class="gvf-panel">
    <div class="gvf-topo">
      <div>
        <div class="gvf-eyebrow">Coach Ruiz · Elite 90 Pro</div>
        <h2 class="gvf-h1" id="gvf-titulo">Fluxos da delegação</h2>
      </div>
      <button type="button" class="gvf-fechar" data-gvf-fechar aria-label="Fechar os fluxos">✕</button>
    </div>

    <div class="gvf-corpo" tabindex="-1">
      <div class="gvf-wrap">
        <p class="gvf-lead">São dois, e não um. O primeiro acontece uma vez por profissional. O
          segundo acontece muitas vezes, para cada atleta e cada plano, enquanto o vínculo durar.</p>

        <div class="gvf-legenda">
          <span class="gvf-lg"><svg width="44" height="22" aria-hidden="true"><rect x="1" y="3" width="42" height="16" rx="8" fill="#A6C300"/></svg>Início ou fim</span>
          <span class="gvf-lg"><svg width="44" height="22" aria-hidden="true"><rect x="1" y="3" width="42" height="16" rx="2" fill="#1A1A1A" stroke="#8A8A82" stroke-width="1.5"/></svg>Processo</span>
          <span class="gvf-lg"><svg width="44" height="22" aria-hidden="true"><polygon points="22,2 43,11 22,20 1,11" fill="#1A1A1A" stroke="#8A8A82" stroke-width="1.5"/></svg>Decisão</span>
          <span class="gvf-lg"><svg width="44" height="22" aria-hidden="true"><circle cx="22" cy="11" r="9" fill="#0D0D0D" stroke="#A6C300" stroke-width="1.5"/></svg>Conector</span>
          <span class="gvf-lg"><svg width="44" height="22" aria-hidden="true"><line x1="2" y1="11" x2="34" y2="11" stroke="#8A8A82" stroke-width="1.5"/><path d="M34 6L41 11L34 16" fill="none" stroke="#8A8A82" stroke-width="1.5"/></svg>Fluxo</span>
        </div>

        <section class="gvf-fl">
          <div class="gvf-n">I</div>
          <h3 class="gvf-h2">Ciclo de vida do profissional</h3>
          <p>Acontece uma vez. Vai da decisão do Coach de trazer alguém para o programa até a saída
            dessa pessoa. Entre uma ponta e outra existe um estado — profissional ativo — que dura o
            tempo que durar, e é dentro dele que o fluxo II roda, quantas vezes for preciso.</p>
          <Fluxogramas qual="i" />
        </section>

        <section class="gvf-fl">
          <div class="gvf-n">II</div>
          <h3 class="gvf-h2">Ciclo de um plano</h3>
          <p>Acontece muitas vezes: uma por atleta, por especialidade e por rodada de plano. Começa
            quando o Coach atribui um atleta e termina quando o plano publicado chega às mãos dele.
            Rodar de novo é voltar ao começo deste fluxo, não do primeiro.</p>
          <Fluxogramas qual="ii" />
        </section>

        <section class="gvf-notas">
          <h3 class="gvf-h3">Como ler</h3>
          <p>A coluna em que um símbolo está diz de quem é o ato, e toda seta que muda de coluna é
            uma passagem de responsabilidade. Em tela estreita, a mesma sequência aparece em coluna
            única, com o nome do ator dentro de cada símbolo.</p>
          <p>Os círculos são conectores. As <strong>letras</strong> marcam retorno a um ponto já
            desenhado acima. Os <strong>números</strong> marcam salto adiante e só aparecem na versão
            em coluna, onde um ramo não tem por onde contornar. Círculo tracejado é saída, contínuo
            é entrada.</p>
          <p>Duas coisas que o desenho deixa explícitas de propósito. A saída do profissional exige
            <strong>dois atos separados</strong>: encerrar cada atribuição, uma a uma, e revogar o
            acesso — um não implica o outro. E o cadastro nunca é apagado, porque a autoria das
            versões publicadas aponta para ele.</p>
        </section>
      </div>
    </div>
  </div>
</div>

<style is:global>
  /* O invólucro é só o pano de fundo: fixo, cobre a tela inteira, mas começa
     transparente e sem bloquear nada por trás até .open ligar. É ele que
     recebe o clique fora do painel para fechar (mesmo papel de #athlete-drawer
     em admin/atletas.astro). */
  .gvf{
    position:fixed; inset:0; z-index:400;
    display:flex; align-items:stretch; justify-content:flex-end;
    background:rgba(0,0,0,0); transition:background var(--dur-med) var(--ease-std);
  }
  .gvf[hidden]{display:none !important}
  .gvf.open{background:rgba(0,0,0,.6)}

  /* O painel é quem desliza. Começa fora da tela (translateX(100%)) e entra
     quando .open liga, na mesma curva que .drawer-panel usa. É mais largo que
     .drawer-panel (800px) porque o fluxo II tem 1200px — largura menor
     reproduziria o problema que a gaveta existe para resolver. */
  .gvf-panel{
    width:min(1320px,94vw); height:100%; overflow:hidden;
    background:var(--c-black); border-left:3px solid var(--c-lime); box-shadow:var(--shadow-lg);
    display:flex; flex-direction:column;
    transform:translateX(100%); transition:transform .4s cubic-bezier(0.16,1,0.3,1);
  }
  .gvf.open .gvf-panel{transform:translateX(0)}

  .gvf-topo{
    flex:none; display:flex; align-items:flex-end; justify-content:space-between; gap:var(--space-4);
    border-bottom:4px solid var(--c-lime); background:#141414;
    padding:var(--space-5) clamp(1rem,4vw,3rem) var(--space-4);
  }
  .gvf-eyebrow{
    font-family:var(--font-label); font-size:.66rem; font-weight:700;
    letter-spacing:var(--tracking-label); text-transform:uppercase; color:var(--c-lime);
  }
  .gvf-h1{
    font-family:var(--font-display); font-weight:400; font-size:clamp(1.6rem,5vw,2.8rem);
    line-height:1; letter-spacing:var(--tracking-display); text-transform:uppercase;
    color:var(--c-white); margin:var(--space-2) 0 0;
  }
  /* Mesmo .drawer-close de editor-plano.css (usado em #athlete-drawer): "✕"
     nu, sem moldura de botão-pílula — não é a gaveta dos fluxos que deveria
     inventar outra convenção de fechar. */
  .gvf-fechar{
    flex:none; background:none; border:none; color:var(--c-textsub);
    font-size:20px; line-height:1; cursor:pointer;
    transition:color var(--dur-med) var(--ease-std);
  }
  .gvf-fechar:hover{color:var(--c-lime)}

  /* A rolagem é DESTE painel, e não da página: o corpo fica travado atrás
     enquanto a gaveta está aberta. Os desenhos têm 1757 e 2317 de altura e não
     cabem em tela nenhuma — o que se escolheu aqui foi onde a barra aparece. */
  .gvf-corpo{flex:1; overflow-y:auto; scrollbar-width:thin; scrollbar-color:rgba(166,195,0,.5) transparent}
  .gvf-corpo::-webkit-scrollbar{width:4px}
  .gvf-corpo::-webkit-scrollbar-thumb{background:rgba(166,195,0,.5); border-radius:2px}
  .gvf-corpo:focus{outline:none}
  .gvf-wrap{max-width:1240px; margin:0 auto; padding:0 clamp(1rem,4vw,3rem) var(--space-7)}
  .gvf-lead{max-width:64ch; color:var(--c-textsub); margin:var(--space-5) 0 0}
  .gvf-legenda{
    display:flex; flex-wrap:wrap; gap:var(--space-3) var(--space-5);
    padding:var(--space-4) 0; border-bottom:1px solid rgba(255,255,255,.08);
  }
  .gvf-lg{
    display:flex; align-items:center; gap:var(--space-2);
    font-family:var(--font-label); font-size:.64rem; font-weight:700;
    letter-spacing:var(--tracking-label); text-transform:uppercase; color:var(--c-textsub);
  }
  .gvf-lg svg{flex:none}
  .gvf-fl{padding:var(--space-6) 0 var(--space-3); border-top:1px solid rgba(255,255,255,.08)}
  .gvf-fl:first-of-type{border-top:none}
  .gvf-n{font-family:var(--font-display); font-size:2.2rem; line-height:1; color:var(--c-lime); letter-spacing:.06em}
  .gvf-h2{
    font-family:var(--font-display); font-weight:400; font-size:clamp(1.4rem,4vw,2rem);
    line-height:1.05; letter-spacing:var(--tracking-display); text-transform:uppercase;
    color:var(--c-white); margin:var(--space-1) 0 var(--space-2);
  }
  .gvf-fl > p{max-width:66ch; color:var(--c-textsub); font-size:.9rem; margin:0 0 var(--space-5)}
  .gvf-notas{padding:var(--space-5) 0 0; border-top:1px solid rgba(255,255,255,.08)}
  .gvf-h3{
    font-family:var(--font-display); font-weight:400; font-size:1.4rem;
    letter-spacing:var(--tracking-display); text-transform:uppercase; color:var(--c-white);
    margin:0 0 var(--space-2);
  }
  .gvf-notas p{max-width:68ch; font-size:.875rem; color:var(--c-textsub)}
  .gvf-notas strong{color:var(--c-white); font-weight:600}

  html.gvf-travado, html.gvf-travado body{overflow:hidden}

  /* Mesma conversão de #athlete-drawer/.drawer-panel neste breakpoint (editor-
     plano.css): abaixo de 768px a gaveta deixa de ancorar na lateral e vira
     folha inferior, porque uma faixa de 94vw docada à direita já não sobra
     espaço nenhum do guia por trás para o backdrop separar visualmente — na
     base, cobrindo quase a tela toda mas ainda deixando ver que é um painel
     por cima, não a própria página. */
  @media (max-width:768px){
    .gvf{align-items:flex-end; justify-content:center}
    .gvf-panel{
      width:100%; height:92vh; height:92svh;
      border-left:none; border-top:none; border-radius:20px 20px 0 0;
      transform:translateY(100%);
    }
    .gvf.open .gvf-panel{transform:translateY(0)}
  }

  @media (prefers-reduced-motion:reduce){
    .gvf, .gvf-panel{transition:none}
  }

  /* No papel, a gaveta é o documento: o guia atrás sai do caminho e o painel
     imprime inteiro, sem invólucro, sem borda e sem barra de rolagem. */
  @media print{
    html.gvf-travado body > *:not(.gvf){display:none !important}
    .gvf{position:static; background:#fff !important; display:block}
    .gvf-panel{
      width:auto; height:auto; overflow:visible; transform:none;
      border-left:none; box-shadow:none; background:#fff;
    }
    .gvf-corpo{overflow:visible}
    .gvf-fechar{display:none}
  }
</style>

<script>
  // Gaveta dos fluxos. Progressiva: sem JS, o gatilho não faz nada e a gaveta
  // segue oculta — nenhum conteúdo do guia depende disto para ser lido.
  (() => {
    const gaveta = document.getElementById('gvf');
    if (!gaveta) return;
    const corpo = gaveta.querySelector<HTMLElement>('.gvf-corpo');
    const raiz = document.documentElement;
    let devolverFoco: HTMLElement | null = null;
    let fecharTimer: ReturnType<typeof setTimeout> | null = null;

    // Casa com a transição de .gvf-panel (transform .4s): só depois dela some
    // de fato (hidden), senão o painel reapareceria sem deslizar da próxima vez.
    const DURACAO_TRANSICAO = 400;

    const focaveis = () => Array.from(
      gaveta.querySelectorAll<HTMLElement>('a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])')
    ).filter((e) => e.offsetParent !== null);

    const abrir = (comHash = true) => {
      if (fecharTimer) { clearTimeout(fecharTimer); fecharTimer = null; }
      if (gaveta.classList.contains('open')) return;
      devolverFoco = document.activeElement as HTMLElement | null;
      gaveta.hidden = false;
      // Duas etapas: tirar o [hidden] e só then ligar .open, para o navegador
      // ter um quadro com transform:translateX(100%) já aplicado e animar a
      // entrada — ligar as duas coisas juntas pula direto para o estado final.
      requestAnimationFrame(() => gaveta.classList.add('open'));
      raiz.classList.add('gvf-travado');
      // O hash é o que torna a gaveta endereçável: quem receber o link cai
      // direto nela. replaceState, e não pushState, para que "voltar" do
      // navegador saia do guia em vez de só fechar a gaveta.
      if (comHash && location.hash !== '#fluxos') {
        history.replaceState(null, '', location.pathname + location.search + '#fluxos');
      }
      corpo?.focus();
    };

    const fechar = () => {
      if (!gaveta.classList.contains('open')) return;
      gaveta.classList.remove('open');
      raiz.classList.remove('gvf-travado');
      fecharTimer = setTimeout(() => { gaveta.hidden = true; fecharTimer = null; }, DURACAO_TRANSICAO);
      if (location.hash === '#fluxos') {
        history.replaceState(null, '', location.pathname + location.search);
      }
      devolverFoco?.focus();
    };

    document.querySelectorAll('[data-gvf-abrir]').forEach((b) => {
      b.addEventListener('click', (e) => { e.preventDefault(); abrir(); });
    });
    gaveta.querySelectorAll('[data-gvf-fechar]').forEach((b) => {
      b.addEventListener('click', () => fechar());
    });
    // Clicar no pano de fundo (fora do painel) fecha — só quando o alvo do
    // clique é o próprio invólucro, nunca um descendente dentro do painel.
    gaveta.addEventListener('click', (e) => { if (e.target === gaveta) fechar(); });

    document.addEventListener('keydown', (e) => {
      if (gaveta.hidden || !gaveta.classList.contains('open')) return;
      if (e.key === 'Escape') { fechar(); return; }
      if (e.key !== 'Tab') return;
      // Prende o foco: sem isto, o Tab sairia da gaveta e passearia pelo guia
      // atrás, que está visualmente coberto mas continua no documento.
      const lista = focaveis();
      if (!lista.length) return;
      const primeiro = lista[0];
      const ultimo = lista[lista.length - 1];
      const atual = document.activeElement;
      if (e.shiftKey && (atual === primeiro || atual === corpo)) {
        e.preventDefault(); ultimo.focus();
      } else if (!e.shiftKey && atual === ultimo) {
        e.preventDefault(); primeiro.focus();
      }
    });

    if (location.hash === '#fluxos') abrir(false);
    window.addEventListener('hashchange', () => {
      if (location.hash === '#fluxos') abrir(false); else fechar();
    });
  })();
</script>
