---
import type { Translations } from "../i18n/pt";

interface ResultItem {
  n: number;
  beforeSrc: string;
  afterSrc: string;
  name: string;
  meta: string;
  stat: string;
  statDesc: string;
  story: string;
  beforeLabel: string;
  afterLabel: string;
  /** true = texto/stat criado ou modificado pela equipe, ainda não revisado pelo Coach */
  pending?: boolean;
  /** true = a foto em si é um placeholder genérico, não uma foto real do caso */
  photoPending?: boolean;
}

interface Props {
  items: ResultItem[];
  t?: Translations;
}
const { items, t } = Astro.props;
---

<script type="module" src="https://cdn.jsdelivr.net/npm/img-comparison-slider@8/dist/index.js"></script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/img-comparison-slider@8/dist/styles.css" />

<div class="results-carousel">
  <button class="results-nav results-nav--prev" type="button" aria-label="Fila anterior de resultados">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
  </button>
  <div class="results-viewport">
  <div class="results-track">
  {items.map((item) => (
    <div class="result-card">
      {item.photoPending && (
        <span class="result-card__pending-mark" tabindex="0" aria-label={t?.results.pendingLabel ?? "Conteúdo novo, ainda não revisado por você"}>
          <svg viewBox="0 0 24 24" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 8v4"/><path d="M12 16h.01"/></svg>
          <span class="result-card__pending-tip">{t?.results.pendingTooltip ?? "Conteúdo novo — ainda não revisado por você."}</span>
        </span>
      )}
      <div class="result-card__slider-wrap">
        <img-comparison-slider class="result-card__slider" tabindex="0">
          <figure slot="first" class="result-card__fig">
            <img
              src={item.beforeSrc}
              alt={`${item.name} antes`}
              class="result-card__img"
              loading="lazy"
            />
            {/* Tag movida para dentro do slot para sofrer clipping */}
            <span class="result-card__tag result-card__tag--before" aria-hidden="true">
              {item.beforeLabel}
            </span>
          </figure>
          
          <figure slot="second" class="result-card__fig">
            <img
              src={item.afterSrc}
              alt={`${item.name} depois`}
              class="result-card__img"
              loading="lazy"
            />
            {/* Tag movida para dentro do slot para sofrer clipping */}
            <span class="result-card__tag result-card__tag--after" aria-hidden="true">
              {item.afterLabel}
            </span>
          </figure>

          <svg slot="handle" class="result-card__handle" xmlns="http://www.w3.org/2000/svg"
            width="40" height="40" viewBox="0 0 40 40" fill="none" aria-hidden="true">
            <circle cx="20" cy="20" r="19" fill="#0D0D0D" stroke="#A6C300" stroke-width="1.5"/>
            <path d="M15 20L10 15M15 20L10 25" stroke="#A6C300" stroke-width="1.5" stroke-linecap="round"/>
            <path d="M25 20L30 15M25 20L30 25" stroke="#A6C300" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </img-comparison-slider>
      </div>

      <div class="result-card__caption">
        <p class="result-card__name">{item.name}</p>
        <p class="result-card__meta">{item.meta}</p>

        <div class="result-card__stat-wrap">
          {item.pending && (
            <span class="result-card__pending-mark" tabindex="0" aria-label={t?.results.pendingLabel ?? "Conteúdo novo, ainda não revisado por você"}>
              <svg viewBox="0 0 24 24" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 8v4"/><path d="M12 16h.01"/></svg>
              <span class="result-card__pending-tip">{t?.results.pendingTooltip ?? "Conteúdo novo — ainda não revisado por você."}</span>
            </span>
          )}
          <p class="result-card__stat">{item.stat}</p>
          <p class="result-card__stat-desc">{item.statDesc}</p>
        </div>

        <div class="result-card__story-wrap">
          <p class="result-card__story" data-full={item.story}>
            {item.story.slice(0, 150)}<span class="result-card__ellipsis">...</span>
          </p>
          <button
            class="result-card__toggle"
            aria-expanded="false"
            type="button"
            data-read-more={t?.results.readMore ?? "Ver mais"}
            data-read-less={t?.results.readLess ?? "Ver menos"}
          >
            {t?.results.readMore ?? "Ver mais"}
          </button>
        </div>
      </div>
    </div>
  ))}
  </div>
  </div>
  <button class="results-nav results-nav--next" type="button" aria-label="Próxima fila de resultados">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
  </button>
</div>
<div class="results-dots" role="tablist" aria-label="Filas de resultados"></div>

<script>
  document.querySelectorAll(".result-card__toggle").forEach(btn => {
    const b = btn as HTMLButtonElement;
    const wrap = b.closest(".result-card__story-wrap");
    const storyEl = wrap?.querySelector(".result-card__story") as HTMLElement | null;
    const ellipsis = storyEl?.querySelector(".result-card__ellipsis") as HTMLElement | null;
    if (!storyEl || !ellipsis) return;
    const fullText = storyEl.dataset.full ?? "";
    const shortText = storyEl.childNodes[0]?.textContent ?? "";
    b.addEventListener("click", () => {
      const expanded = b.getAttribute("aria-expanded") === "true";
      if (expanded) {
        if (storyEl.childNodes[0]) storyEl.childNodes[0].textContent = shortText;
        ellipsis.hidden = false;
        b.setAttribute("aria-expanded", "false");
        b.textContent = b.dataset.readMore ?? "";
      } else {
        if (storyEl.childNodes[0]) storyEl.childNodes[0].textContent = fullText;
        ellipsis.hidden = true;
        b.setAttribute("aria-expanded", "true");
        b.textContent = b.dataset.readLess ?? "";
      }
    });
  });

  // ── Carrossel rotativo: no desktop, número de cards por fila calculado
  // pelo espaço disponível, deslizando o trilho inteiro com transform+
  // animação (inalterado, já validado). No mobile, a navegação passa a
  // ser rolagem nativa por toque (scroll-snap) — mesmo mecanismo já usado
  // em Nossa Equipe — para o usuário poder arrastar manualmente, não só
  // clicar nas setas. Nenhum <img-comparison-slider> ou listener de
  // "Ver mais" é recriado ao trocar de fila/página, nos dois modos.
  (function setupResultsCarousel() {
    const viewportEl = document.querySelector<HTMLElement>(".results-viewport");
    const trackEl = document.querySelector<HTMLElement>(".results-track");
    const carouselEl = document.querySelector<HTMLElement>(".results-carousel");
    const dotsEl = document.querySelector<HTMLElement>(".results-dots");
    if (!viewportEl || !trackEl || !carouselEl || !dotsEl) return;

    const viewport: HTMLElement = viewportEl;
    const track: HTMLElement = trackEl;
    const carousel: HTMLElement = carouselEl;
    const dotsWrap: HTMLElement = dotsEl;

    const cards = Array.from(track.querySelectorAll<HTMLElement>(".result-card"));
    if (cards.length === 0) return;

    const prevBtn = carousel.querySelector<HTMLButtonElement>(".results-nav--prev");
    const nextBtn = carousel.querySelector<HTMLButtonElement>(".results-nav--next");
    const mobileQuery = window.matchMedia("(max-width: 640px)");
    let current = 0;
    let perPage = 1;
    let pageCount = 1;

    function computeLayout() {
      const cardWidth = cards[0].getBoundingClientRect().width;
      const gap = parseFloat(getComputedStyle(track).columnGap || getComputedStyle(track).gap || "0");
      const viewportWidth = viewport.clientWidth;
      perPage = Math.max(1, Math.floor((viewportWidth + gap) / (cardWidth + gap)));
      pageCount = Math.max(1, Math.ceil(cards.length / perPage));
      current = Math.min(current, pageCount - 1);
    }

    function buildDots() {
      dotsWrap.innerHTML = "";
      if (pageCount <= 1) return;
      for (let i = 0; i < pageCount; i++) {
        const dot = document.createElement("button");
        dot.className = "results-dot";
        dot.type = "button";
        dot.setAttribute("role", "tab");
        dot.setAttribute("aria-label", `Fila ${i + 1} de ${pageCount}`);
        dot.addEventListener("click", () => goTo(i));
        dotsWrap.appendChild(dot);
      }
    }

    function updateChrome() {
      const dots = Array.from(dotsWrap.querySelectorAll<HTMLButtonElement>(".results-dot"));
      dots.forEach((dot, i) => dot.setAttribute("aria-current", String(i === current)));
      if (prevBtn) prevBtn.disabled = current === 0;
      if (nextBtn) nextBtn.disabled = current === pageCount - 1;
      carousel.classList.toggle("results-carousel--single-page", pageCount <= 1);
    }

    // ── Modo desktop: desliza o trilho inteiro via transform (já validado) ──
    function renderDesktop() {
      const offset = current * viewport.clientWidth;
      track.style.transform = `translateX(-${offset}px)`;
      updateChrome();
    }

    // ── Modo mobile: a posição é ditada pelo scrollLeft nativo; aqui só
    // sincronizamos dots/setas com o que o usuário já rolou (por toque ou
    // clicando na seta, que também rola nativamente) ──
    function stepWidthMobile() {
      const gap = parseFloat(getComputedStyle(track).columnGap || getComputedStyle(track).gap || "0");
      return cards[0].getBoundingClientRect().width + gap;
    }

    function syncFromScroll() {
      const step = stepWidthMobile();
      current = step > 0 ? Math.round(viewport.scrollLeft / step) : 0;
      current = Math.max(0, Math.min(pageCount - 1, current));
      updateChrome();
    }

    function goTo(page: number) {
      current = Math.max(0, Math.min(pageCount - 1, page));
      if (mobileQuery.matches) {
        viewport.scrollTo({ left: current * stepWidthMobile(), behavior: "smooth" });
        // updateChrome() roda via o listener de "scroll" (debounced) abaixo
      } else {
        renderDesktop();
      }
    }

    let scrollTimer: ReturnType<typeof setTimeout>;
    viewport.addEventListener("scroll", () => {
      if (!mobileQuery.matches) return;
      clearTimeout(scrollTimer);
      scrollTimer = setTimeout(syncFromScroll, 100);
    });

    function refresh() {
      computeLayout();
      buildDots();
      if (mobileQuery.matches) {
        track.style.transform = ""; // a rolagem nativa governa a posição, não o transform
        syncFromScroll();
      } else {
        viewport.scrollLeft = 0; // volta ao início ao trocar para o modo desktop
        renderDesktop();
      }
    }

    prevBtn?.addEventListener("click", () => goTo(current - 1));
    nextBtn?.addEventListener("click", () => goTo(current + 1));

    let resizeTimer: ReturnType<typeof setTimeout>;
    window.addEventListener("resize", () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(refresh, 150);
    });

    refresh();
  })();
</script>

<style>
  /* ── Carrossel rotativo: trilho deslizante, largura de card própria.
     JS mede a largura real e calcula quantos cabem por fila — no mobile,
     isso resulta em 1 por vez naturalmente, sem regra especial. ── */
  .results-carousel {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }
  .results-viewport {
    flex: 1;
    min-width: 0;
    overflow: hidden;
  }
  .results-track {
    display: flex;
    gap: var(--space-5);
    transition: transform 0.45s cubic-bezier(0.65, 0, 0.35, 1);
    will-change: transform;
  }
  /* ---------- Setas — réplica exata de .team__arrow / .content__arrow (44px) ---------- */
  .results-nav {
    flex: none;
    width: 44px; height: 44px; border-radius: 50%;
    background: transparent; border: 0.75px solid var(--c-white); color: var(--c-white);
    padding: 0; cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    transition: all var(--transition-base);
  }
  .results-nav svg { width: 20px; height: 20px; }
  .results-nav:hover:not(:disabled) { border-color: var(--c-lime); color: var(--c-lime); background: rgba(166,195,0,0.1); }
  .results-nav:active { transform: translateY(-1px) scale(0.96); }
  .results-nav[disabled] { opacity: .2; cursor: default; pointer-events: none; }
  .results-carousel--single-page .results-nav { visibility: hidden; }
  .results-dots {
    display: flex; justify-content: center; gap: 8px; margin-top: var(--space-5);
  }
  .results-dot {
    width: 8px; height: 8px; border-radius: 50%; background: #3a3a3a;
    border: none; cursor: pointer; padding: 0; transition: all .2s ease;
  }
  .results-dot[aria-current="true"] { background: var(--c-lime); width: 22px; border-radius: 4px; }

  .result-card {
    position: relative;
    flex: 0 0 280px;
    width: 280px;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  /* ── Mobile: troca o deslize por transform (JS) por rolagem nativa por
     toque — mesmo padrão já usado em Nossa Equipe (.team__grid). Isso dá
     ao usuário a opção de arrastar manualmente, não só as setas.
     Setas passam a flutuar por cima da imagem (posição absoluta) em vez
     de ocupar espaço ao lado, para não espremer a área útil do card. ── */
  @media (max-width: 640px) {
    .results-carousel {
      position: relative;
      gap: 0;
    }
    .results-viewport {
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      margin: 0 -20px;
      padding: 0 20px 4px;
      -webkit-overflow-scrolling: touch;
    }
    .results-viewport::-webkit-scrollbar { display: none; }
    .results-track {
      transition: none; /* a posição passa a ser ditada pelo scrollLeft nativo, não por transform */
    }
    .result-card {
      flex: 0 0 82%;
      width: 82%;
      scroll-snap-align: start;
    }
    .results-nav {
      position: absolute;
      top: 88px;
      z-index: 3;
      /* Preenchimento sólido — mesmo par cor/contorno do handle do
         slider de comparação (#0D0D0D + lime), que já resolve o mesmo
         problema de contraste sobre fotos de tom/exposição variáveis. */
      background: var(--c-black);
    }
    .results-nav--prev { left: 4px; }
    .results-nav--next { right: 4px; }
  }

  .result-card__pending-mark {
    position: absolute; top: -1px; right: -1px; z-index: 5;
    width: 26px; height: 26px;
    background: var(--c-pending);
    border-radius: 0 4px 0 10px;
    display: flex; align-items: center; justify-content: center;
    cursor: help;
  }
  .result-card__pending-mark svg { width: 13px; height: 13px; stroke: var(--c-black); }
  .result-card__pending-mark:hover .result-card__pending-tip,
  .result-card__pending-mark:focus-visible .result-card__pending-tip {
    opacity: 1; transform: translateY(0); pointer-events: auto;
  }
  .result-card__pending-tip {
    position: absolute; top: 32px; right: 0;
    background: var(--c-black); border: 1px solid var(--c-pending);
    color: var(--c-white); font-family: var(--font-label); font-size: 11px; font-weight: 600;
    padding: 8px 11px; border-radius: 4px; width: 200px; line-height: 1.5;
    opacity: 0; transform: translateY(-4px); transition: opacity .15s, transform .15s;
    pointer-events: none;
  }

  .result-card__slider-wrap {
    position: relative;
    border-radius: var(--radius-card);
    overflow: hidden;
    border: var(--border-lime);
  }

  .result-card__slider {
    width: 100%;
    display: block;
    --divider-width: 2px;
    --divider-color: var(--c-lime);
    --default-handle-opacity: 1;
  }

  .result-card__slider:focus {
    outline: 2px solid var(--c-lime);
    outline-offset: 3px;
  }

  .result-card__fig {
    margin: 0;
    width: 100%;
    display: block;
    position: relative; 
    background-color: var(--c-darkbg, #0A0A0A);
    /* O selo de arquitetura Z: aprisiona a tag DEPOIS no seu próprio contexto */
    isolation: isolate; 
  }

  .result-card__img {
    width: 100%;
    /* Substitui a altura fluida (auto) por uma trava tridimensional vertical inegociável */
    aspect-ratio: 9 / 16;
    display: block;
    /* Altera o algoritmo de preenchimento para proteger a integridade anatômica (sem cortes) */
    object-fit: contain;
  }

  .result-card__handle {
    filter: drop-shadow(0 0 6px rgba(166,195,0,0.4));
  }

/* Unificação brutalista das tags: neutraliza fluxo e alinha z-index */
  .result-card__tag {
    position: absolute;
    bottom: var(--space-3);
    font-family: var(--font-label);
    font-size: 0.6rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--c-white);
    background-color: rgba(13,13,13,0.85);
    padding: 4px 10px;
    border-radius: 2px;
    z-index: 5; /* Força z-index idêntico para ambos */
    pointer-events: none;
    line-height: 1; /* Garante que o height seja ditado apenas pelo padding */
  }

  /* Aplicação em ambos os slots com offset idêntico */
  .result-card__tag--before { left: var(--space-3); }
  .result-card__tag--after  { right: var(--space-3); }

  /* Blindagem: força a figure a ignorar o conteúdo das tags no cálculo de tamanho */
  .result-card__fig {
    margin: 0;
    width: 100%;
    display: flex; /* Alinhamento flex para controle rígido */
    flex-direction: column;
    position: relative;
    background-color: var(--c-darkbg, #0A0A0A);
    overflow: hidden; /* Corta qualquer transbordo acidental */
  }

  .result-card__caption {
    padding-inline: var(--space-1);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .result-card__name {
    font-family: var(--font-display);
    font-size: 1rem;
    color: var(--c-lime);
    text-transform: uppercase;
  }

  .result-card__meta {
    font-size: var(--fs-body-sm);
    color: var(--c-textsub);
  }

  .result-card__stat-wrap {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-3);
    background-color: rgba(166, 195, 0, 0.08);
    border: 1px solid rgba(166, 195, 0, 0.2);
    border-radius: var(--radius-card);
  }

  .result-card__stat {
    font-family: var(--font-display);
    font-size: var(--fs-display-sm);
    color: var(--c-lime);
    text-transform: uppercase;
    font-weight: 700;
  }

  .result-card__stat-desc {
    font-size: var(--fs-body-sm);
    color: var(--c-textbody);
    line-height: 1.5;
  }

  .result-card__story-wrap {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .result-card__story {
    font-size: var(--fs-body-sm);
    color: var(--c-textsub);
    line-height: 1.6;
  }

  .result-card__ellipsis {
    display: inline;
  }

  .result-card__toggle {
    font-family: var(--font-label);
    font-size: var(--fs-label);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--c-lime);
    cursor: pointer;
    background: none;
    border: none;
    padding: 0;
    align-self: flex-start;
    transition: opacity var(--transition-base);
  }

  .result-card__toggle:hover {
    opacity: 0.8;
  }
</style>
