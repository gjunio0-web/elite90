---
// @elite90/site — componente compartilhado do editor de plano.
// Sobreposições de busca de alimento e de quantidade (AC-15). Contém os
// controles de quantidade; a remoção de refeição vive no corpo do editor
// (CA-50).
//
// CA-42: a gaveta do Coach e a rota restrita do profissional importam ESTE
// arquivo. Não existe cópia. Alterar aqui altera as duas.
// A lógica vive em @elite90/editor-plano/nucleo.js, injetada pela hospedeira.
---
      <div class="wke-search-overlay" id="nte-search-overlay" hidden onclick="if(event.target===this)closeFoodSearch()">
        <div class="wke-search-box">
          <div class="wke-search-inputwrap">
            <span data-lucide="search"></span>
            <input type="text" class="wke-search-input" id="nte-search-input" placeholder="Buscar alimento (mín. 3 letras)…" autocomplete="off" oninput="onFoodSearchInput()" onkeydown="onFoodSearchKey(event)" />
          </div>
          <div class="wke-search-results" id="nte-search-results">
            <div class="wke-search-hint">Digite ao menos 3 letras para buscar.</div>
          </div>
          <!-- Atalho para a base de alimentos — mesmo papel e mesma razão do
               atalho ao catálogo de exercícios logo acima (spec da tela de
               alimentos, seção 3): a vontade de corrigir um nome ou de
               preencher uma medida caseira que falta nasce AQUI, com o plano
               aberto, não no hub.

               CA-42 · mesma correção de destino por papel que
               SobreposicoesTreino.astro já tem, e pelo mesmo motivo — ver o
               comentário lá para o raciocínio completo, incluindo por que o
               profissional abre um MODAL em vez de navegar. -->
          <a class="wke-search-catalogo" id="nte-search-catalogo" href="/admin/alimentos" target="_blank" rel="noopener">
            Gerenciar base
            <span data-lucide="external-link"></span>
          </a>
        </div>
      </div>

      <!-- Modal de propor alimento (AC-34). Ver o comentário equivalente em
           SobreposicoesTreino.astro — mesma regra, mesmo motivo. -->
      <div class="pi-modal-overlay" id="pi-modal-alimento" hidden onclick="if(event.target===this)fecharPropostaItem('alimento')">
        <div class="pi-modal-box">
          <h2 class="pi-modal-title">Propor alimento</h2>
          <p class="pi-modal-sub">Vai para a mesma fila de revisão que o Coach já usa. Aprovado, passa a existir para todo mundo.</p>
          <form class="pi-modal-form" id="pi-form-alimento" onsubmit="event.preventDefault(); piEnviarProposta('alimento');">
            <div class="pi-grid">
              <div class="pi-campo pi-campo--largo">
                <label for="pi-al-nome">Nome de exibição</label>
                <input type="text" id="pi-al-nome" required />
              </div>
              <div class="pi-campo pi-campo--largo">
                <label id="pi-al-categoria-label">Categoria</label>
                <!-- Ver o comentário equivalente em SobreposicoesTreino.astro
                     sobre por que isto é um gatilho, não um <select>. -->
                <button type="button" class="pi-dd-trigger" id="pi-al-categoria" aria-labelledby="pi-al-categoria-label"></button>
              </div>
              <div class="pi-campo">
                <label for="pi-al-proteina">Proteína (g / 100g)</label>
                <input type="number" id="pi-al-proteina" min="0" step="0.1" required oninput="piAtualizarKcal()" />
              </div>
              <div class="pi-campo">
                <label for="pi-al-carboidrato">Carboidrato (g / 100g)</label>
                <input type="number" id="pi-al-carboidrato" min="0" step="0.1" required oninput="piAtualizarKcal()" />
              </div>
              <div class="pi-campo">
                <label for="pi-al-lipideos">Lipídeos (g / 100g)</label>
                <input type="number" id="pi-al-lipideos" min="0" step="0.1" required oninput="piAtualizarKcal()" />
              </div>
              <div class="pi-campo">
                <label>Calorias (calculado)</label>
                <p class="pi-kcal-calc" id="pi-al-kcal-calc">— kcal / 100g</p>
              </div>
            </div>

            <p class="pi-erro" id="pi-erro-alimento" hidden></p>

            <div class="pi-modal-actions">
              <button type="button" class="pi-btn pi-btn--secundario" onclick="fecharPropostaItem('alimento')">Cancelar</button>
              <button type="submit" class="pi-btn" id="pi-enviar-alimento">Enviar para aprovação</button>
            </div>
          </form>

          <div class="pi-lista-wrap">
            <h3 class="pi-lista-title">Suas propostas</h3>
            <div id="pi-lista-alimento"></div>
          </div>
        </div>
      </div>

      <script is:inline>
        // Ver o comentário equivalente em SobreposicoesTreino.astro sobre por
        // que isto espera DOMContentLoaded.
        document.addEventListener("DOMContentLoaded", function () {
          if (typeof window.E90 === "undefined") return; // é o Coach — link já está certo
          var a = document.getElementById("nte-search-catalogo");
          if (!a) return;
          a.href = "#";
          a.removeAttribute("target");
          a.removeAttribute("rel");
          a.firstChild.textContent = "Propor alimento";
          a.addEventListener("click", function (ev) {
            ev.preventDefault();
            abrirPropostaItem("alimento");
          });
        });
      </script>

      <!-- AddFood: quantidade + preview de macros -->
      <div class="nte-qty-overlay" id="nte-qty-overlay" hidden onclick="if(event.target===this)closeFoodQty()">
        <div class="nte-qty-box">
          <div class="nte-qty-title" id="nte-qty-title">Quantidade</div>
          <div class="nte-qty-field">
            <input type="number" id="nte-qty-input" inputmode="decimal" value="100" oninput="nteUpdateQtyPreview()" onkeydown="if(event.key==='Enter')nteConfirmFood();if(event.key==='Escape')closeFoodQty()" />
            <span class="nte-qty-unit">g</span>
          </div>
          <div class="nte-qty-preview" id="nte-qty-preview"></div>
          <div class="nte-qty-actions">
            <button class="nte-qty-cancel" onclick="closeFoodQty()">Cancelar</button>
            <button class="nte-qty-confirm" onclick="nteConfirmFood()">Adicionar</button>
          </div>
        </div>
      </div>
