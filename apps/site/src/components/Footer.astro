---
// ─── ELITE 90 · Footer ───────────────────────────────────────────────────────
import type { Translations } from "../i18n/pt";

interface Props {
  t: Translations;
}
const { t } = Astro.props;
---

<footer class="site-footer">
  <div class="site-footer__divider" role="presentation"></div>
  <div class="container site-footer__inner">
    <p class="site-footer__copy">{t.footer.copyright}</p>
    <p class="site-footer__credit">{t.footer.credit}</p>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--c-darkbg);
    padding-bottom: var(--space-6);
  }

  .site-footer__divider {
    width: 100%;
    height: 1px;
    background: linear-gradient(
      to right,
      transparent,
      var(--c-lime) 20%,
      var(--c-lime) 80%,
      transparent
    );
    opacity: 0.25;
    margin-bottom: var(--space-6);
  }

  .site-footer__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    text-align: center;
  }

  .site-footer__copy {
    font-family: var(--font-label);
    font-size: var(--fs-label);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--c-textsub);
  }

  .site-footer__credit {
    font-family: var(--font-label);
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: rgba(153, 153, 153, 0.5);
  }
</style>
