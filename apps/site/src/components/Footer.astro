---
// --- ELITE90 PRO · Footer
import type { Translations } from "../i18n/pt";

interface Props {
  t: Translations;
}
const { t } = Astro.props;

// O relatorio de progresso e artefato de homologacao: a edge function
// progresso-guard devolve 404 em /progresso* quando o contexto de publicacao
// e "production". O link no rodape segue a mesma regra, para nao ficar visivel
// apontando para uma rota morta. CONTEXT e definido pelo Netlify no build.
const isProduction = process.env.CONTEXT === "production";
---

<footer class="site-footer">
  <div class="site-footer__divider" role="presentation"></div>
  <div class="container site-footer__inner">
    <p class="site-footer__copy" id="admin-ignite" style="user-select: none;">{t.footer.copyright}</p>
    <p class="site-footer__credit">{t.footer.credit} <a href={isProduction ? undefined : "/progresso/"} class="site-footer__status-dot" aria-hidden="true" tabindex="-1"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><line x1="6" y1="20" x2="6" y2="14"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="18" y1="20" x2="18" y2="10"/></svg></a></p>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--c-darkbg);
    padding-bottom: var(--space-6);
  }

  .site-footer__divider {
    width: 100%;
    height: 1px;
    background: linear-gradient(
      to right,
      transparent,
      var(--c-lime) 20%,
      var(--c-lime) 80%,
      transparent
    );
    opacity: 0.25;
    margin-bottom: var(--space-6);
  }

  .site-footer__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    text-align: center;
  }

  .site-footer__copy {
    font-family: var(--font-label);
    font-size: var(--fs-label);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--c-textsub);
  }

  .site-footer__credit {
    font-family: var(--font-label);
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: rgba(153, 153, 153, 0.5);
  }

  .site-footer__status-dot {
    color: inherit;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    vertical-align: middle;
  }
</style>

<script>
  // Ocultação Esteganográfica: Gatilho de 5 cliques iterativos
  const triggerElement = document.getElementById('admin-ignite');

  if (triggerElement) {
    let clickCount = 0;
    let clickTimer: ReturnType<typeof setTimeout> | null = null;

    const handleIgnition = (e: Event) => {
      // Previne comportamentos padrão em dispositivos móveis (zoom ou seleção)
      e.preventDefault(); 

      clickCount++;

      // Inicia a janela de tempo no primeiro clique
      if (clickCount === 1) {
        clickTimer = setTimeout(() => {
          clickCount = 0; // Reseta a contagem se o administrador demorar mais de 2 segundos
        }, 2000);
      }

      // Conclusão do ritual (5 cliques dentro do tempo limite)
      if (clickCount >= 5) {
        if (clickTimer) clearTimeout(clickTimer);
        clickCount = 0;
        
        // Injeção do Salvo-Conduto no navegador (Token Efêmero)
        sessionStorage.setItem('gateway_unlocked', 'true');
        
        // Redirecionamento Silencioso para a rota real
        window.location.assign('/admin/login');
      }
    };

    // Escuta dupla para garantir funcionamento tátil (mobile) e físico (desktop)
    triggerElement.addEventListener('click', handleIgnition);
    triggerElement.addEventListener('touchstart', handleIgnition, { passive: false });
  }
</script>