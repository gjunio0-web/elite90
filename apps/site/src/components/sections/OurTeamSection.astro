---
import type { Translations } from "../../i18n/pt";
interface Props { t: Translations; }
const { t } = Astro.props;
---

<section class="section team" id="nossa-equipe" style="scroll-margin-top:80px" aria-label="Nossa Equipe">
  <div class="container">
    <p class="section__eyebrow">{t.team.eyebrow}</p>
    <h2 class="section__title">
      {t.team.title} <span>{t.team.titleAccent}</span>
    </h2>
    <p class="team__intro">{t.team.intro}</p>

    <div class="team__grid">
      {t.team.items.map((member, idx) => (
        <article class="team-card">
          <div class="team-card__photo">
            <img
              src={member.image}
              alt={member.name}
              width="240"
              height="240"
              loading="lazy"
            />
          </div>

          <p class="team-card__role">{member.role}</p>
          <h3 class="team-card__name">{member.name}</h3>
          <p class="team-card__credential">{member.credential}</p>

          <div class="team-card__badges">
            {member.badges.map(badge => (
              <span class="team-card__badge">{badge}</span>
            ))}
          </div>

          <p class="team-card__bio">{member.bio}</p>

          <div class="team-card__footer">
            <div class="team-card__stat">
              {member.stat}
              <span>{member.statLabel}</span>
            </div>
            <a class="team-card__link" href={member.link} aria-label={`Link de ${member.name}`}>↗</a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .team__intro {
    font-size: var(--fs-body-md);
    color: var(--c-textsub);
    line-height: 1.7;
    max-width: 560px;
    margin-top: var(--space-4);
    margin-bottom: var(--space-8);
  }

  .team__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-5);
  }

  @media (min-width: 900px) {
    .team__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .team-card {
    position: relative;
    background-color: var(--c-darkbg);
    border: var(--border-card);
    border-radius: var(--radius-card);
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    transition: border-color var(--transition-base), transform var(--transition-base), box-shadow var(--transition-base);
  }

  .team-card:hover {
    border-color: rgba(166, 195, 0, 0.4);
    transform: translateY(-4px);
    box-shadow: 0 0 32px rgba(166, 195, 0, 0.15);
  }

  .team-card__photo {
    width: 100%;
    aspect-ratio: 1;
    border-radius: calc(var(--radius-card) - 6px);
    background: radial-gradient(circle at 30% 20%, rgba(166, 195, 0, 0.08), transparent 60%),
                var(--c-black);
    border: var(--border-card);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .team-card__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .team-card__role {
    font-family: var(--font-label);
    font-weight: 600;
    font-size: var(--fs-label);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--c-amber, #D69A3E);
    margin: 0;
  }

  .team-card__name {
    font-family: var(--font-display);
    font-size: 1.5rem;
    letter-spacing: 0.01em;
    color: var(--c-white);
    text-transform: uppercase;
    line-height: 1.1;
    margin: 0;
  }

  .team-card__credential {
    font-family: var(--font-label);
    font-weight: 500;
    font-size: var(--fs-body-sm);
    color: var(--c-textsub);
    margin: 0;
  }

  .team-card__badges {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .team-card__badge {
    font-family: var(--font-label);
    font-weight: 600;
    font-size: 10px;
    letter-spacing: 0.03em;
    color: var(--c-textsub);
    background: rgba(242, 242, 237, 0.05);
    border: var(--border-card);
    border-radius: 100px;
    padding: 5px 10px;
    display: inline-block;
  }

  .team-card__bio {
    font-size: var(--fs-body-sm);
    line-height: 1.65;
    color: var(--c-textbody);
    flex-grow: 1;
    margin: 0;
  }

  .team-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: var(--space-3);
    border-top: var(--border-card);
    margin-top: var(--space-3);
  }

  .team-card__stat {
    font-family: var(--font-label);
    font-weight: 700;
    font-size: var(--fs-label);
    color: var(--c-lime);
    letter-spacing: 0.02em;
  }

  .team-card__stat span {
    display: block;
    font-family: var(--font-label);
    font-weight: 500;
    font-size: 9px;
    color: var(--c-textbody);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-top: 2px;
  }

  .team-card__link {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 1px solid rgba(242, 242, 237, 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--c-white);
    text-decoration: none;
    font-size: 14px;
    transition: background var(--transition-base), color var(--transition-base), border-color var(--transition-base);
    flex-shrink: 0;
  }

  .team-card__link:hover {
    background: linear-gradient(135deg, var(--c-lime) 0%, #556600 100%);
    border-color: transparent;
    color: var(--c-black);
  }

  @media (max-width: 768px) {
    .team__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .team__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
