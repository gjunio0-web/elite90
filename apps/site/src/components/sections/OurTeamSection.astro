---
import type { Translations } from "../../i18n/pt";
interface Props { t: Translations; }
const { t } = Astro.props;
---

<section class="section team" id="nossa-equipe" style="scroll-margin-top:80px" aria-label={t.team.ariaLabel}>
  <div class="container">
    <p class="section__eyebrow">{t.team.eyebrow}</p>
    <h2 class="section__title">
      {t.team.title} <span>{t.team.titleAccent}</span>
    </h2>
    <p class="team__intro">{t.team.intro}</p>

    <div class="team__carousel-wrap">
      <button class="team__arrow team__arrow--prev" id="teamPrevArrow" aria-label={t.team.prevAriaLabel} disabled>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
      </button>
      <button class="team__arrow team__arrow--next" id="teamNextArrow" aria-label={t.team.nextAriaLabel}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
      </button>

      <div class="team__grid" id="teamGrid">
        {t.team.items.map((member, idx) => (
          <article class="team-card">
            <div class="team-card__photo">
              <img
                src={member.image}
                alt={member.name}
                width="240"
                height="320"
                loading="lazy"
              />
            </div>

            <p class="team-card__role">{member.role}</p>
            <h3 class="team-card__name">{member.name}</h3>
            <p class="team-card__credential">{member.credential}</p>

            <div class="team-card__badges">
              {member.badges.map(badge => (
                <span class="team-card__badge">{badge}</span>
              ))}
            </div>

            <p class="team-card__bio">{member.bio}</p>

            <div class="team-card__footer">
              <div class="team-card__stat">
                {member.stat}
                <span>{member.statLabel}</span>
              </div>
              <a class="team-card__link" href={member.link} aria-label={`${t.team.linkAriaLabel} ${member.name}`}>↗</a>
            </div>
          </article>
        ))}
      </div>
    </div>

    <div class="team__dots" id="teamDots">
      {t.team.items.map((_, idx) => (
        <span class={idx === 0 ? "is-active" : ""}></span>
      ))}
    </div>
  </div>
</section>

<style>
  /* Intro: réplica exata de .pillars__intro (a convenção real do site) */
  .team__intro {
    font-size: var(--fs-body-lg);
    font-style: italic;
    color: var(--c-textbody);
    line-height: 1.8;
    max-width: 680px;
    margin-bottom: var(--space-7);
  }

  /* ---------- Grid / carousel wrap ---------- */
  .team__carousel-wrap {
    position: relative;
  }

  .team__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-5);
  }

  @media (min-width: 900px) {
    .team__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  /* ---------- Card — réplica de .pillar-card / .testimonial-card:
       acento de 4px lime em um lado só (não contorno fino nos 4 lados),
       radius-card real, padding space-5, gap interno space-3 ---------- */
  .team-card {
    position: relative;
    background-color: var(--c-darkbg);
    border-top: var(--border-card);
    border-radius: var(--radius-card);
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    transition: box-shadow var(--transition-base), transform var(--transition-base);
  }

  .team-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-cta);
  }

  .team-card__photo {
    width: 100%;
    aspect-ratio: 3 / 4;
    border-radius: var(--radius-card);
    background: var(--c-black);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .team-card__photo img {
    width: 100%;
    height: 100%;
    object-position: center top;
    object-fit: cover;
  }

  .team-card__role {
    font-family: var(--font-label);
    font-weight: 600;
    font-size: var(--fs-label);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--c-amber, #D69A3E);
    margin: 0;
  }

  .team-card__name {
    font-family: var(--font-display);
    font-size: var(--fs-display-sm);
    letter-spacing: 0.01em;
    color: var(--c-white);
    text-transform: uppercase;
    line-height: 1.1;
    margin: 0;
  }

  .team-card__credential {
    font-family: var(--font-label);
    font-weight: 500;
    font-size: var(--fs-body-sm);
    color: var(--c-textsub);
    margin: 0;
  }

  .team-card__badges {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .team-card__badge {
    font-family: var(--font-label);
    font-weight: 600;
    font-size: 10px;
    letter-spacing: 0.03em;
    color: var(--c-textsub);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: var(--radius-pill);
    padding: 5px 10px;
    display: inline-block;
  }

  .team-card__bio {
    font-size: var(--fs-body-sm);
    line-height: 1.65;
    color: var(--c-textbody);
    flex-grow: 1;
    margin: 0;
  }

  .team-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: var(--space-3);
    border-top: 1px solid rgba(255, 255, 255, 0.10);
    margin-top: auto;
  }

  .team-card__stat {
    font-family: var(--font-label);
    font-weight: 700;
    font-size: var(--fs-label);
    color: var(--c-lime);
    letter-spacing: 0.02em;
  }

  .team-card__stat span {
    display: block;
    font-family: var(--font-label);
    font-weight: 500;
    font-size: 9px;
    color: var(--c-textbody);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-top: 2px;
  }

  /* Link: convenção real de CTA é cor sólida lime (.btn-cta), não gradiente */
  .team-card__link {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.18);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--c-white);
    text-decoration: none;
    font-size: 14px;
    transition: background var(--transition-base), color var(--transition-base), border-color var(--transition-base);
    flex-shrink: 0;
  }

  .team-card__link:hover {
    background: var(--c-lime);
    border-color: transparent;
    color: var(--c-black);
  }

  /* ---------- Arrows — 44px, alinhadas ao único precedente real da
       plataforma (.photo-modal-arrow do painel ADM em viewport mobile) ---------- */
  .team__arrow {
    display: none;
    position: absolute;
    top: 88px;
    z-index: 3;
    width: 44px;
    height: 44px;
    background: transparent;
    border: 0.75px solid var(--c-white);
    border-radius: 50%;
    color: var(--c-white);
    align-items: center;
    justify-content: center;
    padding: 0;
    cursor: pointer;
    transition: all var(--transition-base);
  }

  .team__arrow svg { width: 20px; height: 20px; }

  .team__arrow:hover:not(:disabled) {
    border-color: var(--c-lime);
    color: var(--c-lime);
    background: rgba(166, 195, 0, 0.1);
  }

  .team__arrow:active { transform: translateY(-1px) scale(0.96); }

  .team__arrow:disabled {
    opacity: 0.2;
    cursor: default;
    pointer-events: none;
  }

  .team__arrow--prev { left: 8px; }
  .team__arrow--next { right: 8px; }

  /* ---------- Dots ---------- */
  .team__dots {
    display: none;
    justify-content: center;
    gap: 6px;
    margin-top: var(--space-3);
  }

  .team__dots span {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.18);
  }

  .team__dots span.is-active {
    background: var(--c-lime);
    width: 16px;
    border-radius: 4px;
  }

  /* ---------- Mobile: switch grid to a swipeable carousel ---------- */
  @media (max-width: 768px) {
    .team__grid {
      display: flex;
      grid-template-columns: unset;
      gap: 14px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      margin: 0 -20px;
      padding: 0 20px 4px;
      scrollbar-width: none;
    }

    .team__grid::-webkit-scrollbar { display: none; }

    .team-card {
      scroll-snap-align: start;
      flex: 0 0 82%;
    }

    .team__arrow { display: flex; }
    .team__dots { display: flex; }
  }
</style>

<script>
  const grid = document.getElementById('teamGrid');
  const dots = document.querySelectorAll('#teamDots span');
  const cards = document.querySelectorAll('.team-card');
  const prevArrow = document.getElementById('teamPrevArrow') as HTMLButtonElement | null;
  const nextArrow = document.getElementById('teamNextArrow') as HTMLButtonElement | null;

  if (grid && prevArrow && nextArrow && cards.length) {
    const currentIndex = () => {
      let closestIndex = 0;
      let closestDist = Infinity;
      cards.forEach((card, i) => {
        const dist = Math.abs(card.getBoundingClientRect().left - grid.getBoundingClientRect().left);
        if (dist < closestDist) { closestDist = dist; closestIndex = i; }
      });
      return closestIndex;
    };

    const updateUI = () => {
      const idx = currentIndex();
      dots.forEach((d, i) => d.classList.toggle('is-active', i === idx));
      prevArrow.disabled = idx === 0;
      nextArrow.disabled = idx === cards.length - 1;
    };

    const goTo = (index: number) => {
      const clamped = Math.max(0, Math.min(cards.length - 1, index));
      cards[clamped].scrollIntoView({ behavior: 'smooth', inline: 'start', block: 'nearest' });
    };

    grid.addEventListener('scroll', () => window.requestAnimationFrame(updateUI));
    prevArrow.addEventListener('click', () => goTo(currentIndex() - 1));
    nextArrow.addEventListener('click', () => goTo(currentIndex() + 1));

    updateUI();
  }
</script>
