---
import BeforeAfterSlider from "../BeforeAfterSlider.astro";
import type { Translations } from "../../i18n/pt";
import type { Locale } from "../../i18n/utils";

interface Props { t: Translations; locale: Locale; }
const { t, locale } = Astro.props;

// Curadoria fechada pelo Coach em 13/08/2026: seis casos, nesta ordem.
// Nome, cargo, pesos e narrativa vieram todos dele, por escrito.
// A correspondencia foto <-> pessoa dos quatro primeiros tambem foi
// confirmada por ele, sobre uma folha com as fotos numeradas de 1 a 4.
// Luiz Fernando e Goncalo ainda nao tem par antes/depois: usam a imagem
// provisoria e carregam photoPending, que marca apenas a foto.
const copyByLocale = {
  "pt-br": {
    cases: [
      {
        name: "Dr. Ricardo Cauduro",
        meta: "Médico oftalmologista · Esportista",
        stat: "TOP 1 na estreia",
        statDesc: "estreando nos palcos com destaque em condicionamento, qualidade muscular e qualidade de pele.",
        story: "O Dr. Ricardo sempre manteve um físico atlético e, em determinado momento, resolveu conhecer os palcos. Logo na estreia conquistou o TOP 1, muito bem avaliado pelo condicionamento físico, pela qualidade muscular e pela qualidade de pele. Uma estreia que mostrou o que acontece quando existe uma boa base e o trabalho é conduzido com estratégia.",
        photos: 1,
      },
      {
        name: "Felipe Hunziker",
        meta: "Mercado financeiro",
        stat: "+10 kg",
        statDesc: "de 98 kg a 108 kg, com ganho expressivo de massa muscular e redução do percentual de gordura.",
        story: "O Felipe passou por uma transformação excepcional. Construímos um físico mais atlético, denso e condicionado, com ganho expressivo de massa muscular e redução do percentual de gordura, sem a necessidade de viver em função de um peso de competição. A proposta sempre foi maior: construir um físico para a vida. Um verdadeiro lifestyle, com estratégia, consistência e um corpo que pudesse ser sustentado no longo prazo.",
        photos: 2,
      },
      {
        name: "João Pedro Valle",
        meta: "Advogado e empresário",
        stat: "+10 kg",
        statDesc: "de massa magra em cerca de 2 anos, com redução drástica do percentual de gordura.",
        story: "O Jonny colocou 10 kg de massa magra ao longo de aproximadamente 2 anos, reduzindo drasticamente o percentual de gordura e promovendo uma verdadeira virada de chave. Mais do que mudar o físico, construiu uma nova relação com treinamento, alimentação e disciplina. Um lifestyle de respeito, e um físico que passou a ser consequência de tudo isso.",
        photos: 3,
      },
      {
        name: "Valmir Castilho",
        meta: "Empresário no ramo de confecção",
        stat: "90 dias",
        statDesc: "para chegar ao shape de atleta no padrão da casa, sem nenhuma intenção de subir aos palcos.",
        story: "O Valmir construiu um físico de respeito, o famoso shape de atleta. E pronto em 90 dias, sem qualquer intenção de competir. O objetivo era outro: provocar uma virada de chave que costumo chamar de preparação. Porque preparação vai muito além do físico — envolve disciplina, comportamento, mentalidade e, muitas vezes, um processo de reconstrução pessoal. Hoje o Valmir concilia musculação com corrida de rua.",
        photos: 4,
      },
      {
        name: "Luiz Fernando Mello",
        meta: "Mercado financeiro",
        stat: "-27,2 kg",
        statDesc: "de 138,1 kg a 110,9 kg, com preservação máxima de massa muscular e sem sofrimento.",
        story: "O Fernando teve uma redução expressiva de 27,2 kg, conduzida de forma estratégica e com foco na preservação máxima de massa muscular. O processo envolveu ajustes progressivos na alimentação, no treinamento e na rotina, buscando melhorar composição corporal, digestão, metabolismo e aderência, sem transformar o caminho em sofrimento. E não terminou na balança: a mudança foi comportamental. O Fernando virou uma chave, abraçou um novo estilo de vida e hoje usufrui de um físico mais atlético, denso e funcional. Desde então, segue aprimorando.",
        photos: 5,
      },
      {
        name: "Gonçalo Marques",
        meta: "GM Digital Bunker",
        stat: "+12 kg",
        statDesc: "de 86 kg a 98 kg, quebrando um platô até o título de campeão de categoria.",
        story: "O Gonçalo é a prova de que consistência vence talento quando o talento não trabalha. Quando começamos, o objetivo era único: ficar grande. Ele chegou com um físico denso, porém travado e desacreditado por outros profissionais. Quebramos o platô e evoluímos tanto que enfrentamos um palco ao longo da jornada, onde o Gon foi campeão da sua categoria, TOP 1 na maior federação de fisiculturismo. Seguimos na trajetória do ficar grande, e foi aí que ele percebeu que tinha perdido praticamente todo o guarda-roupa.",
        photos: 6,
      },
    ],
  },
  en: {
    cases: [
      {
        name: "Dr. Ricardo Cauduro",
        meta: "Ophthalmologist · Athlete",
        stat: "TOP 1 on debut",
        statDesc: "debuting on stage with standout conditioning, muscle quality and skin quality.",
        story: "Dr. Ricardo had always kept an athletic physique and, at a certain point, decided to try the competitive stage. On his very first appearance he took TOP 1, highly rated for conditioning, muscle quality and skin quality. A debut that showed what happens when there is a solid base and the work is guided by strategy.",
        photos: 1,
      },
      {
        name: "Felipe Hunziker",
        meta: "Financial market",
        stat: "+10 kg",
        statDesc: "from 98 kg to 108 kg, with a significant gain in muscle mass and a drop in body fat.",
        story: "Felipe went through an exceptional transformation. We built a more athletic, denser and better conditioned physique, with a significant gain in muscle mass and a reduction in body fat, without having to live around a competition weight. The goal was always bigger: to build a physique for life. A true lifestyle, with strategy, consistency and a body that could be sustained in the long run.",
        photos: 2,
      },
      {
        name: "João Pedro Valle",
        meta: "Lawyer and entrepreneur",
        stat: "+10 kg",
        statDesc: "of lean mass over roughly 2 years, with a sharp drop in body fat.",
        story: "Jonny added 10 kg of lean mass over roughly 2 years, sharply reducing his body fat and bringing about a real turning point. More than changing his physique, he built a new relationship with training, nutrition and discipline. A lifestyle to respect, and a physique that became the consequence of all of it.",
        photos: 3,
      },
      {
        name: "Valmir Castilho",
        meta: "Entrepreneur in the apparel industry",
        stat: "90 days",
        statDesc: "to reach an athlete's physique by our standard, with no intention of ever competing.",
        story: "Valmir built a physique to respect, the well-known athlete's shape. And ready in 90 days, with no intention of competing. The goal was different: to bring about the turning point I like to call preparation. Because preparation goes far beyond the physical — it involves discipline, behaviour, mindset and, often, a process of personal rebuilding. Today Valmir combines weight training with street running.",
        photos: 4,
      },
      {
        name: "Luiz Fernando Mello",
        meta: "Financial market",
        stat: "-27.2 kg",
        statDesc: "from 138.1 kg to 110.9 kg, preserving as much muscle mass as possible and without suffering.",
        story: "Fernando achieved a significant reduction of 27.2 kg, guided strategically and focused on preserving as much muscle mass as possible. The process involved progressive adjustments to nutrition, training and routine, aiming to improve body composition, digestion, metabolism and adherence, without turning the journey into suffering. And it did not end on the scale: the change was behavioural. Fernando flipped a switch, embraced a new lifestyle and today enjoys a more athletic, denser and more functional physique. He has been refining it ever since.",
        photos: 5,
      },
      {
        name: "Gonçalo Marques",
        meta: "GM Digital Bunker",
        stat: "+12 kg",
        statDesc: "from 86 kg to 98 kg, breaking through a plateau all the way to a category championship title.",
        story: "Gonçalo is proof that consistency beats talent when talent doesn't put in the work. When we started, the goal was a single one: get big. He arrived with a dense physique, but stuck, and written off by other professionals. We broke through the plateau and progressed so much that we took on a stage along the way, where Gon won his category, TOP 1 in the largest bodybuilding federation. We carried on with the get-big plan, and that was when he realised he had lost practically his whole wardrobe.",
        photos: 6,
      },
    ],
  },
} as const;

const c = copyByLocale[locale];

const results = c.cases.map((item, i) => {
  const n = (item as { photos?: number }).photos;
  const hasPhotos = typeof n === "number";
  return {
    n: i + 1,
    beforeSrc: hasPhotos ? `/images/results/resultado-0${n}-antes.webp` : "/images/results/placeholder-novo-caso-antes.webp",
    afterSrc:  hasPhotos ? `/images/results/resultado-0${n}-depois.webp` : "/images/results/placeholder-novo-caso-depois.webp",
    name: item.name,
    meta: item.meta,
    stat: item.stat,
    statDesc: item.statDesc,
    story: item.story,
    beforeLabel: t.results.beforeLabel,
    afterLabel:  t.results.afterLabel,
    ...(hasPhotos ? {} : { photoPending: true }),
  };
});
---


<section class="section results" id="resultados" style="scroll-margin-top:80px" aria-label={t.results.ariaLabel}>
  <div class="container">
    <p class="section__eyebrow">{t.results.eyebrow}</p>
    <h2 class="section__title">
      {t.results.title}<span> {t.results.titleAccent}</span>
    </h2>
    <BeforeAfterSlider items={results} t={t} />
  </div>
</section>
