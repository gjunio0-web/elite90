---
import BeforeAfterSlider from "../BeforeAfterSlider.astro";
import type { Translations } from "../../i18n/pt";

interface Props { t: Translations; }
const { t } = Astro.props;

const results = [
  {
    n: 1,
    beforeSrc: `/images/results/resultado-01-antes.webp`,
    afterSrc:  `/images/results/resultado-01-depois.webp`,
    name:      "Dr. Ricardo",
    meta:      "Médico · Oftalmologista",
    stat:      "50+",
    statDesc:  "Estreou em competições conquistando o TOP 1, com destaque pelo condicionamento físico e qualidade de pele.",
    story:     "Preparação para competição, conquistou o TOP1 logo na sua estreia, foi bem avaliado pelo condicionamento físico e qualidade de pele.",
    beforeLabel: t.results.beforeLabel,
    afterLabel:  t.results.afterLabel,
  },
  {
    n: 2,
    beforeSrc: `/images/results/resultado-02-antes.webp`,
    afterSrc:  `/images/results/resultado-02-depois.webp`,
    name:      "Felipe Hunziker",
    meta:      "Mercado Financeiro",
    stat:      "+17 kg",
    statDesc:  "de massa magra, reduzindo o percentual de gordura e construindo um físico atlético para a vida.",
    story:     "Ganhou 17 kilos de massa magra, reduzindo o percentual de gordura, construindo um físico atleta \"sem o peso de competição\", e seguindo um life style pra vida.",
    beforeLabel: t.results.beforeLabel,
    afterLabel:  t.results.afterLabel,
  },
  {
    n: 3,
    beforeSrc: `/images/results/resultado-03-antes.webp`,
    afterSrc:  `/images/results/resultado-03-depois.webp`,
    name:      "João Pedro",
    meta:      "Advogado e Empresário",
    stat:      "+10 kg",
    statDesc:  "de massa magra, transformando o físico e adotando um estilo de vida de alta performance.",
    story:     "Ganhou 10 kilos de massa magra ao longo de 2 anos, reduzindo drasticamente o percentual de gordura e com uma virada de chave para um life style de respeito.",
    beforeLabel: t.results.beforeLabel,
    afterLabel:  t.results.afterLabel,
  },
  {
    n: 4,
    beforeSrc: `/images/results/resultado-04-antes.webp`,
    afterSrc:  `/images/results/resultado-04-depois.webp`,
    name:      "Valmir Castilho",
    meta:      "Empresário",
    stat:      "90 dias",
    statDesc:  "para lapidar o físico, mantendo os 105 kg com muito mais definição, densidade e presença.",
    story:     "Conversão de massa gorda para massa magra, cravando um físico de respeito em apenas 90 dias.",
    beforeLabel: t.results.beforeLabel,
    afterLabel:  t.results.afterLabel,
  },
];
---

<section class="section results" id="resultados" style="scroll-margin-top:80px" aria-label="Resultados reais">
  <div class="container">
    <p class="section__eyebrow">{t.results.eyebrow}</p>
    <h2 class="section__title">
      {t.results.title}<span> {t.results.titleAccent}</span>
    </h2>
    <BeforeAfterSlider items={results} t={t} />
  </div>
</section>
