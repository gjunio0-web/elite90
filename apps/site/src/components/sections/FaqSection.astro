---
import type { Translations } from "../../i18n/pt";
interface Props { t: Translations; }
const { t } = Astro.props;
---

<section class="section faq" id="faq" style="scroll-margin-top:80px" aria-label="FAQ">
  <div class="container container--text">
    <p class="section__eyebrow">{t.faq.eyebrow}</p>
    <h2 class="section__title">{t.faq.title}</h2>
    <dl class="faq__list">
      {t.faq.items.map((item, idx) => (
        <div class="faq__item">
          <dt>
            <button class="faq__btn" type="button" aria-expanded="false" aria-controls={`faq-answer-${idx}`}>
              {item.question}
              <span class="faq__icon" aria-hidden="true">+</span>
            </button>
          </dt>
          <dd class="faq__answer" id={`faq-answer-${idx}`} inert>
            <div class="faq__answer-inner"><p>{item.answer}</p></div>
          </dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<script>
  document.querySelectorAll(".faq__btn").forEach(btn => {
    const b = btn as HTMLButtonElement;
    const item = b.closest(".faq__item") as HTMLElement | null;
    const answer = item?.querySelector(".faq__answer") as HTMLElement | null;
    const icon = b.querySelector(".faq__icon") as HTMLElement | null;
    if (!item || !answer || !icon) return;
    b.addEventListener("click", () => {
      const willExpand = b.getAttribute("aria-expanded") !== "true";
      b.setAttribute("aria-expanded", String(willExpand));
      item.classList.toggle("is-open", willExpand);
      // "inert" (não "hidden") para permitir a transição de altura via CSS
      // e ainda tirar o conteúdo recolhido da navegação por teclado/leitor de tela
      if (willExpand) answer.removeAttribute("inert");
      else answer.setAttribute("inert", "");
      icon.textContent = willExpand ? "-" : "+";
    });
  });
</script>

<style>
  .faq__list { display: flex; flex-direction: column; margin-top: var(--space-6); }
  .faq__item { border-bottom: 1px solid rgba(255,255,255,.08); }
  .faq__item:first-child { border-top: 1px solid rgba(255,255,255,.08); }
  .faq__btn { width: 100%; display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); padding-block: var(--space-4); font-family: var(--font-label); font-size: var(--fs-body-md); font-weight: 700; text-align: left; color: var(--c-white); background: none; border: none; cursor: pointer; text-transform: uppercase; letter-spacing: .04em; transition: color var(--transition-base); }
  .faq__btn:hover { color: var(--c-lime); }
  .faq__icon { font-family: var(--font-display); font-size: 1.5rem; color: var(--c-lime); flex-shrink: 0; transition: transform var(--transition-base); line-height: 1; }
  .faq__btn[aria-expanded="true"] .faq__icon { transform: rotate(45deg); }

  /* Animação de abrir/fechar: grid-template-rows 0fr -> 1fr anima a altura
     sem precisar medir o conteúdo em JS (funciona com texto de qualquer
     tamanho). A opacidade some/aparece um pouco mais rápido que a altura,
     mesma proporção usada no drawer mobile do Header. */
  .faq__answer {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition: grid-template-rows 300ms ease, opacity 200ms ease;
  }
  .faq__item.is-open .faq__answer { grid-template-rows: 1fr; opacity: 1; }
  .faq__answer-inner { overflow: hidden; min-height: 0; }
  .faq__answer p { padding-bottom: var(--space-4); padding-right: 3rem; font-size: var(--fs-body-md); color: var(--c-textbody); line-height: 1.7; margin: 0; }
</style>
