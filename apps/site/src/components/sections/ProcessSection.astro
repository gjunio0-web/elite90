---
import ProcessTimeline from "../ProcessTimeline.astro";
import type { Translations } from "../../i18n/pt";

interface Props { t: Translations; }
const { t } = Astro.props;
---

<section class="section process" id="processo" style="scroll-margin-top:80px" aria-label={t.process.ariaLabel}>
  <div class="container">
    <p class="section__eyebrow">{t.process.eyebrow}</p>
    <h2 class="section__title">{t.process.title}</h2>
    <ProcessTimeline t={t} />
  </div>
</section>
