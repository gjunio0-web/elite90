---
import type { Translations } from "../../i18n/pt";
interface Props { t: Translations; }
const { t } = Astro.props;
---
<section class="section objection" id="objection" style="scroll-margin-top:80px" aria-label={t.objection.ariaLabel}>
  <div class="container container--text objection__inner">
    <p class="section__eyebrow">{t.objection.eyebrow}</p>
    <h2 class="objection__question">{t.objection.question}</h2>
    {t.objection.paragraphs.map(para => <p class="objection__para">{para}</p>)}
  </div>
</section>

<style>
  .objection { background-color: var(--c-darkbg); }
  .objection__inner { text-align: center; }
  .objection__question { font-size: var(--fs-display-md); color: var(--c-white); margin-bottom: var(--space-5); font-style: italic; }
  .objection__para { font-size: var(--fs-body-lg); color: var(--c-textbody); line-height: 1.8; margin-bottom: var(--space-4); }
  .objection__para:last-child { color: var(--c-lime); font-weight: 700; }
</style>
